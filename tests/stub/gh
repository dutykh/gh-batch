#!/bin/sh
#
# Stub gh for the test suite of gh-batch: canned answers, no network.
#
# Author: Dr. Denys Dutykh (Mathematics Department, Khalifa University of
#         Science and Technology, Abu Dhabi, UAE).
#
# The answers live in the folder $GH_STUB_DIR:
#   user               the login of the account
#   repos/OWNER/NAME   the line answered by "gh api repos/OWNER/NAME"
#   names/OWNER/NAME   its present name, answered when only .full_name is asked
#   list/OWNER         the lines answered by "gh repo list OWNER"
#   orgs               the organisations of the account, one login per line
#   orgs.refused       when present, GitHub refuses to list them, in these words
#   titles/LOGIN       the name that the organisation LOGIN shows
#   protocol           https or ssh, for "gh config get git_protocol"
# Every call is appended to $GH_STUB_DIR/calls, so that a test can tell
# whether GitHub was asked.

dir=${GH_STUB_DIR:?the stub gh needs GH_STUB_DIR}
printf '%s\n' "$*" >> "$dir/calls"

case "$1 $2" in
    "api user")
        cat "$dir/user" 2>/dev/null || exit 1
        ;;
    "api user/orgs")
        if [ -f "$dir/orgs.refused" ]; then
            cat "$dir/orgs.refused" >&2
            exit 1
        fi
        # An account without the file belongs to no organisation.
        [ -f "$dir/orgs" ] && cat "$dir/orgs"
        exit 0
        ;;
    "api orgs/"*)
        # An organisation without the file shows no name.
        [ -f "$dir/titles/${2#orgs/}" ] && cat "$dir/titles/${2#orgs/}"
        exit 0
        ;;
    "api repos/"*)
        kind=repos
        for arg in "$@"; do
            [ "$arg" = ".full_name" ] && kind=names
        done
        if [ -f "$dir/$kind/${2#repos/}" ]; then
            cat "$dir/$kind/${2#repos/}"
        else
            echo "gh: Not Found (HTTP 404)" >&2
            exit 1
        fi
        ;;
    "repo list")
        owner=$3
        case "$owner" in
            ""|-*) owner=$(cat "$dir/user" 2>/dev/null) ;;
        esac
        if [ -f "$dir/list/$owner" ]; then
            cat "$dir/list/$owner"
        else
            echo "gh: could not resolve to a user or an organization: $owner" >&2
            exit 1
        fi
        ;;
    "config get")
        cat "$dir/protocol" 2>/dev/null || echo https
        ;;
    "auth status")
        exit 0
        ;;
    *)
        echo "stub gh: unexpected call: $*" >&2
        exit 2
        ;;
esac
