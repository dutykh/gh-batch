show_help() {
    case "${1:-}" in
        "")      usage ;;
        pull)    help_pull ;;
        push)    help_push ;;
        commit)  help_commit ;;
        sync)    help_sync ;;
        reset)   help_reset ;;
        tidy)    help_tidy ;;
        clone)   help_clone ;;
        status)  help_status ;;
        fetch)   help_fetch ;;
        log)     help_log ;;
        exec)    help_exec ;;
        doctor)  help_doctor ;;
        completion) help_completion ;;
        list)    help_list ;;
        config)  help_config ;;
        *)       die "$EX_USAGE" "no such command: $1 (see $PROG help)" ;;
    esac
}

# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------

need_value() {
    [ "$#" -ge 2 ] || die "$EX_USAGE" "the option $1 needs a value"
}

parse_options() {
    local before first second
    while [ "$#" -gt 0 ]; do
        before=$#; first=$1; second=${2-}
        case "$1" in
            -j|--jobs)      need_value "$@"; OPT_JOBS=$2; shift 2 ;;
            --jobs=*)       OPT_JOBS=${1#*=}; shift ;;
            -j[0-9]*)       OPT_JOBS=${1#-j}; shift ;;
            --depth)        need_value "$@"; OPT_DEPTH=$2; shift 2 ;;
            --depth=*)      OPT_DEPTH=${1#*=}; shift ;;
            --timeout)      need_value "$@"; OPT_TIMEOUT=$2; shift 2 ;;
            --timeout=*)    OPT_TIMEOUT=${1#*=}; shift ;;
            --diverged)     need_value "$@"; OPT_DIVERGED=$2; shift 2 ;;
            --diverged=*)   OPT_DIVERGED=${1#*=}; shift ;;
            --conflicts)    need_value "$@"; OPT_CONFLICTS=$2; shift 2 ;;
            --conflicts=*)  OPT_CONFLICTS=${1#*=}; shift ;;
            --only)         need_value "$@"; ONLY+=("$2"); shift 2 ;;
            --only=*)       ONLY+=("${1#*=}"); shift ;;
            --except)       need_value "$@"; EXCEPT+=("$2"); shift 2 ;;
            --except=*)     EXCEPT+=("${1#*=}"); shift ;;
            --commit)       OPT_COMMIT="true"; shift ;;
            --no-commit)    OPT_COMMIT="false"; shift ;;
            --discard-local) DISCARD_LOCAL=1; shift ;;
            -m|--message)   need_value "$@"; OPT_MESSAGE=$2; shift 2 ;;
            --message=*)    OPT_MESSAGE=${1#*=}; shift ;;
            -y|--yes)       YES=1; shift ;;
            -u)
                DASH_U=1
                if [ "$COMMAND" = "clone" ]; then UPDATE=1; else SET_UPSTREAM=1; fi
                shift ;;
            --set-upstream) SET_UPSTREAM=1; shift ;;
            --update)       UPDATE=1; shift ;;
            --into)         need_value "$@"; INTO=$2; shift 2 ;;
            --into=*)       INTO=${1#*=}; shift ;;
            --since)        need_value "$@"; SINCE=$2; shift 2 ;;
            --since=*)      SINCE=${1#*=}; shift ;;
            --until)        need_value "$@"; LOG_UNTIL=$2; shift 2 ;;
            --until=*)      LOG_UNTIL=${1#*=}; shift ;;
            --author)       need_value "$@"; LOG_AUTHOR=$2; shift 2 ;;
            --author=*)     LOG_AUTHOR=${1#*=}; shift ;;
            --all-authors)  ALL_AUTHORS=1; shift ;;
            --dirty)        F_DIRTY=1; shift ;;
            --clean)        F_CLEAN=1; shift ;;
            --ahead)        F_AHEAD=1; shift ;;
            --behind)       F_BEHIND=1; shift ;;
            --offline)      OFFLINE=1; shift ;;
            --days)         need_value "$@"; DOCTOR_DAYS=$2; DAYS_GIVEN=1; shift 2 ;;
            --days=*)       DOCTOR_DAYS=${1#*=}; DAYS_GIVEN=1; shift ;;
            --in)           need_value "$@"; ARGS+=("$2"); shift 2 ;;
            --in=*)         ARGS+=("${1#*=}"); shift ;;
            --orgs)         OPT_ORGS="true"; shift ;;
            --no-orgs)      OPT_ORGS="false"; shift ;;
            --no-forks)     NO_FORKS=1; shift ;;
            --no-archived)  NO_ARCHIVED=1; shift ;;
            --flat)         LAYOUT="flat"; shift ;;
            --by-owner)     LAYOUT="owner"; shift ;;
            --notify)       OPT_NOTIFY=1; shift ;;
            -n|--dry-run)   DRY_RUN=1; shift ;;
            -v|--verbose)   VERBOSE=1; shift ;;
            -q|--quiet)     QUIET=1; shift ;;
            -l|--long)      LONG=1; shift ;;
            --porcelain)    PORCELAIN=1; shift ;;
            --absolute)     ABSOLUTE=1; shift ;;
            --manifest)
                if [ "$COMMAND" = "clone" ]; then
                    need_value "$@"; MANIFEST_IN=$2; shift 2
                else
                    MANIFEST_OUT=1; shift
                fi ;;
            --manifest=*)   MANIFEST_IN=${1#*=}; shift ;;
            --color|--colour)       need_value "$@"; COLOR_MODE=$2; shift 2 ;;
            --color=*|--colour=*)   COLOR_MODE=${1#*=}; shift ;;
            --no-color|--no-colour) COLOR_MODE="never"; shift ;;
            -h|--help)      show_help "$COMMAND"; exit "$EX_OK" ;;
            --version)      printf '%s %s\n' "$PROG" "$GH_BATCH_VERSION"; exit "$EX_OK" ;;
            --)
                shift
                if [ "$COMMAND" = "exec" ]; then
                    EXEC_CMD=("$@")
                    return 0
                fi
                AFTER_DASHES=1
                while [ "$#" -gt 0 ]; do positional "$1"; shift; done
                continue ;;
            -?*)            die "$EX_USAGE" "unknown option: $1 (see $PROG help${COMMAND:+ $COMMAND})" ;;
            *)
                # The command of "exec" starts at its first word and keeps
                # the rest of the line, options included.
                if [ "$COMMAND" = "exec" ]; then
                    EXEC_CMD=("$@")
                    return 0
                fi
                positional "$1"; shift
                continue ;;
        esac
        # The option as it was typed, with its value: each command of a line
        # receives it again.
        OPT_TOKENS+=("$first")
        if [ $(( before - $# )) -ge 2 ]; then
            OPT_TOKENS+=("$second")
        fi
    done
}

chainable() {
    # chainable WORD -> 0 for a command that may share its line with others
    case "$1" in
        pull|push|commit|sync|reset|tidy|clone|status|fetch|log|doctor) return 0 ;;
    esac
    return 1
}

positional() {
    # A word that names a command joins the line of commands, wherever it
    # stands, unless a "--" came before it: "commit push" asks for the push
    # once the commits are made, and "pull commit push" adds a pull before.
    # A folder or a repository named like a command is given as a path, or
    # after "--".
    if [ "$AFTER_DASHES" -eq 0 ] && chainable "$COMMAND" && chainable "$1"; then
        CHAIN+=("$1")
        return 0
    fi
    case "$COMMAND" in
        help)   HELP_TOPIC=$1 ;;
        completion) SHELL_NAME=$1 ;;
        clone)  OWNERS+=("$1") ;;
        config) die "$EX_USAGE" "config takes no argument" ;;
        *)      ARGS+=("$1") ;;
    esac
}

plan_steps() {
    # The commands of the line, as steps run one after another. A commit
    # followed by a push is one step, the form "commit push", and a pull
    # followed by a push is "sync". Each command comes once; sync holds a
    # pull and a push.
    local i=1 word part seen=" "
    STEPS=()
    # A word that names a command and also a folder where the line is typed
    # could mean either: the run stops rather than guess, before anything
    # is done. Until version 1.6 such a word was the folder.
    while [ "$i" -lt "${#CHAIN[@]}" ]; do
        word=${CHAIN[$i]}
        if [ -d "$word" ]; then
            die "$EX_USAGE" "$word is a command and also a folder here: write ./$word for the folder, or type the line in another folder"
        fi
        i=$(( i + 1 ))
    done
    i=0
    for word in ${CHAIN[@]+"${CHAIN[@]}"}; do
        for part in $( [ "$word" = "sync" ] && printf 'pull push' || printf '%s' "$word" ); do
            case "$seen" in
                *" $part "*) die "$EX_USAGE" "$part comes twice on the line (sync is a pull and a push)" ;;
            esac
            seen="$seen$part "
        done
    done
    while [ "$i" -lt "${#CHAIN[@]}" ]; do
        word=${CHAIN[$i]}
        case "$word ${CHAIN[$(( i + 1 ))]:-}" in
            "commit push") STEPS+=("commit push"); i=$(( i + 2 )); continue ;;
            "pull push")   STEPS+=("sync"); i=$(( i + 2 )); continue ;;
        esac
        STEPS+=("$word")
        i=$(( i + 1 ))
    done
    if [ "${#STEPS[@]}" -eq 1 ]; then
        case "${STEPS[0]}" in
            "commit push") COMMAND="commit"; ALSO_PUSH=1 ;;
            *)             COMMAND=${STEPS[0]} ;;
        esac
    elif [ "${#STEPS[@]}" -gt 1 ]; then
        # On a line of several commands the words are folders or names for
        # all of them; clone then reads the account and its organisations.
        ARGS+=(${OWNERS[@]+"${OWNERS[@]}"})
        OWNERS=()
    fi
    return 0
}

in_line() {
    # in_line COMMAND -> 0 when the line holds that command
    local word
    for word in ${CHAIN[@]+"${CHAIN[@]}"}; do
        [ "$word" = "$1" ] && return 0
        [ "$word" = "sync" ] && { [ "$1" = "pull" ] || [ "$1" = "push" ]; } && return 0
    done
    return 1
}

declined() {
    # A question answered no ends a line of several commands there: the
    # command that asked leaves this mark, and the line starts nothing more.
    if [ -n "${GH_BATCH_DECLINED:-}" ]; then
        : > "$GH_BATCH_DECLINED" 2>/dev/null
    fi
    return 0
}

run_line() {
    # Several commands on one line. Each runs as a gh-batch of its own, in
    # the order typed, with the options of the line and its folders or
    # names, and prints its own report. A question answered no, a command
    # that cannot start and a signal end the line; a repository that needs
    # the user does not, since each repository is handled on its own.
    local step rc worst="$EX_OK" n=0
    [ "$DASH_U" -eq 1 ] &&
        die "$EX_USAGE" "-u means --update to clone and --set-upstream to the others: on a line of several commands, write the long option"
    if [ "$MANIFEST_OUT" -eq 1 ] || [ -n "$MANIFEST_IN" ]; then
        die "$EX_USAGE" "--manifest belongs to clone or to list alone, not to a line of several commands"
    fi
    if [ -n "$SINCE" ] && in_line clone && in_line log; then
        die "$EX_USAGE" "--since means one thing to clone and another to log: run them apart"
    fi
    # A word that names nothing stops the line before anything is done.
    [ "${#ARGS[@]}" -gt 0 ] && discover
    TMP=$(mktemp -d "${TMPDIR:-/tmp}/gh-batch.XXXXXX") ||
        die "$EX_ENV" "cannot create a temporary directory"
    trap cleanup EXIT
    # The command at work receives the signal too and ends in its own way;
    # the line only learns that it must stop.
    trap 'LINE_STOP=1' INT TERM HUP
    for step in "${STEPS[@]}"; do
        if [ "$n" -gt 0 ] && [ "$PORCELAIN" -eq 0 ] && [ "$QUIET" -eq 0 ]; then
            printf '\n'
        fi
        n=$(( n + 1 ))
        # shellcheck disable=SC2086  # a step is one or two words
        set -- $step
        if [ "$1" = "clone" ]; then
            GH_BATCH_DECLINED="$TMP/declined" "$BASH" "$SELF" "$@" ${OPT_TOKENS[@]+"${OPT_TOKENS[@]}"}
        else
            GH_BATCH_DECLINED="$TMP/declined" "$BASH" "$SELF" "$@" ${OPT_TOKENS[@]+"${OPT_TOKENS[@]}"} \
                -- ${ARGS[@]+"${ARGS[@]}"}
        fi
        rc=$?
        [ "$LINE_STOP" -eq 1 ] && exit "$EX_INTERRUPT"
        case "$rc" in
            "$EX_OK") ;;
            "$EX_ATTENTION") worst=$EX_ATTENTION ;;
            *) exit "$rc" ;;
        esac
        [ -e "$TMP/declined" ] && exit "$worst"
    done
    exit "$worst"
}

main() {
    case "${1:-}" in
        ""|-h|--help)   usage; exit "$EX_OK" ;;
        --version|version) printf '%s %s\n' "$PROG" "$GH_BATCH_VERSION"; exit "$EX_OK" ;;
        -*)             die "$EX_USAGE" "the command comes first: $PROG <command> [options] (see $PROG help)" ;;
    esac
    COMMAND=$1
    shift
    case "$COMMAND" in
        pull|push|commit|sync|reset|tidy|clone|status|fetch|log|exec|doctor|list|config|completion|help) ;;
        *) die "$EX_USAGE" "no such command: $COMMAND (see $PROG help)" ;;
    esac
    SELF=$0
    chainable "$COMMAND" && CHAIN=("$COMMAND")
    parse_options "$@"
    if [ "$COMMAND" = "help" ]; then
        show_help "$HELP_TOPIC"
        exit "$EX_OK"
    fi
    [ "$COMMAND" = "completion" ] && cmd_completion
    plan_steps
    check_git
    load_settings
    resolve_settings
    [ "${#STEPS[@]}" -gt 1 ] && run_line
    case "$COMMAND" in
        pull|fetch) cmd_pull ;;
        push)       cmd_push ;;
        commit)     cmd_commit ;;
        sync)       cmd_sync ;;
        reset)      cmd_reset ;;
        tidy)       cmd_tidy ;;
        clone)      cmd_clone ;;
        log)        LOG_SINCE=$SINCE; cmd_log ;;
        exec)       cmd_exec ;;
        doctor)     cmd_doctor ;;
        status)     cmd_status ;;
        list)       cmd_list ;;
        config)     cmd_config ;;
    esac
}

main "$@"; exit
