cmd_list() {
    local i=0 url branch
    setup_colour
    harden_git
    discover
    if [ "$MANIFEST_OUT" -eq 1 ]; then
        printf '# Layout of %s, written by %s list --manifest.\n' "$ROOT_LABEL" "$PROG"
        printf '# One repository per line: folder, address, branch, separated by tabs.\n'
        printf '# "%s clone --manifest FILE" clones the missing ones into the same folders.\n' "$PROG"
    fi
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        REPO=${REPOS[$i]}
        if [ "$MANIFEST_OUT" -eq 1 ]; then
            GIT=(git -C "$REPO")
            url=$(g remote get-url origin 2>/dev/null) || url=$(first_remote_url)
            branch=$(g symbolic-ref -q --short HEAD 2>/dev/null)
            if [ -n "$url" ]; then
                printf '%s\t%s\t%s\n' "${NAMES[$i]}" "$(printf '%s' "$url" | redact)" "$branch"
            else
                warn "${NAMES[$i]} has no remote and is left out of the layout"
            fi
        elif [ "$ABSOLUTE" -eq 1 ]; then
            printf '%s\n' "$REPO"
        else
            printf '%s\n' "${NAMES[$i]}"
        fi
        i=$(( i + 1 ))
    done
    exit "$EX_OK"
}

first_remote_url() {
    local name=""
    IFS= read -r name < <(g remote 2>/dev/null)
    [ -n "$name" ] && g remote get-url "$name" 2>/dev/null
    return 0
}

setting_row() {
    # setting_row NAME VALUE SOURCE: one line of "config"
    if [ "$STYLED" -eq 1 ]; then
        printf '  %s%-12s%s %-30s %s%s%s\n' "$C_CMD" "$1" "$C_OFF" "$2" "$C_DIM" "$3" "$C_OFF"
    else
        printf '  %-12s %-30s %s\n' "$1" "$2" "$3"
    fi
}

cmd_config() {
    local root i=0
    setup_colour
    if [ "$STYLED" -eq 1 ]; then
        printf '%s settings in force\n\n' "$(title_band "$PROG $GH_BATCH_VERSION")"
    else
        printf '%s %s, settings in force\n\n' "$PROG" "$GH_BATCH_VERSION"
    fi
    if [ -n "${GH_BATCH_ROOT:-}" ]; then
        setting_row "root" "$GH_BATCH_ROOT" "environment (GH_BATCH_ROOT)"
    elif [ "${#CFG_ROOTS[@]}" -gt 0 ]; then
        for root in "${CFG_ROOTS[@]}"; do
            setting_row "root" "$(short_path "$root")" "git config"
        done
    else
        setting_row "root" "(the current folder)" "default"
    fi
    setting_row "depth" "$DEPTH" "$SRC_depth"
    setting_row "jobs" "$JOBS" "$SRC_jobs"
    setting_row "timeout" "$TIMEOUT s" "$SRC_timeout"
    setting_row "diverged" "$DIVERGED" "$SRC_diverged"
    setting_row "conflicts" "$CONFLICTS" "$SRC_conflicts"
    setting_row "commit" "$( [ "$COMMIT" -eq 1 ] && printf 'true' || printf 'false' )" "$SRC_commit"
    setting_row "confirm" "$( [ "$CONFIRM" -eq 1 ] && printf 'true' || printf 'false' )" "$SRC_confirm"
    setting_row "message" "$MESSAGE" "$SRC_message"
    setting_row "machine" "$MACHINE_NAME" "$SRC_machine"
    setting_row "maxFileSize" "$MAX_FILE_MB MB" "$SRC_maxfile"
    setting_row "maxNewFiles" "$MAX_NEW_FILES" "$SRC_maxnew"
    setting_row "notify" "${NOTIFY_CMD:-(none)}" "$SRC_notify"
    setting_row "notifyOn" "$NOTIFY_ON" "$SRC_notifyon"
    for root in ${CFG_EXCLUDE[@]+"${CFG_EXCLUDE[@]}"}; do
        setting_row "exclude" "$root" "git config"
    done
    setting_row "orgs" "$( [ "$ORGS" -eq 1 ] && printf 'true' || printf 'false' )" "$SRC_orgs"
    # What the settings say of single owners, for "clone".
    while [ "$i" -lt "${#CFG_OWNERS[@]}" ]; do
        [ -n "${CFG_OWNER_FOLDER[$i]}" ] &&
            setting_row "folder" "${CFG_OWNERS[$i]} in ${CFG_OWNER_FOLDER[$i]}" "git config"
        [ "${CFG_OWNER_SKIP[$i]}" = "1" ] &&
            setting_row "skip" "${CFG_OWNERS[$i]}" "git config"
        i=$(( i + 1 ))
    done
    printf '\n%sA setting is changed with:%s %sgit config --global gh-batch.NAME VALUE%s\n' "$C_DIM" "$C_OFF" "$C_CMD" "$C_OFF"
    printf '%sThe folder of an owner, for clone:%s %sgit config --global gh-batch.OWNER.folder NAME%s\n' "$C_DIM" "$C_OFF" "$C_CMD" "$C_OFF"
    printf '%sThe record of what the tool moved is kept in%s %s\n' "$C_DIM" "$C_OFF" "$(short_path "$STATE_DIR")"
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
$PROG $GH_BATCH_VERSION, one command for many git repositories.

USAGE
  $PROG <command> [command ...] [options] [folder or name ...]

  A folder is searched for git repositories, three levels deep by default; a
  folder that is itself a repository is taken alone. Without a folder, the
  ones of "git config --global gh-batch.root" are used, else the current one.

  A word that is not a folder here is a name, looked up under those folders
  from wherever the command is typed: the name of a repository as the
  report shows it, the last part of that name, or a folder holding several.
  A name may hold the wildcards of --only.

    $PROG commit push obsidian notes

  Several commands run one after another, in the order given, each with
  its own report and its own question, on the same repositories; clone
  then reads the whole account. A question answered no ends the line. A
  folder named like a command is given as a path, or after --, and one
  that stands here stops the run rather than guess.

    $PROG pull commit push thesis
    $PROG clone pull status

COMMANDS
  pull        fetch every repository and bring it forward (the morning command)
  push        push every repository that has new commits, after committing
              what is pending when asked to (the evening command)
  commit      commit what is pending, asking for the message; with "push"
              afterwards, push once the commits are made
  sync        pull, then push
  reset       set every branch to the one it follows on its server, safely:
              its commit is kept first, and commits that the server lacks
              are dropped only with --discard-local
  tidy        remove the backups and the kept files of runs older than a
              month
  clone       clone what is missing: a whole GitHub account with its
              organisations, or the entries of a layout file written by
              "list --manifest"
  status      what is pending in every repository, without touching the network
  fetch       look at the servers, change no file, say what pull would do
  log         the commits of today, or of a period, across the repositories
  exec        run a command in every repository
  doctor      health check of the repositories, their remotes and the folder
  list        the repositories found; --manifest writes their layout
  config      the settings in force and where each comes from
  completion  the completion script for bash or zsh
  help        help for one command, for example: $PROG help pull

COMMON OPTIONS
  -j, --jobs N       repositories handled at the same time (default 8; 1 means
                     strictly one after the other); the report always follows
                     the order of the folders
      --depth N      levels searched below each folder (default 3)
      --only GLOB    keep only the repositories whose name matches, repeatable
      --except GLOB  leave out the repositories whose name matches, repeatable
  -n, --dry-run      show what would be done and change nothing
  -y, --yes          do not ask for a commit message, or before committing,
                     pushing, cloning or dropping commits
  -v, --verbose      show every repository, not only those that changed
  -q, --quiet        show only what needs you
      --porcelain    one line per repository, fields separated by tabs:
                     state, path, branch, message
      --timeout SEC  give up on a server that does not answer (default 300)
      --color WHEN   auto, always or never; --no-color is never
  -h, --help         this text, or the help of the command given
      --version      the version

EXIT STATUS
  0 nothing needs you, 1 at least one repository needs you, 2 bad usage,
  3 git or gh is missing or another $PROG is at work, 130 stopped by a signal.

SETTINGS
  git config --global gh-batch.root ~/workspace    the folder searched by default
  git config --global gh-batch.diverged rebase     see: $PROG help pull
  git config --global gh-batch.conflicts server    see: $PROG help pull
  git config --global gh-batch.commit true         see: $PROG help push
  The others are listed by "$PROG config". Inside a repository,
  "git config gh-batch.skip true" sets it aside and "git config
  gh-batch.pullOnly true" keeps it out of every commit and push.
EOF
}

help_pull() {
    cat <<EOF
$PROG pull [options] [folder or name ...]

Fetch every repository and bring its branch forward. For each repository:

  nothing new on the server   it is up to date
  new commits on the server   the branch is moved forward (a fast-forward);
                              pending changes that the new commits do not
                              touch stay as they are; a file deleted here
                              that the new commits change comes back in its
                              new version, and is named
  new commits on both sides   following gh-batch.diverged:
                                report  (default) nothing is tried
                                rebase  your commits are replayed on top
                                merge   the two histories are joined
                              a conflict is undone at once: the repository
                              is left exactly as it was and the files that
                              conflict are named, unless gh-batch.conflicts
                              is server (see below)

A file that git does not track here (untracked or ignored) and that stands
where the new commits put a file makes way for the version of the server:
it is moved, whole, into the git folder of the repository,
.git/gh-batch/kept/DATE-TIME/, the report names it and gives the command
that compares the two versions. An identical copy is simply dropped.

Uncommitted changes that the new commits touch travel over the update in a
stash of the tool's own when git tells beforehand that they still apply
(git 2.40 or newer): they are back in the files afterwards. When they touch
the same lines as the new commits, nothing changes and the repository is
reported as blocked, or, with gh-batch.conflicts server, the version of the
server is taken and the changes wait in the stash (git stash pop brings
them back), which the report says.

With gh-batch.conflicts server, a replay or a merge that conflicts is made
again with the version of the server in the lines that both sides changed,
and in a file changed on both sides that git cannot merge (a PDF rebuilt on
two machines). Before that, the commit of the branch is kept under
refs/gh-batch/before-pull/BRANCH/DATE-TIME and this machine's version of
each of those files is copied into .git/gh-batch/kept/DATE-TIME/; the
report names the files and prints the one command that restores the branch.
A conflict that even this cannot settle (a file deleted on one side and
changed on the other) is undone as above.

A replay is tried only when it is safe: no merge commit among your commits,
none of them already on a server, the history of the server not rewritten,
no signature to type. When the server rewrote its history and every commit
here that it lacks was once on it, nothing of this machine is at stake:
the branch takes the new history, its commit kept first.

The other local branches that only lack commits of the server are moved
forward too, without a file being touched. A detached HEAD, an operation
left in progress, a branch that left the server and a repository without
remote are reported and left alone. What was kept aside is listed at the
end of the report.

OPTIONS
      --diverged HOW   report, rebase or merge, for this run
      --conflicts WHO  report or server, for this run
  -n, --dry-run        fetch, then only say what would be done (as "fetch")
  and the common options, see: $PROG help
EOF
}

help_push() {
    cat <<EOF
$PROG push [options] [folder or name ...]

Push every repository whose branch has commits that its server lacks. The
push goes where "git push" would send the branch, is never forced, and uses
no network for a repository that has nothing to send.

With --commit, or the setting gh-batch.commit, every pending change (files
modified, deleted or new, the ignored ones excepted) is first committed,
under the message "Work in progress, DATE (MACHINE)" followed by the list
of the files. Four guards leave a repository uncommitted and report it:

  a new file whose name suggests a secret (.env, a key, a credentials file)
  a file above gh-batch.maxFileSize (50 MB)
  more new files at once than gh-batch.maxNewFiles (200): a missing .gitignore
  a folder that is a git repository of its own and is not ignored

When a commit is refused (by a hook, for instance) the staging area is put
back as it was.

Before anything is committed or pushed, the list of what will be done is
shown, the public repositories marked PUBLIC when gh is installed, and one
confirmation is asked. Without a terminal the run needs --yes.

When the server has commits that this machine lacks, they are taken as
"pull" would take them (see gh-batch.diverged and gh-batch.conflicts) and
the push is tried once more; a conflict there is undone and reported, or
settled with the version of the server first. With the default setting,
report, a repository whose last fetch already showed such commits is
neither committed nor pushed: pull first, or use "$PROG sync".

Pending changes of a repository without remote, of a detached HEAD, or of
a branch that exists on this machine only are reported, never committed.

OPTIONS
      --commit         commit pending changes first, for this run
      --no-commit      push only what is committed already, for this run
  -m, --message TEXT   the first line of the automatic commits; %d is the
                       date, %t the time, %h the machine, %n the number of
                       files
  -u, --set-upstream   publish a branch that exists on this machine only
  -y, --yes            do not ask for the confirmation
  -n, --dry-run        show the list and change nothing
      --notify         send the report through the command of gh-batch.notify
  and the common options, see: $PROG help

SETTINGS (git config, in a repository or with --global)
  gh-batch.commit true|false   a repository that sets it to false is never
                               committed automatically, whatever the rest
  gh-batch.pullOnly true       the repository is neither committed nor pushed
  gh-batch.confirm false       never ask (--global)
  gh-batch.message, gh-batch.machine, gh-batch.maxFileSize,
  gh-batch.maxNewFiles         see above (--global)

To commit with a message you type, and to be asked for it, see: $PROG help commit
EOF
}

help_commit() {
    cat <<EOF
$PROG commit [push] [options] [folder or name ...]

Commit the pending changes of every repository: files modified, deleted or
new, the ignored ones excepted. The list is shown first. The first line of
the commits is then asked for:

  Commit message [A Regular Commit to Synchronise], or - to do nothing:

Enter takes that sentence. Another line is used instead, and a minus sign
alone does nothing. The list of the files follows the first line in the
commit. With -m TEXT the text is the first line and the question is the
usual confirmation; %d is the date, %t the time, %h the machine and %n the
number of files. The setting gh-batch.message, when it was given, replaces
the sentence above. Without a terminal the run needs --yes. With
gh-batch.confirm false nothing is asked.

The same four guards as "$PROG push --commit" leave a repository
uncommitted and name it: a new file whose name suggests a secret, a file
above gh-batch.maxFileSize, more new files at once than
gh-batch.maxNewFiles, and a folder that is a git repository of its own.
When a commit is refused (by a hook, for instance) the staging area is put
back as it was. A repository that sets gh-batch.commit to false, or
gh-batch.pullOnly, is left alone. A detached HEAD is left alone. A
repository without a remote is committed, and the commit stays on this
machine.

With "push" after the command, the push runs once the commits are made,
with its own list and its own confirmation. Declining it leaves the
commits where they are.

OPTIONS
  -m, --message TEXT   the first line of the commits (see the placeholders
                       above); the question is then the usual confirmation
  -y, --yes            do not ask for the message, nor before the push
  -n, --dry-run        show the list and the message, and change nothing
      --notify         send the report through the command of gh-batch.notify
  and the common options, see: $PROG help

The word push asks for the push afterwards, and another command named on
the line runs in its turn: "$PROG pull commit push" pulls first. A folder
or a repository named push is given as a path, for example ./push, or
after --.
EOF
}

help_sync() {
    cat <<EOF
$PROG sync [options] [folder or name ...]

Pull, then push, in one run: what "$PROG pull" does for every repository,
then what "$PROG push" does, with its list and its confirmation. It is the
command for a change of machine in the middle of the day, and the line
"$PROG pull push" is the same.

OPTIONS
  those of pull and of push, see: $PROG help pull, $PROG help push
EOF
}

help_reset() {
    cat <<EOF
$PROG reset [options] [folder or name ...]

Set the branch of every repository to the branch it follows on its server,
as a fetch and a hard reset onto that branch would, but without losing
anything. After the fetch, for each repository:

  level with the server         nothing is done
  new commits on the server     the branch moves forward (a fast-forward)
  commits here that the         nothing is done and the commits are named,
  server lacks                  unless --discard-local is given: the branch
                                and its files are then set to those of the
                                server, after one confirmation

Before a branch moves, its commit is kept under a reference of its own,
refs/gh-batch/before-reset/BRANCH/DATE-TIME, and the report prints the one
command that puts the branch and its files back. A repository with
uncommitted changes to tracked files is left alone, and so are a detached
HEAD, an operation in progress, a branch that follows nothing and a
repository without remote. Untracked and ignored files are never deleted
or overwritten: one that stands where the server has a file is moved,
whole, into .git/gh-batch/kept/DATE-TIME/, and the report names it.
Nothing is pushed.

The command is made for a history rewritten on the server, a folder
removed from every commit and the result pushed by force: the clones on
the other machines still hold the old commits, which pull reports as
diverged, and "$PROG reset --discard-local" sets them to the new history.

OPTIONS
      --discard-local  let the reset drop the commits that the server lacks
  -y, --yes            do not ask before dropping commits
  -n, --dry-run        fetch, then only say what would be done
      --notify         send the report through the command of gh-batch.notify
  and the common options, see: $PROG help
EOF
}

help_tidy() {
    cat <<EOF
$PROG tidy [options] [folder or name ...]

Remove what this tool kept in the repositories during earlier runs and that
is older than a month: the backups of a branch made before it moved
(refs/gh-batch/...), and the folders of files that made way for the
version of the server (.git/gh-batch/kept/DATE-TIME/). The list is shown
first, and one confirmation is asked. A backup is removed only if it still
names the commit it was made for. Stashes are never touched.

OPTIONS
      --days N       remove what is older than N days (default 30)
  -y, --yes          do not ask for the confirmation
  -n, --dry-run      show the list and remove nothing
  and the common options, see: $PROG help
EOF
}

help_clone() {
    cat <<EOF
$PROG clone [options] [owner ...]
$PROG clone --manifest FILE [options]

Clone the repositories that are missing under the destination folder.

In the first form the list comes from GitHub, through gh: every repository
of the account that gh is logged in to and of the organisations it belongs
to, or of the owners named (accounts or organisations). A repository counts
as present when one of the clones under the destination has it as a remote,
whatever the name and the depth of its folder, also when it was renamed or
transferred since. The missing ones are cloned into DEST/name for the
account itself and DEST/folder/name for any other owner.

The folder of an owner is the one that gh-batch.OWNER.folder names, else
the one where its clones already are, else its name on GitHub. The first
time an organisation of the account has something to clone, its folder is
asked for, before the list: Enter takes the folder proposed, a minus sign
leaves the organisation out, and the answer is kept in the settings of git.
With --yes, with --dry-run or without a terminal nothing is asked and the
folder proposed is taken.

In the second form the list is a layout file, as "$PROG list --manifest"
writes it: each repository returns to the folder it had, on its branch. No
gh is needed, and the servers may be any.

When other commands follow on the line, as in "$PROG clone pull status",
clone reads the account and its organisations, and the folders or names of
the line belong to the commands that follow it.

The list is shown with the sizes, one confirmation is asked, then four
repositories are cloned at a time. Each clone is made under a temporary
name and renamed when complete: an interrupted run leaves nothing half-made.
A folder that exists and is not the repository is never touched.

OPTIONS
      --into DIR       the destination (default: the folder of gh-batch.root)
      --manifest FILE  clone the entries of a layout file
  -u, --update         also pull the repositories that are present already
      --only GLOB      clone only the names that match, repeatable
      --except GLOB    leave out the names that match, repeatable
      --since DATE     only the repositories pushed since DATE (2026-01-31)
      --no-forks       leave the forks out
      --no-archived    leave the archived repositories out
      --no-orgs        the account only, without its organisations
      --orgs           the organisations too, even when gh-batch.orgs is false
      --flat           DEST/name for every owner
      --by-owner       DEST/folder/name for every owner, the account too,
                       the folder being the name of the owner unless
                       gh-batch.OWNER.folder names another
  -y, --yes            do not ask for the confirmation
  -n, --dry-run        show the list and clone nothing
  and the common options, see: $PROG help

SETTINGS (git config --global)
  gh-batch.orgs false          never read the organisations of the account
  gh-batch.OWNER.folder NAME   the folder of an owner under the destination;
                               a dot is the destination itself
  gh-batch.OWNER.skip true     leave this organisation out, unless it is
                               named on the command line
EOF
}

help_status() {
    cat <<EOF
$PROG status [options] [folder or name ...]

One line per repository that has something pending: files changed or new
and since when, commits to push and since when, commits behind the last
fetch, stashes, an operation left in progress. Nothing is fetched: the
comparison with the server is the one of the last fetch or pull, and the
forks are shown as "fetch" or "doctor" last saw them, with the date.

OPTIONS
  -l, --long      list the pending files of each repository
  -v, --verbose   show the clean repositories too
  and the common options, see: $PROG help
EOF
}

help_fetch() {
    cat <<EOF
$PROG fetch [options] [folder or name ...]

Fetch every repository and say what "pull" would do, without touching a
branch or a file: how many commits wait on the server, which files would be
set aside, which repositories have diverged, which branch left the server.

When gh is installed, the forks are compared with the repository they were
forked from, one question to GitHub per owner and two per fork: a section
"Forks" names the commits of the original that a fork lacks, and those of
the fork that the original lacks, with the command that offers them to it
(gh pr create). Nothing is opened, synced or pushed.

OPTIONS
      --offline   do not ask GitHub about the forks
  and the common options, see: $PROG help
EOF
}

help_log() {
    cat <<EOF
$PROG log [options] [folder or name ...]

The commits of a period across all the repositories, each repository with
its commits in the order they were made. Without an option: your commits of
today, on every local branch. "Yours" means the e-mail address that git
uses in each repository (user.email).

OPTIONS
      --since WHEN     the start of the period, as git reads it: yesterday,
                       monday, "2 weeks ago", 2026-11-01 (default: midnight)
      --until WHEN     the end of the period
      --author TEXT    the commits of another author (a part of the name or
