cmd_completion() {
    case "${SHELL_NAME:-}" in
        bash)
            cat <<'EOF'
# bash completion for gh-batch
_gh_batch_names() {
    # The names of the repositories under gh-batch.root, one per line, and
    # the last part of each longer one; none when no root is set, since the
    # current folder may be anything.
    local name
    if [ -n "${GH_BATCH_ROOT:-}" ] || git config --global --includes --get gh-batch.root >/dev/null 2>&1; then
        gh-batch list 2>/dev/null | while IFS= read -r name; do
            printf '%s\n' "$name"
            case "$name" in */*) printf '%s\n' "${name##*/}" ;; esac
        done
    fi
}
_gh_batch() {
    local cur prev commands verbs options words word list
    cur=${COMP_WORDS[COMP_CWORD]}
    prev=${COMP_WORDS[COMP_CWORD-1]}
    commands="pull push commit sync reset tidy clone status fetch log exec doctor list config completion help"
    verbs="pull push commit sync reset tidy clone status fetch log doctor"
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W "$commands --help --version" -- "$cur"))
        return 0
    fi
    case "$prev" in
        --diverged) COMPREPLY=($(compgen -W "report rebase merge" -- "$cur")); return 0 ;;
        --conflicts) COMPREPLY=($(compgen -W "report server" -- "$cur")); return 0 ;;
        --color|--colour) COMPREPLY=($(compgen -W "auto always never" -- "$cur")); return 0 ;;
        --into) COMPREPLY=($(compgen -d -- "$cur")); return 0 ;;
        --manifest) COMPREPLY=($(compgen -f -- "$cur")); return 0 ;;
        --in)
            list=$(_gh_batch_names)
            local IFS=$'\n'
            COMPREPLY=($(compgen -W "$list" -- "$cur"; compgen -d -- "$cur"))
            return 0 ;;
        help) COMPREPLY=($(compgen -W "$commands" -- "$cur")); return 0 ;;
        completion) COMPREPLY=($(compgen -W "bash zsh" -- "$cur")); return 0 ;;
    esac
    options="--jobs --depth --only --except --dry-run --yes --verbose --quiet --porcelain --timeout --color --help"
    # The options of every command on the line, when commands share it.
    words=${COMP_WORDS[1]}
    case " $verbs " in
        *" ${COMP_WORDS[1]} "*) words="${COMP_WORDS[*]:1:COMP_CWORD-1}" ;;
    esac
    for word in $words; do
        case "$word" in
            pull)       options="$options --diverged --conflicts --notify" ;;
            fetch)      options="$options --diverged --conflicts --offline --notify" ;;
            push|sync)  options="$options --commit --no-commit --message --set-upstream --diverged --conflicts --notify" ;;
            commit)     options="$options --message --notify" ;;
            reset)      options="$options --discard-local --notify" ;;
            tidy)       options="$options --days" ;;
            clone)      options="$options --into --manifest --update --since --no-forks --no-archived --orgs --no-orgs --flat --by-owner" ;;
            status)     options="$options --long" ;;
            log)        options="$options --since --until --author --all-authors --long" ;;
            exec)       options="$options --in --dirty --clean --ahead --behind" ;;
            doctor)     options="$options --offline --days" ;;
            list)       options="$options --absolute --manifest" ;;
        esac
    done
    case "$cur" in
        -*) COMPREPLY=($(compgen -W "$options" -- "$cur")) ;;
        *)
            # The other commands of a line, the names of the repositories
            # and the folders here.
            list=""
            case " $verbs " in
                *" ${COMP_WORDS[1]} "*) list=$(printf '%s\n' $verbs; _gh_batch_names) ;;
            esac
            [ "${COMP_WORDS[1]}" = "list" ] && list=$(_gh_batch_names)
            local IFS=$'\n'
            COMPREPLY=($(compgen -W "$list" -- "$cur"; compgen -d -- "$cur"))
            ;;
    esac
    return 0
}
complete -o filenames -F _gh_batch gh-batch
EOF
            ;;
        zsh)
