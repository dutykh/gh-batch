#!/usr/bin/env bash
#
# gh-batch: fetch, pull, push and clone many git repositories with one command.
#
# Author: Dr. Denys Dutykh (Mathematics Department, Khalifa University of
#         Science and Technology, Abu Dhabi, UAE).
#
# Homepage:  https://github.com/dutykh/gh-batch
# License:   LGPL-2.1-or-later, see the LICENSE file of the distribution.
#
# Dependencies: bash (3.2+) and git (2.30+). Optional: gh, the GitHub CLI, for
# cloning an account, for the public marks and for the remote checks of
# "doctor".
#
# The file is also a GitHub CLI extension: "gh extension install
# dutykh/gh-batch" gives the same commands as "gh batch ...".
#
# Layout of the file: diagnostics, settings, discovery of the repositories,
# the engine that runs them in parallel, what git says about one repository,
# the update of one repository, the commands, the help texts, main.

# Most functions are reached through a name handed to the engine (the worker
# of a command, the function that prints a result), which the linter cannot
# follow.
# shellcheck disable=SC2329

set -uo pipefail

: "${HOME:=/}"

GH_BATCH_VERSION="1.1.0"
PROG="gh-batch"

TAB=$(printf '\t')
US=$(printf '\037')       # unit separator, the field delimiter of internal records
