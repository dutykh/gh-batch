readonly EX_OK=0          # nothing needs the user
readonly EX_ATTENTION=1   # at least one repository needs the user
readonly EX_USAGE=2       # bad invocation
readonly EX_ENV=3         # git or gh missing, another run at work
readonly EX_INTERRUPT=130 # stopped by a signal

