cmd_list() {
    local i=0 url branch
    setup_colour
    harden_git
    discover
    if [ "$MANIFEST_OUT" -eq 1 ]; then
        printf '# Layout of %s, written by %s list --manifest.\n' "$ROOT_LABEL" "$PROG"
        printf '# One repository per line: folder, address, branch, separated by tabs.\n'
        printf '# "%s clone --manifest FILE" clones the missing ones into the same folders.\n' "$PROG"
    fi
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        REPO=${REPOS[$i]}
        if [ "$MANIFEST_OUT" -eq 1 ]; then
            GIT=(git -C "$REPO")
            url=$(g remote get-url origin 2>/dev/null) || url=$(first_remote_url)
            branch=$(g symbolic-ref -q --short HEAD 2>/dev/null)
            if [ -n "$url" ]; then
                printf '%s\t%s\t%s\n' "${NAMES[$i]}" "$(printf '%s' "$url" | redact)" "$branch"
            else
                warn "${NAMES[$i]} has no remote and is left out of the layout"
            fi
        elif [ "$ABSOLUTE" -eq 1 ]; then
            printf '%s\n' "$REPO"
        else
            printf '%s\n' "${NAMES[$i]}"
        fi
        i=$(( i + 1 ))
    done
    exit "$EX_OK"
}

first_remote_url() {
    local name=""
    IFS= read -r name < <(g remote 2>/dev/null)
    [ -n "$name" ] && g remote get-url "$name" 2>/dev/null
    return 0
}

setting_row() {
    # setting_row NAME VALUE SOURCE: one line of "config"
    if [ "$STYLED" -eq 1 ]; then
        printf '  %s%-12s%s %-30s %s%s%s\n' "$C_CYAN" "$1" "$C_OFF" "$2" "$C_DIM" "$3" "$C_OFF"
    else
        printf '  %-12s %-30s %s\n' "$1" "$2" "$3"
    fi
}

cmd_config() {
    local root
    setup_colour
    printf '%s%s %s%s, settings in force\n\n' "$C_TITLE" "$PROG" "$GH_BATCH_VERSION" "$C_OFF"
    if [ -n "${GH_BATCH_ROOT:-}" ]; then
        setting_row "root" "$GH_BATCH_ROOT" "environment (GH_BATCH_ROOT)"
    elif [ "${#CFG_ROOTS[@]}" -gt 0 ]; then
        for root in "${CFG_ROOTS[@]}"; do
            setting_row "root" "$(short_path "$root")" "git config"
        done
    else
        setting_row "root" "(the current folder)" "default"
    fi
    setting_row "depth" "$DEPTH" "$SRC_depth"
    setting_row "jobs" "$JOBS" "$SRC_jobs"
    setting_row "timeout" "$TIMEOUT s" "$SRC_timeout"
    setting_row "diverged" "$DIVERGED" "$SRC_diverged"
    setting_row "commit" "$( [ "$COMMIT" -eq 1 ] && printf 'true' || printf 'false' )" "$SRC_commit"
    setting_row "confirm" "$( [ "$CONFIRM" -eq 1 ] && printf 'true' || printf 'false' )" "$SRC_confirm"
    setting_row "message" "$MESSAGE" "$SRC_message"
    setting_row "machine" "$MACHINE_NAME" "$SRC_machine"
    setting_row "maxFileSize" "$MAX_FILE_MB MB" "$SRC_maxfile"
    setting_row "maxNewFiles" "$MAX_NEW_FILES" "$SRC_maxnew"
    setting_row "notify" "${NOTIFY_CMD:-(none)}" "$SRC_notify"
    setting_row "notifyOn" "$NOTIFY_ON" "$SRC_notifyon"
    for root in ${CFG_EXCLUDE[@]+"${CFG_EXCLUDE[@]}"}; do
        setting_row "exclude" "$root" "git config"
    done
    printf '\n%sA setting is changed with: git config --global gh-batch.NAME VALUE%s\n' "$C_DIM" "$C_OFF"
    printf '%sThe record of what the tool moved is kept in %s%s\n' "$C_DIM" "$(short_path "$STATE_DIR")" "$C_OFF"
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
$PROG $GH_BATCH_VERSION, one command for many git repositories.

USAGE
  $PROG <command> [options] [folder ...]

  A folder is searched for git repositories, three levels deep by default; a
  folder that is itself a repository is taken alone. Without a folder, the
  ones of "git config --global gh-batch.root" are used, else the current one.

COMMANDS
  pull        fetch every repository and bring it forward (the morning command)
  push        push every repository that has new commits, after committing
              what is pending when asked to (the evening command)
  sync        pull, then push
  clone       clone what is missing: a whole GitHub account, or the entries
              of a layout file written by "list --manifest"
  status      what is pending in every repository, without touching the network
  fetch       look at the servers, change no file, say what pull would do
  log         the commits of today, or of a period, across the repositories
  exec        run a command in every repository
  doctor      health check of the repositories, their remotes and the folder
  list        the repositories found; --manifest writes their layout
  config      the settings in force and where each comes from
  completion  the completion script for bash or zsh
  help        help for one command, for example: $PROG help pull

COMMON OPTIONS
  -j, --jobs N       repositories handled at the same time (default 8; 1 means
                     strictly one after the other); the report always follows
                     the order of the folders
      --depth N      levels searched below each folder (default 3)
      --only GLOB    keep only the repositories whose name matches, repeatable
      --except GLOB  leave out the repositories whose name matches, repeatable
  -n, --dry-run      show what would be done and change nothing
  -y, --yes          do not ask before committing or pushing
  -v, --verbose      show every repository, not only those that changed
  -q, --quiet        show only what needs you
      --porcelain    one line per repository, fields separated by tabs:
                     state, path, branch, message
      --timeout SEC  give up on a server that does not answer (default 300)
      --color WHEN   auto, always or never
  -h, --help         this text, or the help of the command given
      --version      the version

EXIT STATUS
  0 nothing needs you, 1 at least one repository needs you, 2 bad usage,
  3 git or gh is missing or another $PROG is at work, 130 stopped by a signal.

SETTINGS
  git config --global gh-batch.root ~/workspace    the folder searched by default
  git config --global gh-batch.diverged rebase     see: $PROG help pull
  git config --global gh-batch.commit true         see: $PROG help push
  The others are listed by "$PROG config". Inside a repository,
  "git config gh-batch.skip true" sets it aside and "git config
  gh-batch.pullOnly true" keeps it out of every commit and push.
EOF
}

help_pull() {
    cat <<EOF
$PROG pull [options] [folder ...]

Fetch every repository and bring its branch forward. For each repository:

  nothing new on the server   it is up to date
  new commits on the server   the branch is moved forward (a fast-forward);
                              pending changes that the new commits do not
                              touch stay as they are; if they would be
                              touched, git refuses, nothing changes, and the
                              repository is reported as blocked; a file
                              deleted here that the new commits change comes
                              back in its new version, and is named
  new commits on both sides   following gh-batch.diverged:
                                report  (default) nothing is tried
                                rebase  your commits are replayed on top
                                merge   the two histories are joined
                              a conflict is undone at once: the repository
                              is left exactly as it was and the files that
                              conflict are named

A replay is tried only when it is safe: no uncommitted change to a tracked
file, no merge commit among your commits, none of them already on a server,
the history of the server not rewritten, no signature to type.

A detached HEAD, an operation left in progress, a branch that left the
server and a repository without remote are reported and left alone.

OPTIONS
      --diverged HOW   report, rebase or merge, for this run
  -n, --dry-run        fetch, then only say what would be done (as "fetch")
  and the common options, see: $PROG help
EOF
}

help_push() {
    cat <<EOF
$PROG push [options] [folder ...]

Push every repository whose branch has commits that its server lacks. The
push goes where "git push" would send the branch, is never forced, and uses
no network for a repository that has nothing to send.

With --commit, or the setting gh-batch.commit, every pending change (files
modified, deleted or new, the ignored ones excepted) is first committed,
under the message "Work in progress, DATE (MACHINE)" followed by the list
of the files. Four guards leave a repository uncommitted and report it:

  a new file whose name suggests a secret (.env, a key, a credentials file)
  a file above gh-batch.maxFileSize (50 MB)
  more new files at once than gh-batch.maxNewFiles (200): a missing .gitignore
  a folder that is a git repository of its own and is not ignored

When a commit is refused (by a hook, for instance) the staging area is put
back as it was.

Before anything is committed or pushed, the list of what will be done is
shown, the public repositories marked PUBLIC when gh is installed, and one
confirmation is asked. Without a terminal the run needs --yes.

When the server has commits that this machine lacks, they are taken as
"pull" would take them (see gh-batch.diverged) and the push is tried once
more; a conflict there is undone and reported. With the default setting,
report, a repository whose last fetch already showed such commits is
neither committed nor pushed: pull first, or use "$PROG sync".

Pending changes of a repository without remote, of a detached HEAD, or of
a branch that exists on this machine only are reported, never committed.

OPTIONS
      --commit         commit pending changes first, for this run
      --no-commit      push only what is committed already, for this run
  -m, --message TEXT   the first line of the automatic commits; %d is the
                       date, %t the time, %h the machine, %n the number of
                       files
  -u, --set-upstream   publish a branch that exists on this machine only
  -y, --yes            do not ask for the confirmation
  -n, --dry-run        show the list and change nothing
      --notify         send the report through the command of gh-batch.notify
  and the common options, see: $PROG help

SETTINGS (git config, in a repository or with --global)
  gh-batch.commit true|false   a repository that sets it to false is never
                               committed automatically, whatever the rest
  gh-batch.pullOnly true       the repository is neither committed nor pushed
  gh-batch.confirm false       never ask (--global)
  gh-batch.message, gh-batch.machine, gh-batch.maxFileSize,
  gh-batch.maxNewFiles         see above (--global)
EOF
}

help_sync() {
    cat <<EOF
$PROG sync [options] [folder ...]

Pull, then push, in one run: what "$PROG pull" does for every repository,
then what "$PROG push" does, with its list and its confirmation. It is the
command for a change of machine in the middle of the day.

OPTIONS
  those of pull and of push, see: $PROG help pull, $PROG help push
EOF
}

help_clone() {
    cat <<EOF
$PROG clone [options] [owner ...]
$PROG clone --manifest FILE [options]

Clone the repositories that are missing under the destination folder.

In the first form the list comes from GitHub, through gh: every repository
of the account that gh is logged in to, or of the owners named (accounts or
organisations). A repository counts as present when one of the clones under
the destination has it as a remote, whatever the name and the depth of its
folder, also when it was renamed or transferred since. The missing ones are
cloned into DEST/name for the account itself and DEST/owner/name for any
other owner.

In the second form the list is a layout file, as "$PROG list --manifest"
writes it: each repository returns to the folder it had, on its branch. No
gh is needed, and the servers may be any.

The list is shown with the sizes, one confirmation is asked, then four
repositories are cloned at a time. Each clone is made under a temporary
name and renamed when complete: an interrupted run leaves nothing half-made.
A folder that exists and is not the repository is never touched.

OPTIONS
      --into DIR       the destination (default: the folder of gh-batch.root)
      --manifest FILE  clone the entries of a layout file
  -u, --update         also pull the repositories that are present already
      --only GLOB      clone only the names that match, repeatable
      --except GLOB    leave out the names that match, repeatable
      --since DATE     only the repositories pushed since DATE (2026-01-31)
      --no-forks       leave the forks out
      --no-archived    leave the archived repositories out
      --flat           DEST/name for every owner
      --by-owner       DEST/owner/name for every owner
  -y, --yes            do not ask for the confirmation
  -n, --dry-run        show the list and clone nothing
  and the common options, see: $PROG help
EOF
}

