# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

redact() {
    # Hide a password or a token written inside an address, so that no
    # message ever shows a credential.
    sed -e 's#\(https\{0,1\}://\)[^/@[:space:]]*@#\1<hidden>@#g' \
        -e 's#\(://[^/@:[:space:]]*\):[^/@[:space:]]*@#\1:<hidden>@#g'
}

warn() { printf '%s: warning: %s\n' "$PROG" "$*" | redact >&2; }

die() {
    local code="$1"; shift
    printf '%s: error: %s\n' "$PROG" "$*" | redact >&2
    exit "$code"
}

have() {
    # GH_BATCH_HIDE lists programs to treat as absent, so that the paths taken
    # without gh, git-lfs or perl can be exercised on any machine.
    case " ${GH_BATCH_HIDE:-} " in *" $1 "*) return 1 ;; esac
    command -v "$1" >/dev/null 2>&1
}

is_uint() { case "$1" in ""|*[!0-9]*) return 1 ;; esac; return 0; }

truthy() {
    # The spellings git accepts for "true"; a key without a value is true.
    case "$1" in
        [Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]|1|"") return 0 ;;
    esac
    return 1
}

plural() {
    # plural N WORD -> "1 commit", "3 commits", "2 repositories"
    local n="$1" word="$2"
    if [ "$n" = 1 ]; then
        printf '1 %s' "$word"
    else
        case "$word" in
            *y)  printf '%s %sies' "$n" "${word%y}" ;;
            *ch) printf '%s %ses' "$n" "$word" ;;
            *)   printf '%s %ss' "$n" "$word" ;;
        esac
    fi
}

enumerate() {
    # enumerate WORD ... -> "a", "a and b", "a, b and c"
    local text="" i=1 word
    for word in "$@"; do
        if [ "$i" -eq 1 ]; then
            text=$word
        elif [ "$i" -eq "$#" ]; then
            text="$text and $word"
        else
            text="$text, $word"
        fi
        i=$(( i + 1 ))
    done
    printf '%s' "$text"
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# In the two functions below the tilde is a character of the text, written
# by the user or shown to him, and not a path for the shell to expand.
# shellcheck disable=SC2088
expand_tilde() {
    case "$1" in
        "~")    printf '%s' "$HOME" ;;
        "~/"*)  printf '%s/%s' "$HOME" "${1#\~/}" ;;
        *)      printf '%s' "$1" ;;
    esac
}

# shellcheck disable=SC2088
short_path() {
    case "$1" in
        "$HOME")    printf '~' ;;
        "$HOME"/*)  printf '~/%s' "${1#"$HOME"/}" ;;
        *)          printf '%s' "$1" ;;
    esac
}

one_line() {
    # The text on one line, without the control characters that would break
    # a record or a terminal.
    printf '%s' "$1" | tr '\n\r\t\037' '    '
}

last_line() {
    # last_line FILE -> the end of what a command wrote on its error output:
    # its last three lines, the hints of git left out, on one line and
    # without credentials. A hook says why it refuses just before git says
    # that it failed, so one line would lose the reason.
    local line a="" b="" c="" text
    [ -f "$1" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            hint:*) continue ;;
        esac
        [ -n "${line// /}" ] || continue
        a=$b; b=$c; c=$line
    done < "$1"
    text=$c
    [ -n "$b" ] && text="$b; $c"
    [ -n "$a" ] && text="$a; $b; $c"
    one_line "$text" | redact | cut -c 1-300
}

clip() {
    # clip TEXT WIDTH -> TEXT, cut with three dots when it is longer
    if [ "${#1}" -gt "$2" ]; then
        printf '%s...' "${1:0:$(( $2 - 3 ))}"
    else
        printf '%s' "$1"
    fi
}

age_text() {
    # age_text SECONDS -> "5 min", "3 h", "12 d"
    local s="$1"
    if [ "$s" -lt 3600 ]; then
        printf '%s min' $(( s / 60 ))
    elif [ "$s" -lt 172800 ]; then
        printf '%s h' $(( s / 3600 ))
    else
        printf '%s d' $(( s / 86400 ))
    fi
}

# ---------------------------------------------------------------------------
# Settings: command line, then environment, then "git config --global
# gh-batch.*", then the defaults
# ---------------------------------------------------------------------------

owner_line() {
    # owner_line OWNER -> OWNER_I, the place of an owner (in lower case) in
    # the table of the settings that owners have; a new line when it has none.
    OWNER_I=0
    while [ "$OWNER_I" -lt "${#CFG_OWNERS[@]}" ]; do
        [ "${CFG_OWNERS[$OWNER_I]}" = "$1" ] && return 0
        OWNER_I=$(( OWNER_I + 1 ))
    done
    CFG_OWNERS+=("$1")
    CFG_OWNER_FOLDER+=("")
    CFG_OWNER_SKIP+=("")
    return 0
}

owner_setting() {
    # owner_setting OWNER -> S_folder and S_skip, what the settings say of an
    # owner: gh-batch.OWNER.folder and gh-batch.OWNER.skip. GitHub does not
    # tell the cases of a name apart, and neither does this.
    local low i=0
    S_folder=""; S_skip=0
    [ "${#CFG_OWNERS[@]}" -gt 0 ] || return 0
    low=$(lower "$1")
    while [ "$i" -lt "${#CFG_OWNERS[@]}" ]; do
        if [ "${CFG_OWNERS[$i]}" = "$low" ]; then
            S_folder=${CFG_OWNER_FOLDER[$i]}
            [ "${CFG_OWNER_SKIP[$i]}" = "1" ] && S_skip=1
            return 0
        fi
        i=$(( i + 1 ))
    done
    return 0
}

load_settings() {
    local line key val owner
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        key=${line%% *}
        val=""
        case "$line" in *" "*) val=${line#* } ;; esac
        case "$key" in
            gh-batch.?*.folder)
                # The owner is the middle of the key, which git prints as it
                # was typed; a later value replaces an earlier one.
                owner=${key#gh-batch.}
                owner_line "$(lower "${owner%.folder}")"
                CFG_OWNER_FOLDER[OWNER_I]=$val
                ;;
            gh-batch.?*.skip)
                owner=${key#gh-batch.}
                owner_line "$(lower "${owner%.skip}")"
                if truthy "$val"; then CFG_OWNER_SKIP[OWNER_I]=1; else CFG_OWNER_SKIP[OWNER_I]=0; fi
                ;;
            gh-batch.orgs)      CFG_orgs=${val:-true} ;;
            gh-batch.root)      CFG_ROOTS+=("$(expand_tilde "$val")") ;;
            gh-batch.exclude)   CFG_EXCLUDE+=("$val") ;;
            gh-batch.depth)     CFG_depth=$val ;;
            gh-batch.jobs)      CFG_jobs=$val ;;
            gh-batch.timeout)   CFG_timeout=$val ;;
            gh-batch.diverged)  CFG_diverged=$val ;;
            gh-batch.conflicts) CFG_conflicts=$val ;;
            gh-batch.commit)    CFG_commit=${val:-true} ;;
            gh-batch.confirm)   CFG_confirm=${val:-true} ;;
            gh-batch.message)   CFG_message=$val ;;
            gh-batch.machine)   CFG_machine=$val ;;
            gh-batch.maxfilesize) CFG_maxfilesize=$val ;;
            gh-batch.maxnewfiles) CFG_maxnewfiles=$val ;;
            gh-batch.notify)    CFG_notify=$val ;;
            gh-batch.notifyon)  CFG_notifyon=$val ;;
        esac
    done <<EOF
$(git config --global --includes --get-regexp '^gh-batch\.' 2>/dev/null)
EOF
}

pick() {
    # pick ENVIRONMENT_NAME CONFIG_VALUE DEFAULT OPTION_VALUE -> VAL and SRC
    local env_name="$1" cfg="$2" def="$3" opt="$4"
    if [ -n "$opt" ]; then
        VAL=$opt; SRC="command line"
    elif [ -n "${!env_name:-}" ]; then
        VAL=${!env_name}; SRC="environment ($env_name)"
    elif [ -n "$cfg" ]; then
        VAL=$cfg; SRC="git config"
    else
        VAL=$def; SRC="default"
    fi
}

resolve_settings() {
    pick GH_BATCH_JOBS "$CFG_jobs" 8 "$OPT_JOBS";               JOBS=$VAL; SRC_jobs=$SRC
    pick GH_BATCH_DEPTH "$CFG_depth" 3 "$OPT_DEPTH";            DEPTH=$VAL; SRC_depth=$SRC
    pick GH_BATCH_TIMEOUT "$CFG_timeout" 300 "$OPT_TIMEOUT";    TIMEOUT=$VAL; SRC_timeout=$SRC
    pick GH_BATCH_DIVERGED "$CFG_diverged" report "$OPT_DIVERGED"; DIVERGED=$VAL; SRC_diverged=$SRC
    pick GH_BATCH_CONFLICTS "$CFG_conflicts" report "$OPT_CONFLICTS"; CONFLICTS=$VAL; SRC_conflicts=$SRC

    { is_uint "$JOBS" && [ "$JOBS" -ge 1 ]; } ||
        die "$EX_USAGE" "the number of jobs must be a positive integer, not '$JOBS'"
    { is_uint "$DEPTH" && [ "$DEPTH" -ge 1 ]; } ||
        die "$EX_USAGE" "the depth must be a positive integer, not '$DEPTH'"
    is_uint "$TIMEOUT" ||
        die "$EX_USAGE" "the timeout is a number of seconds (0 for none), not '$TIMEOUT'"
    case "$DIVERGED" in
        report|rebase|merge) ;;
        *) die "$EX_USAGE" "the choices for diverged histories are report, rebase and merge, not '$DIVERGED'" ;;
    esac
    case "$CONFLICTS" in
        report|server) ;;
        *) die "$EX_USAGE" "the choices for the lines that both sides changed are report and server, not '$CONFLICTS'" ;;
    esac

    pick GH_BATCH_COMMIT "$CFG_commit" false "$OPT_COMMIT"
    SRC_commit=$SRC
    if truthy "$VAL"; then COMMIT=1; else COMMIT=0; fi
    case "$SRC" in
        "command line"|environment*) COMMIT_FORCED=1 ;;
    esac
    pick GH_BATCH_CONFIRM "$CFG_confirm" true ""
    SRC_confirm=$SRC
    if truthy "$VAL"; then CONFIRM=1; else CONFIRM=0; fi
    pick GH_BATCH_ORGS "$CFG_orgs" true "$OPT_ORGS"
    SRC_orgs=$SRC
    if truthy "$VAL"; then ORGS=1; else ORGS=0; fi
    pick GH_BATCH_MESSAGE "$CFG_message" "Work in progress, %d (%h)" "$OPT_MESSAGE"
    MESSAGE=$VAL; SRC_message=$SRC
    pick GH_BATCH_MACHINE "$CFG_machine" "" ""
    MACHINE_NAME=$VAL; SRC_machine=$SRC
    if [ -z "$MACHINE_NAME" ]; then
        MACHINE_NAME=$(hostname -s 2>/dev/null || hostname 2>/dev/null || uname -n 2>/dev/null)
        SRC_machine="the name of the host"
    fi
    pick GH_BATCH_MAX_FILE_SIZE "$CFG_maxfilesize" 50 ""
    MAX_FILE_MB=$VAL; SRC_maxfile=$SRC
    pick GH_BATCH_MAX_NEW_FILES "$CFG_maxnewfiles" 200 ""
    MAX_NEW_FILES=$VAL; SRC_maxnew=$SRC
    is_uint "$MAX_FILE_MB" ||
        die "$EX_USAGE" "gh-batch.maxFileSize is a number of megabytes (0 for no limit), not '$MAX_FILE_MB'"
    is_uint "$MAX_NEW_FILES" ||
        die "$EX_USAGE" "gh-batch.maxNewFiles is a number of files (0 for no limit), not '$MAX_NEW_FILES'"
    pick GH_BATCH_NOTIFY "$CFG_notify" "" ""
    NOTIFY_CMD=$VAL; SRC_notify=$SRC
    pick GH_BATCH_NOTIFY_ON "$CFG_notifyon" never ""
    NOTIFY_ON=$VAL; SRC_notifyon=$SRC
    case "$NOTIFY_ON" in
        never|attention|always) ;;
        *) die "$EX_USAGE" "the choices for gh-batch.notifyOn are never, attention and always, not '$NOTIFY_ON'" ;;
    esac
    STATE_DIR=${GH_BATCH_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gh-batch}
}

check_git() {
    local v rest major minor
    have git || die "$EX_ENV" "git is not installed"
    v=$(git version 2>/dev/null)
    v=${v#git version }
    major=${v%%.*}
    rest=${v#*.}
    minor=${rest%%.*}
    if ! is_uint "$major" || ! is_uint "$minor"; then
        die "$EX_ENV" "the version of git could not be read: $v"
    fi
    if [ "$major" -lt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -lt 30 ]; }; then
        die "$EX_ENV" "git 2.30 or newer is needed, and this one is $v"
    fi
    if [ "$major" -gt 2 ] || [ "$minor" -ge 41 ]; then
        FETCH_PORCELAIN=1
    fi
    # The merges computed without a working tree, which tell beforehand
    # whether two sets of changes touch the same lines. GH_BATCH_HIDE may
    # name merge-tree, so that the paths taken without it can be tried.
    if [ "$major" -gt 2 ] || [ "$minor" -ge 38 ]; then
        MT_WRITE=1
    fi
    if [ "$major" -gt 2 ] || [ "$minor" -ge 40 ]; then
        MT_BASE=1
    fi
    case " ${GH_BATCH_HIDE:-} " in
        *" merge-tree "*) MT_WRITE=0; MT_BASE=0 ;;
    esac
}

# ---------------------------------------------------------------------------
# Working directory, lock and signals
# ---------------------------------------------------------------------------

claim() {
    # claim FILE [TEXT] -> 0 for the one process that creates FILE. The
    # shell's own exclusive creation is used: the mkdir of some systems (the
    # Rust coreutils among them) lets two callers succeed at the same time.
    local rc
    set -o noclobber
    { printf '%s' "${2:-}" > "$1"; } 2>/dev/null
    rc=$?
    set +o noclobber
    return "$rc"
}

cleanup() {
    local code=$?
    progress_clear
    if [ "$LOCKED" -eq 1 ] && [ -n "$STATE_DIR" ]; then
        rm -f "$STATE_DIR/lock"
    fi
    case "$TMP" in
        */gh-batch.*) rm -rf "$TMP" ;;
    esac
    exit "$code"
}

on_signal() {
    # A question is put before anything is changed: an interrupt that comes
    # while it waits ends the run there, without waiting for the answer.
    if [ "$ASKING" -eq 1 ]; then
        ASKING=0
        printf '\n' >&2
        put "Nothing was done."
        exit "$EX_INTERRUPT"
    fi
    [ "$STOP" -eq 1 ] && HARD=1
    STOP=1
    [ -n "$TMP" ] && [ -d "$TMP" ] && : > "$TMP/stop"
    return 0
}

setup_run() {
    TMP=$(mktemp -d "${TMPDIR:-/tmp}/gh-batch.XXXXXX") ||
        die "$EX_ENV" "cannot create a temporary directory"
    trap cleanup EXIT
    trap 'on_signal' INT TERM HUP PIPE
    NOW=$(date +%s)
    RUN_START=$SECONDS
    RUN_STAMP=$(date '+%Y%m%d-%H%M%S')
    TODAY=$(date '+%Y-%m-%d')
    CLOCK=$(date '+%H:%M')
    if stat -c %Y / >/dev/null 2>&1; then
        STAT_STYLE="gnu"
    elif stat -f %m / >/dev/null 2>&1; then
        STAT_STYLE="bsd"
    fi
    detect_isolation
}

detect_isolation() {
    # A long child must sit in its own process group: Ctrl-C then reaches
    # this program, which decides, and never a commit or a merge half-way.
    # Job control gives that; perl is the fallback where it does not.
    local answer
    if [ -n "${GH_BATCH_ISOLATE:-}" ]; then
        ISOLATE=$GH_BATCH_ISOLATE
        return 0
    fi
    answer=$(
        set -m
        sleep 5 >/dev/null 2>&1 &
        child=$!
        set +m
        group=$(ps -o pgid= -p "$child" 2>/dev/null | tr -d ' ')
        kill "$child" 2>/dev/null
        [ "$group" = "$child" ] && printf 'yes'
    ) 2>/dev/null
    if [ "$answer" = "yes" ]; then
        ISOLATE="setm"
        return 0
    fi
    if have perl; then
        answer=$(
            perl -e 'setpgrp(0, 0); exec { $ARGV[0] } @ARGV or exit 127' sleep 5 </dev/null >/dev/null 2>&1 &
            child=$!
            sleep 0.2
            group=$(ps -o pgid= -p "$child" 2>/dev/null | tr -d ' ')
            kill "$child" 2>/dev/null
            [ "$group" = "$child" ] && printf 'yes'
        ) 2>/dev/null
        if [ "$answer" = "yes" ]; then
            ISOLATE="perl"
            return 0
        fi
    fi
    ISOLATE="none"
}

take_lock() {
    # One run at a time may change repositories: a timer and a hand-typed
    # command must not meet in the same working tree.
    local pid="" lock
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    lock="$STATE_DIR/lock"
    if ! claim "$lock" "$$"; then
        pid=$(cat "$lock" 2>/dev/null)
        if [ -z "$pid" ]; then
            sleep 0.3
            pid=$(cat "$lock" 2>/dev/null)
        fi
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            die "$EX_ENV" "another $PROG is at work (process $pid): wait for it to finish"
        fi
        # The lock of a run that died is taken over.
        rm -f "$lock"
        claim "$lock" "$$" || die "$EX_ENV" "cannot take the lock in $STATE_DIR"
    fi
    LOCKED=1
    report_unfinished_updates
}

report_unfinished_updates() {
    # A marker is written before a working tree is moved and removed after:
    # one that remains names a repository whose update was cut short.
    local marker pid path line notes
    for marker in "$STATE_DIR"/inflight.*; do
        [ -f "$marker" ] || continue
        pid=${marker##*/inflight.}
        pid=${pid%%.*}
        if is_uint "$pid" && kill -0 "$pid" 2>/dev/null; then
            continue
        fi
        path=""; notes=""
        {
            IFS= read -r path
            while IFS= read -r line; do
                [ -n "$line" ] && notes="$notes; $line"
            done
        } < "$marker" 2>/dev/null
        [ -n "$path" ] &&
            warn "an earlier run was cut short while it updated $(short_path "$path"): look at it with git status$notes"
        rm -f "$marker"
    done
}

harden_git() {
    # Variables such as GIT_DIR would redirect every "git -C DIR"; they are
    # cleared. No git started here may ask a question: with several
    # repositories at work the terminal belongs to nobody.
    local name
    for name in $(git rev-parse --local-env-vars 2>/dev/null); do
        unset "$name"
    done
    [ -n "${GIT_SSH_COMMAND:-}${GIT_SSH:-}" ] && USER_SSH=1
    export GIT_OPTIONAL_LOCKS=0
    export GIT_TERMINAL_PROMPT=0
    export GIT_ASKPASS=""
    export GCM_INTERACTIVE=never
    export GIT_EDITOR=:
    export GIT_SEQUENCE_EDITOR=:
    export GIT_MERGE_AUTOEDIT=no
}

# ---------------------------------------------------------------------------
# Discovery of the repositories
# ---------------------------------------------------------------------------

add_repo() {
    # add_repo PATH NAME: keep the repository unless its physical path was
    # already taken (a symbolic link to a repository listed elsewhere).
    local phys
    phys=$(cd "$1" 2>/dev/null && pwd -P) || return 0
    case "$SEEN$US" in
        *"$US$phys$US"*) return 0 ;;
    esac
    SEEN="$SEEN$US$phys"
    REPOS+=("$1")
    NAMES+=("$2")
}

walk() {
    # walk DIR LEVELS PREFIX: a folder holding ".git" is a repository and is
    # not entered; hidden folders and node_modules are not searched.
    local dir="$1" levels="$2" prefix="$3" entry base
    for entry in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
        [ -d "$entry" ] || continue
        base=${entry##*/}
        if [ -e "$entry/.git" ]; then
            add_repo "$entry" "$prefix$base"
            continue
        fi
        case "$base" in
            .*|node_modules) continue ;;
        esac
        if [ "$levels" -gt 1 ]; then
            walk "$entry" $(( levels - 1 )) "$prefix$base/"
        fi
    done
    return 0
}

selected() {
    # selected NAME -> 0 when --only, --except and gh-batch.exclude keep it
    local name="$1" base="${1##*/}" pattern
    # shellcheck disable=SC2254  # the patterns are meant to be matched as globs
    for pattern in ${EXCEPT[@]+"${EXCEPT[@]}"} ${CFG_EXCLUDE[@]+"${CFG_EXCLUDE[@]}"}; do
        case "$name" in $pattern) return 1 ;; esac
        case "$base" in $pattern) return 1 ;; esac
    done
    [ "${#ONLY[@]}" -eq 0 ] && return 0
    # shellcheck disable=SC2254
    for pattern in "${ONLY[@]}"; do
        case "$name" in $pattern) return 0 ;; esac
        case "$base" in $pattern) return 0 ;; esac
    done
    return 1
}

default_roots() {
    # The folders searched when the command line names none, and those
    # under which a name is looked up.
    if [ -n "${GH_BATCH_ROOT:-}" ]; then
        DEFAULT_ROOTS=("$(expand_tilde "$GH_BATCH_ROOT")")
    elif [ "${#CFG_ROOTS[@]}" -gt 0 ]; then
        DEFAULT_ROOTS=("${CFG_ROOTS[@]}")
    else
        DEFAULT_ROOTS=(".")
    fi
}

is_path_word() {
    # is_path_word WORD -> 0 when the word is a folder seen from here, or is
    # written as a path; any other word is the name of a repository.
    case "$1" in
        /*|./*|../*|"~"*|.|..) return 0 ;;
    esac
    [ -d "$1" ]
}

label_root() {
    # label_root PATH: the folder joins the first line of the report, once.
    local shown
    shown=$(short_path "$1")
    case ", $ROOT_LABEL, " in
        *", $shown, "*) ;;
        *) ROOT_LABEL="$ROOT_LABEL${ROOT_LABEL:+, }$shown" ;;
    esac
    return 0
}

search_folder() {
    # search_folder FOLDER: a repository is taken alone, any other folder is
    # searched.
    local abs
    [ -d "$1" ] || die "$EX_USAGE" "no such folder: $1"
    abs=$(cd "$1" && pwd) || die "$EX_USAGE" "cannot enter $1"
    ROOTS_ABS+=("$abs")
    label_root "$abs"
    if [ -e "$abs/.git" ]; then
        add_repo "$abs" "${abs##*/}"
    else
        walk "${abs%/}" "$DEPTH" ""
    fi
}

name_pool() {
    # The repositories under the default folders, where the names given on
    # the command line are looked up, listed once. The walk writes into
    # REPOS, NAMES and SEEN, which are kept aside meanwhile.
    local repos=() names=() seen=$SEEN root abs
    [ "$POOL_DONE" -eq 1 ] && return 0
    POOL_DONE=1
    repos=(${REPOS[@]+"${REPOS[@]}"})
    names=(${NAMES[@]+"${NAMES[@]}"})
    REPOS=(); NAMES=(); SEEN=""
    for root in "${DEFAULT_ROOTS[@]}"; do
        [ -d "$root" ] || die "$EX_USAGE" "no such folder: $root"
        abs=$(cd "$root" && pwd) || die "$EX_USAGE" "cannot enter $root"
        POOL_ROOTS+=("$abs")
        if [ -e "$abs/.git" ]; then
            add_repo "$abs" "${abs##*/}"
        else
            walk "${abs%/}" "$DEPTH" ""
        fi
    done
    POOL_PATHS=(${REPOS[@]+"${REPOS[@]}"})
    POOL_NAMES=(${NAMES[@]+"${NAMES[@]}"})
    REPOS=(${repos[@]+"${repos[@]}"})
    NAMES=(${names[@]+"${names[@]}"})
    SEEN=$seen
    return 0
}

named_by() {
    # named_by NAME WORD -> 0 when the word names the repository: its whole
    # name, the last part of it, or a folder that holds it. The word may
    # hold the wildcards of --only.
    # shellcheck disable=SC2254  # the word is meant to be matched as a glob
    case "$1" in $2|$2/*) return 0 ;; esac
    # shellcheck disable=SC2254
    case "${1##*/}" in $2) return 0 ;; esac
    return 1
}

unknown_name() {
    # unknown_name WORD -> why the word names nothing, with the names that
    # contain it, when there are some.
    local word="$1" where="" root hits="" line n=0
    for root in ${POOL_ROOTS[@]+"${POOL_ROOTS[@]}"}; do
        where="$where${where:+, }$(short_path "$root")"
    done
    case "$word" in
        *[*?[]*) ;;
        *)
            while IFS= read -r line; do
                [ -n "$line" ] || continue
                n=$(( n + 1 ))
                [ "$n" -le 5 ] || break
                hits="$hits${hits:+$US}$line"
            done <<EOF
$(printf '%s\n' ${POOL_NAMES[@]+"${POOL_NAMES[@]}"} | grep -i -F -- "$word")
EOF
            ;;
    esac
    if [ "${#CHAIN[@]}" -gt 0 ]; then
        case "$word" in
            exec|list|config|completion|help)
                printf '%s is neither a folder here nor the name of a repository under %s, and the command %s runs alone, not after another one' \
                    "$word" "$where" "$word"
                return 0 ;;
        esac
    fi
    if [ -n "$hits" ]; then
        local IFS=$US
        # shellcheck disable=SC2086  # the names are split at the separator
        printf '%s is neither a folder here nor the name of a repository under %s; the names that contain it: %s' \
            "$word" "$where" "$(enumerate $hits)"
    else
        printf '%s is neither a folder here nor the name of a repository under %s (%s list prints the names)' \
            "$word" "$where" "$PROG"
    fi
}

take_named() {
    # take_named WORD: the repositories that the word names under the
    # default folders, in the order of the walk; a word that names none
    # stops the run before anything is done.
    local word="$1" i=0 n=0 root
    while [ "${word%/}" != "$word" ] && [ -n "${word%/}" ]; do
        word=${word%/}
    done
    name_pool
    while [ "$i" -lt "${#POOL_PATHS[@]}" ]; do
        if named_by "${POOL_NAMES[$i]}" "$word"; then
            add_repo "${POOL_PATHS[$i]}" "${POOL_NAMES[$i]}"
            n=$(( n + 1 ))
        fi
        i=$(( i + 1 ))
    done
    [ "$n" -gt 0 ] || die "$EX_USAGE" "$(unknown_name "$word")"
    for root in ${POOL_ROOTS[@]+"${POOL_ROOTS[@]}"}; do
        label_root "$root"
    done
    return 0
}

discover() {
    # The repositories of the run: each word of the command line is a
    # folder, when it is one here or is written as a path, or else the name
    # of repositories under the default folders; without a word, the default
    # folders are searched.
    local word i kept_repos=() kept_names=()
    REPOS=(); NAMES=(); SEEN=""
    default_roots
    ROOT_LABEL=""
    ROOTS_ABS=()
    if [ "${#ARGS[@]}" -eq 0 ]; then
        for word in "${DEFAULT_ROOTS[@]}"; do
            search_folder "$word"
        done
    else
        for word in "${ARGS[@]}"; do
            if is_path_word "$word"; then
                search_folder "$word"
            else
                take_named "$word"
            fi
        done
    fi
    ALL_REPOS=(${REPOS[@]+"${REPOS[@]}"})
    i=0
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        if selected "${NAMES[$i]}"; then
            kept_repos+=("${REPOS[$i]}")
            kept_names+=("${NAMES[$i]}")
        fi
        i=$(( i + 1 ))
    done
    REPOS=(${kept_repos[@]+"${kept_repos[@]}"})
    NAMES=(${kept_names[@]+"${kept_names[@]}"})
    fit_names
    return 0
}

fit_names() {
    # The width of the column of names, for the repositories in hand. On a
    # terminal it leaves 48 columns to the messages, enough for most of them
    # to stand on one line: a longer name pushes the rest of its own line to
    # the right.
    local name limit
    NAME_WIDTH=12
    for name in ${NAMES[@]+"${NAMES[@]}"}; do
        [ "${#name}" -gt "$NAME_WIDTH" ] && NAME_WIDTH=${#name}
    done
    [ "$NAME_WIDTH" -gt 40 ] && NAME_WIDTH=40
    if [ "$SCREEN_W" -gt 0 ]; then
        limit=$(( SCREEN_W - 77 ))
        [ "$limit" -lt 12 ] && limit=12
        [ "$NAME_WIDTH" -gt "$limit" ] && NAME_WIDTH=$limit
    fi
    return 0
}

# ---------------------------------------------------------------------------
# The engine: workers that claim repositories one by one, children in their
# own process groups, results as files printed in the order of the folders
# ---------------------------------------------------------------------------

stopped() { [ -e "$TMP/stop" ]; }

spawn() {
    # spawn NAME COMMAND...: start a long child with its output in
    # $W/NAME.out and $W/NAME.err, in a process group of its own. Sets CHILD.
    local name="$1"; shift
    OUT="$W/$name.out"
    ERR="$W/$name.err"
    case "$ISOLATE" in
        setm)
            set -m
            "$@" </dev/null >"$OUT" 2>"$ERR" &
            CHILD=$!
            set +m
            ;;
        perl)
            perl -e 'setpgrp(0, 0); exec { $ARGV[0] } @ARGV or exit 127' "$@" </dev/null >"$OUT" 2>"$ERR" &
            CHILD=$!
            ;;
        *)
            "$@" </dev/null >"$OUT" 2>"$ERR" &
            CHILD=$!
            ;;
    esac
    printf '%s\n' "$CHILD" > "$W/child"
}

signal_child() {
    if [ "$ISOLATE" = "none" ]; then
        kill "-$1" "$CHILD" 2>/dev/null
    else
        kill "-$1" -- "-$CHILD" 2>/dev/null
    fi
    return 0
}

end_child() {
    local n=0
    signal_child TERM
    signal_child CONT
    while kill -0 "$CHILD" 2>/dev/null && [ "$n" -lt 30 ]; do
        sleep 0.1
        n=$(( n + 1 ))
    done
    kill -0 "$CHILD" 2>/dev/null && signal_child KILL
    return 0
}

await() {
    # await net|timed|local [LIMIT] -> the exit status of the child, or 124
    # when the deadline passed, 130 when the run was stopped, 125 when the
    # child waited for the terminal. A network step is ended on a stop or at
    # its deadline, a timed one at its deadline only; a local step, which
    # moves files, is always left to finish.
    local kind="$1" limit="${2:-0}" started=$SECONDS n=0 why="" rc
    while kill -0 "$CHILD" 2>/dev/null; do
        n=$(( n + 1 ))
        if [ "$kind" = "net" ] && { stopped || ! kill -0 "$$" 2>/dev/null; }; then
            why=130
        elif [ "$kind" != "local" ] && [ "$limit" -gt 0 ] && [ $(( SECONDS - started )) -ge "$limit" ]; then
            why=124
        fi
        if [ -z "$why" ] && [ $(( n % 25 )) -eq 0 ]; then
            case "$(ps -o stat= -p "$CHILD" 2>/dev/null)" in
                T*) why=125 ;;
            esac
        fi
        if [ -n "$why" ]; then
            end_child
            break
        fi
        if [ "$n" -lt 12 ]; then sleep 0.02; else sleep 0.1; fi
    done
    wait "$CHILD" 2>/dev/null
    rc=$?
    rm -f "$W/child"
    [ -n "$why" ] && return "$why"
    return "$rc"
}

run_net() {
    # run_net NAME COMMAND... -> status of a step that talks to a server
    spawn "$@"
    await net "$TIMEOUT"
}

run_local() {
    # run_local NAME COMMAND... -> status of a step that changes local files
    spawn "$@"
    await local 0
}

pool_worker() {
    # pool_worker FUNCTION DIR COUNT: claim the next free repository, run
    # FUNCTION on it, publish its result by renaming the finished file.
    local fn="$1" dir="$2" count="$3" i=0
    trap - EXIT
    trap ':' TERM HUP
    while [ "$i" -lt "$count" ]; do
        stopped && break
        kill -0 "$$" 2>/dev/null || break
        if claim "$TMP/$dir/$i.claim"; then
            IDX=$i
            REPO=${REPOS[$i]}
            NAME=${NAMES[$i]}
            W="$TMP/$dir/$i.w"
            mkdir -p "$W"
            "$fn" > "$TMP/$dir/$i.part" 2>> "$TMP/$dir/$i.log"
            mv "$TMP/$dir/$i.part" "$TMP/$dir/$i.res"
        fi
        i=$(( i + 1 ))
    done
    return 0
}

hard_stop() {
    # A second signal: the workers and their children are ended at once.
    local pid file group
    for pid in "$@"; do
        kill -TERM "$pid" 2>/dev/null
    done
    for file in "$TMP"/*/*.w/child; do
        [ -f "$file" ] || continue
        group=$(cat "$file" 2>/dev/null)
        is_uint "$group" || continue
        if [ "$ISOLATE" = "none" ]; then
            kill -KILL "$group" 2>/dev/null
        else
            kill -KILL -- "-$group" 2>/dev/null
        fi
    done
    return 0
}

pool() {
    # pool FUNCTION DIR RENDER: run FUNCTION on every repository with $JOBS
    # workers and hand each result to RENDER in the order of the folders.
    local fn="$1" dir="$2" render="$3" count="${#REPOS[@]}" jobs="$JOBS"
    local w=0 next=0 alive pid pids=() killed=0
    mkdir -p "$TMP/$dir"
    [ "$jobs" -gt "$count" ] && jobs=$count
    while [ "$w" -lt "$jobs" ]; do
        pool_worker "$fn" "$dir" "$count" </dev/null >/dev/null 2>>"$TMP/worker.log" &
        pids+=("$!")
        w=$(( w + 1 ))
    done
    while [ "$next" -lt "$count" ]; do
        if [ -f "$TMP/$dir/$next.res" ]; then
            progress_clear
            "$render" "$next" "$TMP/$dir/$next.res"
            next=$(( next + 1 ))
            continue
        fi
        if [ "$HARD" -eq 1 ] && [ "$killed" -eq 0 ]; then
            hard_stop ${pids[@]+"${pids[@]}"}
            killed=1
        fi
        alive=0
        for pid in ${pids[@]+"${pids[@]}"}; do
            if kill -0 "$pid" 2>/dev/null; then
                alive=1
                break
            fi
        done
        if [ "$alive" -eq 0 ] && [ ! -f "$TMP/$dir/$next.res" ]; then
            # No worker is left: this repository was not reached, or its
            # worker died with it.
            if [ -e "$TMP/$dir/$next.claim" ] && ! stopped; then
                printf 'S%slost%s1%s%sits worker died before it finished\n' "$US" "$US" "$US" "$US" > "$TMP/$dir/$next.res"
            else
                printf 'S%sinterrupted%s1%s%snot reached before the stop\n' "$US" "$US" "$US" "$US" > "$TMP/$dir/$next.res"
            fi
            continue
        fi
        progress_show "$next" "$count"
        sleep 0.1
    done
    for pid in ${pids[@]+"${pids[@]}"}; do
        wait "$pid" 2>/dev/null
    done
    progress_clear
    return 0
}

# ---------------------------------------------------------------------------
# Results: one record per repository, written by a worker, read by render
# ---------------------------------------------------------------------------

emit() {
    # emit STATE ATTENTION MESSAGE: the state of the repository, whether it
    # needs the user (1) and one line saying why.
    printf 'S%s%s%s%s%s%s%s%s\n' "$US" "$1" "$US" "$2" "$US" "$(one_line "${R_branch:-}")" "$US" "$(one_line "$3")"
}

detail() {
    # detail TEXT: one more line shown under the repository.
    printf 'D%s%s\n' "$US" "$(one_line "$1")"
}

details() {
    # details TEXT: each line of TEXT becomes a detail.
    local line
    [ -n "$1" ] || return 0
    while IFS= read -r line; do
        [ -n "$line" ] && detail "$line"
    done <<EOF
$1
EOF
    return 0
}

record_move() {
    # record_move ACTION OLD NEW: a line for the journal of what was changed.
    printf 'J%s%s%s%s%s%s\n' "$US" "$1" "$US" "$2" "$US" "$3"
}

record_kept() {
    # record_kept WORDS: what this repository kept aside, for the line
    # "Kept aside" of the summary.
    [ -n "$1" ] && printf 'K%s%s\n' "$US" "$(one_line "$1")"
    return 0
}

state_label() {
    case "$1" in
        uptodate)     printf 'up to date' ;;
        halfupdated)  printf 'half-updated' ;;
        localonly)    printf 'local only' ;;
        noupstream)   printf 'no upstream' ;;
        notcommitted) printf 'not committed' ;;
        planned)      printf 'to do' ;;
        active)       printf 'commits' ;;
        *)            printf '%s' "$1" ;;
    esac
}

state_class() {
    case "$1" in
        updated|rebased|merged|reset|pushed|committed|cloned|tidied|ok) printf 'good' ;;
        uptodate|level|clean|present|skipped|nothing|healthy) printf 'dim' ;;
        ahead|behind|pending|stash|localonly|noupstream|detached|planned|active|warning) printf 'info' ;;
        *)                                         printf 'bad' ;;
    esac
}

state_phrase() {
    # state_phrase STATE N -> the words of the summary line
    local n="$2"
    case "$1" in
        updated)      printf '%s updated' "$n" ;;
        cloned)       printf '%s cloned' "$n" ;;
        ok)           printf '%s ok' "$n" ;;
        healthy)      printf '%s healthy' "$n" ;;
        warning)      printf '%s with warnings' "$n" ;;
        problem)      printf '%s with problems' "$n" ;;
        pushed)       printf '%s pushed' "$n" ;;
        committed)    printf '%s committed' "$n" ;;
        planned)      printf '%s to do' "$n" ;;
        nothing)      printf '%s with nothing to push' "$n" ;;
        rejected)     printf '%s rejected' "$n" ;;
        notcommitted) printf '%s not committed' "$n" ;;
        rebased)      printf '%s rebased' "$n" ;;
        merged)       printf '%s merged' "$n" ;;
        reset)        printf '%s reset' "$n" ;;
        tidied)       printf '%s tidied' "$n" ;;
        uptodate)     printf '%s up to date' "$n" ;;
        level)        printf '%s level with the server' "$n" ;;
        clean)        printf '%s clean' "$n" ;;
        pending)      printf '%s with pending changes' "$n" ;;
        stash)        printf '%s with a stash' "$n" ;;
        ahead)        printf '%s with commits to push' "$n" ;;
        behind)       printf '%s behind' "$n" ;;
        diverged)     printf '%s diverged' "$n" ;;
        conflict)     printf '%s in conflict' "$n" ;;
        blocked)      printf '%s blocked' "$n" ;;
        failed)       printf '%s failed' "$n" ;;
        gone)         printf '%s whose branch left the server' "$n" ;;
        unfinished)   printf '%s with an unfinished operation' "$n" ;;
        halfupdated)  printf '%s half-updated' "$n" ;;
        busy)         printf '%s busy' "$n" ;;
        unreadable)   printf '%s unreadable' "$n" ;;
        localonly)    printf '%s without remote' "$n" ;;
        noupstream)   printf '%s without upstream' "$n" ;;
        detached)     printf '%s detached' "$n" ;;
        skipped)      printf '%s skipped' "$n" ;;
        interrupted)  printf '%s interrupted' "$n" ;;
        lost)         printf '%s lost' "$n" ;;
        *)            printf '%s %s' "$n" "$1" ;;
    esac
}

STATE_ORDER="updated rebased merged reset tidied pushed committed planned cloned ok uptodate level clean nothing present pending stash ahead behind localonly noupstream detached skipped healthy warning problem diverged conflict blocked rejected notcommitted failed gone unfinished halfupdated busy unreadable interrupted lost"

tally() {
    local var="N_$1"
    printf -v "$var" '%s' $(( ${!var:-0} + 1 ))
}

setup_colour() {
    local width
    USE_COLOUR=0
    case "$COLOR_MODE" in
        always) USE_COLOUR=1 ;;
        never)  ;;
        auto)
            if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
                USE_COLOUR=1
            fi
            ;;
        *) die "$EX_USAGE" "the choices for --color are auto, always and never, not '$COLOR_MODE'" ;;
    esac
    # The sixteen colours of the terminal, so that the output follows its
    # theme, light or dark. Their parts are those of Tokyo Night and of
    # most themes: blue for the titles and the bullets, magenta for the
    # branches, cyan for what is typed, green, yellow and red for what was
    # done, what waits and what needs the user. The band of the first line
    # is the blue of the theme behind its own background colour, so that it
    # reads on a dark theme as on a light one.
    if [ "$USE_COLOUR" -eq 1 ]; then
        C_GOOD=$(printf '\033[32m')
        C_INFO=$(printf '\033[33m')
        C_BAD=$(printf '\033[1;31m')
        C_DIM=$(printf '\033[2m')
        C_BOLD=$(printf '\033[1m')
        C_TITLE=$(printf '\033[1;7;34m')
        C_HEAD=$(printf '\033[1;34m')
        C_NAME=$(printf '\033[1m')
        C_BRANCHNAME=$(printf '\033[35m')
        C_CMD=$(printf '\033[36m')
        C_HASH=$(printf '\033[33m')
        C_PUBLIC=$(printf '\033[1;35m')
        C_BULLET=$(printf '\033[34m')
        C_OFF=$(printf '\033[0m')
    fi
    STYLED=$USE_COLOUR
    UNICODE=0
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) UNICODE=1 ;;
    esac
    BULLET="-"
    GUTTER="|"
    if [ "$UNICODE" -eq 1 ]; then
        BULLET="•"
        GUTTER="│"
    fi
    # On a terminal a long line is cut at a space and goes on under its
    # column, instead of running back to the left edge. A pipe and the copy
    # kept for the notification keep whole lines; the colours forced on a
    # pipe follow COLUMNS when it is exported.
    SCREEN_W=0
    width=""
    if [ -t 1 ]; then
        width=$(stty size 2>/dev/null < /dev/tty)
        width=${width#* }
        is_uint "$width" || width=$(tput cols 2>/dev/null)
        is_uint "$width" || width=${COLUMNS:-}
    elif [ "$USE_COLOUR" -eq 1 ]; then
        width=${COLUMNS:-}
    fi
    is_uint "$width" && [ "$width" -ge 40 ] && SCREEN_W=$width
    PROGRESS=0
    if [ -t 2 ] && [ "$QUIET" -eq 0 ] && [ "$PORCELAIN" -eq 0 ]; then
        PROGRESS=1
    fi
}

mark() {
    # mark STATE -> the sign in front of a state on the screen: a tick for
    # what was done, a dot for nothing to do, arrows for what waits, a
    # cross for what needs the user; letters when the terminal is not UTF-8.
    local u a
    case "$1" in
        updated|rebased|merged|reset|pushed|committed|cloned|tidied|ok|healthy) u='✓'; a='+' ;;
        ahead)                 u='↑'; a='^' ;;
        behind)                u='↓'; a='v' ;;
        diverged)              u='⇅'; a='x' ;;
        planned)               u='→'; a='>' ;;
        warning)               u='⚠'; a='!' ;;
        pending|stash|active)  u='●'; a='*' ;;
        localonly|noupstream|detached) u='○'; a='o' ;;
        uptodate|level|clean|nothing|present|skipped) u='·'; a='-' ;;
        *)                     u='✗'; a='x' ;;
    esac
    if [ "$UNICODE" -eq 1 ]; then printf '%s' "$u"; else printf '%s' "$a"; fi
}

class_colour() {
    # class_colour STATE -> the colour of the class of the state
    case "$(state_class "$1")" in
        good) printf '%s' "$C_GOOD" ;;
        info) printf '%s' "$C_INFO" ;;
        dim)  printf '%s' "$C_DIM" ;;
        *)    printf '%s' "$C_BAD" ;;
    esac
}

progress_show() {
    local frame
    [ "$PROGRESS" -eq 1 ] || return 0
    if [ "$UNICODE" -eq 1 ]; then
        frame=${SPIN_U[$(( SPIN_I % 10 ))]}
    else
        frame=${SPIN_A[$(( SPIN_I % 4 ))]}
    fi
    SPIN_I=$(( SPIN_I + 1 ))
    printf '\r\033[K  %s%s%s %s %sof %s%s' "$C_BULLET" "$frame" "$C_OFF" "$1" "$C_DIM" "$2" "$C_OFF" >&2
}

progress_clear() {
    [ "$PROGRESS" -eq 1 ] || return 0
    printf '\r\033[K' >&2
}

progress_note() {
    # progress_note TEXT: what a question to GitHub is about, shown while
    # the answer is awaited and wiped by progress_clear.
    [ "$PROGRESS" -eq 1 ] || return 0
    printf '\r\033[K  %s%s%s' "$C_DIM" "$1" "$C_OFF" >&2
}

put() {
    # put TEXT: one line of the report, on the screen and in the copy kept
    # for the notification.
    [ -n "$TMP" ] && printf '%s\n' "$1" >> "$TMP/report.txt"
    [ "$QUIET" -eq 1 ] && return 0
    printf '%s\n' "$1"
}

put_styled() {
    # put_styled PLAIN STYLED: PLAIN goes to the copy kept for the
    # notification and to a pipe, STYLED to a terminal that shows colours.
    [ -n "$TMP" ] && printf '%s\n' "$1" >> "$TMP/report.txt"
    [ "$QUIET" -eq 1 ] && return 0
    if [ "$STYLED" -eq 1 ]; then
        printf '%s\n' "$2"
    else
        printf '%s\n' "$1"
    fi
}

spaces() { printf '%*s' "$1" ''; }

as_is() { printf '%s' "$1"; }

wrap() {
    # wrap ROOM NEXT TEXT -> TEXT cut at its spaces into lines, the first
    # at most ROOM characters long and the others at most NEXT. A word
    # longer than its line stands alone on it, whole, and the spaces inside
    # a line stay as they are. A last word that would stand alone takes the
    # word before it along, so that no line ends a text with one word.
    local room="$1" next="$2" rest="$3" line="" prev="" held=0 word more=1 last
    if [ "${#rest}" -le "$room" ] || [ "$room" -lt 1 ] || [ "$next" -lt 1 ]; then
        printf '%s\n' "$rest"
        return 0
    fi
    while [ "$more" -eq 1 ]; do
        case "$rest" in
            *" "*) word=${rest%% *}; rest=${rest#* } ;;
            *)     word=$rest; more=0 ;;
        esac
        if [ -z "$line" ]; then
            line=$word
        elif [ $(( ${#line} + 1 + ${#word} )) -le "$room" ]; then
            line="$line $word"
        else
            [ "$held" -eq 1 ] && printf '%s\n' "$prev"
            prev=$line
            held=1
            line=$word
            room=$next
        fi
    done
    last=${prev##* }
    case "$line" in
        *" "*) ;;
        *)
            case "$prev" in
                *" "*" "*)
                    if [ -n "$last" ] && [ $(( ${#last} + 1 + ${#line} )) -le "$next" ]; then
                        line="$last $line"
                        prev=${prev% *}
                    fi
                    ;;
            esac
            ;;
    esac
    [ "$held" -eq 1 ] && printf '%s\n' "$prev"
    [ -n "$line" ] && printf '%s\n' "$line"
    return 0
}

screen_lines() {
    # screen_lines LEAD WIDTH NEXT HANG STYLE TEXT: TEXT on the screen after
    # LEAD, which takes WIDTH columns. A text too long for the terminal is
    # cut at spaces and goes on after NEXT, which takes HANG columns, so
    # that it stays in its column. STYLE names the function that colours
    # each piece of the text.
    local lead="$1" width="$2" next="$3" hang="$4" style="$5" text="$6" line first=1
    if [ "$SCREEN_W" -eq 0 ] || [ $(( width + ${#text} )) -le "$SCREEN_W" ]; then
        printf '%s%s\n' "$lead" "$("$style" "$text")"
        return 0
    fi
    while IFS= read -r line; do
        if [ "$first" -eq 1 ]; then
            printf '%s%s\n' "$lead" "$("$style" "$line")"
            first=0
        else
            printf '%s%s\n' "$next" "$("$style" "$line")"
        fi
    done <<EOF
$(wrap $(( SCREEN_W - width )) $(( SCREEN_W - hang )) "$text")
EOF
    return 0
}

put_wrapped() {
    # put_wrapped LEAD STYLED_LEAD HANG STYLE TEXT: one line of the report,
    # LEAD then TEXT. The copy kept for the notification and a pipe get it
    # whole; a terminal gets it cut at spaces, going on HANG columns from
    # the left edge. STYLED_LEAD is LEAD in colour, as wide on the screen,
    # and STYLE the function that colours the text.
    local lead="$1" styled="$2" hang="$3" style="$4" text="$5"
    [ -n "$TMP" ] && printf '%s%s\n' "$lead" "$text" >> "$TMP/report.txt"
    [ "$QUIET" -eq 1 ] && return 0
    if [ "$STYLED" -eq 1 ]; then
        screen_lines "$styled" "${#lead}" "$(spaces "$hang")" "$hang" "$style" "$text"
    else
        screen_lines "$lead" "${#lead}" "$(spaces "$hang")" "$hang" as_is "$text"
    fi
}

title_band() {
    # title_band TEXT -> TEXT in the coloured band that opens a report
    printf '%s %s %s' "$C_TITLE" "$1" "$C_OFF"
}

put_title() {
    # put_title TEXT: a line that heads a part of the report.
    put_styled "$1" "$C_HEAD$1$C_OFF"
}

style_strong() {
    # style_strong TEXT -> TEXT in bold, its PUBLIC in the colour of the mark
    local t="$1"
    t=${t//PUBLIC/$C_PUBLIC"PUBLIC"$C_OFF$C_BOLD}
    printf '%s%s%s' "$C_BOLD" "$t" "$C_OFF"
}

put_todo() {
    # put_todo TEXT: the sentence that ends a plan, "To do: a push from 3
    # repositories.", its first words as a title.
    local word="${1%%: *}:" rest="${1#*: }"
    put_wrapped "$word " "$C_HEAD$word$C_OFF " $(( ${#word} + 1 )) style_strong "$rest"
}

put_item() {
    # put_item SIGN NAME TEXT: an item of a list, after a bullet, or after
    # SIGN on a terminal that shows colours (one column wide, coloured):
    # NAME in bold when there is one, then TEXT, which goes on under the
    # start of the item.
    local sign="$1" name="$2" text="$3" lead styled
    lead="  $BULLET "
    styled="  $sign "
    if [ -n "$name" ]; then
        lead="$lead$name: "
        styled="$styled$C_NAME$name$C_OFF: "
    fi
    put_wrapped "$lead" "$styled" 4 as_is "$text"
}

put_finding() {
    # put_finding LEVEL TEXT: an item of a list of findings, "warning: TEXT"
    # in the copy and in a pipe; on a terminal that shows colours, the sign
    # of the level in its colour stands for the word, as a bullet.
    local level="$1" text="$2"
    if [ "$STYLED" -eq 0 ]; then
        put_wrapped "  $level: " "" 4 as_is "$text"
        return 0
    fi
    [ -n "$TMP" ] && printf '  %s: %s\n' "$level" "$text" >> "$TMP/report.txt"
    [ "$QUIET" -eq 1 ] && return 0
    screen_lines "  $(class_colour "$level")$(mark "$level")$C_OFF " 4 "    " 4 as_is "$text"
}

put_command() {
    # put_command INDENT LABEL COMMAND: a command to type, after its label,
    # under what it serves. It stays whole, so that it can be copied.
    local pad
    pad=$(spaces "$1")
    put_styled "$pad$2 $3" "$pad$C_DIM$2$C_OFF $C_CMD$3$C_OFF"
}

style_message() {
    # style_message TEXT -> the message of a repository, its marks coloured
    local t="$1"
    t=${t//\[PUBLIC\]/[$C_PUBLIC"PUBLIC"$C_OFF]}
    t=${t//NOT committed/$C_BAD"NOT committed"$C_OFF}
    printf '%s' "$t"
}

command_detail() {
    # command_detail TEXT -> 0 when a line of detail gives a command to
    # type, after its label: "to compare: git -C ..."
    case "$1" in
        "to "*": "*) return 0 ;;
    esac
    return 1
}

style_detail() {
    # style_detail LINE -> a line of detail: the commit at its start in the
    # colour of git, the label of a command faint and the command in the
    # colour of what is typed, the word for a change in the colour of its
    # state, the level of a finding in its own.
    local line="$1" word rest
    if [ "$EXEC_OUTPUT" -eq 1 ]; then
        printf '%s' "$line"
        return 0
    fi
    if [[ $line =~ ^([0-9a-f]{7,40})[[:space:]]+(.*)$ ]]; then
        printf '%s%s%s %s' "$C_HASH" "${BASH_REMATCH[1]}" "$C_OFF" "${BASH_REMATCH[2]}"
        return 0
    fi
    if command_detail "$line"; then
        printf '%s%s:%s %s%s%s' "$C_DIM" "${line%%: *}" "$C_OFF" "$C_CMD" "${line#*: }" "$C_OFF"
        return 0
    fi
    word=${line%% *}
    rest=${line#"$word"}
    case "$word" in
        new)              printf '%s%s%s%s' "$C_GOOD" "$word" "$C_OFF" "$rest" ;;
        changed)          printf '%s%s%s%s' "$C_INFO" "$word" "$C_OFF" "$rest" ;;
        deleted|conflict) printf '%s%s%s%s' "$C_BAD" "$word" "$C_OFF" "$rest" ;;
        warning:)         printf '%s%s%s%s' "$C_INFO" "$word" "$C_OFF" "$rest" ;;
        problem:)         printf '%s%s%s%s' "$C_BAD" "$word" "$C_OFF" "$rest" ;;
        *)                printf '%s%s%s' "$C_DIM" "$line" "$C_OFF" ;;
    esac
}

style_log() {
    # style_log LINE -> a commit of "log", "13:42  d27d145  Subject": the
    # time faint, the commit in the colour of git, the author faint when
    # every author is shown.
    local line="$1" when commit rest author=""
    when=${line%%  *}
    rest=${line#*  }
    commit=${rest%%  *}
    rest=${rest#*  }
    if [ "$ALL_AUTHORS" -eq 1 ]; then
        case "$rest" in
            *"  ("*")") author="  $C_DIM(${rest##*  (}$C_OFF"; rest=${rest%  (*} ;;
        esac
    fi
    printf '%s%s%s  %s%s%s  %s%s' "$C_DIM" "$when" "$C_OFF" "$C_HASH" "$commit" "$C_OFF" "$rest" "$author"
}

put_repo() {
    # put_repo STATE ATTENTION NAME BRANCH MESSAGE: the line of a
    # repository, in columns: its state, its name, its branch, the message.
    # On a terminal a long message goes on under its column, or under the
    # name when the column is too narrow for it.
    local state="$1" attention="$2" name="$3" branch="$4" message="$5" label colour plain
    local name_colour branch_colour lead width hang style
    label=$(state_label "$state")
    plain=$(printf '  %-13s %-*s  %-8s %s' "$label" "$NAME_WIDTH" "$name" "$branch" "$message")
    plain=${plain%"${plain##*[! ]}"}
    [ -n "$TMP" ] && printf '%s\n' "$plain" >> "$TMP/report.txt"
    SHOWN=1
    if [ "$QUIET" -eq 1 ] && [ "$attention" -ne 1 ]; then
        return 0
    fi
    if [ "$STYLED" -eq 0 ] && { [ "$SCREEN_W" -eq 0 ] || [ -z "$message" ]; }; then
        printf '%s\n' "$plain"
        return 0
    fi
    lead=$(printf '  %-13s %-*s  %-8s ' "$label" "$NAME_WIDTH" "$name" "$branch")
    width=${#lead}
    hang=16
    if [ "$STYLED" -eq 1 ]; then
        colour=$(class_colour "$state")
        name_colour=$C_NAME
        branch_colour=$C_BRANCHNAME
        if [ "$colour" = "$C_DIM" ]; then
            name_colour=$C_DIM
            branch_colour=$C_DIM
        fi
        lead=$(printf '  %s%s %-13s%s %s%-*s%s  %s%-8s%s ' "$colour" "$(mark "$state")" "$label" "$C_OFF" \
            "$name_colour" "$NAME_WIDTH" "$name" "$C_OFF" "$branch_colour" "$branch" "$C_OFF")
        width=$(( width + 2 ))
        hang=18
    fi
    [ $(( SCREEN_W - width )) -ge 40 ] && hang=$width
    style=as_is
    [ "$STYLED" -eq 1 ] && style=style_message
    # A message that does not fit beside a long name or on a narrow
    # terminal starts on the next line, under the name, rather than leave
    # a few words alone there.
    if [ -n "$message" ] && [ "$hang" -lt "$width" ] && [ $(( width + ${#message} )) -gt "$SCREEN_W" ]; then
        printf '%s\n' "${lead%"${lead##*[! ]}"}"
        screen_lines "$(spaces "$hang")" "$hang" "$(spaces "$hang")" "$hang" "$style" "$message"
        return 0
    fi
    screen_lines "$lead" "$width" "$(spaces "$hang")" "$hang" "$style" "$message"
}

put_detail() {
    # put_detail TEXT ATTENTION [STYLE]: a line under the line of its
    # repository. The copy and a pipe get it indented; a terminal that
    # shows colours gets it under the name, after a faint line that holds
    # the details of the repository together, and cut at spaces when it
    # is long, unless it is a command to type or what a command of the
    # user wrote, which stay whole.
    local text="$1" style="${3:-style_detail}" lead
    [ -n "$TMP" ] && printf '        %s\n' "$text" >> "$TMP/report.txt"
    [ "$QUIET" -eq 0 ] || [ "$2" = 1 ] || return 0
    if [ "$STYLED" -eq 0 ]; then
        if [ "$SCREEN_W" -eq 0 ] || [ "$EXEC_OUTPUT" -eq 1 ] || command_detail "$text"; then
            printf '        %s\n' "$text"
        else
            screen_lines "        " 8 "        " 8 as_is "$text"
        fi
        return 0
    fi
    lead="$(spaces 18)$C_DIM$GUTTER$C_OFF "
    if [ "$EXEC_OUTPUT" -eq 1 ] || command_detail "$text"; then
        printf '%s%s\n' "$lead" "$("$style" "$text")"
    else
        screen_lines "$lead" 20 "$lead" 20 "$style" "$text"
    fi
}

read_record() {
    # read_record FILE: the record of one repository into the REC_* variables.
    local kind a b c d
    REC_state=""; REC_attention=0; REC_branch=""; REC_message=""
    REC_lines=(); REC_moves=(); REC_kept=()
    while IFS=$US read -r kind a b c d; do
        case "$kind" in
            S) REC_state=$a; REC_attention=$b; REC_branch=$c; REC_message=$d ;;
            D) REC_lines+=("$a") ;;
            J) REC_moves+=("$a$US$b$US$c") ;;
            K) REC_kept+=("$a") ;;
        esac
    done < "$1"
    if [ -z "$REC_state" ]; then
        REC_state="lost"; REC_attention=1
        REC_message="no result came back for this repository"
    fi
    REC_message=$(printf '%s' "$REC_message" | redact)
    return 0
}

print_record() {
    # print_record INDEX: the line of the repository read by read_record,
    # and the lines of detail under it.
    local idx="$1" line
    put_repo "$REC_state" "$REC_attention" "${NAMES[$idx]}" "$REC_branch" "$REC_message"
    for line in ${REC_lines[@]+"${REC_lines[@]}"}; do
        put_detail "$(printf '%s' "$line" | redact)" "$REC_attention"
    done
    return 0
}

note_attention() {
    # note_attention INDEX STATE: a repository that needs the user, for the
    # end of the report.
    ATTENTION=1
    ATTENTION_LIST+=("${NAMES[$1]}$US$2")
}

render() {
    # render INDEX FILE: read the record of one repository, count it, print
    # it when it changed or needs the user (always with --verbose).
    local idx="$1" move action old new
    read_record "$2"
    [ "$REC_state" = "ignored" ] && return 0
    for move in ${REC_moves[@]+"${REC_moves[@]}"}; do
        IFS=$US read -r action old new <<EOF
$move
EOF
        journal "$action" "${REPOS[$idx]}" "$old" "$new"
    done
    TOTAL=$(( TOTAL + 1 ))
    tally "$REC_state"
    [ "$REC_attention" = 1 ] && note_attention "$idx" "$REC_state"
    for move in ${REC_kept[@]+"${REC_kept[@]}"}; do
        KEPT_LIST+=("${NAMES[$idx]}$US$move")
    done
    if [ "$PORCELAIN" -eq 1 ]; then
        printf '%s\t%s\t%s\t%s\n' "$REC_state" "${REPOS[$idx]}" "$REC_branch" "$REC_message"
        return 0
    fi
    if [ "$REC_attention" != 1 ] && [ "$VERBOSE" -eq 0 ]; then
        case "$(state_class "$REC_state")" in
            dim) return 0 ;;
        esac
    fi
    print_record "$idx"
    return 0
}

header() {
    # header [NOTE]: the first line of a report, and NOTE on a line of its
    # own under it. On a terminal the program and its command open the
    # line in a coloured band, and NOTE stands under the words after it.
    local count note="${1:-}"
    [ "$PORCELAIN" -eq 1 ] && return 0
    count="$(plural "${#REPOS[@]}" repository) under $ROOT_LABEL"
    put_styled "$PROG $COMMAND: $count" "$(title_band "$PROG $COMMAND") $count"
    if [ -n "$note" ]; then
        put_styled "$note" "$(spaces $(( ${#PROG} + ${#COMMAND} + 4 )))$C_DIM$note$C_OFF"
    fi
    put ""
}

tally_colour() {
    # tally_colour STATE -> the colour of its count at the end of the
    # report: that of its class, but plain for nothing to do, whose sign
    # is faint already.
    case "$(state_class "$1")" in
        dim) return 0 ;;
    esac
    class_colour "$1"
}

put_list() {
    # put_list TITLE COLOUR SIGN ITEM...: what a few repositories have in
    # common, at the end of the report, each item "NAME<US>WORDS": on one
    # line for one item, as a list for more. TITLE is in COLOUR on the
    # screen, after SIGN when there is one, and so are the bullets.
    local title="$1" colour="$2" sign="$3" item name words lead
    shift 3
    lead="$colour$title$C_OFF"
    [ -n "$sign" ] && lead="$colour$sign $title$C_OFF"
    if [ "$#" -eq 1 ]; then
        name=${1%%"$US"*}
        words=${1#*"$US"}
        put_styled "$title $name ($words)." "$lead $C_NAME$name$C_OFF ($words)."
        return 0
    fi
    put_styled "$title" "$lead"
    for item in "$@"; do
        name=${item%%"$US"*}
        words=${item#*"$US"}
        put_styled "  $BULLET $name ($words)" "  $colour$BULLET$C_OFF $C_NAME$name$C_OFF ($words)"
    done
    return 0
}

summary() {
    # The end of a report: how many repositories, and in which states, on
    # one line for a single state and as a list, one sign each, for more;
    # then what was kept aside and what needs the user.
    local state var n states=() phrase elapsed when="" head item needs=() gap="none"
    [ "$PORCELAIN" -eq 1 ] && return 0
    for state in $STATE_ORDER; do
        var="N_$state"
        n=${!var:-0}
        [ "$n" -gt 0 ] && states+=("$state")
    done
    # On the screen a run of some length says how long it took; the plain
    # text, which a program or a notification may compare, does not depend
    # on the clock.
    elapsed=$(( SECONDS - RUN_START ))
    [ "$elapsed" -ge 2 ] && when=" in $elapsed s"
    head=$(plural "$TOTAL" repository)
    # A blank line parts the summary from the lines above it, and only from
    # them: the header already ends with one.
    [ "$SHOWN" -eq 1 ] && put ""
    if [ "${#states[@]}" -eq 0 ]; then
        put_styled "$head: nothing to report." "$C_HEAD$head$when$C_OFF: nothing to report."
    elif [ "${#states[@]}" -eq 1 ]; then
        state=${states[0]}
        var="N_$state"
        phrase=$(state_phrase "$state" "${!var}")
        put_styled "$head: $phrase." "$C_HEAD$head$when$C_OFF: $(tally_colour "$state")$phrase$C_OFF."
    else
        put_styled "$head:" "$C_HEAD$head$when$C_OFF:"
        for state in "${states[@]}"; do
            var="N_$state"
            phrase=$(state_phrase "$state" "${!var}")
            put_styled "  $BULLET $phrase" "  $(class_colour "$state")$(mark "$state")$C_OFF $(tally_colour "$state")$phrase$C_OFF"
        done
    fi
    # When one of the parts that follow the count is a list, a blank line
    # parts each from the one before; one line each, they stay together.
    if [ "${#states[@]}" -gt 1 ] || [ "${#KEPT_LIST[@]}" -gt 1 ] || [ "${#ATTENTION_LIST[@]}" -gt 1 ]; then
        gap=""
    fi
    # What was moved aside to let the server's version in: nothing is lost,
    # and nothing needs to be done, but it is worth knowing.
    if [ "${#KEPT_LIST[@]}" -gt 0 ]; then
        [ -z "$gap" ] && put ""
        put_list "Kept aside:" "$C_INFO" "" "${KEPT_LIST[@]}"
    fi
    if [ "${#ATTENTION_LIST[@]}" -gt 0 ]; then
        for item in "${ATTENTION_LIST[@]}"; do
            needs+=("${item%%"$US"*}$US$(state_label "${item#*"$US"}")")
        done
        [ -z "$gap" ] && put ""
        put_list "Needs you:" "$C_BAD" "$(mark failed)" "${needs[@]}"
    fi
    if [ "$STOP" -eq 1 ]; then
        [ -z "$gap" ] && put ""
        put_styled "The run was stopped before the end." "${C_INFO}The run was stopped before the end.$C_OFF"
    fi
    return 0
}
journal() {
    # journal ACTION PATH OLD NEW: append to the record of what the tool moved.
    [ -n "$STATE_DIR" ] || return 0
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$COMMAND" "$1" "$2" "$3" "$4" \
        >> "$STATE_DIR/journal.tsv" 2>/dev/null
    return 0
}

remember_run() {
    # The date of the last pull and of the last push, shown by "status".
    [ -n "$STATE_DIR" ] || return 0
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    date '+%Y-%m-%d %H:%M' > "$STATE_DIR/last.$1" 2>/dev/null
    return 0
}

finish() {
    summary
    notify
    if [ "$STOP" -eq 1 ]; then
        exit "$EX_INTERRUPT"
    fi
    if [ "$ATTENTION" -eq 1 ]; then
        exit "$EX_ATTENTION"
    fi
    exit "$EX_OK"
}

no_repository() {
    [ "${#REPOS[@]}" -gt 0 ] && return 1
    [ "$PORCELAIN" -eq 1 ] || put_styled "$PROG $COMMAND: no git repository found under $ROOT_LABEL." \
        "$(title_band "$PROG $COMMAND") no git repository found under $ROOT_LABEL."
    return 0
}

# ---------------------------------------------------------------------------
# One repository: what git says about it
# ---------------------------------------------------------------------------

g() { "${GIT[@]}" "$@"; }

inspect() {
    # Read the state of $REPO into the R_* variables. Returns 1 when the
    # folder is not a usable repository: R_problem then says why, and stays
    # empty for a folder that only looks like one.
    local out rc line inside bare shallow gitdir common prefix path rest
    R_problem=""; R_branch=""; R_oid=""; R_detached=0; R_unborn=0
    R_upstream=""; R_ahead=""; R_behind=""
    R_tracked=0; R_unmerged=0; R_untracked=0
    R_up_ref=""; R_up_remote=""; R_up_rref=""; R_push_ref=""; R_push_remote=""
    R_operation=""; R_busy=0; R_remotes=0; R_shallow=0; R_worktree=0

    out=$(g rev-parse --is-inside-work-tree --is-bare-repository --is-shallow-repository \
        --git-dir --git-common-dir --show-prefix 2>&1)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        if [ -f "$REPO/.git/HEAD" ] || { [ -f "$REPO/.git" ] && grep -q '^gitdir:' "$REPO/.git" 2>/dev/null; }; then
            R_problem=${out%%"$NL"*}
            R_problem=${R_problem#fatal: }
        fi
        return 1
    fi
    {
        IFS= read -r inside
        IFS= read -r bare
        IFS= read -r shallow
        IFS= read -r gitdir
        IFS= read -r common
        IFS= read -r prefix
    } <<EOF
$out
EOF
    # A folder inside a larger repository answers with a prefix: it is not a
    # repository of its own.
    if [ "$inside" != "true" ] || [ "$bare" != "false" ] || [ -n "${prefix:-}" ]; then
        return 1
    fi
    [ "$shallow" = "true" ] && R_shallow=1
    [ "$gitdir" != "$common" ] && R_worktree=1

    while IFS= read -r line; do
        case "$line" in
            "# branch.oid "*)
                R_oid=${line#\# branch.oid }
                [ "$R_oid" = "(initial)" ] && R_unborn=1
                ;;
            "# branch.head "*)
                R_branch=${line#\# branch.head }
                [ "$R_branch" = "(detached)" ] && R_detached=1
                ;;
            "# branch.upstream "*)
                R_upstream=${line#\# branch.upstream }
                ;;
            "# branch.ab "*)
                rest=${line#\# branch.ab }
                R_ahead=${rest%% *}
                R_ahead=${R_ahead#+}
                R_behind=${rest##* }
                R_behind=${R_behind#-}
                ;;
            "1 "*|"2 "*) R_tracked=$(( R_tracked + 1 )) ;;
            "u "*)       R_unmerged=$(( R_unmerged + 1 )) ;;
            "? "*)       R_untracked=$(( R_untracked + 1 )) ;;
        esac
    done <<EOF
$(g status --porcelain=v2 --branch --untracked-files=normal --no-renames 2>/dev/null)
EOF

    if [ "$R_detached" -eq 0 ] && [ "$R_unborn" -eq 0 ] && [ -n "$R_branch" ]; then
        IFS=$US read -r R_up_ref R_up_remote R_up_rref R_push_ref R_push_remote <<EOF
$(g for-each-ref --format='%(upstream)%1f%(upstream:remotename)%1f%(upstream:remoteref)%1f%(push)%1f%(push:remotename)' "refs/heads/$R_branch" 2>/dev/null)
EOF
    fi

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
            /*) path=$line ;;
            *)  path="$REPO/$line" ;;
        esac
        [ -e "$path" ] || continue
        case "$line" in
            *rebase-merge|*rebase-apply) R_operation="a rebase" ;;
            *MERGE_HEAD)                 R_operation="a merge" ;;
            *CHERRY_PICK_HEAD)           R_operation="a cherry-pick" ;;
            *REVERT_HEAD)                R_operation="a revert" ;;
            *BISECT_LOG)                 R_operation="a bisection" ;;
            *index.lock)                 R_busy=1 ;;
        esac
    done <<EOF
$(g rev-parse --git-path rebase-merge --git-path rebase-apply --git-path MERGE_HEAD \
    --git-path CHERRY_PICK_HEAD --git-path REVERT_HEAD --git-path BISECT_LOG --git-path index.lock 2>/dev/null)
EOF

    while IFS= read -r line; do
        [ -n "$line" ] && R_remotes=$(( R_remotes + 1 ))
    done <<EOF
$(g remote 2>/dev/null)
EOF
    return 0
}

repo_settings() {
    # The settings of this repository that steer the tool: its own
    # gh-batch.* keys and a few git keys that decide how to talk to it.
    # git names the scope of each value, which tells a choice made inside
    # the repository from the general one.
    local line scope key val
    R_skip=0; R_pullonly=0; R_sshcmd=""; R_sshvariant=""; R_lowspeed=0; R_gpgsign=0
    R_commit_eff=""; R_commit_local=""; R_autosetup=0; R_pushdefault=""; R_icase=0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        scope=${line%%"$TAB"*}
        line=${line#*"$TAB"}
        key=${line%% *}
        val=""
        case "$line" in *" "*) val=${line#* } ;; esac
        case "$key" in
            gh-batch.skip)      if truthy "$val"; then R_skip=1; else R_skip=0; fi ;;
            gh-batch.pullonly)  if truthy "$val"; then R_pullonly=1; else R_pullonly=0; fi ;;
            gh-batch.commit)
                if truthy "$val"; then R_commit_eff=1; else R_commit_eff=0; fi
                case "$scope" in
                    local|worktree) R_commit_local=$R_commit_eff ;;
                esac
                ;;
            core.sshcommand)    R_sshcmd=$val ;;
            ssh.variant)        R_sshvariant=$val ;;
            http.lowspeedlimit|http.lowspeedtime) R_lowspeed=1 ;;
            commit.gpgsign)     if truthy "$val"; then R_gpgsign=1; else R_gpgsign=0; fi ;;
            push.autosetupremote) if truthy "$val"; then R_autosetup=1; else R_autosetup=0; fi ;;
            push.default)       R_pushdefault=$val ;;
            core.ignorecase)    if truthy "$val"; then R_icase=1; else R_icase=0; fi ;;
        esac
    done <<EOF
$(g config --show-scope --get-regexp '^(gh-batch\.|core\.sshcommand$|ssh\.variant$|http\.lowspeed|commit\.gpgsign$|push\.autosetupremote$|push\.default$|core\.ignorecase$)' 2>/dev/null)
EOF
    return 0
}

repo_begin() {
    # Inspect $REPO and settle the cases every command treats alike.
    # Returns 1 when the repository is settled and nothing more is to do.
    GIT=(git -C "$REPO" -c credential.interactive=false -c submodule.recurse=false)
    if ! inspect; then
        if [ -n "$R_problem" ]; then
            emit unreadable 1 "git cannot read it: $R_problem"
        else
            emit ignored 0 ""
        fi
        return 1
    fi
    repo_settings
    if [ "$R_skip" -eq 1 ]; then
        emit skipped 0 "set aside by gh-batch.skip"
        return 1
    fi
    if [ "$R_worktree" -eq 1 ]; then
        emit skipped 0 "a linked worktree: its main repository is the one to handle"
        return 1
    fi
    return 0
}

net_setup() {
    # How git talks to the server of this repository: stalled transfers are
    # dropped, and ssh never stops to ask.
    NETCFG=()
    if [ "$R_lowspeed" -eq 0 ]; then
        NETCFG=(-c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30)
    fi
    if [ "$USER_SSH" -eq 0 ]; then
        unset GIT_SSH_COMMAND
        case "$R_sshvariant" in
            ""|ssh|auto)
                export GIT_SSH_COMMAND="${R_sshcmd:-ssh} -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
                ;;
        esac
    fi
    return 0
}

snapshot() {
    # What must be identical before and after when a repository is said to
    # be untouched: the commit, the branch, every pending change.
    g rev-parse -q --verify HEAD 2>/dev/null
    g symbolic-ref -q HEAD 2>/dev/null
    g status --porcelain=v1 --untracked-files=all 2>/dev/null
    return 0
}

mark_inflight() {
    [ -n "$STATE_DIR" ] && [ -d "$STATE_DIR" ] || return 0
    printf '%s\n' "$REPO" > "$STATE_DIR/inflight.$$.$IDX" 2>/dev/null
    return 0
}

unmark_inflight() {
    [ -n "$STATE_DIR" ] && rm -f "$STATE_DIR/inflight.$$.$IDX"
    return 0
}

note_inflight() {
    # note_inflight TEXT: one more line for the marker of the update in
    # progress, which a later run prints if this one is cut short.
    [ -n "$STATE_DIR" ] && [ -f "$STATE_DIR/inflight.$$.$IDX" ] || return 0
    printf '%s\n' "$(one_line "$1")" >> "$STATE_DIR/inflight.$$.$IDX" 2>/dev/null
    return 0
}

uses_lfs() {
    local path
    path=$(g rev-parse --git-path lfs 2>/dev/null) || return 1
    case "$path" in
        /*) ;;
        *)  path="$REPO/$path" ;;
    esac
    [ -d "$path" ]
}

# ---------------------------------------------------------------------------
# Bringing one repository level with its server
# ---------------------------------------------------------------------------

net_failure() {
    # net_failure STATUS -> the words for a network step that did not succeed
    case "$1" in
        124) printf 'no answer from the server within %s s' "$TIMEOUT" ;;
        125) printf 'the server asked for a password or a passphrase' ;;
        *)   last_line "$ERR" ;;
    esac
}

fetch_upstream() {
    # Fetch the remote that the branch follows. Returns 0 when the branch is
    # still on the server, 1 on a failure (F_msg), 2 when the run was
    # stopped, 3 when the branch left the server.
    local rc before after line found=0 args=(fetch --no-progress)
    F_msg=""
    before=$(g rev-parse -q --verify "$R_up_ref" 2>/dev/null)
    [ "$FETCH_PORCELAIN" -eq 1 ] && args+=(--porcelain --verbose)
    run_net fetch "${GIT[@]}" ${NETCFG[@]+"${NETCFG[@]}"} "${args[@]}" "$R_up_remote"
    rc=$?
    case "$rc" in
        0|1) ;;
        130) return 2 ;;
        *)   F_msg=$(net_failure "$rc"); return 1 ;;
    esac
    if [ "$FETCH_PORCELAIN" -eq 1 ]; then
        # Every reference of the server has its line; a branch without one is
        # gone, even though its last known position stays in this clone.
        while IFS= read -r line; do
            if [ "${line##* }" = "$R_up_ref" ] && [ "${line%% *}" != "-" ]; then
                found=1
                break
            fi
        done < "$OUT"
        if [ "$found" -eq 0 ] && [ "$rc" -ne 0 ]; then
            F_msg=$(last_line "$ERR")
            return 1
        fi
    else
        after=$(g rev-parse -q --verify "$R_up_ref" 2>/dev/null)
        [ "$after" != "$before" ] && found=1
    fi
    if [ "$found" -eq 0 ]; then
        # The fetch did not show the branch. The server is asked for it by
        # name before it is said to be gone: a remote set to fetch only
        # some branches does not list the others.
        run_net lsremote "${GIT[@]}" ${NETCFG[@]+"${NETCFG[@]}"} ls-remote --exit-code "$R_up_remote" "$R_up_rref"
        rc=$?
        case "$rc" in
            0)   ;;
            2)   return 3 ;;
            130) return 2 ;;
            *)   F_msg=$(net_failure "$rc"); return 1 ;;
        esac
    fi
    g rev-parse -q --verify "$R_up_ref^{commit}" >/dev/null 2>&1 || return 3
    return 0
}

incoming() {
    # incoming OLD NEW COUNT -> the first new commits, one per line, then
    # what was left out. The merge commits are counted, not listed, so that
    # the lines and the count of the report agree.
    local limit=5 line listed=0 merges rest
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        listed=$(( listed + 1 ))
        printf '%s\n' "$(clip "$line" 100)"
    done <<EOF
$(g log --no-merges --format='%h %s' -n "$limit" "$1..$2" 2>/dev/null)
EOF
    merges=$(g rev-list --merges --count "$1..$2" 2>/dev/null)
    is_uint "$merges" || merges=0
    rest=$(( $3 - merges - listed ))
    if [ "$rest" -gt 0 ] && [ "$merges" -gt 0 ]; then
        printf '... and %s more, and %s\n' "$rest" "$(plural "$merges" "merge commit")"
    elif [ "$rest" -gt 0 ]; then
        printf '... and %s more\n' "$rest"
    elif [ "$merges" -gt 0 ]; then
        printf '... and %s\n' "$(plural "$merges" "merge commit")"
    fi
    return 0
}

refused_files() {
    # The files git names when it refuses to overwrite them: its message
    # lists them one per line after a tab, whatever the language.
    local line list="" n=0
    [ -f "$ERR" ] || return 0
    while IFS= read -r line; do
        case "$line" in
            "$TAB"*)
                n=$(( n + 1 ))
                [ "$n" -le 5 ] && list="$list${list:+, }${line#"$TAB"}"
                ;;
        esac
    done < "$ERR"
    [ "$n" -gt 5 ] && list="$list and $(( n - 5 )) more"
    printf '%s' "$list"
}

lfs_prefetch() {
    # Large files are downloaded while the network step is still allowed to
    # fail, so that the checkout which follows needs no server.
    uses_lfs || return 0
    have git-lfs || return 0
    run_net lfs "${GIT[@]}" lfs fetch "$R_up_remote" "$R_up_ref"
}

written_back() {
    # written_back FILE -> the words for the files that FILE lists (deleted
    # here before the update, separated by NUL) and that the update wrote
    # back, or nothing.
    local path list="" n=0
    [ -s "$1" ] || return 0
    while IFS= read -r -d '' path; do
        if [ -e "$REPO/$path" ] || [ -L "$REPO/$path" ]; then
            n=$(( n + 1 ))
            [ "$n" -le 5 ] && list="$list${list:+, }$path"
        fi
    done < "$1"
    [ "$n" -gt 0 ] || return 0
    [ "$n" -gt 5 ] && list="$list and $(( n - 5 )) more"
    if [ "$n" -eq 1 ]; then
        printf 'a file deleted here and changed on the server came back: %s' "$list"
    else
        printf '%s files deleted here and changed on the server came back: %s' "$n" "$list"
    fi
}

clear_extras() {
    # What the steps below add to the report of an update, cleared for each
    # repository: a clause for the message (U_extra_msg), lines of detail
    # (U_extra), the words of the line "Kept aside" (U_kept), and their
    # working state.
    U_extra_msg=""; U_extra=""; U_kept=""
    K_dir=""; S_oid=""; S_note=""; B_ref=""; B_why=""; A_why=""; CF_words=""
    IW_n=0; IW_words=""; KEPT_n=0; KEPT_words=""; SP_n=0; SP_words=""
    OB_lines=""; OB_moves=""; OB_n=0
    : > "$W/inway"; : > "$W/aside"; : > "$W/kept"; : > "$W/copied"
    return 0
}

# ---------------------------------------------------------------------------
# What stands where the server puts a file, and where it is kept
# ---------------------------------------------------------------------------

untracked_here() {
    # untracked_here PATH -> 0 when git tracks nothing at PATH, nor below it.
    # The path is taken literally, and without regard to case on a system
    # that does not tell the cases apart.
    local magic="literal"
    [ "${R_icase:-0}" -eq 1 ] && magic="literal,icase"
    ! g ls-files --error-unmatch -- ":($magic)$1" >/dev/null 2>&1
}

files_in_way() {
    # files_in_way FROM TO: the paths that the commits from FROM to TO add
    # and that exist here as something git does not track (a file, a link
    # or a folder at the place of the new file, or a file or a link where a
    # folder must be made for it). Git would refuse to write over an
    # untracked file, and some of its commands silently write over an
    # ignored one. They go to $W/inway, separated by NUL; IW_n counts them
    # and IW_words names the first five. A link is never followed.
    local meta path lead rest part seen="$US"
    : > "$W/inway"; IW_n=0; IW_words=""
    while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
        case "$meta" in *" 160000 "*) continue ;; esac
        lead=""; rest=$path
        while [ -n "$rest" ]; do
            case "$rest" in
                */*) part=${rest%%/*}; rest=${rest#*/} ;;
                *)   part=$rest; rest="" ;;
            esac
            lead="${lead:+$lead/}$part"
            if [ -L "$REPO/$lead" ] || { [ -e "$REPO/$lead" ] && { [ -z "$rest" ] || [ ! -d "$REPO/$lead" ]; }; }; then
                case "$seen" in
                    *"$US$lead$US"*) ;;
                    *)
                        if untracked_here "$lead"; then
                            seen="$seen$lead$US"
                            printf '%s\0' "$lead" >> "$W/inway"
                            IW_n=$(( IW_n + 1 ))
                            [ "$IW_n" -le 5 ] && IW_words="$IW_words${IW_words:+, }$lead"
                        fi
                        ;;
                esac
                break
            fi
            [ -d "$REPO/$lead" ] || break
        done
    done < <(g diff --raw -z --no-abbrev --no-renames --no-color --no-ext-diff --diff-filter=A "$1" "$2" 2>/dev/null)
    [ "$IW_n" -gt 5 ] && IW_words="$IW_words and $(( IW_n - 5 )) more"
    return 0
}

kept_folder() {
    # The folder of this run that receives what is kept aside: inside the
    # git folder of the repository, where nothing is ever committed, and
    # created once per repository and run. Sets K_dir; returns 1, with
    # A_why, when it cannot be made.
    local gitdir base n=1
    [ -n "$K_dir" ] && [ -d "$K_dir" ] && return 0
    gitdir=$(g rev-parse --absolute-git-dir 2>/dev/null)
    if [ -z "$gitdir" ] || [ ! -d "$gitdir" ]; then
        A_why="the git folder of the repository could not be found"
        return 1
    fi
    base="$gitdir/gh-batch/kept"
    if ! mkdir -p "$base" 2>/dev/null; then
        A_why="the folder $(short_path "$base") could not be made"
        return 1
    fi
    K_dir="$base/$RUN_STAMP"
    while ! mkdir "$K_dir" 2>/dev/null; do
        n=$(( n + 1 ))
        if [ "$n" -gt 9 ]; then
            K_dir=""
            A_why="no folder could be made in $(short_path "$base")"
            return 1
        fi
        K_dir="$base/$RUN_STAMP-$n"
    done
    note_inflight "what it set aside is in $(short_path "$K_dir")"
    return 0
}

kept_label() {
    # How a report names the kept folder: from the top of the repository
    # when it lies inside, else from the home folder.
    case "$K_dir" in
        "$REPO"/*) printf '%s' "${K_dir#"$REPO"/}" ;;
        *)         short_path "$K_dir" ;;
    esac
}

prune_kept() {
    # The empty folders of the kept folder go, and the kept folder itself
    # when nothing is left in it.
    local kept
    [ -n "$K_dir" ] && [ -d "$K_dir" ] || return 0
    find "$K_dir" -depth -type d -empty -exec rmdir {} \; 2>/dev/null
    if [ ! -d "$K_dir" ]; then
        kept=${K_dir%/*}
        rmdir "$kept" "${kept%/*}" 2>/dev/null
        K_dir=""
    fi
    return 0
}

same_entry() {
    # same_entry A B -> 0 when A and B are two links to the same place, or
    # two regular files with the same bytes.
    if [ -L "$1" ] || [ -L "$2" ]; then
        [ -L "$1" ] && [ -L "$2" ] && [ "$(readlink "$1")" = "$(readlink "$2")" ]
        return
    fi
    [ -f "$1" ] && [ -f "$2" ] && cmp -s -- "$1" "$2"
}

set_aside() {
    # Every path of $W/inway is moved, by a rename, into the kept folder;
    # $W/aside lists the paths moved. Returns 1, with A_why, when one cannot
    # be moved, after the others went back.
    local path dest
    : > "$W/aside"
    [ "$IW_n" -gt 0 ] || return 0
    kept_folder || return 1
    while IFS= read -r -d '' path; do
        dest="$K_dir/$path"
        case "$path" in
            */*) mkdir -p "$K_dir/${path%/*}" 2>/dev/null ;;
        esac
        if [ -e "$dest" ] || [ -L "$dest" ] || ! mv -- "$REPO/$path" "$dest" 2>/dev/null; then
            A_why="$path could not be moved aside"
            put_back
            return 1
        fi
        printf '%s\0' "$path" >> "$W/aside"
    done < "$W/inway"
    return 0
}

put_back() {
    # Every path of $W/aside goes back to its place when the place is free;
    # $W/aside keeps those that could not.
    local path
    if [ -s "$W/aside" ]; then
        : > "$W/aside.left"
        while IFS= read -r -d '' path; do
            if [ ! -e "$REPO/$path" ] && [ ! -L "$REPO/$path" ]; then
                case "$path" in
                    */*) mkdir -p "$REPO/${path%/*}" 2>/dev/null ;;
                esac
                mv -- "$K_dir/$path" "$REPO/$path" 2>/dev/null && continue
            fi
            printf '%s\0' "$path" >> "$W/aside.left"
        done < "$W/aside"
        mv -f "$W/aside.left" "$W/aside"
    fi
    prune_kept
    return 0
}

settle_aside() {
    # After an update that went through: a path whose place stayed free goes
    # back there; a copy identical to what git wrote is removed; the others
    # stay kept, listed in $W/kept, counted in KEPT_n, named in KEPT_words.
    local path
    KEPT_n=0; KEPT_words=""
    : > "$W/kept"
    if [ -s "$W/aside" ]; then
        while IFS= read -r -d '' path; do
            if [ ! -e "$REPO/$path" ] && [ ! -L "$REPO/$path" ]; then
                case "$path" in
                    */*) mkdir -p "$REPO/${path%/*}" 2>/dev/null ;;
                esac
                mv -- "$K_dir/$path" "$REPO/$path" 2>/dev/null && continue
            elif same_entry "$K_dir/$path" "$REPO/$path"; then
                rm -f -- "$K_dir/$path" 2>/dev/null && continue
            fi
            printf '%s\0' "$path" >> "$W/kept"
            KEPT_n=$(( KEPT_n + 1 ))
            [ "$KEPT_n" -le 5 ] && KEPT_words="$KEPT_words${KEPT_words:+, }$path"
        done < "$W/aside"
        : > "$W/aside"
    fi
    [ "$KEPT_n" -gt 5 ] && KEPT_words="$KEPT_words and $(( KEPT_n - 5 )) more"
    prune_kept
    return 0
}

kept_report() {
    # The clause and the lines of detail for the files that made way for
    # those of the server and stay kept.
    local label path n=0 lines=""
    [ "$KEPT_n" -gt 0 ] || return 0
    label=$(kept_label)
    if [ "$KEPT_n" -eq 1 ]; then
        U_extra_msg="$U_extra_msg; $KEPT_words, which git did not track here, made way for the version of the server: this machine's copy is kept in $label"
        U_kept="$U_kept${U_kept:+, }$KEPT_words"
    else
        U_extra_msg="$U_extra_msg; $KEPT_n files that git did not track here made way for those of the server ($KEPT_words): this machine's copies are kept in $label"
        U_kept="$U_kept${U_kept:+, }$KEPT_n files"
    fi
    while IFS= read -r -d '' path; do
        { [ -f "$K_dir/$path" ] && [ ! -L "$K_dir/$path" ]; } || continue
        n=$(( n + 1 ))
        [ "$n" -le 3 ] || break
        lines="$lines${lines:+$NL}to compare: git -C $(shell_path "$REPO") diff --no-index -- $(shell_word "$label/$path") $(shell_word "$path")"
    done < "$W/kept"
    lines="$lines${lines:+$NL}to take $( [ "$KEPT_n" -eq 1 ] && printf 'it' || printf 'them' ) back: cp -Rp $(shell_path "$K_dir")/. $(shell_path "$REPO")"
    U_extra="$U_extra${U_extra:+$NL}$lines"
    return 0
}

refused_words() {
    # What git named when it refused to overwrite, sorted into the changes
    # of tracked files and the files it does not track: "your uncommitted
    # changes in a, b" or "x, which git does not track here".
    local list mine="" theirs="" line
    list=$(refused_files)
    [ -n "$list" ] || return 0
    while IFS= read -r line; do
        case "$line" in
            "$TAB"*)
                line=${line#"$TAB"}
                if untracked_here "$line"; then
                    theirs="$theirs${theirs:+, }$line"
                else
                    mine="$mine${mine:+, }$line"
                fi
                ;;
        esac
    done < "$ERR"
    if [ -n "$mine" ] && [ -n "$theirs" ]; then
        printf 'your uncommitted changes in %s, and %s, which git does not track here' "$mine" "$theirs"
    elif [ -n "$mine" ]; then
        printf 'your uncommitted changes in %s' "$mine"
    elif [ -n "$theirs" ]; then
        printf '%s, which git does not track here' "$theirs"
    else
        printf '%s' "$list"
    fi
}

# ---------------------------------------------------------------------------
# Uncommitted changes carried over an update in a stash of the tool's own
# ---------------------------------------------------------------------------

carry_ok() {
    # 0 when the uncommitted changes to tracked files can travel in a stash:
    # git can tell beforehand whether they still apply (2.40 or newer), and
    # none of them is of a kind that a stash refuses or loses (a submodule,
    # a file added with --intent-to-add, a file that git stopped tracking
    # while it stays on the disk).
    local record path
    [ "$MT_BASE" -eq 1 ] || return 1
    while IFS= read -r -d '' record; do
        case "$record" in
            "1 "??" S"*|"2 "??" S"*) return 1 ;;
            "1 .A "*) return 1 ;;
            "1 D"?" "*)
                path=${record#* * * * * * * * }
                if [ -e "$REPO/$path" ] || [ -L "$REPO/$path" ]; then
                    return 1
                fi
                ;;
        esac
    done < <(g status --porcelain=v2 -z --untracked-files=no --no-renames 2>/dev/null)
    return 0
}

stash_fits() {
    # stash_fits STASH COMMIT -> 0 when the changes kept in STASH apply on
    # top of COMMIT without touching the lines that COMMIT changed. Else
    # CF_words names the files where they clash.
    local rc name n=0 first=1
    CF_words=""
    g merge-tree --write-tree --name-only --no-messages -z --merge-base="$1^1" "$2" "$1" > "$W/fits" 2>/dev/null
    rc=$?
    [ "$rc" -eq 0 ] && return 0
    while IFS= read -r -d '' name; do
        if [ "$first" -eq 1 ]; then
            first=0
            continue
        fi
        [ -n "$name" ] || continue
        n=$(( n + 1 ))
        [ "$n" -le 3 ] && CF_words="$CF_words${CF_words:+, }$name"
    done < "$W/fits"
    [ "$n" -gt 3 ] && CF_words="$CF_words and $(( n - 3 )) more"
    [ -n "$CF_words" ] || CF_words="the files they change"
    return 1
}

stash_away() {
    # stash_away WHAT: the uncommitted changes to tracked files go into a
    # stash of the tool's own, named after the run, so that WHAT finds a
    # clean working tree; untracked files stay where they are. Sets S_oid;
    # returns 1 when that could not be done.
    local prev now
    S_oid=""
    prev=$(g rev-parse -q --verify refs/stash 2>/dev/null)
    run_local stash "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false \
        stash push --quiet --message "gh-batch $RUN_STAMP: uncommitted changes of $R_branch, before the $1"
    now=$(g rev-parse -q --verify refs/stash 2>/dev/null)
    if [ -z "$now" ] || [ "$now" = "$prev" ]; then
        return 1
    fi
    S_oid=$now
    if [ "$(g rev-parse -q --verify "$S_oid^1" 2>/dev/null)" != "$U_head" ] ||
        [ -n "$(g status --porcelain --untracked-files=no 2>/dev/null)" ]; then
        stash_back
        S_oid=""
        return 1
    fi
    note_inflight "uncommitted changes of $R_branch wait in its stash: git -C $(shell_path "$REPO") stash list"
    return 0
}

stash_gone() {
    # 0 when the tool's own stash has left the top of the list, applied.
    [ "$(g rev-parse -q --verify refs/stash 2>/dev/null)" != "$S_oid" ] || return 1
    S_oid=""
    return 0
}

stash_back() {
    # Put the tool's own stash back into the working tree. Returns 0 when
    # it was applied and is gone (S_note says when the staging could not
    # follow), 1 when it stays and nothing changed, 2 when it stays and a
    # part of it is in the working tree. Only that stash is ever applied,
    # and only while it is on top of the list.
    S_note=""
    [ -n "$S_oid" ] || return 0
    [ "$(g rev-parse -q --verify refs/stash 2>/dev/null)" = "$S_oid" ] || return 1
    run_local pop "${GIT[@]}" stash pop --quiet --index
    stash_gone && return 0
    if [ -z "$(conflict_files)" ] && [ -z "$(g status --porcelain --untracked-files=no 2>/dev/null)" ]; then
        # The staging needs the exact lines around each change, which the
        # new commits may have moved: the changes go back unstaged.
        run_local pop "${GIT[@]}" -c stash.index=false stash pop --quiet
        if stash_gone; then
            S_note="no longer staged"
            return 0
        fi
    fi
    if [ -n "$(conflict_files)" ]; then
        run_local undo "${GIT[@]}" reset --quiet --merge
    fi
    [ -z "$(g status --porcelain --untracked-files=no 2>/dev/null)" ] && return 1
    return 2
}

common_files() {
    # common_files A1 B1 A2 B2 -> the files changed both from A1 to B1 and
    # from A2 to B2, the first three named.
    local name list="" n=0 other
    other="$US$(g diff --name-only --no-renames "$3" "$4" 2>/dev/null | tr '\n' "$US")"
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        case "$other" in
            *"$US$name$US"*)
                n=$(( n + 1 ))
                [ "$n" -le 3 ] && list="$list${list:+, }$name"
                ;;
        esac
    done <<EOF
$(g diff --name-only --no-renames "$1" "$2" 2>/dev/null)
EOF
    [ "$n" -gt 3 ] && list="$list and $(( n - 3 )) more"
    printf '%s' "$list"
}

stash_report() {
    # stash_report RESULT [FILES]: the words for uncommitted changes that
    # travelled in the stash (RESULT 0) or that wait there (1 or 2).
    case "$1" in
        0)
            if [ -n "${2:-}" ]; then
                U_carry="your uncommitted changes were kept, merged with the new version of $2"
            else
                U_carry="your uncommitted changes were kept"
            fi
            [ -n "$S_note" ] && U_carry="$U_carry, $S_note"
            ;;
        *)
            U_attn=1
            if [ -n "$CF_words" ]; then
                U_extra_msg="$U_extra_msg; your uncommitted changes touch the same lines as the new commits, in $CF_words: the server's version is in place, and they wait in the stash"
            else
                U_extra_msg="$U_extra_msg; your uncommitted changes could not be put back: they wait in the stash"
            fi
            [ "$1" = 2 ] && U_extra_msg="$U_extra_msg, a part of them back in the files"
            U_extra="$U_extra${U_extra:+$NL}to bring them back: git -C $(shell_path "$REPO") stash pop"
            U_kept="$U_kept${U_kept:+, }uncommitted changes, in the stash"
            ;;
    esac
    return 0
}

undo_move() {
    # The branch and its files go back to the commit of before, after an
    # update that went through but must not stay.
    run_local back "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false \
        checkout --quiet --no-track --no-overwrite-ignore -B "$R_branch" "$U_head"
    [ "$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)" = "$U_head" ]
}

# ---------------------------------------------------------------------------
# The update itself
# ---------------------------------------------------------------------------

ff_once() {
    run_local ff "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false -c merge.autoStash=false \
        merge --ff-only --no-squash --no-overwrite-ignore --no-stat --quiet "$U_up"
}

fast_forward() {
    # The branch is strictly behind: move it forward. Pending changes that
    # the new commits do not touch stay. What git does not track and stands
    # where the server puts a file makes way for it, kept in the git folder
    # of the repository. Uncommitted changes that the new commits touch
    # travel in a stash of the tool's own when they still apply on top of
    # them; when they clash the repository is blocked, or, with
    # gh-batch.conflicts server, the server's version is taken and the
    # changes wait in the stash. A file deleted here without a commit is the
    # exception git makes: it does not count a missing file as a change it
    # would overwrite, and writes the new version of a file that the new
    # commits change. The report names such files.
    local before after now rc files pending back mid s0 carry=0 left="" both=""
    U_carry=""
    if ! lfs_prefetch; then
        U_state="failed"; U_attn=1
        U_msg="the large files of the new commits could not be downloaded: $(net_failure "$?")"
        return 0
    fi
    if stopped; then
        U_state="interrupted"; U_attn=1; U_msg="stopped before the update: nothing was changed"
        return 0
    fi
    pending=$(( R_tracked + R_untracked ))
    : > "$W/deleted"
    if [ "$R_tracked" -gt 0 ]; then
        g diff --no-color --name-only --diff-filter=D -z > "$W/deleted" 2>/dev/null
    fi
    files_in_way "$U_head" "$U_up"
    before=$(snapshot)
    mark_inflight
    if ! set_aside; then
        unmark_inflight
        U_state="blocked"; U_attn=1
        U_msg="$(plural "$U_behind" "new commit") on the server would write over what git does not track here, and $A_why: nothing was changed"
        return 0
    fi
    mid=$(snapshot)
    ff_once
    rc=$?
    now=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
    # Uncommitted changes in the way: they travel in a stash when git tells
    # beforehand that they apply on top of the new commits.
    if [ "$rc" -ne 0 ] && [ "$now" = "$U_head" ] && [ "$R_tracked" -gt 0 ] &&
        [ "$(snapshot)" = "$mid" ] && carry_ok; then
        s0=$(g stash create 2>/dev/null)
        if [ -n "$s0" ]; then
            if stash_fits "$s0" "$U_up"; then
                carry=1
            elif [ "$CONFLICTS" = "server" ]; then
                carry=2
            else
                put_back
                unmark_inflight
                U_state="blocked"; U_attn=1
                U_msg="$(plural "$U_behind" "new commit") on the server and your uncommitted changes touch the same lines, in $CF_words: nothing was changed"
                return 0
            fi
            if stash_away "fast-forward"; then
                both=$(common_files "$S_oid^1" "$S_oid" "$U_head" "$U_up")
                if [ "$carry" -eq 1 ] && ! stash_fits "$S_oid" "$U_up"; then
                    if [ "$CONFLICTS" = "server" ]; then
                        carry=2
                    else
                        stash_back
                        carry=0
                    fi
                fi
                if [ "$carry" -gt 0 ]; then
                    ff_once
                    rc=$?
                    now=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
                fi
            else
                carry=0
            fi
        fi
    fi
    if [ "$rc" -eq 0 ] && [ "$now" = "$U_up" ]; then
        if [ "$carry" -eq 1 ]; then
            stash_back
            left=$?
            [ "$left" -eq 0 ] && left=""
            [ -n "$left" ] && CF_words=""
        elif [ "$carry" -eq 2 ]; then
            left=1
        fi
        settle_aside
        unmark_inflight
        U_state="updated"
        U_msg="$(plural "$U_behind" "new commit")"
        back=$(written_back "$W/deleted")
        if [ "$carry" -eq 1 ] && [ -z "$left" ]; then
            stash_report 0 "$both"
            U_msg="$U_msg ($U_carry)"
        elif [ -z "$left" ] && [ "$pending" -gt 0 ]; then
            inspect
            if [ $(( R_tracked + R_untracked )) -gt 0 ] && [ -n "$back" ]; then
                U_msg="$U_msg (your other pending changes were kept)"
            elif [ $(( R_tracked + R_untracked )) -gt 0 ]; then
                U_msg="$U_msg (your pending changes were kept)"
            fi
        fi
        [ -n "$back" ] && U_msg="$U_msg; $back"
        kept_report
        [ -n "$left" ] && stash_report "$left"
        U_msg="$U_msg$U_extra_msg"
        U_details=$(incoming "$U_head" "$U_up" "$U_behind")
        U_move="fast-forward$US$U_head$US$U_up"
        return 0
    fi
    # The update did not go through: everything goes back, then the
    # repository is compared with what it was.
    [ -n "$S_oid" ] && stash_back
    put_back
    unmark_inflight
    after=$(snapshot)
    if [ "$after" = "$before" ] && [ ! -s "$W/aside" ]; then
        U_state="blocked"; U_attn=1
        ERR="$W/ff.err"
        files=$(refused_words)
        if [ -n "$files" ]; then
            U_msg="$(plural "$U_behind" "new commit") on the server would write over $files: nothing was changed"
        else
            U_msg="$(plural "$U_behind" "new commit") on the server could not be taken, git refused the update ($(last_line "$W/ff.err")): nothing was changed"
        fi
    else
        U_state="halfupdated"; U_attn=1
        U_msg="the update stopped half-way from ${U_head:0:9} to ${U_up:0:9}: look at it with git status"
        [ -s "$W/aside" ] && U_msg="$U_msg; what was set aside is in $(short_path "$K_dir")"
    fi
    return 0
}

attempt() {
    # attempt KIND [server]: the rebase or the merge of the commits of the
    # server; with "server", the version of the server is taken in the
    # lines that both sides changed (in a rebase "ours" is the side of the
    # server, in a merge "theirs"). Sets AT_ok to 1 when it went through.
    local x=()
    if [ -n "${2:-}" ]; then
        if [ "$1" = "rebase" ]; then x=(-X ours); else x=(-X theirs); fi
    fi
    if [ "$1" = "rebase" ]; then
        run_local rebase "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false \
            -c rebase.autoStash=false -c rebase.updateRefs=false -c rebase.rebaseMerges=false \
            -c rebase.autoSquash=false -c rebase.backend=merge -c merge.directoryRenames=conflict \
            rebase --no-fork-point --quiet ${x[@]+"${x[@]}"} "$U_up"
    else
        run_local merge "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false -c merge.autoStash=false \
            merge --no-edit --no-squash --no-ff --no-overwrite-ignore --no-stat --quiet ${x[@]+"${x[@]}"} "$U_up"
    fi
    AT_rc=$?
    AT_now=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
    inspect
    AT_ok=0
    if [ "$AT_rc" -eq 0 ] && [ -z "$R_operation" ] && [ "$R_unmerged" -eq 0 ] && [ "$R_detached" -eq 0 ] &&
        g merge-base --is-ancestor "$U_up" "$AT_now" 2>/dev/null; then
        AT_ok=1
    fi
    return 0
}

abort_attempt() {
    # abort_attempt KIND: the rebase or the merge that stopped is undone.
    if [ -n "$R_operation" ]; then
        run_local abort "${GIT[@]}" "$1" --abort
    fi
    inspect
    return 0
}

clash_files() {
    # clash_files BASE: the files where both sides changed the same lines,
    # as a merge of the two ends sees them (git 2.38 or newer), to $W/clash,
    # and the files that both sides changed since BASE, to $W/both, each
    # separated by NUL. SP_words names the first ones of the first list, or
    # of the second when git cannot tell the first.
    local name n=0 first=1 theirs rc
    : > "$W/clash"; : > "$W/both"
    SP_n=0; SP_words=""
    if [ "$MT_WRITE" -eq 1 ]; then
        g merge-tree --write-tree --name-only --no-messages -z "$U_up" "$U_head" > "$W/mt" 2>/dev/null
        rc=$?
        if [ "$rc" -eq 1 ]; then
            while IFS= read -r -d '' name; do
                if [ "$first" -eq 1 ]; then
                    first=0
                    continue
                fi
                [ -n "$name" ] && printf '%s\0' "$name" >> "$W/clash"
            done < "$W/mt"
        fi
    fi
    theirs="$US$(g diff --name-only --no-renames "$1" "$U_up" 2>/dev/null | tr '\n' "$US")"
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        case "$theirs" in
            *"$US$name$US"*) printf '%s\0' "$name" >> "$W/both" ;;
        esac
    done <<EOF
$(g diff --name-only --no-renames "$1" "$U_head" 2>/dev/null)
EOF
    while IFS= read -r -d '' name; do
        n=$(( n + 1 ))
        [ "$n" -le 5 ] && SP_words="$SP_words${SP_words:+, }$name"
    done < <(if [ -s "$W/clash" ]; then cat "$W/clash"; else cat "$W/both"; fi)
    [ "$n" -gt 5 ] && SP_words="$SP_words and $(( n - 5 )) more"
    SP_n=$n
    return 0
}

server_first() {
    # server_first BASE: before the replay is made again with the version
    # of the server first, the commit of the branch is kept under
    # refs/gh-batch/before-pull, and this machine's version of each file
    # that both sides changed is copied into the kept folder (the working
    # tree is then the one of the commit). Returns 1 when either cannot be
    # done, with nothing left behind.
    local name
    keep_backup before-pull || return 1
    clash_files "$1"
    if ! kept_folder; then
        drop_backup
        return 1
    fi
    : > "$W/copied"
    while IFS= read -r -d '' name; do
        [ -e "$REPO/$name" ] || [ -L "$REPO/$name" ] || continue
        [ -e "$K_dir/$name" ] || [ -L "$K_dir/$name" ] && continue
        case "$name" in
            */*) mkdir -p "$K_dir/${name%/*}" 2>/dev/null ;;
        esac
        if ! cp -Rp -- "$REPO/$name" "$K_dir/$name" 2>/dev/null; then
            remove_copies
            drop_backup
            return 1
        fi
        printf '%s\0' "$name" >> "$W/copied"
    done < <(cat "$W/clash" "$W/both")
    return 0
}

remove_copies() {
    # The copies made by server_first go, when the replay did not stay.
    local name
    if [ -s "$W/copied" ]; then
        while IFS= read -r -d '' name; do
            rm -rf -- "${K_dir:?}/$name" 2>/dev/null
        done < "$W/copied"
        : > "$W/copied"
    fi
    prune_kept
    return 0
}

only_old_commits() {
    # 0 when every commit of the branch that the server lacks was once on
    # the server, as the positions of the remote branch recorded here (its
    # reflog) show: nothing of this machine is then at stake.
    local olds=() line n
    while IFS= read -r line; do
        [ -n "$line" ] && olds+=("$line")
    done <<EOF
$(g reflog show --format=%H "$R_up_ref" -- 2>/dev/null)
EOF
    [ "${#olds[@]}" -gt 0 ] || return 1
    n=$(g rev-list --count "$U_head" --not "$U_up" "${olds[@]}" 2>/dev/null)
    [ "$n" = "0" ]
}

move_to_server() {
    # The branch and its files are set to the commit of the server, as a
    # checkout sets them. What git does not track and stands in the way is
    # set aside first; uncommitted changes travel in a stash. A file that
    # only the commits left behind held leaves the working tree; the backup
    # reference keeps it. Sets U_state to "reset" when it went through.
    local before after now rc files carry=0 left=""
    U_carry=""
    if ! lfs_prefetch; then
        U_state="failed"; U_attn=1
        U_msg="the large files of the server could not be downloaded: $(net_failure "$?")"
        return 0
    fi
    if stopped; then
        U_state="interrupted"; U_attn=1; U_msg="stopped before the move: nothing was changed"
        return 0
    fi
    files_in_way "$U_head" "$U_up"
    before=$(snapshot)
    mark_inflight
    if ! set_aside; then
        unmark_inflight
        U_state="blocked"; U_attn=1
        U_msg="the move would write over what git does not track here, and $A_why: nothing was changed"
        return 0
    fi
    if [ "$R_tracked" -gt 0 ]; then
        if ! stash_away "move"; then
            put_back
            unmark_inflight
            U_state="blocked"; U_attn=1
            U_msg="your uncommitted changes could not be set aside in a stash: nothing was changed"
            return 0
        fi
        carry=1
    fi
    run_local reset "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false \
        checkout --quiet --no-track --no-overwrite-ignore -B "$R_branch" "$U_up"
    rc=$?
    now=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
    if [ "$rc" -eq 0 ] && [ "$now" = "$U_up" ] &&
        [ "$(g symbolic-ref -q HEAD 2>/dev/null)" = "refs/heads/$R_branch" ]; then
        if [ "$carry" -eq 1 ]; then
            if stash_fits "$S_oid" "$U_up"; then
                stash_back
                left=$?
                [ "$left" -eq 0 ] && left=""
            elif [ "$CONFLICTS" = "server" ]; then
                left=1
            else
                undo_move
                stash_back
                put_back
                unmark_inflight
                U_state="blocked"; U_attn=1
                U_msg="your uncommitted changes touch the same lines as the commits of the server, in $CF_words: nothing was changed"
                return 0
            fi
        fi
        settle_aside
        unmark_inflight
        U_state="reset"
        U_msg="dropped $(plural "$U_ahead" commit) that the server lacks"
        [ "$U_behind" -gt 0 ] && U_msg="$U_msg, took $(plural "$U_behind" "new one")"
        if [ "$carry" -eq 1 ] && [ -z "$left" ]; then
            stash_report 0
            U_msg="$U_msg ($U_carry)"
        fi
        kept_report
        [ -n "$left" ] && stash_report "$left"
        U_msg="$U_msg$U_extra_msg"
        U_move="reset$US$U_head$US$U_up"
        return 0
    fi
    [ -n "$S_oid" ] && stash_back
    put_back
    unmark_inflight
    after=$(snapshot)
    if [ "$after" = "$before" ] && [ ! -s "$W/aside" ]; then
        U_state="blocked"; U_attn=1
        ERR="$W/reset.err"
        files=$(refused_words)
        if [ -n "$files" ]; then
            U_msg="the move would write over $files: nothing was changed"
        else
            U_msg="git refused the move ($(last_line "$W/reset.err")): nothing was changed"
        fi
    else
        U_state="halfupdated"; U_attn=1
        U_msg="the move stopped half-way from ${U_head:0:9} to ${U_up:0:9}: look at it with git status"
        [ -s "$W/aside" ] && U_msg="$U_msg; what was set aside is in $(short_path "$K_dir")"
    fi
    return 0
}

follow_rewrite() {
    # The server rewrote its history, and every commit here that it lacks
    # was once on it: nothing of this machine is at stake, and the branch
    # takes the new history, its commit kept first under refs/gh-batch.
    local old
    if ! keep_backup before-pull; then
        U_state="diverged"; U_attn=1
        U_msg="the history of the server was rewritten, and the commit could not be kept under refs/gh-batch ($B_why): nothing was changed"
        return 0
    fi
    old=$(incoming "$U_up" "$U_head" "$U_ahead")
    move_to_server
    case "$U_state" in
        reset)
            U_msg="the history of the server was rewritten; this clone held only its old commits ($U_ahead), replaced by $(plural "$U_behind" "new one"); the commit before is kept as $B_ref${U_carry:+ ($U_carry)}$U_extra_msg"
            U_details=$old
            U_extra="$U_extra${U_extra:+$NL}$(restore_line)"
            U_kept="$U_kept${U_kept:+, }the $(plural "$U_ahead" "old commit") of the server, under refs/gh-batch"
            ;;
        halfupdated)
            U_msg="$U_msg; the commit before is kept as $B_ref"
            U_extra="$U_extra${U_extra:+$NL}$(restore_line)"
            ;;
        *)
            drop_backup
            ;;
    esac
    return 0
}

reconcile() {
    # Both sides have new commits. Following the setting, report, or replay
    # the local commits on top (rebase), or join the histories (merge). A
    # conflict is undone; with gh-batch.conflicts server the attempt is then
    # made again with the version of the server in the lines that both
    # sides changed, after the branch and this machine's version of those
    # files are kept. What git does not track and stands in the way is set
    # aside, and uncommitted changes travel in a stash.
    local reason="" count base fork before after now files kind both why="" sp=0 carry=0 left="" replayed text
    local name shown
    U_carry=""
    both="$(plural "$U_ahead" commit) here and $U_behind on the server"
    if [ "$DIVERGED" = "report" ]; then
        U_state="diverged"; U_attn=1
        U_msg="$both: left to you (git pull --rebase, or git pull --no-rebase)"
        return 0
    fi
    base=$(g merge-base "$U_head" "$U_up" 2>/dev/null)
    if [ "$R_tracked" -gt 0 ] && ! carry_ok; then
        reason="files with uncommitted changes are in the working tree"
    elif [ -z "$base" ]; then
        reason="the two histories have no common commit"
    elif server_rewrote && only_old_commits; then
        follow_rewrite
        return 0
    elif [ "$DIVERGED" = "rebase" ]; then
        count=$(g rev-list --merges --count "$U_up..$U_head" 2>/dev/null)
        fork=$(g merge-base --fork-point "$R_up_ref" "$U_head" 2>/dev/null)
        if [ "$R_shallow" -eq 1 ]; then
            reason="the clone is shallow"
        elif [ "${count:-0}" -gt 0 ]; then
            reason="there are merge commits among the local ones"
        elif [ "$R_gpgsign" -eq 1 ]; then
            reason="the commits are signed, and signing them again may ask for a passphrase"
        elif [ "$(g rev-list --count "$U_head" --not --remotes 2>/dev/null)" != "$U_ahead" ]; then
            reason="some of the local commits are already on a server"
        elif [ -n "$fork" ] && [ "$fork" != "$base" ]; then
            reason="the history on the server was rewritten"
        fi
    fi
    if [ -n "$reason" ]; then
        U_state="diverged"; U_attn=1
        U_msg="$both: not reconciled automatically, because $reason"
        return 0
    fi
    if ! lfs_prefetch; then
        U_state="failed"; U_attn=1
        U_msg="the large files of the new commits could not be downloaded: $(net_failure "$?")"
        return 0
    fi
    if stopped; then
        U_state="interrupted"; U_attn=1; U_msg="stopped before the update: nothing was changed"
        return 0
    fi

    kind=$DIVERGED
    files_in_way "$U_head" "$U_up"
    before=$(snapshot)
    mark_inflight
    if ! set_aside; then
        unmark_inflight
        U_state="blocked"; U_attn=1
        U_msg="$both: the $kind would write over what git does not track here, and $A_why: nothing was changed"
        return 0
    fi
    if [ "$R_tracked" -gt 0 ]; then
        if ! stash_away "$kind"; then
            put_back
            unmark_inflight
            U_state="diverged"; U_attn=1
            U_msg="$both: not reconciled automatically, because your uncommitted changes could not be set aside in a stash"
            return 0
        fi
        carry=1
    fi
    attempt "$kind"
    if [ "$AT_ok" -eq 0 ]; then
        files=$(conflict_files)
        abort_attempt "$kind"
        now=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
        if [ "$CONFLICTS" = "server" ] && [ -n "$files" ] && [ "$now" = "$U_head" ] && [ -z "$R_operation" ]; then
            if stopped; then
                why=", and the run was stopped before the version of the server was tried"
            elif server_first "$base"; then
                sp=1
                attempt "$kind" server
                if [ "$AT_ok" -eq 0 ]; then
                    files=$(conflict_files)
                    abort_attempt "$kind"
                    why=", even with the version of the server first"
                fi
            fi
        fi
    fi

    if [ "$AT_ok" -eq 1 ]; then
        now=$AT_now
        if [ "$carry" -eq 1 ]; then
            if stash_fits "$S_oid" "$now"; then
                stash_back
                left=$?
                [ "$left" -eq 0 ] && left=""
                [ -n "$left" ] && CF_words=""
            elif [ "$CONFLICTS" = "server" ]; then
                left=1
            else
                # The changes would clash with the result: the branch goes
                # back, and they with it.
                undo_move
                stash_back
                [ "$sp" -eq 1 ] && { remove_copies; drop_backup; }
                put_back
                unmark_inflight
                inspect
                U_state="diverged"; U_attn=1
                U_msg="$both: not reconciled automatically, because your uncommitted changes touch the same lines as the result, in $CF_words"
                if [ "$(snapshot)" != "$before" ] || [ -s "$W/aside" ]; then
                    U_state="halfupdated"
                    U_msg="the $kind could not be undone cleanly; the branch was at ${U_head:0:9}: look at it with git status"
                fi
                return 0
            fi
        fi
        settle_aside
        unmark_inflight
        replayed=$(g rev-list --count "$U_up..$now" 2>/dev/null)
        if [ "$kind" = "rebase" ]; then
            U_state="rebased"
            U_msg="your $(plural "$U_ahead" commit) replayed on top of $(plural "$U_behind" "new one")"
            if is_uint "$replayed" && [ "$replayed" -lt "$U_ahead" ]; then
                text="$(( U_ahead - replayed ))"
                if [ "$text" -eq 1 ]; then
                    U_msg="$U_msg (1 of them was left empty by the version of the server and dropped)"
                else
                    U_msg="$U_msg ($text of them were left empty by the version of the server and dropped)"
                fi
            fi
        else
            U_state="merged"
            U_msg="your $(plural "$U_ahead" commit) merged with $(plural "$U_behind" "new one")"
        fi
        if [ "$sp" -eq 1 ]; then
            prune_kept
            if [ -n "$SP_words" ] && [ -s "$W/clash" ]; then
                text="; the version of the server taken where both sides changed the same lines ($SP_words)"
            else
                text="; the version of the server taken where both sides changed the same lines, among $SP_words"
            fi
            if [ -s "$W/copied" ] && [ -n "$K_dir" ]; then
                text="$text: this machine's versions are kept in $(kept_label), the commit before as $B_ref"
                U_kept="$U_kept${U_kept:+, }this machine's version of $(plural "$SP_n" file) where the server won"
            else
                text="$text: the commit before is kept as $B_ref"
                U_kept="$U_kept${U_kept:+, }the commit before, where the server won"
            fi
            U_extra_msg="$text$U_extra_msg"
        fi
        if [ "$carry" -eq 1 ] && [ -z "$left" ]; then
            stash_report 0
            U_msg="$U_msg ($U_carry)"
        fi
        kept_report
        [ -n "$left" ] && stash_report "$left"
        U_msg="$U_msg$U_extra_msg"
        U_details=$(incoming "$U_head" "$U_up" "$U_behind")
        if [ "$sp" -eq 1 ]; then
            if [ -s "$W/copied" ] && [ -n "$K_dir" ]; then
                shown=0
                while IFS= read -r -d '' name; do
                    { [ -f "$K_dir/$name" ] && [ ! -L "$K_dir/$name" ]; } || continue
                    shown=$(( shown + 1 ))
                    [ "$shown" -le 3 ] || break
                    U_extra="$U_extra${U_extra:+$NL}to compare: git -C $(shell_path "$REPO") diff --no-index -- $(shell_word "$(kept_label)/$name") $(shell_word "$name")"
                done < "$W/copied"
            fi
            U_extra="$U_extra${U_extra:+$NL}$(restore_line)"
        fi
        U_move="$kind$US$U_head$US$now"
        return 0
    fi

    # The attempt did not go through: everything goes back, then the
    # repository is compared with what it was.
    [ "$carry" -eq 1 ] && stash_back
    if [ "$sp" -eq 1 ]; then
        remove_copies
        drop_backup
    fi
    put_back
    unmark_inflight
    inspect
    after=$(snapshot)
    if [ "$after" = "$before" ] && [ ! -s "$W/aside" ]; then
        if [ -n "$files" ]; then
            U_state="conflict"; U_attn=1
            U_msg="$both, and they conflict in $files$why: nothing was changed, the $kind is yours (git pull --$( [ "$kind" = rebase ] && printf 'rebase' || printf 'no-rebase' ))"
        else
            U_state="blocked"; U_attn=1
            ERR="$W/$kind.err"
            files=$(refused_words)
            if [ -n "$files" ]; then
                U_msg="$both: the $kind would write over $files, nothing was changed"
            else
                U_msg="$both: git refused the $kind ($(last_line "$W/$kind.err")), nothing was changed"
            fi
        fi
    else
        U_state="halfupdated"; U_attn=1
        U_msg="the $kind could not be undone cleanly; the branch was at ${U_head:0:9}: look at it with git status"
        [ -s "$W/aside" ] && U_msg="$U_msg; what was set aside is in $(short_path "$K_dir")"
    fi
    return 0
}

conflict_files() {
    local path list="" n=0
    while IFS= read -r -d '' path; do
        n=$(( n + 1 ))
        [ "$n" -le 5 ] && list="$list${list:+, }$path"
    done < <(g diff --name-only --diff-filter=U -z 2>/dev/null)
    [ "$n" -gt 5 ] && list="$list and $(( n - 5 )) more"
    printf '%s' "$list"
}

fetch_and_compare() {
    # The first half of the morning logic, which "reset" shares: the states
    # that leave a repository alone, the fetch, and the comparison of the
    # branch with the one it follows. Returns 0 with U_head, U_up, U_ahead
    # and U_behind set, or 1 when the repository is settled: U_state and
    # U_msg then say why.
    local rc counts
    U_state=""; U_attn=0; U_msg=""; U_details=""; U_move=""
    U_head=""; U_up=""; U_ahead=0; U_behind=0
    clear_extras

    if [ "$R_busy" -eq 1 ]; then
        sleep 1
        inspect
    fi
    if [ "$R_busy" -eq 1 ]; then
        U_state="busy"; U_attn=1
        U_msg="another git process holds its index (index.lock): try again later"
        return 1
    fi
    if [ -n "$R_operation" ]; then
        U_state="unfinished"; U_attn=1
        U_msg="$R_operation is in progress: finish or abort it first"
        return 1
    fi
    if [ "$R_unmerged" -gt 0 ]; then
        U_state="unfinished"; U_attn=1
        U_msg="$(plural "$R_unmerged" file) with unresolved conflicts"
        return 1
    fi
    if [ "$R_remotes" -eq 0 ]; then
        U_state="localonly"; U_msg="it has no remote: it exists on this machine only"
        return 1
    fi
    if [ "$R_detached" -eq 1 ]; then
        U_state="detached"; U_msg="HEAD is detached: there is no branch to bring forward"
        return 1
    fi
    if [ "$R_unborn" -eq 1 ]; then
        U_state="skipped"; U_msg="it has no commit yet"
        return 1
    fi
    if [ -z "$R_up_ref" ] || [ "$R_up_remote" = "." ] || [ -z "$R_up_remote" ]; then
        U_state="noupstream"; U_msg="the branch $R_branch follows no branch of a server"
        return 1
    fi

    net_setup
    fetch_upstream
    rc=$?
    case "$rc" in
        0) ;;
        2) U_state="interrupted"; U_attn=1; U_msg="stopped during the fetch"; return 1 ;;
        3) U_state="gone"; U_attn=1
           U_msg="the branch ${R_up_rref#refs/heads/} is no longer on $R_up_remote: choose what $R_branch should follow"
           return 1 ;;
        *) U_state="failed"; U_attn=1; U_msg="the fetch failed: $F_msg"; return 1 ;;
    esac
    U_head=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
    U_up=$(g rev-parse -q --verify "$R_up_ref^{commit}" 2>/dev/null)
    counts=$(g rev-list --left-right --count "$U_head...$U_up" 2>/dev/null)
    U_ahead=${counts%%"$TAB"*}
    U_behind=${counts##*"$TAB"}
    if ! is_uint "$U_ahead" || ! is_uint "$U_behind"; then
        U_state="failed"; U_attn=1; U_msg="the two histories could not be compared"
        return 1
    fi
    if stopped; then
        U_state="interrupted"; U_attn=1; U_msg="stopped after the fetch, before any change"
        return 1
    fi
    return 0
}

level_with_server() {
    # The whole morning logic for the repository already inspected: fetch,
    # compare, bring forward; then the other branches that only lack the
    # new commits of the server. Sets U_state, U_attn, U_msg, U_details,
    # U_move, and the extras of clear_extras.
    fetch_and_compare || return 0
    bring_level
    other_branches_forward
    if [ "$OB_n" -gt 0 ] || [ -n "$OB_lines" ]; then
        if [ "$U_state" = "uptodate" ]; then
            if [ "$ONLY_LOOK" -eq 1 ]; then
                U_state="behind"
            else
                U_state="updated"
            fi
            U_msg=${OB_lines%%"$NL"*}
            case "$OB_lines" in
                *"$NL"*) U_extra="${OB_lines#*"$NL"}${U_extra:+$NL$U_extra}" ;;
            esac
        else
            U_extra="$OB_lines${U_extra:+$NL$U_extra}"
        fi
    fi
    return 0
}

bring_level() {
    # The branch that is checked out, once fetched and compared.
    local text
    if [ "$U_behind" -eq 0 ]; then
        if [ "$U_ahead" -eq 0 ]; then
            U_state="uptodate"
        else
            U_state="ahead"; U_msg="$(plural "$U_ahead" commit) to push"
        fi
        return 0
    fi
    if [ "$ONLY_LOOK" -eq 1 ]; then
        # What pull would set aside is named; nothing is moved.
        files_in_way "$U_head" "$U_up"
        if [ "$IW_n" -eq 1 ]; then
            text="; $IW_words, which git does not track here, would make way for the version of the server and be kept"
        elif [ "$IW_n" -gt 1 ]; then
            text="; $IW_n files that git does not track here ($IW_words) would make way for those of the server and be kept"
        else
            text=""
        fi
        if [ "$U_ahead" -eq 0 ]; then
            U_state="behind"; U_msg="$(plural "$U_behind" "new commit") on the server: pull will bring them$text"
            U_details=$(incoming "$U_head" "$U_up" "$U_behind")
        else
            U_state="diverged"
            U_msg="$(plural "$U_ahead" commit) here and $U_behind on the server"
            if [ "$DIVERGED" = "report" ]; then
                U_attn=1; U_msg="$U_msg: pull will leave it to you"
            elif server_rewrote && only_old_commits; then
                U_msg="the history of the server was rewritten, and this clone holds only its old commits: pull will take the new history, the old one kept under refs/gh-batch"
            elif [ "$CONFLICTS" = "server" ]; then
                U_msg="$U_msg: pull will try a $DIVERGED, the version of the server taken where both sides changed the same lines$text"
            else
                U_msg="$U_msg: pull will try a $DIVERGED$text"
            fi
        fi
        return 0
    fi
    if [ "$U_ahead" -eq 0 ]; then
        fast_forward
    else
        reconcile
    fi
    return 0
}

other_branches_forward() {
    # The other local branches that follow the branch of the same name on
    # the remote just fetched, that no worktree has checked out, and that
    # only lack commits of the server, move forward without a file being
    # touched (pull only writes their reference, and only if it did not
    # move meanwhile). A branch that follows a branch of another name, as a
    # bookmark made from main does, is left where it is. Sets OB_lines (the
    # words), OB_moves (the journal) and OB_n; with ONLY_LOOK, only says
    # what pull would do.
    local name up remote rref wt old new n
    OB_lines=""; OB_moves=""; OB_n=0
    stopped && return 0
    # A push takes the commits of the server only for the branch it sends;
    # the other branches are the business of pull.
    [ "${IN_PUSH:-0}" -eq 1 ] && return 0
    while IFS=$US read -r name up remote rref wt; do
        [ -n "$name" ] && [ "$name" != "$R_branch" ] || continue
        [ -n "$up" ] && [ "$remote" = "$R_up_remote" ] && [ "$rref" = "refs/heads/$name" ] && [ -z "$wt" ] || continue
        old=$(g rev-parse -q --verify "refs/heads/$name^{commit}" 2>/dev/null)
        new=$(g rev-parse -q --verify "$up^{commit}" 2>/dev/null)
        [ -n "$old" ] && [ -n "$new" ] && [ "$old" != "$new" ] || continue
        g merge-base --is-ancestor "$old" "$new" 2>/dev/null || continue
        n=$(g rev-list --count "$old..$new" 2>/dev/null)
        is_uint "$n" || continue
        if [ "$ONLY_LOOK" -eq 1 ]; then
            OB_lines="$OB_lines${OB_lines:+$NL}the branch $name lacks $(plural "$n" "new commit") of the server: pull will move it forward"
        elif g update-ref -m "gh-batch pull: fast-forward" "refs/heads/$name" "$new" "$old" 2>/dev/null; then
            OB_n=$(( OB_n + 1 ))
            OB_lines="$OB_lines${OB_lines:+$NL}the branch $name also moved forward: $(plural "$n" "new commit")"
            OB_moves="$OB_moves${OB_moves:+$NL}fast-forward:$name$US$old$US$new"
        fi
    done <<EOF
$(g for-each-ref --format='%(refname:short)%1f%(upstream)%1f%(upstream:remotename)%1f%(upstream:remoteref)%1f%(worktreepath)' refs/heads 2>/dev/null)
EOF
    return 0
}

emit_update() {
    # Publish what level_with_server found.
    emit "$U_state" "$U_attn" "$U_msg"
    details "$U_details"
    details "$U_extra"
    emit_moves
    return 0
}

emit_moves() {
    # The journal lines of what moved, and what was kept aside.
    local line
    if [ -n "$U_move" ]; then
        printf 'J%s%s\n' "$US" "$U_move"
    fi
    while IFS= read -r line; do
        [ -n "$line" ] && printf 'J%s%s\n' "$US" "$line"
    done <<EOF
$OB_moves
EOF
    record_kept "$U_kept"
    return 0
}

do_pull() {
    repo_begin || return 0
    level_with_server
    emit_update
    if [ "$ONLY_LOOK" -eq 1 ] && [ -s "$TMP/forks.list" ] && ! stopped; then
        fork_gap "$(fork_parent "$(remote_slug "${R_up_remote:-origin}")")"
    fi
    return 0
}

# ---------------------------------------------------------------------------
# status: what is pending in each repository, without touching the network
# ---------------------------------------------------------------------------

oldest_change() {
    # oldest_change -> the age in seconds of the oldest pending file, or
    # nothing. The records of "status -z" end with a NUL and keep spaces.
    local record path files=() n=0 times oldest="" t
    [ -n "$STAT_STYLE" ] || return 0
    while IFS= read -r -d '' record; do
        case "$record" in
            "1 "*) path=${record#* * * * * * * * } ;;
            "u "*) path=${record#* * * * * * * * * * } ;;
            "? "*) path=${record#\? } ;;
            *)     continue ;;
        esac
        [ -e "$REPO/$path" ] || continue
        files+=("$REPO/$path")
        n=$(( n + 1 ))
        [ "$n" -ge 200 ] && break
    done < <(g status --porcelain=v2 -z --untracked-files=normal --no-renames 2>/dev/null)
    [ "$n" -gt 0 ] || return 0
    if [ "$STAT_STYLE" = "gnu" ]; then
        times=$(stat -c %Y -- "${files[@]}" 2>/dev/null)
    else
        times=$(stat -f %m -- "${files[@]}" 2>/dev/null)
    fi
    for t in $times; do
        is_uint "$t" || continue
        if [ -z "$oldest" ] || [ "$t" -lt "$oldest" ]; then
            oldest=$t
        fi
    done
    [ -n "$oldest" ] && [ "$NOW" -ge "$oldest" ] && printf '%s' $(( NOW - oldest ))
    return 0
}

change_word() {
    # change_word XY -> the word for a pending change, from the two letters
    # that "git status" gives it: new, deleted, changed, or conflict.
    case "$1" in
        "??")         printf 'new' ;;
        U?|?U|AA|DD)  printf 'conflict' ;;
        D?|?D)        printf 'deleted' ;;
        A?|?A)        printf 'new' ;;
        *)            printf 'changed' ;;
    esac
}

pending_files() {
    # pending_files LIMIT -> the pending files, one per line with the word
    # for its change: "changed  notes.txt"
    local limit="$1" record path flag n=0 more=0
    while IFS= read -r -d '' record; do
        case "$record" in
            "1 "*) flag=${record:2:2}; path=${record#* * * * * * * * } ;;
            "u "*) flag="UU"; path=${record#* * * * * * * * * * } ;;
            "? "*) flag="??"; path=${record#\? } ;;
            *)     continue ;;
        esac
        n=$(( n + 1 ))
        if [ "$n" -le "$limit" ]; then
            printf '%-8s %s\n' "$(change_word "$flag")" "$path"
        else
            more=$(( more + 1 ))
        fi
    done < <(g status --porcelain=v2 -z --untracked-files=all --no-renames 2>/dev/null)
    [ "$more" -gt 0 ] && printf '... and %s more\n' "$more"
    return 0
}

count_stashes() {
    local n=0 line
    g rev-parse -q --verify refs/stash >/dev/null 2>&1 || { printf '0'; return 0; }
    while IFS= read -r line; do
        [ -n "$line" ] && n=$(( n + 1 ))
    done <<EOF
$(g stash list 2>/dev/null)
EOF
    printf '%s' "$n"
}

describe_pending() {
    # "3 changed, 2 new" for the pending files of the repository inspected
    local text=""
    [ "$R_tracked" -gt 0 ] && text="$R_tracked changed"
    [ "$R_untracked" -gt 0 ] && text="$text${text:+, }$R_untracked new"
    printf '%s' "$text"
}

do_status() {
    local state="clean" attention=0 parts="" pending age stashes first
    repo_begin || return 0
    if [ -n "$R_operation" ]; then
        state="unfinished"; attention=1; parts="$R_operation is in progress"
    elif [ "$R_unmerged" -gt 0 ]; then
        state="unfinished"; attention=1; parts="$(plural "$R_unmerged" file) with unresolved conflicts"
    fi
    pending=$(describe_pending)
    if [ -n "$pending" ]; then
        [ "$state" = "clean" ] && state="pending"
        age=$(oldest_change)
        parts="$parts${parts:+; }$pending"
        [ -n "$age" ] && parts="$parts (the oldest since $(age_text "$age"))"
    fi
    if [ "$R_detached" -eq 1 ]; then
        [ "$state" = "clean" ] && state="detached"
        parts="$parts${parts:+; }HEAD is detached"
    elif [ "$R_unborn" -eq 1 ]; then
        parts="$parts${parts:+; }no commit yet"
    elif [ "$R_remotes" -eq 0 ]; then
        [ "$state" = "clean" ] && state="localonly"
        parts="$parts${parts:+; }no remote: it exists on this machine only"
    elif [ -z "$R_upstream" ]; then
        [ "$state" = "clean" ] && state="noupstream"
        parts="$parts${parts:+; }the branch follows no branch of a server"
    elif [ -z "$R_ahead" ]; then
        [ "$state" = "clean" ] && state="gone"
        attention=1
        parts="$parts${parts:+; }its branch $R_upstream is gone"
    else
        if [ "$R_ahead" -gt 0 ] && [ "$R_behind" -gt 0 ]; then
            [ "$state" = "clean" ] || [ "$state" = "pending" ] && state="diverged"
            parts="$parts${parts:+; }$(plural "$R_ahead" commit) here and $R_behind on the server"
        elif [ "$R_ahead" -gt 0 ]; then
            [ "$state" = "clean" ] && state="ahead"
            first=""
            IFS= read -r first < <(g log --format=%ct --reverse "$R_upstream..HEAD" 2>/dev/null)
            parts="$parts${parts:+; }$(plural "$R_ahead" commit) to push"
            if is_uint "$first" && [ "$NOW" -ge "$first" ]; then
                parts="$parts (the oldest since $(age_text $(( NOW - first ))))"
            fi
        elif [ "$R_behind" -gt 0 ]; then
            [ "$state" = "clean" ] && state="behind"
            parts="$parts${parts:+; }$(plural "$R_behind" commit) behind the last fetch"
        fi
    fi
    stashes=$(count_stashes)
    if [ "$stashes" -gt 0 ]; then
        [ "$state" = "clean" ] && state="stash"
        parts="$parts${parts:+; }$(plural "$stashes" stash)"
    fi
    emit "$state" "$attention" "$parts"
    if [ "$LONG" -eq 1 ] && [ $(( R_tracked + R_untracked + R_unmerged )) -gt 0 ]; then
        details "$(pending_files 20)"
    fi
    return 0
}

# ---------------------------------------------------------------------------
# GitHub: what the server knows about a repository
# ---------------------------------------------------------------------------

github_slug() {
    # github_slug ADDRESS -> "owner/name" in lower case when the address is
    # on GitHub, whatever its form (https, ssh, or user@host:path).
    local host lower rest owner name
    host=$(printf '%s' "${GH_HOST:-github.com}" | tr '[:upper:]' '[:lower:]')
    lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
        http://*|https://*|ssh://*|git://*|git+ssh://*)
            rest=${lower#*://}
            case "$rest" in
                *@*) rest=${rest#*@} ;;
            esac
            case "$rest" in
                "$host"/*) rest=${rest#"$host"/} ;;
                "$host":*) rest=${rest#"$host":}; rest=${rest#*/} ;;
                *)         return 0 ;;
            esac
            ;;
        *@"$host":*) rest=${lower#*@"$host":} ;;
        "$host":*)   rest=${lower#"$host":} ;;
        *)           return 0 ;;
    esac
    rest=${rest%/}
    rest=${rest%.git}
    rest=${rest%/}
    owner=${rest%%/*}
    name=${rest#*/}
    case "$name" in
        ""|*/*) return 0 ;;
    esac
    if [ -n "$owner" ] && [ "$owner" != "$rest" ]; then
        printf '%s/%s' "$owner" "$name"
    fi
    return 0
}

remote_slug() {
    # remote_slug REMOTE -> the GitHub name behind a remote of $REPO, from
    # its address as git expands it, then as the configuration writes it.
    local remote="$1" url slug
    url=$(g remote get-url --push "$remote" 2>/dev/null)
    slug=$(github_slug "$url")
    if [ -z "$slug" ]; then
        url=$(g config --get "remote.$remote.pushurl" 2>/dev/null) ||
            url=$(g config --get "remote.$remote.url" 2>/dev/null)
        slug=$(github_slug "$url")
    fi
    printf '%s' "$slug"
}

github_facts() {
    # github_facts SLUG: ask GitHub whether the repository is public, whether
    # this account may push to it, whether it is archived. Sets H_vis
    # (public, private or empty when unknown), H_push and H_archived.
    local private="" push="" archived=""
    H_vis=""; H_push=""; H_archived=""
    [ -n "$1" ] || return 0
    have gh || return 0
    spawn github env GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh api "repos/$1" \
        --jq '[(.private|tostring), (.permissions.push|tostring), (.archived|tostring)] | join("\u001f")'
    await net 20 || return 0
    IFS=$US read -r private push archived < "$OUT" || true
    case "$private" in
        true)  H_vis="private" ;;
        false) H_vis="public" ;;
    esac
    case "$push" in true|false) H_push=$push ;; esac
    case "$archived" in true|false) H_archived=$archived ;; esac
    return 0
}

# ---------------------------------------------------------------------------
# The automatic commit of the evening, and its guards
# ---------------------------------------------------------------------------

list_pending() {
    # Write the pending files of $REPO to $W/pending, one per line: the two
    # status letters, a tab, the path. Sets L_count, L_new (files that git
    # does not track yet) and L_odd (a name that cannot be written on a line).
    local record flag path
    L_count=0; L_new=0; L_odd=""
    while IFS= read -r -d '' record; do
        case "$record" in
            "1 "*) flag=${record:2:2}; path=${record#* * * * * * * * } ;;
            "u "*) flag="UU"; path=${record#* * * * * * * * * * } ;;
            "? "*) flag="??"; path=${record#\? } ;;
            *)     continue ;;
        esac
        case "$path" in
            *"$NL"*|*"$TAB"*) L_odd="a file name holds a tab or a line break"; continue ;;
        esac
        L_count=$(( L_count + 1 ))
        [ "$flag" = "??" ] && L_new=$(( L_new + 1 ))
        printf '%s\t%s\n' "$flag" "$path"
    done < <(g status --porcelain=v2 -z --untracked-files=all --no-renames 2>/dev/null) > "$W/pending"
    return 0
}

pending_words() {
    # pending_words LIMIT -> the first LIMIT files that list_pending wrote,
    # each with the word for its change: "new      abstract.tex"
    local limit="$1" flag path n=0
    while IFS=$TAB read -r flag path; do
        n=$(( n + 1 ))
        [ "$n" -le "$limit" ] || break
        printf '%-8s %s\n' "$(change_word "$flag")" "$path"
    done < "$W/pending"
    return 0
}

looks_secret() {
    # looks_secret NAME (in lower case) -> 0 when the name of the file is
    # one under which credentials are usually kept.
    case "$1" in
        .env.example|.env.sample|.env.template|.env.dist|*.pub) return 1 ;;
        .env|.env.*|*.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|*.kdbx|*.token) return 0 ;;
        id_rsa*|id_dsa*|id_ecdsa*|id_ed25519*) return 0 ;;
        .netrc|_netrc|.git-credentials|.pypirc|.htpasswd|auth.json) return 0 ;;
        credentials|credentials.*|secrets.*|secret.*) return 0 ;;
    esac
    return 1
}

big_in_batch() {
    # big_in_batch LIMIT FILE... -> prints the first file above LIMIT bytes
    local limit="$1" line size name
    shift
    while IFS= read -r line; do
        size=${line%% *}
        name=${line#* }
        if is_uint "$size" && [ "$size" -gt "$limit" ]; then
            printf '%s (%s MB)' "${name#"$REPO"/}" $(( size / 1048576 ))
            return 0
        fi
    done <<EOF
$(if [ "$STAT_STYLE" = "gnu" ]; then stat -c '%s %n' -- "$@" 2>/dev/null; else stat -f '%z %N' -- "$@" 2>/dev/null; fi)
EOF
    return 1
}

too_big() {
    # too_big -> the first pending file above the limit, with its size
    local path batch=() n=0 limit=$(( MAX_FILE_MB * 1048576 ))
    [ -n "$STAT_STYLE" ] && [ "$MAX_FILE_MB" -gt 0 ] || return 0
    while IFS=$TAB read -r _ path; do
        [ -f "$REPO/$path" ] || continue
        batch+=("$REPO/$path")
        n=$(( n + 1 ))
        if [ "$n" -ge 200 ]; then
            big_in_batch "$limit" "${batch[@]}" && return 0
            batch=()
            n=0
        fi
    done < "$W/pending"
    [ "$n" -gt 0 ] && big_in_batch "$limit" "${batch[@]}"
    return 0
}

commit_blocker() {
    # commit_blocker -> the reason why the pending files listed by
    # list_pending are not committed automatically, or nothing.
    local flag path lowpath base big
    if [ -n "$L_odd" ]; then
        printf '%s' "$L_odd"
        return 0
    fi
    if ! g var GIT_COMMITTER_IDENT >/dev/null 2>&1; then
        printf 'git does not know your name and e-mail (git config --global user.name and user.email)'
        return 0
    fi
    if [ "$MAX_NEW_FILES" -gt 0 ] && [ "$L_new" -gt "$MAX_NEW_FILES" ]; then
        printf '%s new files at once, more than the limit of %s: a .gitignore is probably missing' "$L_new" "$MAX_NEW_FILES"
        return 0
    fi
    tr '[:upper:]' '[:lower:]' < "$W/pending" > "$W/pending.lower"
    while IFS=$TAB read -r flag path <&3 && IFS=$TAB read -r _ lowpath <&4; do
        [ "$flag" = "??" ] || continue
        case "$path" in
            */)
                printf 'the folder %s is a git repository of its own: ignore it, or make it a submodule' "${path%/}"
                return 0
                ;;
        esac
        base=${lowpath##*/}
        if looks_secret "$base"; then
            printf 'the new file %s looks like a secret: commit it by hand, or add it to .gitignore' "$path"
            return 0
        fi
    done 3< "$W/pending" 4< "$W/pending.lower"
    big=$(too_big)
    if [ -n "$big" ]; then
        printf 'the file %s is above the limit of %s MB' "$big" "$MAX_FILE_MB"
    fi
    return 0
}

commits_here() {
    # commits_here -> 0 when the pending changes of $REPO are committed
    # automatically: the repository may opt out, and the command line wins
    # over the general setting.
    [ "$R_commit_local" = "0" ] && return 1
    if [ "$COMMIT_FORCED" -eq 1 ]; then
        [ "$COMMIT" -eq 1 ]
        return $?
    fi
    case "$R_commit_eff" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    [ "$COMMIT" -eq 1 ]
}

expand_message() {
    # expand_message TEMPLATE -> the subject of the automatic commit:
    # %d the date, %t the time, %h the machine, %n the number of files.
    local t="$1" out=""
    while [ -n "$t" ]; do
        case "$t" in
            %d*) out="$out$TODAY";        t=${t:2} ;;
            %t*) out="$out$CLOCK";        t=${t:2} ;;
            %h*) out="$out$MACHINE_NAME"; t=${t:2} ;;
            %n*) out="$out$L_count";      t=${t:2} ;;
            %%*) out="$out%";             t=${t:2} ;;
            *)   out="$out${t:0:1}";      t=${t:1} ;;
        esac
    done
    printf '%s' "$out"
}

commit_pending() {
    # Commit every pending change of $REPO. On a refusal (a hook, a guard)
    # the staging area is put back as it was. Returns 0 when the commit
    # exists; C_why says why it does not.
    local reason index old new rc
    C_why=""
    list_pending
    if [ "$L_count" -eq 0 ]; then
        C_why="nothing is pending any more"
        return 1
    fi
    reason=$(commit_blocker)
    if [ -n "$reason" ]; then
        C_why=$reason
        return 1
    fi
    index=$(g rev-parse --git-path index 2>/dev/null)
    case "$index" in
        /*) ;;
        *)  index="$REPO/$index" ;;
    esac
    rm -f "$W/index.before"
    [ -f "$index" ] && cp "$index" "$W/index.before"
    old=$(g rev-parse -q --verify HEAD 2>/dev/null)
    {
        printf '%s\n\n' "$(expand_message "$MESSAGE")"
        pending_words 50
        [ "$L_count" -gt 50 ] && printf '... and %s more\n' $(( L_count - 50 ))
    } > "$W/message"

    mark_inflight
    run_local add "${GIT[@]}" add -A
    rc=$?
    if [ "$rc" -eq 0 ]; then
        run_local commit "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false commit --quiet -F "$W/message"
        rc=$?
    fi
    new=$(g rev-parse -q --verify HEAD 2>/dev/null)
    if [ "$rc" -ne 0 ] || [ "$new" = "$old" ]; then
        # Nothing was committed: the staging area returns to what it was.
        if [ -f "$W/index.before" ]; then
            cp "$W/index.before" "$index"
        fi
        unmark_inflight
        C_why="git refused the commit ($(last_line "$ERR"))"
        return 1
    fi
    unmark_inflight
    record_move commit "$old" "$new"
    return 0
}

# ---------------------------------------------------------------------------
# Where a branch is pushed, and the push itself
# ---------------------------------------------------------------------------

push_target() {
    # Where "git push" would send the branch of $REPO. Sets P_remote, P_dst
    # (the name of the branch on the server), P_ref (its last known position
    # here), P_new (1 when the server has no such branch yet) and P_setup
    # (1 when the push must also record the upstream). Returns 1 with P_why
    # when there is no destination.
    local name remotes=0 first="" has_origin=0
    P_remote=""; P_dst=""; P_ref=""; P_new=0; P_setup=0; P_why=""
    if [ -n "$R_push_ref" ]; then
        if [ "$R_push_ref" = "$R_up_ref" ] && [ -n "$R_up_rref" ]; then
            P_remote=$R_up_remote
            P_dst=$R_up_rref
        else
            P_remote=$R_push_remote
            P_dst="refs/heads/${R_push_ref#refs/remotes/"$R_push_remote"/}"
        fi
        P_ref=$R_push_ref
        if [ -z "$P_remote" ] || [ "$P_remote" = "." ]; then
            P_why="the branch $R_branch follows a local branch, not a server"
            return 1
        fi
        g rev-parse -q --verify "$P_ref^{commit}" >/dev/null 2>&1 || P_new=1
        # A branch that the server lacks is created only when that was
        # asked for: by the option, or by the settings of git that make a
        # plain "git push" create it.
        if [ "$P_new" -eq 1 ] && [ "$R_pushdefault" != "current" ]; then
            if [ "$SET_UPSTREAM" -eq 1 ] || [ "$R_autosetup" -eq 1 ]; then
                P_setup=1
            else
                P_why="the branch $R_branch is not on $P_remote yet: publish it with --set-upstream"
                return 1
            fi
        fi
        return 0
    fi
    if [ -n "$R_up_ref" ]; then
        P_why="git knows no push destination for $R_branch, which follows $R_upstream under another name"
        return 1
    fi
    if [ "$SET_UPSTREAM" -eq 0 ] && [ "$R_autosetup" -eq 0 ]; then
        P_why="the branch $R_branch is on this machine only: publish it with --set-upstream"
        return 1
    fi
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        remotes=$(( remotes + 1 ))
        [ -z "$first" ] && first=$name
        [ "$name" = "origin" ] && has_origin=1
    done <<EOF
$(g remote 2>/dev/null)
EOF
    if [ "$remotes" -eq 1 ]; then
        P_remote=$first
    elif [ "$has_origin" -eq 1 ]; then
        P_remote="origin"
    else
        P_why="the branch $R_branch is on this machine only, and no remote is called origin"
        return 1
    fi
    P_dst="refs/heads/$R_branch"
    P_ref="refs/remotes/$P_remote/$R_branch"
    P_setup=1
    g rev-parse -q --verify "$P_ref^{commit}" >/dev/null 2>&1 || P_new=1
    return 0
}

count_to_push() {
    # Sets P_ahead and P_behind against the last known position of the
    # destination; a branch that the server lacks counts what no branch of
    # that remote holds yet.
    if [ "$P_new" -eq 1 ]; then
        P_ahead=$(g rev-list --count HEAD --not --remotes="$P_remote" 2>/dev/null)
        P_behind=0
    else
        P_ahead=$(g rev-list --count "$P_ref..HEAD" 2>/dev/null)
        P_behind=$(g rev-list --count "HEAD..$P_ref" 2>/dev/null)
    fi
    is_uint "$P_ahead" || P_ahead=0
    is_uint "$P_behind" || P_behind=0
    return 0
}

push_once() {
    # One push of the branch to its destination, never forced. Returns 0
    # when the server took it, 1 when the server refused it, 2 on any other
    # failure, 3 when the run was stopped. PU_why holds the words of git.
    local rc flag refs summary found="" args=(push --porcelain)
    PU_why=""
    [ "$P_setup" -eq 1 ] && args+=(--set-upstream)
    run_net push "${GIT[@]}" ${NETCFG[@]+"${NETCFG[@]}"} "${args[@]}" "$P_remote" "refs/heads/$R_branch:$P_dst"
    rc=$?
    case "$rc" in
        130)     return 3 ;;
        124|125) PU_why=$(net_failure "$rc"); return 2 ;;
    esac
    while IFS=$TAB read -r flag refs summary; do
        case "$refs" in
            *":$P_dst") found=$flag; PU_why=$summary ;;
        esac
    done < "$OUT"
    case "$found" in
        "!") return 1 ;;
        "")  PU_why=$(last_line "$ERR"); return 2 ;;
    esac
    [ "$rc" -eq 0 ] && return 0
    PU_why=$(last_line "$ERR")
    return 2
}

other_branches() {
    # Lines about the other local branches whose commits are on this machine
    # only: the evening push sends the current branch, and says what stays.
    local name upstream track n
    while IFS=$US read -r name upstream track; do
        [ -n "$name" ] || continue
        [ "$name" = "$R_branch" ] && continue
        if [ -z "$upstream" ]; then
            n=$(g rev-list --count "refs/heads/$name" --not --remotes 2>/dev/null)
            if is_uint "$n" && [ "$n" -gt 0 ]; then
                printf 'the branch %s holds %s that no server has\n' "$name" "$(plural "$n" commit)"
            fi
        else
            case "$track" in
                *">"*) printf 'the branch %s has commits that are not pushed\n' "$name" ;;
            esac
        fi
    done <<EOF
$(g for-each-ref --format='%(refname:short)%1f%(upstream)%1f%(upstream:trackshort)' refs/heads 2>/dev/null)
EOF
    return 0
}

visibility_mark() {
    case "$H_vis" in
        public) printf '  [PUBLIC]' ;;
    esac
}

do_plan() {
    # The first pass of "push": what would be committed and pushed in this
    # repository. Nothing is changed; the repositories with something to do
    # leave a marker for the second pass.
    local pending text="" block="" stays="" will_commit=0 slug total extras
    repo_begin || return 0
    if [ "$R_pullonly" -eq 1 ]; then
        emit skipped 0 "update-only (gh-batch.pullOnly)"
        return 0
    fi
    if [ "$R_busy" -eq 1 ]; then
        emit busy 1 "another git process holds its index (index.lock): try again later"
        return 0
    fi
    if [ -n "$R_operation" ]; then
        emit unfinished 1 "$R_operation is in progress: finish or abort it first"
        return 0
    fi
    if [ "$R_unmerged" -gt 0 ]; then
        emit unfinished 1 "$(plural "$R_unmerged" file) with unresolved conflicts"
        return 0
    fi
    pending=$(( R_tracked + R_untracked ))
    if [ "$R_remotes" -eq 0 ]; then
        if [ "$pending" -gt 0 ]; then
            emit localonly 0 "$(describe_pending), and no remote: it all stays on this machine"
        else
            emit localonly 0 "it has no remote: it exists on this machine only"
        fi
        return 0
    fi
    if [ "$R_detached" -eq 1 ]; then
        if [ "$pending" -gt 0 ]; then
            emit detached 0 "HEAD is detached: nothing is committed or pushed ($(describe_pending))"
        else
            emit detached 0 "HEAD is detached: nothing is pushed"
        fi
        return 0
    fi
    if [ "$R_unborn" -eq 1 ] && [ "$pending" -eq 0 ]; then
        emit nothing 0 ""
        return 0
    fi
    if ! push_target; then
        if [ "$pending" -gt 0 ]; then
            emit noupstream 0 "$P_why; $(describe_pending) stay here too"
        else
            emit noupstream 0 "$P_why"
        fi
        return 0
    fi
    count_to_push

    if [ "$pending" -gt 0 ]; then
        if commits_here; then
            list_pending
            block=$(commit_blocker)
            [ -z "$block" ] && will_commit=1
        else
            stays="$(describe_pending): not committed, they stay on this machine"
        fi
    fi
    if [ "$will_commit" -eq 0 ] && [ "$P_ahead" -eq 0 ] && [ "$P_new" -eq 0 ]; then
        if [ -n "$block" ]; then
            emit notcommitted 1 "$(describe_pending): $block"
        elif [ -n "$stays" ]; then
            emit pending 0 "$stays"
        else
            emit nothing 0 ""
        fi
        extras=$(other_branches)
        details "$extras"
        return 0
    fi
    if [ "$P_behind" -gt 0 ] && [ "$DIVERGED" = "report" ]; then
        # The last fetch saw commits on the server that this machine lacks,
        # and the setting leaves them to the user: the push would be
        # refused, and a commit made now would only widen the gap.
        if [ "$pending" -gt 0 ]; then
            text="; $(describe_pending): not committed"
        fi
        if [ "$P_ahead" -gt 0 ]; then
            emit diverged 1 "$(plural "$P_ahead" commit) here and $P_behind on the server: left to you, since the push would be refused (git pull --rebase, or git pull --no-rebase)$text"
        else
            emit behind 1 "$(plural "$P_behind" "new commit") on the server: pull $( [ "$P_behind" -eq 1 ] && printf 'it' || printf 'them' ) first, then push ($PROG sync does both)$text"
        fi
        extras=$(other_branches)
        details "$extras"
        return 0
    fi

    slug=$(remote_slug "$P_remote")
    net_setup
    github_facts "$slug"
    if [ "$H_push" = "false" ] || [ "$H_archived" = "true" ]; then
        if [ "$H_archived" = "true" ]; then
            text="$slug is archived on GitHub and takes no push"
        else
            text="this account has no right to push to $slug"
        fi
        if [ "$pending" -gt 0 ]; then
            emit pending 0 "$(describe_pending) stay on this machine: $text"
        else
            emit ahead 0 "$(plural "$P_ahead" commit) stay on this machine: $text"
        fi
        return 0
    fi

    total=$(( P_ahead + will_commit ))
    if [ "$will_commit" -eq 1 ]; then
        text="commit $(plural "$L_count" file), then push $(plural "$total" commit)"
    elif [ "$P_new" -eq 1 ]; then
        text="publish the branch $R_branch ($(plural "$P_ahead" commit))"
    else
        text="push $(plural "$P_ahead" commit)"
    fi
    [ "$P_behind" -gt 0 ] && text="$text, after taking $P_behind from the server"
    if [ -n "$block" ]; then
        stays="$(describe_pending) NOT committed: $block"
        : > "$TMP/plan/$IDX.alert"
    fi
    if [ -n "$stays" ]; then
        text="$text; $stays"
        printf '%s' "$stays" > "$TMP/plan/$IDX.stays"
    fi
    text="$text$(visibility_mark)"
    emit planned "$( [ -n "$block" ] && printf 1 || printf 0 )" "$text"
    if [ "$will_commit" -eq 1 ]; then
        details "$(pending_words 6)"
        [ "$L_count" -gt 6 ] && detail "... and $(( L_count - 6 )) more"
        : > "$TMP/plan/$IDX.commit"
    fi
    extras=$(other_branches)
    details "$extras"
    printf 'P%s%s%s%s%s%s\n' "$US" "$will_commit" "$US" "$total" "$US" "$H_vis"
    : > "$TMP/plan/$IDX.go"
    return 0
}

do_push() {
    # The second pass of "push": commit when the plan said so, then push;
    # when the server has newer commits, take them as "pull" does and push
    # once more. A repository without a marker keeps the answer of the plan.
    local committed=0 note="" rc pushed mark nfiles=0 stays="" alert=0 made="" looked=0
    local kind server="" IN_PUSH=1
    if [ ! -e "$TMP/plan/$IDX.go" ]; then
        cat "$TMP/plan/$IDX.res"
        return 0
    fi
    repo_begin || return 0
    if [ "$R_busy" -eq 1 ] || [ -n "$R_operation" ] || [ "$R_unmerged" -gt 0 ] || [ "$R_detached" -eq 1 ]; then
        emit unfinished 1 "its state changed since the plan: nothing was done"
        return 0
    fi
    # What the plan found about GitHub and about pending files that stay.
    H_vis=""
    while IFS=$US read -r kind _ _ mark; do
        [ "$kind" = "P" ] && H_vis=$mark
    done < "$TMP/plan/$IDX.res"
    mark=$(visibility_mark)
    [ -f "$TMP/plan/$IDX.stays" ] && stays=$(cat "$TMP/plan/$IDX.stays")
    [ -e "$TMP/plan/$IDX.alert" ] && alert=1
    if [ -e "$TMP/plan/$IDX.commit" ]; then
        if commit_pending; then
            committed=1
            nfiles=$L_count
            made=" (the commit is made, not pushed)"
            inspect
        elif [ "$C_why" != "nothing is pending any more" ]; then
            stays="$(describe_pending) NOT committed: $C_why"
            alert=1
        fi
    fi
    if ! push_target; then
        emit noupstream 1 "$P_why"
        return 0
    fi
    count_to_push
    net_setup
    if [ "$P_ahead" -eq 0 ] && [ "$P_new" -eq 0 ]; then
        if [ -n "$stays" ]; then
            emit notcommitted "$alert" "$stays"
        else
            emit nothing 0 ""
        fi
        return 0
    fi
    if stopped; then
        emit interrupted 1 "stopped before the push$made"
        return 0
    fi
    pushed=$P_ahead
    server=$(g rev-parse -q --verify "$P_ref^{commit}" 2>/dev/null)
    push_once
    rc=$?
    if [ "$rc" -eq 1 ]; then
        # The server refused. If it holds commits that this machine lacks,
        # they are taken as the morning update does, and the push is tried
        # once more; a conflict there is undone and reported.
        if [ "$P_ref" = "$R_up_ref" ]; then
            if [ "$DIVERGED" = "report" ]; then
                ONLY_LOOK=1
                looked=1
            fi
            level_with_server
            ONLY_LOOK=0
            case "$U_state" in
                updated|rebased|merged|reset)
                    emit_moves
                    [ "$U_attn" -eq 1 ] && alert=1
                    note=" after taking $(plural "$U_behind" commit) from the server$U_extra_msg"
                    inspect
                    push_target && count_to_push
                    if [ "$P_ahead" -eq 0 ] && [ "$P_new" -eq 0 ]; then
                        # The commits of the server left nothing to send.
                        emit "$U_state" "$alert" "$U_msg; nothing is left to push$made"
                        details "$U_details"
                        details "$U_extra"
                        return 0
                    fi
                    pushed=$P_ahead
                    server=$(g rev-parse -q --verify "$P_ref^{commit}" 2>/dev/null)
                    push_once
                    rc=$?
                    ;;
                uptodate|ahead)
                    rc=2
                    ;;
                behind|diverged)
                    if [ "$looked" -eq 1 ]; then
                        emit rejected 1 "the server has $(plural "$U_behind" commit) that this machine lacks: pull first, then push again$made"
                    else
                        emit diverged 1 "the push was refused; $U_msg$made"
                    fi
                    return 0
                    ;;
                *)
                    emit "$U_state" 1 "the push was refused, and taking the commits of the server did not work: $U_msg$made"
                    return 0
                    ;;
            esac
        else
            rc=2
        fi
    fi
    case "$rc" in
        0)
            if [ "$committed" -eq 1 ]; then
                note="committed $(plural "$nfiles" file), pushed $(plural "$pushed" commit)$note"
            elif [ "$P_new" -eq 1 ]; then
                note="published the branch $R_branch ($(plural "$pushed" commit))$note"
            else
                note="pushed $(plural "$pushed" commit)$note"
            fi
            [ -n "$stays" ] && note="$note; $stays"
            emit pushed "$alert" "$note$mark"
            details "$U_extra"
            # The journal keeps where the branch of the server was and the
            # commit that it received.
            record_move push "$server" "$(g rev-parse -q --verify HEAD 2>/dev/null)"
            ;;
        3)
            emit interrupted 1 "stopped during the push$made"
            ;;
        1)
            emit rejected 1 "the server refused the push again: $PU_why$made"
            ;;
        *)
            emit failed 1 "the push failed: $PU_why$made"
            ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# The commands
# ---------------------------------------------------------------------------

begin_command() {
    # begin_command change|read: what every command does first.
    setup_colour
    setup_run
    harden_git
    discover
    if [ "$1" = "change" ] && [ "$DRY_RUN" -eq 0 ] && [ "${#REPOS[@]}" -gt 0 ]; then
        take_lock
    fi
}

last_runs() {
    # The last pull and the last push, for the line under the first one of
    # "status": "last pull today at 09:56, last push yesterday at 18:02".
    local text="" when
    [ -n "$STATE_DIR" ] || return 0
    when=$(cat "$STATE_DIR/last.pull" 2>/dev/null)
    [ -n "$when" ] && text="last pull $(moment_words "$when")"
    when=$(cat "$STATE_DIR/last.push" 2>/dev/null)
    [ -n "$when" ] && text="$text${text:+, }last push $(moment_words "$when")"
    printf '%s' "$text"
    return 0
}

day_words() {
    # day_words YYYY-MM-DD -> "today", "yesterday" or "on 17 November 2026"
    local day="${1//-/}"
    if [ "$1" = "$TODAY" ]; then
        printf 'today'
    elif [ "$day" = "$(days_ago 1)" ]; then
        printf 'yesterday'
    else
        printf 'on %s' "$(stamp_words "$day")"
    fi
}

moment_words() {
    # moment_words "YYYY-MM-DD HH:MM" -> "today at 09:56", or the text as
    # it is when it has another form.
    case "$1" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]" "[0-9][0-9]:[0-9][0-9])
            printf '%s at %s' "$(day_words "${1%% *}")" "${1#* }" ;;
        *)
            printf '%s' "$1" ;;
    esac
}

cmd_status() {
    begin_command read
    no_repository && exit "$EX_OK"
    header "$(last_runs)"
    pool do_status status render
    fork_section_seen
    finish
}

cmd_pull() {
    if [ "$DRY_RUN" -eq 1 ] || [ "$COMMAND" = "fetch" ]; then
        ONLY_LOOK=1
    fi
    begin_command change
    no_repository && exit "$EX_OK"
    header ""
    # A look at the servers also says how far each fork stands from the
    # repository it was forked from.
    [ "$ONLY_LOOK" -eq 1 ] && forks_prepare
    pool do_pull pull render
    [ "$STOP" -eq 0 ] && [ "$ONLY_LOOK" -eq 0 ] && remember_run pull
    [ "$ONLY_LOOK" -eq 1 ] && [ "$STOP" -eq 0 ] && fork_section
    finish
}

render_plan() {
    # render_plan INDEX FILE: count what the first pass of "push" found;
    # nothing is printed before every repository has answered.
    local kind will rest
    while IFS=$US read -r kind will _ rest; do
        [ "$kind" = "P" ] || continue
        PLAN_GO=$(( PLAN_GO + 1 ))
        [ "$will" = "1" ] && PLAN_COMMITS=$(( PLAN_COMMITS + 1 ))
        [ "$rest" = "public" ] && PLAN_PUBLIC=$(( PLAN_PUBLIC + 1 ))
    done < "$2"
    return 0
}

plan_words() {
    local text="To do:"
    if [ "$PLAN_COMMITS" -gt 0 ]; then
        text="$text a commit in $(plural "$PLAN_COMMITS" repository), then"
    fi
    text="$text a push from $(plural "$PLAN_GO" repository)"
    if [ "$PLAN_PUBLIC" -gt 0 ]; then
        text="$text, $PLAN_PUBLIC of them PUBLIC"
    fi
    printf '%s.' "$text"
}

show_plan() {
    # The list shown before anything is committed or pushed: what will be
    # done, and what is left aside and why.
    local i=0 count="${#REPOS[@]}"
    put_title "Plan:"
    while [ "$i" -lt "$count" ]; do
        if [ -f "$TMP/plan/$i.res" ]; then
            read_record "$TMP/plan/$i.res"
            if [ "$REC_state" = "planned" ] || [ "$REC_attention" = 1 ]; then
                print_record "$i"
            fi
        fi
        i=$(( i + 1 ))
    done
    put ""
    put_todo "$(plan_words)"
    return 0
}

asks() {
    # asks -> 0 when this run will stop for the confirmation
    [ "$YES" -eq 0 ] && [ "$CONFIRM" -eq 1 ]
}

answered() {
    # answered -> 0 when somebody can answer a question on the standard
    # input. GH_BATCH_TTY says so of a pipe, so that the questions can be
    # exercised without a terminal.
    [ -n "${GH_BATCH_TTY:-}" ] && return 0
    [ -t 0 ]
}

show_before_asking() {
    # show_before_asking FUNCTION: print the list of what is about to be
    # done. Whoever is asked must see it, even with --quiet; and a run that
    # prints records for a program cannot stop to ask.
    local quiet=$QUIET
    if [ "$PORCELAIN" -eq 1 ]; then
        asks && die "$EX_USAGE" "with --porcelain nothing can be asked: add --yes"
        return 0
    fi
    asks && QUIET=0
    "$1"
    QUIET=$quiet
    return 0
}

confirmed() {
    # One question for the whole run. Without a terminal there is nobody to
    # ask: the run then needs --yes.
    local answer="" since
    if [ "$YES" -eq 1 ] || [ "$CONFIRM" -eq 0 ]; then
        return 0
    fi
    if ! answered; then
        die "$EX_USAGE" "this run changes repositories: confirm it at a terminal, or add --yes"
    fi
    printf '%sProceed?%s [Y/n] ' "$C_HEAD" "$C_OFF" >&2
    ASKING=1
    since=$SECONDS
    IFS= read -r answer || answer="n"
    # The time spent waiting for the answer is not time that the run took.
    RUN_START=$(( RUN_START + SECONDS - since ))
    ASKING=0
    [ "$STOP" -eq 1 ] && return 1
    case "$answer" in
        ""|[Yy]|[Yy][Ee][Ss]) return 0 ;;
    esac
    return 1
}

push_phase() {
    local i=0 count="${#REPOS[@]}"
    PLAN_GO=0; PLAN_COMMITS=0; PLAN_PUBLIC=0
    pool do_plan plan render_plan
    if [ "$STOP" -eq 0 ] && [ "$PLAN_GO" -gt 0 ] && [ "$DRY_RUN" -eq 0 ]; then
        show_before_asking show_plan
        if ! confirmed; then
            # The caller says what was left undone: a push on its own did
            # nothing, while a push that follows a commit leaves that commit.
            return 1
        fi
        if [ "$PORCELAIN" -eq 0 ]; then
            put ""
            put_title "Done:"
        fi
        pool do_push push render
        [ "$STOP" -eq 0 ] && remember_run push
        return 0
    fi
    # Nothing to do, or only a look: the plan is the report.
    while [ "$i" -lt "$count" ]; do
        [ -f "$TMP/plan/$i.res" ] && render "$i" "$TMP/plan/$i.res"
        i=$(( i + 1 ))
    done
    if [ "$DRY_RUN" -eq 1 ] && [ "$PLAN_GO" -gt 0 ] && [ "$PORCELAIN" -eq 0 ]; then
        put ""
        put_todo "$(plan_words) Nothing was changed (dry run)."
    fi
    return 0
}

cmd_push() {
    begin_command change
    no_repository && exit "$EX_OK"
    header ""
    if ! push_phase; then
        put "Nothing was done."
        declined
        exit "$EX_OK"
    fi
    finish
}

reset_tally() {
    local state
    for state in $STATE_ORDER planned; do
        printf -v "N_$state" '%s' 0
    done
    TOTAL=0
    SHOWN=0
    ATTENTION_LIST=()
    KEPT_LIST=()
}

cmd_sync() {
    [ "$DRY_RUN" -eq 1 ] && ONLY_LOOK=1
    begin_command change
    no_repository && exit "$EX_OK"
    header ""
    [ "$PORCELAIN" -eq 0 ] && put_title "First, the pull:"
    pool do_pull pull render
    [ "$STOP" -eq 0 ] && [ "$ONLY_LOOK" -eq 0 ] && remember_run pull
    if [ "$STOP" -eq 1 ]; then
        finish
    fi
    summary
    reset_tally
    if [ "$PORCELAIN" -eq 0 ]; then
        put ""
        put_title "Then, the push:"
    fi
    if ! push_phase; then
        put "Nothing was done."
        declined
        exit "$EX_OK"
    fi
    finish
}

# ---------------------------------------------------------------------------
# commit: the pending changes, with a message, and a push when asked for
# ---------------------------------------------------------------------------

commit_proposal() {
    # The first line that Enter accepts. A message the user chose (on the
    # command line, in the environment or in git) wins. Otherwise this
    # command has its own sentence, and the work-in-progress line of the
    # evening push is left to that command.
    if [ "$SRC_message" = "default" ]; then
        printf '%s' "A Regular Commit to Synchronise"
    else
        printf '%s' "$MESSAGE"
    fi
}

commit_plan_words() {
    local text
    text="To do: a commit in $(plural "$PLAN_COMMITS" repository)"
    if [ -n "$OPT_MESSAGE" ]; then
        text="$text, with the message \"$(one_line "$OPT_MESSAGE")\""
    fi
    if [ "$ALSO_PUSH" -eq 1 ]; then
        text="$text. A push is asked afterwards"
    fi
    printf '%s.' "$text"
}

ask_commit_message() {
    # Ask for the first line of every commit of this run. Enter takes the
    # line proposed, another line replaces it, and a minus sign alone does
    # nothing. Returns 1 when nothing is to be committed. With -m the line
    # is already chosen, and the question is the usual confirmation.
    local proposed answer="" ended since trimmed
    proposed=$(commit_proposal)
    if [ "$YES" -eq 1 ] || [ "$CONFIRM" -eq 0 ]; then
        if [ -z "$OPT_MESSAGE" ]; then
            MESSAGE=$proposed
        fi
        return 0
    fi
    if [ -n "$OPT_MESSAGE" ]; then
        confirmed
        return $?
    fi
    if ! answered; then
        die "$EX_USAGE" "this run commits in the repositories: confirm it at a terminal, or add --yes"
    fi
    printf '%sCommit message%s [%s%s%s], or - to do nothing: ' "$C_HEAD" "$C_OFF" "$C_BOLD" "$proposed" "$C_OFF" >&2
    ended=0
    ASKING=1
    since=$SECONDS
    IFS= read -r answer || [ -n "$answer" ] || ended=1
    RUN_START=$(( RUN_START + SECONDS - since ))
    ASKING=0
    if [ "$ended" -eq 1 ] || [ "$STOP" -eq 1 ]; then
        printf '\n' >&2
        put "Nothing was done."
        declined
        exit "$EX_OK"
    fi
    trimmed=${answer#"${answer%%[![:space:]]*}"}
    trimmed=${trimmed%"${trimmed##*[![:space:]]}"}
    if [ "$trimmed" = "-" ]; then
        return 1
    fi
    if [ -n "$trimmed" ]; then
        MESSAGE=$(one_line "$trimmed")
        [ -n "$MESSAGE" ] || MESSAGE=$proposed
    else
        MESSAGE=$proposed
    fi
    return 0
}

do_commit_plan() {
    # What "commit" would commit in this repository. Nothing is changed.
    # A repository without a remote is included: the commit stays here.
    local pending block text
    repo_begin || return 0
    if [ "$R_pullonly" -eq 1 ]; then
        emit skipped 0 "update-only (gh-batch.pullOnly): nothing is committed"
        return 0
    fi
    if [ "$R_busy" -eq 1 ]; then
        emit busy 1 "another git process holds its index (index.lock): try again later"
        return 0
    fi
    if [ -n "$R_operation" ]; then
        emit unfinished 1 "$R_operation is in progress: finish or abort it first"
        return 0
    fi
    if [ "$R_unmerged" -gt 0 ]; then
        emit unfinished 1 "$(plural "$R_unmerged" file) with unresolved conflicts"
        return 0
    fi
    pending=$(( R_tracked + R_untracked ))
    if [ "$R_detached" -eq 1 ]; then
        if [ "$pending" -gt 0 ]; then
            emit detached 0 "HEAD is detached: nothing is committed ($(describe_pending))"
        else
            emit detached 0 "HEAD is detached: nothing is committed"
        fi
        return 0
    fi
    if [ "$pending" -eq 0 ]; then
        # A dry run does not go on to the push, so a repository that already
        # has commits to send is named here. A real run leaves that to the push.
        if [ "$ALSO_PUSH" -eq 1 ] && [ "$DRY_RUN" -eq 1 ] && [ "$R_remotes" -gt 0 ] && push_target; then
            count_to_push
            if [ "$P_ahead" -gt 0 ] || [ "$P_new" -eq 1 ]; then
                emit planned 0 "push $(plural "$P_ahead" commit)"
                printf 'P%s0%s0%s\n' "$US" "$US" "$US"
                return 0
            fi
        fi
        emit clean 0 ""
        return 0
    fi
    if ! commits_here; then
        emit pending 0 "$(describe_pending): not committed (gh-batch.commit is false here)"
        return 0
    fi
    list_pending
    block=$(commit_blocker)
    if [ -n "$block" ]; then
        emit notcommitted 1 "$(describe_pending): $block"
        return 0
    fi
    text="commit $(plural "$L_count" file)"
    if [ "$R_remotes" -eq 0 ]; then
        text="$text; no remote, so the commit stays on this machine"
    elif [ "$ALSO_PUSH" -eq 1 ]; then
        if push_target; then
            text="$text, then a push"
        else
            text="$text; $P_why"
        fi
    fi
    emit planned 0 "$text"
    details "$(pending_words 6)"
    [ "$L_count" -gt 6 ] && detail "... and $(( L_count - 6 )) more"
    : > "$TMP/cplan/$IDX.commit"
    printf 'P%s1%s0%s\n' "$US" "$US" "$US"
    return 0
}

do_commit() {
    # Commit what the plan marked. A repository without a marker keeps the
    # answer of the plan.
    local nfiles subject note
    if [ ! -e "$TMP/cplan/$IDX.commit" ]; then
        cat "$TMP/cplan/$IDX.res"
        return 0
    fi
    repo_begin || return 0
    if [ "$R_busy" -eq 1 ] || [ -n "$R_operation" ] || [ "$R_unmerged" -gt 0 ] || [ "$R_detached" -eq 1 ]; then
        emit unfinished 1 "its state changed since the plan: nothing was done"
        return 0
    fi
    if ! commits_here; then
        emit pending 0 "$(describe_pending): not committed (gh-batch.commit is false here)"
        return 0
    fi
    if commit_pending; then
        nfiles=$L_count
        subject=$(clip "$(expand_message "$MESSAGE")" 120)
        note="committed $(plural "$nfiles" file): $subject"
        if [ "$R_remotes" -eq 0 ]; then
            note="$note; no remote, so it stays on this machine"
        fi
        emit committed 0 "$note"
    elif [ "$C_why" = "nothing is pending any more" ]; then
        emit clean 0 ""
    else
        emit notcommitted 1 "$(describe_pending) NOT committed: $C_why"
    fi
    return 0
}

show_commit_plan() {
    local i=0 count="${#REPOS[@]}"
    put_title "Plan:"
    while [ "$i" -lt "$count" ]; do
        if [ -f "$TMP/cplan/$i.res" ]; then
            read_record "$TMP/cplan/$i.res"
            if [ "$REC_state" = "planned" ] || [ "$REC_attention" = 1 ]; then
                print_record "$i"
            fi
        fi
        i=$(( i + 1 ))
    done
    put ""
    put_todo "$(commit_plan_words)"
    return 0
}

commit_phase() {
    local i=0 count="${#REPOS[@]}" proposed=""
    PLAN_GO=0
    PLAN_COMMITS=0
    PLAN_PUBLIC=0
    pool do_commit_plan cplan render_plan
    if [ "$STOP" -eq 0 ] && [ "$PLAN_COMMITS" -gt 0 ] && [ "$DRY_RUN" -eq 0 ]; then
        show_before_asking show_commit_plan
        if ! ask_commit_message; then
            put "Nothing was done."
            declined
            exit "$EX_OK"
        fi
        if [ "$PORCELAIN" -eq 0 ]; then
            put ""
            put_title "Done:"
        fi
        pool do_commit cwork render
        [ "${N_committed:-0}" -gt 0 ] && COMMITS_MADE=1
        return 0
    fi
    while [ "$i" -lt "$count" ]; do
        [ -f "$TMP/cplan/$i.res" ] && render "$i" "$TMP/cplan/$i.res"
        i=$(( i + 1 ))
    done
    if [ "$DRY_RUN" -eq 1 ] && [ "$PORCELAIN" -eq 0 ] && [ "$STOP" -eq 0 ]; then
        if [ "$PLAN_COMMITS" -gt 0 ]; then
            put ""
            if [ -n "$OPT_MESSAGE" ]; then
                put_todo "$(commit_plan_words) Nothing was changed (dry run)."
            else
                proposed=$(one_line "$(commit_proposal)")
                put_todo "$(commit_plan_words) The message would be \"$proposed\". Nothing was changed (dry run)."
            fi
        elif [ "$ALSO_PUSH" -eq 1 ] && [ "$PLAN_GO" -gt 0 ]; then
            put ""
            put_title "Nothing was changed (dry run)."
        fi
    fi
    return 0
}

cmd_commit() {
    # The command itself asks for the commits. The general setting does not
    # have to be on. A repository that opted out (gh-batch.commit false
    # inside it, or gh-batch.pullOnly) still opts out.
    COMMIT=1
    COMMIT_FORCED=1
    begin_command change
    no_repository && exit "$EX_OK"
    header ""
    if [ "$ALSO_PUSH" -eq 1 ] && [ "$PORCELAIN" -eq 0 ]; then
        put_title "First, the commit:"
    fi
    commit_phase
    if [ "$STOP" -eq 1 ]; then
        finish
    fi
    # A dry run stops after the list: the push is described there, and a
    # second pass would talk about changes that the commit has not made.
    if [ "$ALSO_PUSH" -eq 1 ] && [ "$DRY_RUN" -eq 0 ]; then
        summary
        reset_tally
        if [ "$PORCELAIN" -eq 0 ]; then
            put ""
            put_title "Then, the push:"
        fi
        # What follows is an ordinary push of the commits, its own included.
        # It asks on its own, unless this run already said not to ask.
        COMMIT=0
        COMMIT_FORCED=1
        if ! push_phase; then
            if [ "$COMMITS_MADE" -eq 1 ]; then
                put "The commits stay on this machine. Nothing was pushed."
            else
                put "Nothing was done."
            fi
            declined
            notify
            if [ "$ATTENTION" -eq 1 ]; then
                exit "$EX_ATTENTION"
            fi
            exit "$EX_OK"
        fi
    fi
    finish
}

notify() {
    # Hand the report to the command of gh-batch.notify, for a run that
    # nobody watches. The command reads the report on its standard input.
    local when="$NOTIFY_ON" status="ok"
    [ "$OPT_NOTIFY" -eq 1 ] && when="always"
    [ "$when" = "never" ] && return 0
    if [ -z "$NOTIFY_CMD" ]; then
        [ "$OPT_NOTIFY" -eq 1 ] &&
            warn "--notify needs a command: git config --global gh-batch.notify 'COMMAND'"
        return 0
    fi
    [ "$ATTENTION" -eq 1 ] && status="attention"
    if [ "$when" = "attention" ] && [ "$status" = "ok" ]; then
        return 0
    fi
    [ -s "$TMP/report.txt" ] || return 0
    ( notify_child "$status" ) </dev/null >/dev/null 2>&1 ||
        warn "the notification command did not succeed"
    return 0
}

notify_child() {
    # Runs in a subshell of its own: the command gets one minute.
    W="$TMP"
    export GH_BATCH_COMMAND="$COMMAND"
    export GH_BATCH_STATUS="$1"
    # shellcheck disable=SC2016  # the inner shell expands its own arguments
    spawn notify sh -c 'exec sh -c "$1" < "$2"' sh "$NOTIFY_CMD" "$TMP/report.txt"
    await timed 60
}

# ---------------------------------------------------------------------------
# reset: every branch level with the branch it follows on its server, the
# commit it had kept under a reference of its own
# ---------------------------------------------------------------------------

shell_word() {
    # shell_word TEXT -> TEXT as one word of a command line: as it is when
    # it holds only characters that a shell leaves alone, else between
    # single quotes.
    case "$1" in
        ""|*[!A-Za-z0-9._/@%+=:,~-]*)
            printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
            ;;
        *)  printf '%s' "$1" ;;
    esac
}

shell_path() {
    # shell_path PATH -> the path in a command shown to the user: short
    # (~/...) when it can be typed as it is, else whole and quoted.
    local short
    short=$(short_path "$1")
    case "$short" in
        *[!A-Za-z0-9._/@%+=:,~-]*) shell_word "$1" ;;
        *)                         printf '%s' "$short" ;;
    esac
}

gap_words() {
    # gap_words -> what separates the branch from the one it follows, in
    # words, once fetch_and_compare has counted.
    if [ "$U_ahead" -eq 0 ]; then
        printf '%s on the server' "$(plural "$U_behind" "new commit")"
    elif [ "$U_behind" -eq 0 ]; then
        printf '%s here that the server lacks' "$(plural "$U_ahead" commit)"
    else
        printf '%s here that the server lacks, and %s there' \
            "$(plural "$U_ahead" commit)" "$(plural "$U_behind" "new one")"
    fi
}

server_rewrote() {
    # server_rewrote -> 0 when the branch of the server once held a commit
    # of this branch that it holds no more: its history was rewritten and
    # pushed by force since this clone last saw it. The positions of the
    # remote branch that git recorded here tell.
    local fork rc
    fork=$(g merge-base --fork-point "$R_up_ref" "$U_head" 2>/dev/null) || return 1
    [ -n "$fork" ] || return 1
    g merge-base --is-ancestor "$fork" "$U_up" 2>/dev/null
    rc=$?
    # 1 says "not an ancestor"; any other failure says nothing.
    [ "$rc" -eq 1 ]
}

drop_words() {
    # drop_words -> what a reset with --discard-local does to the branch
    local text
    text="drop $(plural "$U_ahead" commit) that the server lacks"
    [ "$U_behind" -gt 0 ] && text="$text, and take $(plural "$U_behind" "new one")"
    printf '%s' "$text"
}

keep_backup() {
    # keep_backup KIND: before the branch moves, its commit is kept under a
    # reference of its own, refs/gh-batch/KIND/BRANCH/DATE-TIME (KIND is
    # before-reset or before-pull), outside the branches and the remote
    # branches, which keeps the commit and its files from the garbage
    # collection of git. A name taken already, by a run in the same second,
    # gets a number. Sets B_ref; returns 1, with the words of git in B_why,
    # when no reference can be written.
    local kind="$1" name n=1
    B_ref=""; B_why=""
    name="refs/gh-batch/$kind/$R_branch/$RUN_STAMP"
    while :; do
        # An empty old value makes git refuse a name that exists already.
        if g update-ref "$name" "$U_head" "" 2> "$W/backup.err"; then
            B_ref=$name
            return 0
        fi
        if [ "$n" -ge 9 ]; then
            B_why=$(last_line "$W/backup.err")
            return 1
        fi
        n=$(( n + 1 ))
        name="refs/gh-batch/$kind/$R_branch/$RUN_STAMP-$n"
    done
}

drop_backup() {
    # The branch did not move: the reference written for the move goes, if
    # it still points where it was made to point.
    [ -n "$B_ref" ] && g update-ref -d "$B_ref" "$U_head" >/dev/null 2>&1
    B_ref=""
    return 0
}

restore_line() {
    # The one command that puts the branch and its files back where they
    # were. It is as careful as the reset: git refuses to overwrite a
    # pending change, or a file that it does not track.
    printf 'to restore: git -C %s checkout --no-track --no-overwrite-ignore -B %s %s' \
        "$(shell_path "$REPO")" "$(shell_word "$R_branch")" "$(shell_word "$B_ref")"
}

do_reset_plan() {
    # The first pass of "reset": fetch, compare the branch with the one it
    # follows, decide. Nothing moves but the remote branches that the fetch
    # brings up to date. A repository with a move to make leaves a marker
    # for the second pass: the move, the branch, the two commits seen, the
    # two counts and whether the server rewrote its history.
    local gap rewritten=0 kind text hint state aside=""
    repo_begin || return 0
    if ! fetch_and_compare; then
        emit_update
        return 0
    fi
    if [ "$U_ahead" -eq 0 ] && [ "$U_behind" -eq 0 ]; then
        emit level 0 ""
        return 0
    fi
    gap=$(gap_words)
    if [ "$U_ahead" -gt 0 ] && server_rewrote; then
        rewritten=1
        gap="the history of the server was rewritten; $gap"
    fi
    if [ "$R_tracked" -gt 0 ]; then
        emit pending 1 "$gap, and uncommitted changes to tracked files: left to you"
        [ "$U_ahead" -gt 0 ] && details "$(incoming "$U_up" "$U_head" "$U_ahead")"
        return 0
    fi
    # What git does not track and stands where the server puts a file is
    # named: the move sets it aside, and keeps it.
    files_in_way "$U_head" "$U_up"
    if [ "$IW_n" -eq 1 ]; then
        aside="; $IW_words, which git does not track here, will make way for the version of the server and be kept"
    elif [ "$IW_n" -gt 1 ]; then
        aside="; $IW_n files that git does not track here ($IW_words) will make way for those of the server and be kept"
    fi
    if [ "$U_ahead" -eq 0 ]; then
        kind="fast-forward"
        emit planned 0 "take $(plural "$U_behind" "new commit") from the server$aside"
        details "$(incoming "$U_head" "$U_up" "$U_behind")"
    elif [ "$DISCARD_LOCAL" -eq 0 ]; then
        if [ "$U_behind" -eq 0 ]; then
            state="ahead"
            hint="--discard-local drops $( [ "$U_ahead" -eq 1 ] && printf 'it' || printf 'them' )"
        else
            state="diverged"
            hint="--discard-local drops those here"
        fi
        emit "$state" 1 "$gap: left to you ($hint)"
        details "$(incoming "$U_up" "$U_head" "$U_ahead")"
        return 0
    else
        kind="discard"
        text=$(drop_words)
        [ "$rewritten" -eq 1 ] && text="the history of the server was rewritten; $text"
        emit planned 0 "$text$aside"
        details "$(incoming "$U_up" "$U_head" "$U_ahead")"
    fi
    printf '%s\n' "$kind$US$R_branch$US$U_head$US$U_up$US$U_ahead$US$U_behind$US$rewritten" > "$TMP/rplan/$IDX.go"
    printf 'P%s%s\n' "$US" "$( [ "$kind" = "discard" ] && printf 1 || printf 0 )"
    return 0
}

render_reset_plan() {
    # render_reset_plan INDEX FILE: count the moves that the first pass of
    # "reset" planned; nothing is printed before every repository answered.
    local kind drops
    while IFS=$US read -r kind drops _; do
        [ "$kind" = "P" ] || continue
        PLAN_GO=$(( PLAN_GO + 1 ))
        [ "$drops" = "1" ] && PLAN_DROPS=$(( PLAN_DROPS + 1 ))
    done < "$2"
    return 0
}

reset_plan_words() {
    local text
    text="To do: a reset in $(plural "$PLAN_GO" repository)"
    if [ "$PLAN_DROPS" -gt 0 ] && [ "$PLAN_DROPS" -eq "$PLAN_GO" ]; then
        text="$text, dropping commits that the server lacks"
    elif [ "$PLAN_DROPS" -gt 0 ]; then
        text="$text, $PLAN_DROPS of them dropping commits that the server lacks"
    fi
    printf '%s.' "$text"
}

show_reset_plan() {
    # The list shown before a reset drops commits: what will be done, and
    # what is left aside and why.
    local i=0 count="${#REPOS[@]}"
    put_title "Plan:"
    while [ "$i" -lt "$count" ]; do
        if [ -f "$TMP/rplan/$i.res" ]; then
            read_record "$TMP/rplan/$i.res"
            if [ "$REC_state" = "planned" ] || [ "$REC_attention" = 1 ]; then
                print_record "$i"
            fi
        fi
        i=$(( i + 1 ))
    done
    put ""
    put_todo "$(reset_plan_words)"
    return 0
}

do_reset() {
    # The second pass of "reset": the move that the plan decided, made
    # only when the repository is still as the plan saw it, after its
    # commit is kept. A repository without a marker keeps the answer of the
    # plan.
    local p_kind p_branch p_head p_up p_ahead p_behind p_rewritten head up
    if [ ! -e "$TMP/rplan/$IDX.go" ]; then
        cat "$TMP/rplan/$IDX.res"
        return 0
    fi
    IFS=$US read -r p_kind p_branch p_head p_up p_ahead p_behind p_rewritten < "$TMP/rplan/$IDX.go"
    repo_begin || return 0
    if [ "$R_busy" -eq 1 ] || [ -n "$R_operation" ] || [ "$R_unmerged" -gt 0 ] || [ "$R_detached" -eq 1 ]; then
        emit unfinished 1 "its state changed since the plan: nothing was done"
        return 0
    fi
    if [ "$R_tracked" -gt 0 ]; then
        emit pending 1 "uncommitted changes to tracked files appeared since the plan: nothing was done"
        return 0
    fi
    head=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
    up=""
    [ -n "$R_up_ref" ] && up=$(g rev-parse -q --verify "$R_up_ref^{commit}" 2>/dev/null)
    if [ "$R_branch" != "$p_branch" ] || [ "$head" != "$p_head" ] || [ "$up" != "$p_up" ]; then
        emit unfinished 1 "its state changed since the plan: nothing was done"
        return 0
    fi
    if stopped; then
        emit interrupted 1 "stopped before the reset: nothing was changed"
        return 0
    fi
    U_state=""; U_attn=0; U_msg=""; U_details=""; U_move=""
    U_head=$head; U_up=$up; U_ahead=$p_ahead; U_behind=$p_behind
    clear_extras
    if ! keep_backup before-reset; then
        emit failed 1 "the commit could not be kept under refs/gh-batch ($B_why): nothing was changed"
        return 0
    fi
    net_setup
    if [ "$p_kind" = "discard" ]; then
        move_to_server
        if [ "$U_state" = "reset" ] && [ "$p_rewritten" = "1" ]; then
            U_msg="the history of the server was rewritten; $U_msg"
        fi
    else
        fast_forward
    fi
    case "$U_state" in
        updated|reset|halfupdated)
            U_msg="$U_msg; the commit before is kept as $B_ref"
            U_details="$U_details${U_details:+$NL}$(restore_line)"
            ;;
        *)
            drop_backup
            ;;
    esac
    emit_update
}

cmd_reset() {
    local i=0
    begin_command change
    no_repository && exit "$EX_OK"
    header ""
    PLAN_GO=0; PLAN_DROPS=0
    pool do_reset_plan rplan render_reset_plan
    if [ "$STOP" -eq 0 ] && [ "$PLAN_GO" -gt 0 ] && [ "$DRY_RUN" -eq 0 ]; then
        # Commits are dropped only after one confirmation; a fast-forward
        # loses nothing and needs none, as with pull.
        if [ "$PLAN_DROPS" -gt 0 ]; then
            show_before_asking show_reset_plan
            if ! confirmed; then
                put "Nothing was done."
                declined
                exit "$EX_OK"
            fi
            if [ "$PORCELAIN" -eq 0 ]; then
                put ""
                put_title "Done:"
            fi
        fi
        pool do_reset rwork render
        finish
    fi
    # Nothing to move, only a look, or a stop: the plan is the report.
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        [ -f "$TMP/rplan/$i.res" ] && render "$i" "$TMP/rplan/$i.res"
        i=$(( i + 1 ))
    done
    if [ "$DRY_RUN" -eq 1 ] && [ "$PLAN_GO" -gt 0 ] && [ "$PORCELAIN" -eq 0 ] && [ "$STOP" -eq 0 ]; then
        put ""
        put_todo "$(reset_plan_words) Nothing was changed (dry run)."
    fi
    finish
}

# ---------------------------------------------------------------------------
# clone: what an account or a layout file names and this machine lacks
# ---------------------------------------------------------------------------

clone_destination() {
    # The folder that receives the clones: --into, else the first folder of
    # the settings. A mass clone never falls back on the current folder.
    local dest=""
    if [ -n "$INTO" ]; then
        dest=$(expand_tilde "$INTO")
    elif [ -n "${GH_BATCH_ROOT:-}" ]; then
        dest=$(expand_tilde "$GH_BATCH_ROOT")
    elif [ "${#CFG_ROOTS[@]}" -gt 0 ]; then
        dest=${CFG_ROOTS[0]}
    else
        die "$EX_USAGE" "name the folder that receives the clones: --into DIR, or git config --global gh-batch.root DIR"
    fi
    if [ ! -d "$dest" ]; then
        [ -e "$dest" ] && die "$EX_USAGE" "$dest exists and is not a folder"
        mkdir -p "$dest" || die "$EX_USAGE" "cannot create $dest"
    fi
    DEST=$(cd "$dest" && pwd) || die "$EX_USAGE" "cannot enter $dest"
    if git -C "$DEST" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        die "$EX_USAGE" "$(short_path "$DEST") is inside a git repository: clones do not go there"
    fi
}

known_slugs() {
    # The GitHub names of every repository already under the destination,
    # whatever its folder: one line "name<US>index<US>remote<US>folder" per
    # remote, in $TMP/known. The folder is the one that holds the
    # repository, relative to the destination; a dot stands for the
    # destination itself.
    local i=0 name url slug folder
    : > "$TMP/known"
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        REPO=${REPOS[$i]}
        GIT=(git -C "$REPO")
        folder="."
        case "${NAMES[$i]}" in
            */*) folder=${NAMES[$i]%/*} ;;
        esac
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            for url in "$(g remote get-url "$name" 2>/dev/null)" "$(g config --get "remote.$name.url" 2>/dev/null)"; do
                slug=$(github_slug "$url")
                [ -n "$slug" ] &&
                    printf '%s%s%s%s%s%s%s\n' "$slug" "$US" "$i" "$US" "$name" "$US" "$folder" >> "$TMP/known"
            done
        done <<EOF
$(g remote 2>/dev/null)
EOF
        i=$(( i + 1 ))
    done
    return 0
}

is_known() {
    # is_known SLUG -> 0 when a repository under the destination has it
    local slug
    while IFS=$US read -r slug _; do
        [ "$slug" = "$1" ] && return 0
    done < "$TMP/known"
    return 1
}

clones_folder() {
    # clones_folder OWNER -> HELD, the folder under the destination that
    # holds the most clones of repositories of OWNER (a name in lower case),
    # the first one found when two hold as many: a dot for the destination
    # itself, nothing when no clone of OWNER is here. A clone is one whose
    # remote "origin" is of OWNER: a fork kept elsewhere, which only names
    # the repository it was forked from, says nothing of where OWNER lives.
    local owner="$1" slug index remote folder other seen="" folders="" n best=0
    HELD=""
    while IFS=$US read -r slug index remote folder; do
        [ "$remote" = "origin" ] || continue
        case "$slug" in
            "$owner"/*) ;;
            *)          continue ;;
        esac
        # The address of a remote is listed in its two forms: once is enough.
        case "$seen " in
            *" $index "*) continue ;;
        esac
        seen="$seen $index"
        folders="$folders$folder$NL"
    done < "$TMP/known"
    [ -n "$folders" ] || return 0
    while IFS= read -r folder; do
        [ -n "$folder" ] || continue
        n=0
        while IFS= read -r other; do
            [ "$other" = "$folder" ] && n=$(( n + 1 ))
        done <<EOF
$folders
EOF
        if [ "$n" -gt "$best" ]; then
            best=$n
            HELD=$folder
        fi
    done <<EOF
$folders
EOF
    return 0
}

tidy_folder() {
    # tidy_folder TEXT -> FOLDER, the folder of an owner as a path relative
    # to the destination, empty for the destination itself. Returns 1, with
    # the reason in WHY, when the text names no folder that can hold clones.
    local text rest part parts=0 path
    FOLDER=""; WHY=""
    text=$(expand_tilde "$1")
    case "$text" in
        *[[:cntrl:]]*)
            WHY="its name holds a control character"
            return 1
            ;;
    esac
    case "$text" in
        "$DEST"|"$DEST"/) text="." ;;
        "$DEST"/*)        text=${text#"$DEST"/} ;;
        /*)
            WHY="it lies outside $(short_path "$DEST")"
            return 1
            ;;
    esac
    rest=$text
    while [ -n "$rest" ]; do
        part=${rest%%/*}
        case "$rest" in
            */*) rest=${rest#*/} ;;
            *)   rest="" ;;
        esac
        case "$part" in
            ""|.) continue ;;
            ..)
                WHY="it leaves $(short_path "$DEST")"
                return 1
                ;;
            .*|node_modules)
                WHY="a hidden folder and node_modules are never searched for repositories"
                return 1
                ;;
        esac
        FOLDER="$FOLDER${FOLDER:+/}$part"
        parts=$(( parts + 1 ))
    done
    # The clones must stay within the levels that the other commands search.
    if [ "$parts" -ge "$DEPTH" ]; then
        WHY="it is too deep: repositories are searched $(plural "$DEPTH" level) below $(short_path "$DEST") (gh-batch.depth)"
        return 1
    fi
    path=$DEST
    rest=$FOLDER
    while [ -n "$rest" ]; do
        part=${rest%%/*}
        case "$rest" in
            */*) rest=${rest#*/} ;;
            *)   rest="" ;;
        esac
        path="$path/$part"
        if [ -e "$path/.git" ]; then
            WHY="$(short_path "$path") is a git repository itself"
            return 1
        fi
        if [ -e "$path" ] && [ ! -d "$path" ]; then
            WHY="$(short_path "$path") exists and is not a folder"
            return 1
        fi
    done
    return 0
}

may_ask() {
    # may_ask -> 0 when this run can put a question about an organisation:
    # somebody answers, and the run neither only looks nor writes for a
    # program.
    asks && answered && [ "$DRY_RUN" -eq 0 ] && [ "$PORCELAIN" -eq 0 ]
}

organisation_title() {
    # organisation_title LOGIN -> the organisation as a question names it:
    # the name it shows on GitHub when it has one, then its login. The name
    # is a text of somebody else: its control characters are dropped.
    local name
    name=$(GH_PROMPT_DISABLED=1 gh api "orgs/$1" --jq '.name // ""' 2>/dev/null | tr -d '\000-\037\177' | cut -c 1-60)
    if [ -n "$name" ] && [ "$name" != "$1" ]; then
        printf '%s (%s)' "$name" "$1"
    else
        printf '%s' "$1"
    fi
}

keep_setting() {
    # keep_setting KEY VALUE: write an answer into the settings of git, and
    # show the command that did it, which is also the one that changes it.
    # A value that begins with a dash would be read as an option.
    local value="$2"
    case "$value" in
        -*) value="./$value" ;;
    esac
    if git config --global "$1" "$value" 2>/dev/null; then
        printf '%s(kept: git config --global %s %s)%s\n' "$C_DIM" "$1" "$value" "$C_OFF" >&2
    else
        warn "the answer could not be written into the settings of git: it holds for this run only"
    fi
    return 0
}

ask_folder() {
    # ask_folder OWNER PROPOSED MISSING -> FOLDER: the one question about an
    # organisation that the account brought with it, put before anything is
    # cloned. Enter takes the folder proposed, a minus sign leaves the
    # organisation out, and the answer is kept in the settings of git, so
    # that the question does not return. Returns 1 when the organisation is
    # left out.
    local owner="$1" proposed="$2" missing="$3" shown="$2" verb="are" answer ended since
    [ "$missing" -eq 1 ] && verb="is"
    [ "$proposed" = "." ] && shown=". for $(short_path "$DEST") itself"
    printf '%s of the organisation %s %s missing here.\n' \
        "$(plural "$missing" repository)" "$(organisation_title "$owner")" "$verb" >&2
    while :; do
        printf '%sFolder for the organisation under %s%s [%s%s%s], or - to leave it out: ' \
            "$C_HEAD" "$(short_path "$DEST")" "$C_OFF" "$C_BOLD" "$shown" "$C_OFF" >&2
        answer=""
        ended=0
        ASKING=1
        since=$SECONDS
        IFS= read -r answer || [ -n "$answer" ] || ended=1
        RUN_START=$(( RUN_START + SECONDS - since ))
        ASKING=0
        # The end of the input is no answer, and neither is what follows an
        # interrupt: the run ends there, with nothing changed.
        if [ "$ended" -eq 1 ] || [ "$STOP" -eq 1 ]; then
            printf '\n' >&2
            put "Nothing was done."
            declined
            exit "$EX_OK"
        fi
        answer=${answer#"${answer%%[![:space:]]*}"}
        answer=${answer%"${answer##*[![:space:]]}"}
        [ -n "$answer" ] || answer=$proposed
        if [ "$answer" = "-" ]; then
            keep_setting "gh-batch.$owner.skip" true
            printf '\n' >&2
            return 1
        fi
        if tidy_folder "$answer"; then
            keep_setting "gh-batch.$owner.folder" "${FOLDER:-.}"
            printf '\n' >&2
            return 0
        fi
        printf 'This folder cannot be used: %s.\n' "$WHY" >&2
    done
}

place_owner() {
    # place_owner OWNER KIND MISSING -> FOLDER, the folder under the
    # destination that receives the repositories of an owner, empty for the
    # destination itself. The setting gh-batch.OWNER.folder decides. Without
    # it the folder is the one where clones of the owner already are, else
    # its name; and an organisation that the account brought with it (KIND
    # is "org") is asked for once, where somebody can answer. Returns 1 when
    # the answer leaves the organisation out, and 2, with the reason in WHY,
    # when the folder cannot be used.
    local owner="$1" kind="$2" missing="$3" proposed="$1"
    FOLDER=""; WHY=""
    owner_setting "$owner"
    if [ -n "$S_folder" ]; then
        tidy_folder "$S_folder" && return 0
        WHY="the folder '$S_folder' of gh-batch.$owner.folder cannot be used, $WHY"
        return 2
    fi
    # Forcing one folder per owner means the name of each, wherever its
    # clones happen to be.
    if [ "$LAYOUT" = "auto" ]; then
        clones_folder "$(lower "$owner")"
        [ -n "$HELD" ] && proposed=$HELD
    fi
    if [ "$kind" = "org" ] && may_ask; then
        ask_folder "$owner" "$proposed" "$missing"
        return "$?"
    fi
    tidy_folder "$proposed" && return 0
    WHY="the folder '$proposed' cannot be used, $WHY: git config --global gh-batch.$owner.folder NAME chooses another"
    return 2
}

organisations() {
    # organisations ACCOUNT -> ORG_LIST, the organisations that the account
    # belongs to, as GitHub spells them, without those that the setting
    # gh-batch.ORG.skip leaves out.
    local login
    ORG_LIST=()
    progress_note "reading the organisations of $1"
    if ! GH_PROMPT_DISABLED=1 gh api user/orgs --paginate --jq '.[].login' > "$TMP/orgs" 2> "$TMP/orgs.err"; then
        progress_clear
        warn "GitHub did not give the organisations of $1, which are left out: $(last_line "$TMP/orgs.err")"
        return 0
    fi
    progress_clear
    while IFS= read -r login || [ -n "$login" ]; do
        case "$login" in
            ""|.*|-*|*[!A-Za-z0-9._-]*) continue ;;
        esac
        owner_setting "$login"
        if [ "$S_skip" -eq 1 ]; then
            [ "$VERBOSE" -eq 1 ] && C_NOTES+=("the organisation $login is left out by gh-batch.$login.skip")
            continue
        fi
        ORG_LIST+=("$login")
    done < "$TMP/orgs"
    return 0
}

moved_here() {
    # moved_here FOLDER SLUG -> 0 when the repository in FOLDER is SLUG under
    # an older name: GitHub answers for a renamed or transferred repository
    # with its present name.
    local folder="$1" wanted="$2" name url slug now
    have gh || return 1
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        url=$(git -C "$folder" config --get "remote.$name.url" 2>/dev/null)
        slug=$(github_slug "$url")
        [ -n "$slug" ] || continue
        now=$(GH_PROMPT_DISABLED=1 gh api "repos/$slug" --jq .full_name 2>/dev/null | tr '[:upper:]' '[:lower:]')
        [ "$now" = "$wanted" ] && return 0
    done <<EOF
$(git -C "$folder" remote 2>/dev/null)
EOF
    return 1
}

clone_candidate() {
    # clone_candidate NAME ADDRESS TARGET SLUG SIZE_KB MARK BRANCH: decide
    # whether the repository is cloned, is present, or cannot be placed.
    local name="$1" url="$2" target="$3" slug="$4" size="$5" mark="$6" branch="$7" above
    if [ -e "$target/.git" ]; then
        if [ -z "$slug" ] || moved_here "$target" "$slug"; then
            C_PRESENT=$(( C_PRESENT + 1 ))
            [ -n "$slug" ] && C_NOTES+=("$name is here under an older address: git -C $(short_path "$target") remote set-url origin $url")
        else
            C_NOTES+=("$name is not cloned: the folder $(short_path "$target") holds another repository")
            C_BLOCKED=$(( C_BLOCKED + 1 ))
        fi
        return 0
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        if [ ! -d "$target" ] || [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
            C_NOTES+=("$name is not cloned: $(short_path "$target") exists and is not a repository")
            C_BLOCKED=$(( C_BLOCKED + 1 ))
            return 0
        fi
    fi
    # No folder between the destination and the clone may be a repository.
    above=${target%/*}
    while [ "${#above}" -gt "${#DEST}" ]; do
        if [ -e "$above/.git" ]; then
            C_NOTES+=("$name is not cloned: the folder $(short_path "$above") is a repository itself")
            C_BLOCKED=$(( C_BLOCKED + 1 ))
            return 0
        fi
        above=${above%/*}
    done
    REPOS+=("$target")
    NAMES+=("$name")
    C_URL+=("$url")
    C_BRANCH+=("$branch")
    C_MARK+=("$mark")
    is_uint "$size" || size=0
    C_SIZE+=("$size")
    C_TOTAL_KB=$(( C_TOTAL_KB + size ))
    return 0
}

matches_selection() {
    # The --only and --except patterns, applied to a name of the server.
    local saved_exclude=(${CFG_EXCLUDE[@]+"${CFG_EXCLUDE[@]}"}) rc
    CFG_EXCLUDE=()
    selected "$1"
    rc=$?
    CFG_EXCLUDE=(${saved_exclude[@]+"${saved_exclude[@]}"})
    return "$rc"
}

read_account() {
    # read_account OWNER SELF PROTOCOL KIND: list the repositories of an
    # owner on GitHub and sort them into present, to clone, and impossible
    # to place. KIND is "org" for an organisation that the account brought
    # with it: it may be left out, and a refusal of GitHub to list it does
    # not stop the others. KIND is "named" for the account itself and for an
    # owner named on the command line.
    local owner="$1" self="$2" protocol="$3" kind="$4" lines=0 wanted=0 present=0 missing=0 rc
    local slug fork archived private size pushed https ssh name spelled="" folder="" target url mark
    progress_note "reading the repositories of $owner"
    GH_PROMPT_DISABLED=1 gh repo list "$owner" --limit 4000 \
        --json nameWithOwner,isFork,isArchived,isPrivate,diskUsage,pushedAt,url,sshUrl \
        --jq '.[] | [.nameWithOwner, (.isFork|tostring), (.isArchived|tostring), (.isPrivate|tostring), (.diskUsage|tostring), (.pushedAt // ""), .url, .sshUrl] | join("\u001f")' \
        > "$TMP/list" 2> "$TMP/list.err"
    rc=$?
    progress_clear
    if [ "$rc" -ne 0 ]; then
        [ "$kind" = "org" ] ||
            die "$EX_ENV" "GitHub did not give the repositories of $owner: $(last_line "$TMP/list.err")"
        C_NOTES+=("the organisation $owner is left out: GitHub did not give its repositories ($(last_line "$TMP/list.err"))")
        ATTENTION=1
        return 0
    fi

    # First what is missing, whatever its place: the folder of the owner is
    # needed, and asked for, only when something is to be cloned.
    : > "$TMP/missing"
    while IFS=$US read -r slug fork archived private size pushed https ssh; do
        [ -n "$slug" ] || continue
        lines=$(( lines + 1 ))
        name=${slug#*/}
        case "$slug" in
            */*) ;;
            *)   continue ;;
        esac
        case "${slug%%/*}$name" in
            *[!A-Za-z0-9._-]*)
                warn "the name $slug holds an unexpected character and is left out"
                continue
                ;;
        esac
        case "$name" in
            .|..|.git)
                warn "the name $slug cannot be the name of a folder and is left out"
                continue
                ;;
        esac
        spelled=${slug%%/*}
        [ "$NO_FORKS" -eq 1 ] && [ "$fork" = "true" ] && continue
        [ "$NO_ARCHIVED" -eq 1 ] && [ "$archived" = "true" ] && continue
        if [ -n "$SINCE" ] && [ "${pushed%%T*}" \< "$SINCE" ]; then
            continue
        fi
        matches_selection "$name" || continue
        wanted=$(( wanted + 1 ))
        if is_known "$(lower "$slug")"; then
            present=$(( present + 1 ))
            continue
        fi
        missing=$(( missing + 1 ))
        printf '%s%s%s%s%s%s%s%s%s\n' "$slug" "$US" "$private" "$US" "$size" "$US" "$https" "$US" "$ssh" >> "$TMP/missing"
    done < "$TMP/list"
    [ "$lines" -ge 4000 ] &&
        warn "$owner has 4000 repositories or more: only the first 4000 were read"
    [ -n "$spelled" ] || spelled=$owner

    # The account itself goes to the top of the destination and any other
    # owner into a folder of its own; --flat and --by-owner make one rule
    # for all.
    if [ "$missing" -gt 0 ] && [ "$LAYOUT" != "flat" ]; then
        if [ "$LAYOUT" = "owner" ] || [ "$(lower "$spelled")" != "$self" ]; then
            place_owner "$spelled" "$kind" "$missing"
            case "$?" in
                0)  folder=$FOLDER ;;
                1)  return 0 ;;
                *)
                    [ "$kind" = "org" ] ||
                        die "$EX_USAGE" "the repositories of $spelled cannot be placed: $WHY"
                    C_NOTES+=("the organisation $spelled is left out: $WHY")
                    ATTENTION=1
                    return 0
                    ;;
            esac
        fi
    fi

    C_OWNERS+=("$spelled")
    C_LISTED=$(( C_LISTED + lines ))
    C_WANTED=$(( C_WANTED + wanted ))
    C_PRESENT=$(( C_PRESENT + present ))
    while IFS=$US read -r slug private size https ssh; do
        [ -n "$slug" ] || continue
        name=${slug#*/}
        target="$DEST/$name"
        if [ -n "$folder" ]; then
            target="$DEST/$folder/$name"
            name="$folder/$name"
        fi
        if [ "$protocol" = "ssh" ] && [ -n "$ssh" ]; then url=$ssh; else url=$https; fi
        mark="private"
        [ "$private" = "false" ] && mark="PUBLIC"
        clone_candidate "$name" "$url" "$target" "$(lower "$slug")" "$size" "$mark" ""
    done < "$TMP/missing"
    return 0
}

read_manifest() {
    # read_manifest FILE: the lines "folder, address, branch" of a layout
    # written by "list --manifest".
    local path url branch
    [ -f "$1" ] || die "$EX_USAGE" "no such layout file: $1"
    while IFS=$TAB read -r path url branch || [ -n "${path:-}" ]; do
        case "$path" in
            ""|"#"*) continue ;;
        esac
        C_LISTED=$(( C_LISTED + 1 ))
        case "/$path/" in
            *"/../"*|//*)
                warn "the folder $path of the layout leaves the destination and is left out"
                continue
                ;;
        esac
        case "$url" in
            ""|*"<hidden>"*)
                warn "$path has no usable address in the layout and is left out"
                continue
                ;;
        esac
        matches_selection "$path" || continue
        C_WANTED=$(( C_WANTED + 1 ))
        clone_candidate "$path" "$url" "$DEST/${path%/}" "" 0 "" "${branch:-}"
    done < "$1"
    return 0
}

megabytes() {
    # megabytes KILOBYTES -> "12 MB", or "under 1 MB"
    if [ "$1" -lt 1024 ]; then
        printf 'under 1 MB'
    else
        printf '%s MB' $(( ($1 + 512) / 1024 ))
    fi
}

sweep_leftovers() {
    # A clone is made under a temporary name beside its place. A name left
    # by a run that died is removed; the one of a run still alive is kept.
    local parent="$1" entry pid
    for entry in "$parent"/.gh-batch-clone.*; do
        [ -d "$entry" ] || continue
        pid=${entry##*.}
        if is_uint "$pid" && kill -0 "$pid" 2>/dev/null; then
            continue
        fi
        rm -rf "$entry"
    done
    return 0
}

do_clone() {
    # Clone one repository under a temporary name beside its place, then
    # give it its name: an interrupted run leaves nothing half-made.
    local target="$REPO" url="${C_URL[$IDX]}" branch="${C_BRANCH[$IDX]}" parent tmp rc note="" attention=0 first
    R_branch=""
    parent=${target%/*}
    if ! mkdir -p "$parent" 2>/dev/null; then
        emit failed 1 "cannot create the folder $(short_path "$parent")"
        return 0
    fi
    tmp="$parent/.gh-batch-clone.${target##*/}.$$"
    rm -rf "$tmp"
    if [ "$USER_SSH" -eq 0 ]; then
        export GIT_SSH_COMMAND="${GLOBAL_SSH:-ssh} -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
    fi
    spawn clone env GIT_LFS_SKIP_SMUDGE=1 git -c credential.interactive=false \
        -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 clone --quiet "$url" "$tmp"
    await net 0
    rc=$?
    if [ "$rc" -eq 130 ]; then
        rm -rf "$tmp"
        emit interrupted 1 "stopped during the clone: nothing was left behind"
        return 0
    fi
    if ! git -C "$tmp" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        rm -rf "$tmp"
        emit failed 1 "the clone failed: $(net_failure "$rc")"
        return 0
    fi
    if [ "$rc" -ne 0 ]; then
        # The history arrived but the files could not be written.
        note="; the files could not all be checked out ($(last_line "$ERR"))"
        attention=1
    fi
    [ -d "$target" ] && rmdir "$target" 2>/dev/null
    if [ -e "$target" ] || ! mv "$tmp" "$target" 2>/dev/null; then
        rm -rf "$tmp"
        emit failed 1 "the clone could not take its place at $(short_path "$target")"
        return 0
    fi
    REPO=$target
    GIT=(git -C "$REPO")
    # Large files kept with git-lfs were left as pointers by the clone, so
    # that a failed download cannot lose the clone itself; they come now.
    if have git-lfs; then
        first=""
        IFS= read -r first < <(g lfs ls-files 2>/dev/null)
        if [ -n "$first" ]; then
            run_net lfs "${GIT[@]}" lfs pull
            rc=$?
            if [ "$rc" -ne 0 ]; then
                note="$note; its large files were not downloaded: run git lfs pull in it"
                attention=1
            fi
        fi
    elif grep -qs 'filter=lfs' "$REPO/.gitattributes"; then
        note="$note; it keeps large files with git-lfs, which is not installed"
        attention=1
    fi
    if [ -n "$branch" ]; then
        R_branch=$(g symbolic-ref -q --short HEAD 2>/dev/null)
        if [ "$R_branch" != "$branch" ]; then
            if run_local checkout "${GIT[@]}" checkout --quiet "$branch"; then
                R_branch=$branch
            else
                note="$note; the branch $branch of the layout could not be checked out"
                attention=1
            fi
        fi
    else
        R_branch=$(g symbolic-ref -q --short HEAD 2>/dev/null)
    fi
    emit cloned "$attention" "into $(short_path "$target")$note"
    record_move clone "$(printf '%s' "$url" | redact)" ""
    return 0
}

show_clone_plan() {
    local i=0 line size="" mark_colour
    if [ "$C_TOTAL_KB" -ge 1024 ]; then
        size=" (about $(megabytes "$C_TOTAL_KB"))"
    elif [ "$C_TOTAL_KB" -gt 0 ]; then
        size=" (under 1 MB)"
    fi
    put_todo "Plan: clone $(plural "${#REPOS[@]}" repository) into $(short_path "$DEST")$size"
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        size=$( [ "${C_SIZE[$i]}" -gt 0 ] && megabytes "${C_SIZE[$i]}" )
        line=$(printf '  %-*s  %-8s %s' "$NAME_WIDTH" "${NAMES[$i]}" "${C_MARK[$i]}" "$size")
        case "${C_MARK[$i]}" in
            PUBLIC) mark_colour=$C_PUBLIC ;;
            *)      mark_colour=$C_DIM ;;
        esac
        put_styled "${line%"${line##*[! ]}"}" \
            "$(printf '  %s%s%s %s%-*s%s  %s%-8s%s %s%s%s' "$C_INFO" "$(mark planned)" "$C_OFF" "$C_NAME" "$NAME_WIDTH" "${NAMES[$i]}" "$C_OFF" "$mark_colour" "${C_MARK[$i]}" "$C_OFF" "$C_DIM" "$size" "$C_OFF")"
        i=$(( i + 1 ))
    done
    return 0
}

cmd_clone() {
    local owner self="" protocol="https" i saved_only=() saved_except=() note parent last=""
    local present_repos=() present_names=()
    setup_colour
    setup_run
    harden_git
    clone_destination
    GLOBAL_SSH=$(git config --global --includes --get core.sshCommand 2>/dev/null)
    case "$LAYOUT" in
        auto|flat|owner) ;;
        *) die "$EX_USAGE" "the layouts are auto, flat and owner, not '$LAYOUT'" ;;
    esac
    if [ -n "$SINCE" ]; then
        case "$SINCE" in
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
            *) die "$EX_USAGE" "--since takes a date written as 2026-01-31, not '$SINCE'" ;;
        esac
    fi

    # What is already under the destination, the selection left aside: a
    # repository filtered out is still one that must not be cloned again.
    saved_only=(${ONLY[@]+"${ONLY[@]}"})
    saved_except=(${EXCEPT[@]+"${EXCEPT[@]}"})
    ONLY=(); EXCEPT=()
    ARGS=("$DEST")
    discover
    ONLY=(${saved_only[@]+"${saved_only[@]}"})
    EXCEPT=(${saved_except[@]+"${saved_except[@]}"})
    present_repos=(${REPOS[@]+"${REPOS[@]}"})
    present_names=(${NAMES[@]+"${NAMES[@]}"})
    known_slugs

    REPOS=(); NAMES=()
    C_URL=(); C_BRANCH=(); C_MARK=(); C_SIZE=(); C_NOTES=(); C_OWNERS=()
    C_LISTED=0; C_WANTED=0; C_PRESENT=0; C_BLOCKED=0; C_TOTAL_KB=0
    if [ -n "$MANIFEST_IN" ]; then
        [ "${#OWNERS[@]}" -eq 0 ] || die "$EX_USAGE" "give either owners or --manifest FILE, not both"
        read_manifest "$MANIFEST_IN"
        note="$(plural "$C_LISTED" repository) in $(short_path "$MANIFEST_IN")"
    else
        have gh || die "$EX_ENV" "the GitHub CLI (gh) is needed to read an account: https://cli.github.com"
        self=$(GH_PROMPT_DISABLED=1 gh api user --jq .login 2>"$TMP/list.err" | tr '[:upper:]' '[:lower:]')
        [ -n "$self" ] || die "$EX_ENV" "gh is not logged in to GitHub (gh auth login): $(last_line "$TMP/list.err")"
        protocol=$(GH_PROMPT_DISABLED=1 gh config get git_protocol 2>/dev/null)
        if [ "${#OWNERS[@]}" -gt 0 ]; then
            for owner in "${OWNERS[@]}"; do
                read_account "$owner" "$self" "$protocol" named
            done
        else
            # Nobody is named: the account, then the organisations it
            # belongs to.
            read_account "$self" "$self" "$protocol" named
            if [ "$ORGS" -eq 1 ]; then
                organisations "$self"
                for owner in ${ORG_LIST[@]+"${ORG_LIST[@]}"}; do
                    read_account "$owner" "$self" "$protocol" org
                done
            fi
        fi
        note="$(plural "$C_LISTED" repository) of $(enumerate ${C_OWNERS[@]+"${C_OWNERS[@]}"}) on GitHub"
    fi
    fit_names

    if [ "$PORCELAIN" -eq 0 ]; then
        # The counts that follow concern the repositories that the filters
        # kept, which the first words say when they kept fewer.
        [ "$C_WANTED" -lt "$C_LISTED" ] && note="$note, $C_WANTED of them selected"
        put_styled "$PROG clone: $note; $C_PRESENT already under $(short_path "$DEST"), ${#REPOS[@]} to clone" \
            "$(title_band "$PROG clone") $note; $C_PRESENT already under $(short_path "$DEST"), ${#REPOS[@]} to clone"
        put ""
        for note in ${C_NOTES[@]+"${C_NOTES[@]}"}; do
            put_wrapped "  note: " "  ${C_INFO}note:$C_OFF " 8 as_is "$note"
        done
        [ "${#C_NOTES[@]}" -gt 0 ] && put ""
    fi
    [ "$C_BLOCKED" -gt 0 ] && ATTENTION=1

    if [ "${#REPOS[@]}" -gt 0 ]; then
        if [ "$DRY_RUN" -eq 1 ]; then
            if [ "$PORCELAIN" -eq 1 ]; then
                i=0
                while [ "$i" -lt "${#REPOS[@]}" ]; do
                    printf 'planned\t%s\t\t%s\n' "${REPOS[$i]}" "$(printf '%s' "${C_URL[$i]}" | redact)"
                    i=$(( i + 1 ))
                done
            else
                show_clone_plan
                put ""
                put "Nothing was cloned (dry run)."
            fi
        else
            show_before_asking show_clone_plan
            take_lock
            if ! confirmed; then
                put "Nothing was done."
                declined
                exit "$EX_OK"
            fi
            [ "$PORCELAIN" -eq 0 ] && put ""
            # What a run that died left behind, in every folder that is
            # about to receive a clone.
            sweep_leftovers "$DEST"
            i=0
            while [ "$i" -lt "${#REPOS[@]}" ]; do
                parent=${REPOS[$i]%/*}
                if [ "$parent" != "$last" ] && [ -d "$parent" ]; then
                    sweep_leftovers "$parent"
                fi
                last=$parent
                i=$(( i + 1 ))
            done
            [ "$JOBS" -gt 4 ] && [ "$SRC_jobs" = "default" ] && JOBS=4
            pool do_clone clone render
            summary
        fi
    elif [ "$PORCELAIN" -eq 0 ]; then
        put "Nothing is missing."
    fi

    if [ "$UPDATE" -eq 1 ] && [ "$STOP" -eq 0 ] && [ "${#present_repos[@]}" -gt 0 ]; then
        # The repositories that were there before are brought forward, as
        # "pull" does.
        REPOS=(); NAMES=()
        i=0
        while [ "$i" -lt "${#present_repos[@]}" ]; do
            if selected "${present_names[$i]}"; then
                REPOS+=("${present_repos[$i]}")
                NAMES+=("${present_names[$i]}")
            fi
            i=$(( i + 1 ))
        done
        if [ "${#REPOS[@]}" -gt 0 ]; then
            reset_tally
            fit_names
            [ "$DRY_RUN" -eq 1 ] && ONLY_LOOK=1
            [ "$LOCKED" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && take_lock
            pick GH_BATCH_JOBS "$CFG_jobs" 8 "$OPT_JOBS"
            JOBS=$VAL
            if [ "$PORCELAIN" -eq 0 ]; then
                put ""
                put_title "Then, the pull of the $(plural "${#REPOS[@]}" repository) already here:"
            fi
            pool do_pull pull render
            [ "$STOP" -eq 0 ] && [ "$ONLY_LOOK" -eq 0 ] && remember_run pull
            summary
        fi
    fi
    notify
    [ "$STOP" -eq 1 ] && exit "$EX_INTERRUPT"
    [ "$ATTENTION" -eq 1 ] && exit "$EX_ATTENTION"
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# log: the commits of a period across the repositories
# ---------------------------------------------------------------------------

do_log() {
    # One line "L" per commit of the period on a local branch: epoch, date,
    # short hash, author, subject.
    local author line n=0 args
    repo_begin || return 0
    if [ "$R_unborn" -eq 1 ]; then
        emit quiet 0 ""
        return 0
    fi
    args=(log --branches HEAD --no-merges --reverse "--since=$LOG_SINCE"
        "--date=format-local:$LOG_DATE" "--format=%ct%x1f%cd%x1f%h%x1f%an%x1f%s")
    [ -n "$LOG_UNTIL" ] && args+=("--until=$LOG_UNTIL")
    if [ "$ALL_AUTHORS" -eq 0 ]; then
        author=$LOG_AUTHOR
        [ -n "$author" ] || author=$(g config --get user.email 2>/dev/null)
        [ -n "$author" ] && args+=(--fixed-strings "--author=$author")
    fi
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        n=$(( n + 1 ))
        printf 'L%s%s\n' "$US" "$line"
    done <<EOF
$(g "${args[@]}" 2>/dev/null)
EOF
    if [ "$n" -eq 0 ]; then
        emit quiet 0 ""
    else
        emit active 0 "$(plural "$n" commit)"
    fi
    return 0
}

render_log() {
    # render_log INDEX FILE: the commits of one repository, oldest first.
    local idx="$1" kind a b c d e state="" branch="" message="" n=0 shown=0 line limit=50 width=100
    if [ "$LONG" -eq 1 ]; then
        limit=1000000
        width=1000000
    fi
    while IFS=$US read -r kind a b c d e; do
        [ "$kind" = "S" ] && { state=$a; branch=$c; message=$d; }
    done < "$2"
    case "$state" in
        ignored|skipped|"") return 0 ;;
        unreadable)
            TOTAL=$(( TOTAL + 1 ))
            ATTENTION=1
            put_repo unreadable 1 "${NAMES[$idx]}" "" "$message"
            return 0
            ;;
    esac
    TOTAL=$(( TOTAL + 1 ))
    [ "$state" = "active" ] || return 0
    LOG_REPOS=$(( LOG_REPOS + 1 ))
    [ "$PORCELAIN" -eq 1 ] || put_repo active 0 "${NAMES[$idx]}" "$branch" "$message"
    while IFS=$US read -r kind a b c d e; do
        [ "$kind" = "L" ] || continue
        n=$(( n + 1 ))
        LOG_COMMITS=$(( LOG_COMMITS + 1 ))
        if [ "$PORCELAIN" -eq 1 ]; then
            printf '%s\t%s\t%s\t%s\t%s\n' "$a" "${REPOS[$idx]}" "$c" "$d" "$e"
            continue
        fi
        [ "$n" -gt "$limit" ] && continue
        shown=$n
        line="$b  $c  $(clip "$e" "$width")"
        [ "$ALL_AUTHORS" -eq 1 ] && line="$line  ($d)"
        put_detail "$line" 0 style_log
    done < "$2"
    if [ "$PORCELAIN" -eq 0 ] && [ "$n" -gt "$shown" ]; then
        put_detail "... and $(( n - shown )) more (all of them with --long)" 0
    fi
    return 0
}

cmd_log() {
    local period="since $LOG_SINCE"
    LOG_COMMITS=0; LOG_REPOS=0
    if [ -z "$LOG_SINCE" ]; then
        LOG_SINCE="midnight"
        LOG_DATE="%H:%M"
        period="today"
    else
        LOG_DATE="%Y-%m-%d %H:%M"
    fi
    [ -n "$LOG_UNTIL" ] && period="$period until $LOG_UNTIL"
    begin_command read
    no_repository && exit "$EX_OK"
    header ""
    pool do_log log render_log
    if [ "$PORCELAIN" -eq 0 ]; then
        [ "$LOG_COMMITS" -gt 0 ] && put ""
        if [ "$LOG_COMMITS" -eq 0 ]; then
            put_styled "No commit $period in the $(plural "$TOTAL" repository) under $ROOT_LABEL." \
                "${C_DIM}No commit $period in the $(plural "$TOTAL" repository) under $ROOT_LABEL.$C_OFF"
        else
            put_styled "$(plural "$LOG_COMMITS" commit) in $(plural "$LOG_REPOS" repository) $period." \
                "$C_HEAD$(plural "$LOG_COMMITS" commit) in $(plural "$LOG_REPOS" repository) $period$C_OFF."
        fi
    fi
    [ "$STOP" -eq 1 ] && exit "$EX_INTERRUPT"
    [ "$ATTENTION" -eq 1 ] && exit "$EX_ATTENTION"
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# exec: a command of the user in every repository
# ---------------------------------------------------------------------------

chosen_by_state() {
    # The filters --dirty, --clean, --ahead and --behind, for the repository
    # just inspected. Without a filter every repository is chosen.
    local pending=$(( R_tracked + R_untracked + R_unmerged ))
    [ "$F_DIRTY" -eq 1 ] && [ "$pending" -eq 0 ] && return 1
    [ "$F_CLEAN" -eq 1 ] && [ "$pending" -gt 0 ] && return 1
    [ "$F_AHEAD" -eq 1 ] && [ "${R_ahead:-0}" -eq 0 ] && return 1
    [ "$F_BEHIND" -eq 1 ] && [ "${R_behind:-0}" -eq 0 ] && return 1
    return 0
}

do_exec() {
    # Run the command in the repository, its two outputs together, with the
    # path and the name of the repository in the environment.
    local rc
    repo_begin || return 0
    if ! chosen_by_state; then
        emit ignored 0 ""
        return 0
    fi
    export GH_BATCH_REPO="$REPO"
    export GH_BATCH_NAME="$NAME"
    # shellcheck disable=SC2016  # the inner shell expands its own arguments
    spawn exec sh -c 'cd "$1" && shift && unset GIT_OPTIONAL_LOCKS && exec "$@" 2>&1' sh "$REPO" "${EXEC_CMD[@]}"
    await net "$EXEC_LIMIT"
    rc=$?
    case "$rc" in
        0)   emit ok 0 "" ;;
        124) emit failed 1 "no end within $EXEC_LIMIT s: the command was stopped" ;;
        125) emit failed 1 "the command waited for the terminal and was stopped" ;;
        130) emit interrupted 1 "stopped" ;;
        127) emit failed 1 "the command was not found" ;;
        *)   emit failed 1 "exit status $rc" ;;
    esac
    # The first 500 lines of what the command wrote, as lines of detail.
    awk -v us="$US" '
        NR <= 500 { gsub(/[\r\t\037]/, " "); print "D" us $0 }
        END { if (NR > 500) print "D" us "... and " (NR - 500) " more lines" }
    ' "$OUT"
    return 0
}

render_exec() {
    # render_exec INDEX FILE: a repository is shown when the command wrote
    # something there or failed; the others are only counted.
    local idx="$1"
    read_record "$2"
    [ "$REC_state" = "ignored" ] && return 0
    TOTAL=$(( TOTAL + 1 ))
    tally "$REC_state"
    [ "$REC_attention" = 1 ] && note_attention "$idx" "$REC_state"
    if [ "$PORCELAIN" -eq 1 ]; then
        printf '%s\t%s\t%s\t%s\n' "$REC_state" "${REPOS[$idx]}" "$REC_branch" "$REC_message"
        return 0
    fi
    if [ "${#REC_lines[@]}" -eq 0 ] && [ "$REC_attention" != 1 ] && [ "$VERBOSE" -eq 0 ]; then
        return 0
    fi
    print_record "$idx"
    return 0
}

cmd_exec() {
    local name
    [ "${#EXEC_CMD[@]}" -gt 0 ] ||
        die "$EX_USAGE" "exec needs a command: $PROG exec [options] [--in folder or name] -- COMMAND [ARGUMENT ...]"
    EXEC_LIMIT=${OPT_TIMEOUT:-0}
    EXEC_OUTPUT=1
    setup_colour
    setup_run
    for name in $(git rev-parse --local-env-vars 2>/dev/null); do
        unset "$name"
    done
    export GIT_OPTIONAL_LOCKS=0
    discover
    no_repository && exit "$EX_OK"
    header ""
    pool do_exec exec render_exec
    finish
}

# ---------------------------------------------------------------------------
# doctor: what is wrong, or will be, in the repositories and around them
# ---------------------------------------------------------------------------

finding() {
    # finding LEVEL TEXT: one line of the diagnosis; a problem needs the
    # user, a warning is worth knowing.
    printf 'D%s%s: %s\n' "$US" "$1" "$(one_line "$2")"
    [ "$1" = "problem" ] && D_problems=$(( D_problems + 1 ))
    [ "$1" = "warning" ] && D_warnings=$(( D_warnings + 1 ))
    return 0
}

doctor_remotes() {
    # The remotes of the repository: an address that carries a password, one
    # that travels unencrypted, and what GitHub says of each.
    local name url slug answer now archived seen="" authority k=0 fresh parent base
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        url=$(g config --get "remote.$name.url" 2>/dev/null)
        case "$url" in
            http://*|https://*)
                authority=${url#*://}
                authority=${authority%%/*}
                case "$authority" in
                    *:*@*|ghp_*@*|gho_*@*|ghs_*@*|github_pat_*@*|glpat-*@*)
                        finding problem "the address of the remote $name holds a password or a token: keep it in a credential helper instead" ;;
                esac
                ;;
        esac
        case "$url" in
            http://*|git://*) finding warning "the remote $name is reached without encryption ($(printf '%s' "${url%%://*}"))" ;;
        esac
        [ "$OFFLINE" -eq 1 ] && continue
        have gh || continue
        slug=$(github_slug "$(g remote get-url "$name" 2>/dev/null)")
        [ -n "$slug" ] || slug=$(github_slug "$url")
        [ -n "$slug" ] || continue
        case "$seen " in *" $slug "*) continue ;; esac
        seen="$seen $slug"
        k=$(( k + 1 ))
        spawn "github$k" env GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh api "repos/$slug" \
            --jq '[.full_name, (.archived|tostring), (.parent.full_name // ""), (.parent.default_branch // "")] | join("\u001f")'
        if await net 20; then
            now=""; archived=""; parent=""; base=""
            IFS=$US read -r now archived parent base < "$OUT" || true
            # The remote that the branch follows, when it is a fork, is
            # compared with its original.
            if [ -n "$parent" ] && [ "$name" = "${R_up_remote:-origin}" ]; then
                fork_gap "$parent" "$base"
            fi
            answer=$(printf '%s' "$now" | tr '[:upper:]' '[:lower:]')
            if [ -n "$answer" ] && [ "$answer" != "$slug" ]; then
                case "$url" in
                    *://*) fresh="https://${GH_HOST:-github.com}/$now" ;;
                    *)     fresh="git@${GH_HOST:-github.com}:$now.git" ;;
                esac
                finding warning "the remote $name moved on GitHub to $now: git remote set-url $name $fresh"
            fi
            [ "$archived" = "true" ] && finding warning "$now is archived on GitHub: it takes no push"
        elif grep -q -i -E 'not found|404' "$ERR" 2>/dev/null; then
            finding problem "GitHub does not know $slug (remote $name): deleted, renamed without a trace, or closed to this account"
        else
            finding warning "GitHub could not be asked about $slug: $(last_line "$ERR")"
        fi
    done <<EOF
$(g remote 2>/dev/null)
EOF
    return 0
}

do_doctor() {
    local age first stashes limit=$(( DOCTOR_DAYS * 86400 )) state="healthy" attention=0 text=""
    D_problems=0; D_warnings=0
    GIT=(git -C "$REPO" -c credential.interactive=false -c submodule.recurse=false)
    if ! inspect; then
        if [ -n "$R_problem" ]; then
            emit problem 1 "git cannot read it: $R_problem"
        else
            emit ignored 0 ""
        fi
        return 0
    fi
    repo_settings
    if [ "$R_worktree" -eq 1 ]; then
        emit skipped 0 "a linked worktree: its main repository is the one examined"
        return 0
    fi
    net_setup
    {
        [ "$R_skip" -eq 1 ] && finding note "set aside by gh-batch.skip: no command touches it"
        [ "$R_pullonly" -eq 1 ] && finding note "update-only (gh-batch.pullOnly): never committed or pushed"
        [ -n "$R_operation" ] && finding problem "$R_operation is in progress: finish or abort it"
        [ "$R_unmerged" -gt 0 ] && finding problem "$(plural "$R_unmerged" file) with unresolved conflicts"
        [ "$R_busy" -eq 1 ] && finding warning "an index.lock is present: a git process is at work, or died there"
        if [ "$R_remotes" -eq 0 ]; then
            finding warning "no remote: the repository exists on this machine only"
        elif [ "$R_detached" -eq 1 ]; then
            finding warning "HEAD is detached: new commits would belong to no branch"
        elif [ "$R_unborn" -eq 0 ] && [ -z "$R_upstream" ]; then
            finding warning "the branch $R_branch follows no branch of a server: it is never pulled or pushed"
        elif [ "$R_unborn" -eq 0 ] && [ -z "$R_ahead" ]; then
            finding problem "the branch $R_upstream that $R_branch follows is gone"
        fi
        if [ $(( R_tracked + R_untracked )) -gt 0 ]; then
            age=$(oldest_change)
            if [ -n "$age" ] && [ "$age" -gt "$limit" ]; then
                finding warning "$(describe_pending) pending, the oldest since $(age_text "$age")"
            fi
        fi
        if is_uint "${R_ahead:-}" && [ "$R_ahead" -gt 0 ]; then
            first=""
            IFS= read -r first < <(g log --format=%ct --reverse "$R_upstream..HEAD" 2>/dev/null)
            if is_uint "$first" && [ $(( NOW - first )) -gt "$limit" ]; then
                finding warning "$(plural "$R_ahead" commit) not pushed, the oldest since $(age_text $(( NOW - first )))"
            fi
        fi
        stashes=$(count_stashes)
        [ "$stashes" -gt 0 ] && finding warning "$(plural "$stashes" stash): what is stashed stays on this machine"
        [ "$R_shallow" -eq 1 ] && finding note "a shallow clone: its history is cut"
        if ! g var GIT_COMMITTER_IDENT >/dev/null 2>&1; then
            finding warning "git does not know your name and e-mail here: no commit can be made"
        fi
        if grep -qs 'filter=lfs' "$REPO/.gitattributes" && ! have git-lfs; then
            finding warning "it keeps large files with git-lfs, which is not installed"
        fi
        doctor_leftovers
        doctor_remotes
    } > "$W/findings"
    if [ "$D_problems" -gt 0 ]; then
        state="problem"; attention=1
        text="$(plural "$D_problems" problem)"
        [ "$D_warnings" -gt 0 ] && text="$text, $(plural "$D_warnings" warning)"
    elif [ "$D_warnings" -gt 0 ]; then
        state="warning"
        text="$(plural "$D_warnings" warning)"
    fi
    emit "$state" "$attention" "$text"
    cat "$W/findings"
    return 0
}

doctor_around() {
    # What is wrong around the repositories: folders and files of the
    # workspace that no repository holds, leftovers of interrupted runs.
    local root entry base covered i n
    for root in ${ROOTS_ABS[@]+"${ROOTS_ABS[@]}"}; do
        [ -e "$root/.git" ] && continue
        n=0
        for entry in "$root"/*; do
            [ -e "$entry" ] || continue
            base=${entry##*/}
            if [ ! -d "$entry" ]; then
                n=$(( n + 1 ))
                continue
            fi
            [ -e "$entry/.git" ] && continue
            covered=0
            i=0
            while [ "$i" -lt "${#ALL_REPOS[@]}" ]; do
                case "${ALL_REPOS[$i]}" in
                    "$entry"/*) covered=1; break ;;
                esac
                i=$(( i + 1 ))
            done
            if [ "$covered" -eq 0 ] && [ -n "$(ls -A "$entry" 2>/dev/null)" ]; then
                AROUND+=("the folder $(short_path "$entry") holds no git repository within $(plural "$DEPTH" level): git saves nothing of it")
            fi
        done
        [ "$n" -gt 0 ] &&
            AROUND+=("$(plural "$n" file) directly in $(short_path "$root") belong to no repository")
        for entry in "$root"/.gh-batch-clone.* "$root"/*/.gh-batch-clone.* "$root"/*/*/.gh-batch-clone.*; do
            [ -d "$entry" ] || continue
            AROUND+=("$(short_path "$entry") is the leftover of an interrupted clone: the next clone removes it")
        done
    done
    return 0
}

cmd_doctor() {
    local line
    is_uint "$DOCTOR_DAYS" || die "$EX_USAGE" "--days takes a number of days, not '$DOCTOR_DAYS'"
    begin_command read
    no_repository && exit "$EX_OK"
    header ""
    if [ "$OFFLINE" -eq 0 ] && have gh; then
        mkdir -p "$TMP/forkgap"
    fi
    pool do_doctor doctor render
    AROUND=()
    doctor_around
    if [ "$PORCELAIN" -eq 0 ] && [ "${#AROUND[@]}" -gt 0 ]; then
        [ "$SHOWN" -eq 1 ] && put ""
        put_title "Around the repositories:"
        for line in "${AROUND[@]}"; do
            put_finding warning "$line"
        done
        SHOWN=1
    fi
    if [ "$PORCELAIN" -eq 0 ] && [ "$OFFLINE" -eq 0 ] && ! have gh; then
        [ "$SHOWN" -eq 1 ] && put ""
        put_styled "GitHub was not asked: gh is not installed." "${C_DIM}GitHub was not asked: gh is not installed.$C_OFF"
        SHOWN=1
    fi
    [ "$STOP" -eq 0 ] && fork_section
    finish
}

# ---------------------------------------------------------------------------
# Forks: how far each one stands from the repository it was forked from
# ---------------------------------------------------------------------------

forks_wanted() {
    # 0 when this run speaks of forks: GitHub may be asked, through gh.
    [ "$OFFLINE" -eq 0 ] && have gh
}

forks_prepare() {
    # Before the workers of "fetch": the forks of the owners met among the
    # remotes, as GitHub lists them, one question per owner. They go to
    # $TMP/forks.list, one per line: the fork in lower case and its
    # original as GitHub spells it.
    local i=0 url slug owner owners="" fork parent
    mkdir -p "$TMP/forkgap"
    : > "$TMP/forks.list"
    forks_wanted || return 0
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        url=$(git -C "${REPOS[$i]}" config --get remote.origin.url 2>/dev/null)
        slug=$(github_slug "$url")
        if [ -n "$slug" ]; then
            owner=${slug%%/*}
            case "$US$owners" in
                *"$US$owner$US"*) ;;
                *) owners="$owners$owner$US" ;;
            esac
        fi
        i=$(( i + 1 ))
    done
    : > "$TMP/forks.raw"
    while [ -n "$owners" ]; do
        owner=${owners%%"$US"*}
        owners=${owners#*"$US"}
        progress_note "reading the forks of $owner"
        GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh repo list "$owner" --fork --limit 4000 \
            --json nameWithOwner,parent \
            --jq '.[] | select(.parent != null) | [.nameWithOwner, (.parent.owner.login + "/" + .parent.name)] | join("\u001f")' \
            >> "$TMP/forks.raw" 2>/dev/null
        progress_clear
    done
    while IFS=$US read -r fork parent; do
        [ -n "$fork" ] && [ -n "$parent" ] || continue
        printf '%s%s%s\n' "$(lower "$fork")" "$US" "$parent" >> "$TMP/forks.list"
    done < "$TMP/forks.raw"
    return 0
}

fork_parent() {
    # fork_parent SLUG -> the original of the fork SLUG (lower case), as
    # forks_prepare found it, or nothing.
    local fork parent
    [ -n "$1" ] && [ -s "$TMP/forks.list" ] || return 0
    while IFS=$US read -r fork parent; do
        if [ "$fork" = "$1" ]; then
            printf '%s' "$parent"
            return 0
        fi
    done < "$TMP/forks.list"
    return 0
}

fork_gap() {
    # fork_gap PARENT [BASE]: in a worker, for a fork of PARENT, ask GitHub
    # how far the branch that this clone follows stands from the default
    # branch of the original (BASE, asked for when not given). The answer
    # goes to $TMP/forkgap/INDEX for the section "Forks" of the report.
    local parent="$1" base="${2:-}" slug owner branch ahead="" behind=""
    [ -n "$parent" ] && [ -d "$TMP/forkgap" ] || return 0
    [ -n "$R_up_rref" ] || return 0
    slug=$(remote_slug "${R_up_remote:-origin}")
    owner=${slug%%/*}
    branch=${R_up_rref#refs/heads/}
    [ -n "$owner" ] && [ -n "$branch" ] || return 0
    if [ -z "$base" ]; then
        spawn forkbase env GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh api "repos/$parent" --jq .default_branch
        await net 20 || return 0
        IFS= read -r base < "$OUT" || true
        [ -n "$base" ] || return 0
    fi
    spawn forkgap env GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh api "repos/$parent/compare/$base...$owner:$branch" \
        --jq '[(.ahead_by|tostring), (.behind_by|tostring)] | join("\u001f")'
    await net 20 || return 0
    IFS=$US read -r ahead behind < "$OUT" || true
    { is_uint "$ahead" && is_uint "$behind"; } || return 0
    printf '%s%s%s%s%s%s%s%s%s%s%s\n' "$parent" "$US" "$base" "$US" "$owner" "$US" "$branch" \
        "$US" "$ahead" "$US" "$behind" > "$TMP/forkgap/$IDX"
    return 0
}

fork_words() {
    # fork_words PARENT OWNER BRANCH AHEAD BEHIND: the gap between a fork
    # and its original in words, in FW_text, and the command that offers
    # the commits of the fork to the original, in FW_cmd after its label
    # FW_label; FW_text is empty when there is no gap.
    local parent="$1" head="$2:$3" ahead="$4" behind="$5"
    FW_text=""; FW_label=""; FW_cmd=""
    if [ "$behind" -gt 0 ]; then
        FW_text="the original $parent has $(plural "$behind" commit) that this fork lacks"
    fi
    if [ "$ahead" -gt 0 ]; then
        if [ -n "$FW_text" ]; then
            FW_text="$FW_text, and this fork has $ahead that the original lacks"
        else
            FW_text="this fork has $(plural "$ahead" commit) that its original $parent lacks"
        fi
        FW_label="to offer $( [ "$ahead" -eq 1 ] && printf 'it' || printf 'them' ):"
        FW_cmd="gh pr create --repo $parent --head $head"
    fi
    return 0
}

put_forks() {
    # put_forks TITLE: the section of the forks gathered in F_names,
    # F_texts, F_labels and F_cmds, one item each, with the command that
    # offers the commits of the fork on a line of its own under it.
    local k=0
    [ "${#F_names[@]}" -gt 0 ] || return 0
    [ "$SHOWN" -eq 1 ] && put ""
    put_title "$1"
    while [ "$k" -lt "${#F_names[@]}" ]; do
        put_item "$C_BULLET$BULLET$C_OFF" "${F_names[$k]}" "${F_texts[$k]}"
        [ -n "${F_cmds[$k]}" ] && put_command 6 "${F_labels[$k]}" "${F_cmds[$k]}"
        k=$(( k + 1 ))
    done
    SHOWN=1
    return 0
}

fork_section() {
    # After the report of "fetch" or "doctor": the forks whose branch and
    # original differ. The answers also go to the record that "status"
    # reads, $STATE_DIR/forks.tsv.
    local i=0 parent base owner branch ahead behind
    F_names=(); F_texts=(); F_labels=(); F_cmds=()
    [ -d "$TMP/forkgap" ] || return 0
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        if [ -f "$TMP/forkgap/$i" ]; then
            IFS=$US read -r parent base owner branch ahead behind < "$TMP/forkgap/$i"
            fork_words "$parent" "$owner" "$branch" "$ahead" "$behind"
            if [ -n "$FW_text" ]; then
                F_names+=("${NAMES[$i]}"); F_texts+=("$FW_text"); F_labels+=("$FW_label"); F_cmds+=("$FW_cmd")
            fi
        fi
        i=$(( i + 1 ))
    done
    fork_record
    [ "$PORCELAIN" -eq 0 ] || return 0
    put_forks "Forks:"
    return 0
}

fork_record() {
    # The record of the forks that "status" shows without the network: the
    # lines of the repositories of this run are replaced by what GitHub
    # answered now. One line per fork: path, original, owner:branch,
    # commits of the fork that the original lacks, commits of the original
    # that the fork lacks, date, separated by tabs.
    local file="$STATE_DIR/forks.tsv" i path rest keep parent base owner branch ahead behind
    [ -n "$STATE_DIR" ] || return 0
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    : > "$TMP/forks.tsv"
    if [ -f "$file" ]; then
        while IFS= read -r path; do
            [ -n "$path" ] || continue
            rest=${path#*"$TAB"}
            path=${path%%"$TAB"*}
            keep=1
            i=0
            while [ "$i" -lt "${#REPOS[@]}" ]; do
                if [ "${REPOS[$i]}" = "$path" ]; then
                    keep=0
                    break
                fi
                i=$(( i + 1 ))
            done
            [ "$keep" -eq 1 ] && printf '%s\t%s\n' "$path" "$rest" >> "$TMP/forks.tsv"
        done < "$file"
    fi
    i=0
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        if [ -f "$TMP/forkgap/$i" ]; then
            IFS=$US read -r parent base owner branch ahead behind < "$TMP/forkgap/$i"
            printf '%s\t%s\t%s:%s\t%s\t%s\t%s\n' "${REPOS[$i]}" "$parent" "$owner" "$branch" "$ahead" "$behind" "$TODAY" >> "$TMP/forks.tsv"
        fi
        i=$(( i + 1 ))
    done
    if [ -s "$TMP/forks.tsv" ]; then
        cp "$TMP/forks.tsv" "$file.new" 2>/dev/null && mv -f "$file.new" "$file" 2>/dev/null
    else
        rm -f "$file"
    fi
    return 0
}

fork_section_seen() {
    # For "status", which uses no network: the gaps of the forks as "fetch"
    # or "doctor" last saw them, with the day, named once in the title
    # when it is the same for all.
    local file="$STATE_DIR/forks.tsv" i=0 k line path parent head ahead behind date dates=() same=1
    F_names=(); F_texts=(); F_labels=(); F_cmds=()
    [ "$PORCELAIN" -eq 0 ] && [ -n "$STATE_DIR" ] && [ -f "$file" ] || return 0
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        while IFS= read -r line; do
            path=${line%%"$TAB"*}
            [ "$path" = "${REPOS[$i]}" ] || continue
            IFS=$TAB read -r path parent head ahead behind date <<EOF
$line
EOF
            { is_uint "$ahead" && is_uint "$behind"; } || continue
            fork_words "$parent" "${head%%:*}" "${head#*:}" "$ahead" "$behind"
            [ -n "$FW_text" ] || continue
            F_names+=("${NAMES[$i]}"); F_texts+=("$FW_text"); F_labels+=("$FW_label"); F_cmds+=("$FW_cmd")
            dates+=("$date")
        done < "$file"
        i=$(( i + 1 ))
    done
    [ "${#F_names[@]}" -gt 0 ] || return 0
    for date in "${dates[@]}"; do
        [ "$date" = "${dates[0]}" ] || same=0
    done
    if [ "$same" -eq 1 ]; then
        put_forks "Forks, as fetch or doctor saw them $(day_words "${dates[0]}"):"
        return 0
    fi
    k=0
    while [ "$k" -lt "${#F_texts[@]}" ]; do
        F_texts[k]="${F_texts[$k]} (seen $(day_words "${dates[$k]}"))"
        k=$(( k + 1 ))
    done
    put_forks "Forks, as fetch or doctor last saw them:"
    return 0
}

# ---------------------------------------------------------------------------
# tidy: the backups and the kept files of past runs
# ---------------------------------------------------------------------------

days_ago() {
    # days_ago N -> the date N days before now, as YYYYMMDD.
    local s=$(( NOW - $1 * 86400 ))
    date -d "@$s" '+%Y%m%d' 2>/dev/null || date -r "$s" '+%Y%m%d' 2>/dev/null
}

stamp_words() {
    # stamp_words YYYYMMDD -> "17 November 2026"
    local d="$1" m
    case "${d:4:2}" in
        01) m=January ;;   02) m=February ;; 03) m=March ;;     04) m=April ;;
        05) m=May ;;       06) m=June ;;     07) m=July ;;      08) m=August ;;
        09) m=September ;; 10) m=October ;;  11) m=November ;;  12) m=December ;;
        *)  printf '%s' "$d"; return 0 ;;
    esac
    printf '%s %s %s' "$(( 10#${d:6:2} ))" "$m" "${d:0:4}"
}

leftovers() {
    # leftovers [UNTIL] -> what this tool left in the repository: one line
    # per backup reference ("ref<US>NAME<US>COMMIT<US>DAY") and per folder of
    # kept files ("dir<US>PATH<US><US>DAY"), DAY being YYYYMMDD; with UNTIL,
    # only those of that day or before.
    local until="${1:-}" name oid day gitdir entry
    while IFS=$US read -r name oid; do
        [ -n "$name" ] || continue
        day=${name##*/}
        day=${day:0:8}
        is_uint "$day" || continue
        if [ -z "$until" ] || [ "$day" -le "$until" ]; then
            printf 'ref%s%s%s%s%s%s\n' "$US" "$name" "$US" "$oid" "$US" "$day"
        fi
    done <<EOF
$(g for-each-ref --format='%(refname)%1f%(objectname)' refs/gh-batch 2>/dev/null)
EOF
    gitdir=$(g rev-parse --absolute-git-dir 2>/dev/null)
    [ -n "$gitdir" ] && [ -d "$gitdir/gh-batch/kept" ] || return 0
    for entry in "$gitdir"/gh-batch/kept/*; do
        [ -d "$entry" ] || continue
        day=${entry##*/}
        day=${day:0:8}
        is_uint "$day" || continue
        if [ -z "$until" ] || [ "$day" -le "$until" ]; then
            printf 'dir%s%s%s%s%s\n' "$US" "$entry" "$US" "$US" "$day"
        fi
    done
    return 0
}

leftover_words() {
    # leftover_words FILE: LW_words, "2 backups and 1 folder of kept
    # files", and LW_oldest, the day of the oldest.
    local kind name oid day refs=0 dirs=0 text=""
    LW_oldest=""; LW_words=""
    while IFS=$US read -r kind name oid day; do
        case "$kind" in
            ref) refs=$(( refs + 1 )) ;;
            dir) dirs=$(( dirs + 1 )) ;;
            *)   continue ;;
        esac
        if [ -z "$LW_oldest" ] || [ "$day" -lt "$LW_oldest" ]; then
            LW_oldest=$day
        fi
    done < "$1"
    [ "$refs" -gt 0 ] && text=$(plural "$refs" backup)
    if [ "$dirs" -gt 0 ]; then
        text="$text${text:+ and }$dirs $( [ "$dirs" -eq 1 ] && printf 'folder' || printf 'folders' ) of kept files"
    fi
    LW_words=$text
    return 0
}

doctor_leftovers() {
    # A finding of "doctor": the backups and the kept files in this
    # repository, a note while they are recent, a warning once the oldest
    # is older than --days.
    local limit
    leftovers > "$W/leftovers"
    [ -s "$W/leftovers" ] || return 0
    leftover_words "$W/leftovers"
    limit=$(days_ago "$DOCTOR_DAYS")
    if is_uint "$limit" && is_uint "$LW_oldest" && [ "$LW_oldest" -le "$limit" ]; then
        finding warning "$LW_words that $PROG keeps here, the oldest from $(stamp_words "$LW_oldest"): $PROG tidy removes those older than a month"
    else
        finding note "$LW_words that $PROG keeps here, the oldest from $(stamp_words "$LW_oldest")"
    fi
    return 0
}

do_tidy_plan() {
    # The first pass of "tidy": what this tool left in the repository
    # before the limit. Nothing is removed.
    local kind name oid day text
    repo_begin || return 0
    leftovers "$TIDY_UNTIL" > "$TMP/tplan/$IDX.list"
    if [ ! -s "$TMP/tplan/$IDX.list" ]; then
        emit clean 0 ""
        return 0
    fi
    leftover_words "$TMP/tplan/$IDX.list"
    emit planned 0 "remove $LW_words, the oldest from $(stamp_words "$LW_oldest")"
    while IFS=$US read -r kind name oid day; do
        case "$kind" in
            ref) text=${name#refs/gh-batch/} ;;
            dir)
                case "$name" in
                    "$REPO"/*) text=${name#"$REPO"/} ;;
                    *)         text=$(short_path "$name") ;;
                esac
                ;;
            *)   continue ;;
        esac
        detail "$text"
    done < "$TMP/tplan/$IDX.list"
    : > "$TMP/tplan/$IDX.go"
    printf 'P%s1\n' "$US"
    return 0
}

render_tidy_plan() {
    local kind
    while IFS=$US read -r kind _; do
        [ "$kind" = "P" ] && PLAN_GO=$(( PLAN_GO + 1 ))
    done < "$2"
    return 0
}

show_tidy_plan() {
    local i=0 count="${#REPOS[@]}"
    put_title "Plan:"
    while [ "$i" -lt "$count" ]; do
        if [ -f "$TMP/tplan/$i.res" ]; then
            read_record "$TMP/tplan/$i.res"
            [ "$REC_state" = "planned" ] && print_record "$i"
        fi
        i=$(( i + 1 ))
    done
    put ""
    put_todo "To do: remove what $PROG kept in $(plural "$PLAN_GO" repository), up to $(stamp_words "$TIDY_UNTIL")."
    return 0
}

do_tidy() {
    # The second pass of "tidy": each backup reference goes only if it still
    # names the commit of the plan, each kept folder only if it lies in the
    # folder of this tool inside the git folder.
    local kind name oid day refs=0 dirs=0 failed=0 gitdir text
    if [ ! -e "$TMP/tplan/$IDX.go" ]; then
        cat "$TMP/tplan/$IDX.res"
        return 0
    fi
    repo_begin || return 0
    gitdir=$(g rev-parse --absolute-git-dir 2>/dev/null)
    while IFS=$US read -r kind name oid day; do
        case "$kind" in
            ref)
                if g update-ref -d "$name" "$oid" 2>/dev/null; then
                    refs=$(( refs + 1 ))
                else
                    failed=$(( failed + 1 ))
                fi
                ;;
            dir)
                case "$name" in
                    "$gitdir"/gh-batch/kept/?*)
                        if rm -rf -- "$name" 2>/dev/null; then
                            dirs=$(( dirs + 1 ))
                        else
                            failed=$(( failed + 1 ))
                        fi
                        ;;
                    *)  failed=$(( failed + 1 )) ;;
                esac
                ;;
        esac
    done < "$TMP/tplan/$IDX.list"
    [ -n "$gitdir" ] && rmdir "$gitdir/gh-batch/kept" "$gitdir/gh-batch" 2>/dev/null
    text=""
    [ "$refs" -gt 0 ] && text=$(plural "$refs" backup)
    if [ "$dirs" -gt 0 ]; then
        text="$text${text:+ and }$dirs $( [ "$dirs" -eq 1 ] && printf 'folder' || printf 'folders' ) of kept files"
    fi
    if [ "$failed" -gt 0 ]; then
        emit failed 1 "removed ${text:-nothing}; $failed could not be removed (moved since the plan)"
    else
        emit tidied 0 "removed $text"
    fi
    return 0
}

cmd_tidy() {
    local i=0
    [ "$DAYS_GIVEN" -eq 1 ] || DOCTOR_DAYS=30
    is_uint "$DOCTOR_DAYS" || die "$EX_USAGE" "--days takes a number of days, not '$DOCTOR_DAYS'"
    begin_command change
    no_repository && exit "$EX_OK"
    TIDY_UNTIL=$(days_ago "$DOCTOR_DAYS")
    is_uint "$TIDY_UNTIL" || die "$EX_ENV" "the date of $DOCTOR_DAYS days ago could not be computed"
    header ""
    PLAN_GO=0
    pool do_tidy_plan tplan render_tidy_plan
    if [ "$STOP" -eq 0 ] && [ "$PLAN_GO" -gt 0 ] && [ "$DRY_RUN" -eq 0 ]; then
        show_before_asking show_tidy_plan
        if ! confirmed; then
            put "Nothing was done."
            declined
            exit "$EX_OK"
        fi
        if [ "$PORCELAIN" -eq 0 ]; then
            put ""
            put_title "Done:"
        fi
        pool do_tidy twork render
        finish
    fi
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        [ -f "$TMP/tplan/$i.res" ] && render "$i" "$TMP/tplan/$i.res"
        i=$(( i + 1 ))
    done
    if [ "$DRY_RUN" -eq 1 ] && [ "$PLAN_GO" -gt 0 ] && [ "$PORCELAIN" -eq 0 ] && [ "$STOP" -eq 0 ]; then
        put ""
        put_todo "To do: remove what $PROG kept in $(plural "$PLAN_GO" repository), up to $(stamp_words "$TIDY_UNTIL"). Nothing was changed (dry run)."
    fi
    finish
}

