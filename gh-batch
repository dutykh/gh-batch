  $PROG exec git gc --quiet
  $PROG exec --dirty -- git diff --stat
  $PROG exec --in ~/papers -- sh -c 'ls *.tex 2>/dev/null | wc -l'

OPTIONS
      --in DIR       a folder to search, repeatable (a folder cannot be
