# ---------------------------------------------------------------------------
# Command line
# ---------------------------------------------------------------------------

need_value() {
    [ "$#" -ge 2 ] || die "$EX_USAGE" "the option $1 needs a value"
}

parse_options() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -j|--jobs)      need_value "$@"; OPT_JOBS=$2; shift 2 ;;
            --jobs=*)       OPT_JOBS=${1#*=}; shift ;;
            -j[0-9]*)       OPT_JOBS=${1#-j}; shift ;;
            --depth)        need_value "$@"; OPT_DEPTH=$2; shift 2 ;;
            --depth=*)      OPT_DEPTH=${1#*=}; shift ;;
            --timeout)      need_value "$@"; OPT_TIMEOUT=$2; shift 2 ;;
            --timeout=*)    OPT_TIMEOUT=${1#*=}; shift ;;
            --diverged)     need_value "$@"; OPT_DIVERGED=$2; shift 2 ;;
            --diverged=*)   OPT_DIVERGED=${1#*=}; shift ;;
            --only)         need_value "$@"; ONLY+=("$2"); shift 2 ;;
            --only=*)       ONLY+=("${1#*=}"); shift ;;
            --except)       need_value "$@"; EXCEPT+=("$2"); shift 2 ;;
            --except=*)     EXCEPT+=("${1#*=}"); shift ;;
            --commit)       OPT_COMMIT="true"; shift ;;
            --no-commit)    OPT_COMMIT="false"; shift ;;
            -m|--message)   need_value "$@"; OPT_MESSAGE=$2; shift 2 ;;
            --message=*)    OPT_MESSAGE=${1#*=}; shift ;;
            -y|--yes)       YES=1; shift ;;
            -u)
                if [ "$COMMAND" = "clone" ]; then UPDATE=1; else SET_UPSTREAM=1; fi
                shift ;;
            --set-upstream) SET_UPSTREAM=1; shift ;;
            --update)       UPDATE=1; shift ;;
            --into)         need_value "$@"; INTO=$2; shift 2 ;;
            --into=*)       INTO=${1#*=}; shift ;;
            --since)        need_value "$@"; SINCE=$2; shift 2 ;;
            --since=*)      SINCE=${1#*=}; shift ;;
            --until)        need_value "$@"; LOG_UNTIL=$2; shift 2 ;;
            --until=*)      LOG_UNTIL=${1#*=}; shift ;;
            --author)       need_value "$@"; LOG_AUTHOR=$2; shift 2 ;;
            --author=*)     LOG_AUTHOR=${1#*=}; shift ;;
            --all-authors)  ALL_AUTHORS=1; shift ;;
            --dirty)        F_DIRTY=1; shift ;;
            --clean)        F_CLEAN=1; shift ;;
            --ahead)        F_AHEAD=1; shift ;;
            --behind)       F_BEHIND=1; shift ;;
            --offline)      OFFLINE=1; shift ;;
            --days)         need_value "$@"; DOCTOR_DAYS=$2; shift 2 ;;
            --days=*)       DOCTOR_DAYS=${1#*=}; shift ;;
            --in)           need_value "$@"; ARGS+=("$2"); shift 2 ;;
            --in=*)         ARGS+=("${1#*=}"); shift ;;
            --no-forks)     NO_FORKS=1; shift ;;
            --no-archived)  NO_ARCHIVED=1; shift ;;
            --flat)         LAYOUT="flat"; shift ;;
            --by-owner)     LAYOUT="owner"; shift ;;
            --notify)       OPT_NOTIFY=1; shift ;;
            -n|--dry-run)   DRY_RUN=1; shift ;;
            -v|--verbose)   VERBOSE=1; shift ;;
            -q|--quiet)     QUIET=1; shift ;;
            -l|--long)      LONG=1; shift ;;
            --porcelain)    PORCELAIN=1; shift ;;
            --absolute)     ABSOLUTE=1; shift ;;
            --manifest)
                if [ "$COMMAND" = "clone" ]; then
                    need_value "$@"; MANIFEST_IN=$2; shift 2
                else
                    MANIFEST_OUT=1; shift
                fi ;;
            --manifest=*)   MANIFEST_IN=${1#*=}; shift ;;
            --color|--colour)       need_value "$@"; COLOR_MODE=$2; shift 2 ;;
            --color=*|--colour=*)   COLOR_MODE=${1#*=}; shift ;;
            --no-color|--no-colour) COLOR_MODE="never"; shift ;;
            -h|--help)      show_help "$COMMAND"; exit "$EX_OK" ;;
            --version)      printf '%s %s\n' "$PROG" "$GH_BATCH_VERSION"; exit "$EX_OK" ;;
            --)
                shift
                if [ "$COMMAND" = "exec" ]; then
                    EXEC_CMD=("$@")
                    return 0
                fi
                while [ "$#" -gt 0 ]; do positional "$1"; shift; done ;;
            -?*)            die "$EX_USAGE" "unknown option: $1 (see $PROG help${COMMAND:+ $COMMAND})" ;;
            *)
                # The command of "exec" starts at its first word and keeps
                # the rest of the line, options included.
                if [ "$COMMAND" = "exec" ]; then
                    EXEC_CMD=("$@")
                    return 0
                fi
                positional "$1"; shift ;;
        esac
    done
}

positional() {
    case "$COMMAND" in
        help)   HELP_TOPIC=$1 ;;
        completion) SHELL_NAME=$1 ;;
        clone)  OWNERS+=("$1") ;;
        config) die "$EX_USAGE" "config takes no argument" ;;
        *)      ARGS+=("$1") ;;
    esac
}

main() {
    case "${1:-}" in
        ""|-h|--help)   usage; exit "$EX_OK" ;;
        --version|version) printf '%s %s\n' "$PROG" "$GH_BATCH_VERSION"; exit "$EX_OK" ;;
        -*)             die "$EX_USAGE" "the command comes first: $PROG <command> [options] (see $PROG help)" ;;
    esac
    COMMAND=$1
    shift
    case "$COMMAND" in
        pull|push|sync|clone|status|fetch|log|exec|doctor|list|config|completion|help) ;;
        *) die "$EX_USAGE" "no such command: $COMMAND (see $PROG help)" ;;
    esac
    parse_options "$@"
    if [ "$COMMAND" = "help" ]; then
        show_help "$HELP_TOPIC"
        exit "$EX_OK"
    fi
    [ "$COMMAND" = "completion" ] && cmd_completion
    check_git
    load_settings
    resolve_settings
    case "$COMMAND" in
        pull|fetch) cmd_pull ;;
        push)       cmd_push ;;
        sync)       cmd_sync ;;
        clone)      cmd_clone ;;
        log)        LOG_SINCE=$SINCE; cmd_log ;;
        exec)       cmd_exec ;;
        doctor)     cmd_doctor ;;
        status)     cmd_status ;;
        list)       cmd_list ;;
        config)     cmd_config ;;
    esac
}

main "$@"; exit
