# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

redact() {
    # Hide a password or a token written inside an address, so that no
    # message ever shows a credential.
    sed -e 's#\(https\{0,1\}://\)[^/@[:space:]]*@#\1<hidden>@#g' \
        -e 's#\(://[^/@:[:space:]]*\):[^/@[:space:]]*@#\1:<hidden>@#g'
}

warn() { printf '%s: warning: %s\n' "$PROG" "$*" | redact >&2; }

die() {
    local code="$1"; shift
    printf '%s: error: %s\n' "$PROG" "$*" | redact >&2
    exit "$code"
}

have() {
    # GH_BATCH_HIDE lists programs to treat as absent, so that the paths taken
    # without gh, git-lfs or perl can be exercised on any machine.
    case " ${GH_BATCH_HIDE:-} " in *" $1 "*) return 1 ;; esac
    command -v "$1" >/dev/null 2>&1
}

is_uint() { case "$1" in ""|*[!0-9]*) return 1 ;; esac; return 0; }

truthy() {
    # The spellings git accepts for "true"; a key without a value is true.
    case "$1" in
        [Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]|1|"") return 0 ;;
    esac
    return 1
}

plural() {
    # plural N WORD -> "1 commit", "3 commits", "2 repositories"
    local n="$1" word="$2"
    if [ "$n" = 1 ]; then
        printf '1 %s' "$word"
    else
        case "$word" in
            *y)  printf '%s %sies' "$n" "${word%y}" ;;
            *ch) printf '%s %ses' "$n" "$word" ;;
            *)   printf '%s %ss' "$n" "$word" ;;
        esac
    fi
}

# In the two functions below the tilde is a character of the text, written
# by the user or shown to him, and not a path for the shell to expand.
# shellcheck disable=SC2088
expand_tilde() {
    case "$1" in
        "~")    printf '%s' "$HOME" ;;
        "~/"*)  printf '%s/%s' "$HOME" "${1#\~/}" ;;
        *)      printf '%s' "$1" ;;
    esac
}

# shellcheck disable=SC2088
short_path() {
    case "$1" in
        "$HOME")    printf '~' ;;
        "$HOME"/*)  printf '~/%s' "${1#"$HOME"/}" ;;
        *)          printf '%s' "$1" ;;
    esac
}

one_line() {
    # The text on one line, without the control characters that would break
    # a record or a terminal.
    printf '%s' "$1" | tr '\n\r\t\037' '    '
}

last_line() {
    # last_line FILE -> the end of what a command wrote on its error output:
    # its last three lines, the hints of git left out, on one line and
    # without credentials. A hook says why it refuses just before git says
    # that it failed, so one line would lose the reason.
    local line a="" b="" c="" text
    [ -f "$1" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            hint:*) continue ;;
        esac
        [ -n "${line// /}" ] || continue
        a=$b; b=$c; c=$line
    done < "$1"
    text=$c
    [ -n "$b" ] && text="$b; $c"
    [ -n "$a" ] && text="$a; $b; $c"
    one_line "$text" | redact | cut -c 1-300
}

clip() {
    # clip TEXT WIDTH -> TEXT, cut with three dots when it is longer
    if [ "${#1}" -gt "$2" ]; then
        printf '%s...' "${1:0:$(( $2 - 3 ))}"
    else
        printf '%s' "$1"
    fi
}

age_text() {
    # age_text SECONDS -> "5 min", "3 h", "12 d"
    local s="$1"
    if [ "$s" -lt 3600 ]; then
        printf '%s min' $(( s / 60 ))
    elif [ "$s" -lt 172800 ]; then
        printf '%s h' $(( s / 3600 ))
    else
        printf '%s d' $(( s / 86400 ))
    fi
}

# ---------------------------------------------------------------------------
# Settings: command line, then environment, then "git config --global
# gh-batch.*", then the defaults
# ---------------------------------------------------------------------------

load_settings() {
    local line key val
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        key=${line%% *}
        val=""
        case "$line" in *" "*) val=${line#* } ;; esac
        case "$key" in
            gh-batch.root)      CFG_ROOTS+=("$(expand_tilde "$val")") ;;
            gh-batch.exclude)   CFG_EXCLUDE+=("$val") ;;
            gh-batch.depth)     CFG_depth=$val ;;
            gh-batch.jobs)      CFG_jobs=$val ;;
            gh-batch.timeout)   CFG_timeout=$val ;;
            gh-batch.diverged)  CFG_diverged=$val ;;
            gh-batch.commit)    CFG_commit=${val:-true} ;;
            gh-batch.confirm)   CFG_confirm=${val:-true} ;;
            gh-batch.message)   CFG_message=$val ;;
            gh-batch.machine)   CFG_machine=$val ;;
            gh-batch.maxfilesize) CFG_maxfilesize=$val ;;
            gh-batch.maxnewfiles) CFG_maxnewfiles=$val ;;
            gh-batch.notify)    CFG_notify=$val ;;
            gh-batch.notifyon)  CFG_notifyon=$val ;;
        esac
    done <<EOF
$(git config --global --includes --get-regexp '^gh-batch\.' 2>/dev/null)
EOF
}

pick() {
    # pick ENVIRONMENT_NAME CONFIG_VALUE DEFAULT OPTION_VALUE -> VAL and SRC
    local env_name="$1" cfg="$2" def="$3" opt="$4"
    if [ -n "$opt" ]; then
        VAL=$opt; SRC="command line"
    elif [ -n "${!env_name:-}" ]; then
        VAL=${!env_name}; SRC="environment ($env_name)"
    elif [ -n "$cfg" ]; then
        VAL=$cfg; SRC="git config"
    else
        VAL=$def; SRC="default"
    fi
}

resolve_settings() {
    pick GH_BATCH_JOBS "$CFG_jobs" 8 "$OPT_JOBS";               JOBS=$VAL; SRC_jobs=$SRC
    pick GH_BATCH_DEPTH "$CFG_depth" 3 "$OPT_DEPTH";            DEPTH=$VAL; SRC_depth=$SRC
    pick GH_BATCH_TIMEOUT "$CFG_timeout" 300 "$OPT_TIMEOUT";    TIMEOUT=$VAL; SRC_timeout=$SRC
    pick GH_BATCH_DIVERGED "$CFG_diverged" report "$OPT_DIVERGED"; DIVERGED=$VAL; SRC_diverged=$SRC

    { is_uint "$JOBS" && [ "$JOBS" -ge 1 ]; } ||
        die "$EX_USAGE" "the number of jobs must be a positive integer, not '$JOBS'"
    { is_uint "$DEPTH" && [ "$DEPTH" -ge 1 ]; } ||
        die "$EX_USAGE" "the depth must be a positive integer, not '$DEPTH'"
    is_uint "$TIMEOUT" ||
        die "$EX_USAGE" "the timeout is a number of seconds (0 for none), not '$TIMEOUT'"
    case "$DIVERGED" in
        report|rebase|merge) ;;
        *) die "$EX_USAGE" "the choices for diverged histories are report, rebase and merge, not '$DIVERGED'" ;;
    esac

    pick GH_BATCH_COMMIT "$CFG_commit" false "$OPT_COMMIT"
    SRC_commit=$SRC
    if truthy "$VAL"; then COMMIT=1; else COMMIT=0; fi
    case "$SRC" in
        "command line"|environment*) COMMIT_FORCED=1 ;;
    esac
    pick GH_BATCH_CONFIRM "$CFG_confirm" true ""
    SRC_confirm=$SRC
    if truthy "$VAL"; then CONFIRM=1; else CONFIRM=0; fi
    pick GH_BATCH_MESSAGE "$CFG_message" "Work in progress, %d (%h)" "$OPT_MESSAGE"
    MESSAGE=$VAL; SRC_message=$SRC
    pick GH_BATCH_MACHINE "$CFG_machine" "" ""
    MACHINE_NAME=$VAL; SRC_machine=$SRC
    if [ -z "$MACHINE_NAME" ]; then
        MACHINE_NAME=$(hostname -s 2>/dev/null || hostname 2>/dev/null || uname -n 2>/dev/null)
        SRC_machine="the name of the host"
    fi
    pick GH_BATCH_MAX_FILE_SIZE "$CFG_maxfilesize" 50 ""
    MAX_FILE_MB=$VAL; SRC_maxfile=$SRC
    pick GH_BATCH_MAX_NEW_FILES "$CFG_maxnewfiles" 200 ""
    MAX_NEW_FILES=$VAL; SRC_maxnew=$SRC
    is_uint "$MAX_FILE_MB" ||
        die "$EX_USAGE" "gh-batch.maxFileSize is a number of megabytes (0 for no limit), not '$MAX_FILE_MB'"
    is_uint "$MAX_NEW_FILES" ||
        die "$EX_USAGE" "gh-batch.maxNewFiles is a number of files (0 for no limit), not '$MAX_NEW_FILES'"
    pick GH_BATCH_NOTIFY "$CFG_notify" "" ""
    NOTIFY_CMD=$VAL; SRC_notify=$SRC
    pick GH_BATCH_NOTIFY_ON "$CFG_notifyon" never ""
    NOTIFY_ON=$VAL; SRC_notifyon=$SRC
    case "$NOTIFY_ON" in
        never|attention|always) ;;
        *) die "$EX_USAGE" "the choices for gh-batch.notifyOn are never, attention and always, not '$NOTIFY_ON'" ;;
    esac
    STATE_DIR=${GH_BATCH_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gh-batch}
}

check_git() {
    local v rest major minor
    have git || die "$EX_ENV" "git is not installed"
    v=$(git version 2>/dev/null)
    v=${v#git version }
    major=${v%%.*}
    rest=${v#*.}
    minor=${rest%%.*}
    if ! is_uint "$major" || ! is_uint "$minor"; then
        die "$EX_ENV" "the version of git could not be read: $v"
    fi
    if [ "$major" -lt 2 ] || { [ "$major" -eq 2 ] && [ "$minor" -lt 30 ]; }; then
        die "$EX_ENV" "git 2.30 or newer is needed, and this one is $v"
    fi
    if [ "$major" -gt 2 ] || [ "$minor" -ge 41 ]; then
        FETCH_PORCELAIN=1
    fi
}

# ---------------------------------------------------------------------------
# Working directory, lock and signals
# ---------------------------------------------------------------------------

claim() {
    # claim FILE [TEXT] -> 0 for the one process that creates FILE. The
    # shell's own exclusive creation is used: the mkdir of some systems (the
    # Rust coreutils among them) lets two callers succeed at the same time.
    local rc
    set -o noclobber
    { printf '%s' "${2:-}" > "$1"; } 2>/dev/null
    rc=$?
    set +o noclobber
    return "$rc"
}

cleanup() {
    local code=$?
    progress_clear
    if [ "$LOCKED" -eq 1 ] && [ -n "$STATE_DIR" ]; then
        rm -f "$STATE_DIR/lock"
    fi
    case "$TMP" in
        */gh-batch.*) rm -rf "$TMP" ;;
    esac
    exit "$code"
}

on_signal() {
    [ "$STOP" -eq 1 ] && HARD=1
    STOP=1
    [ -n "$TMP" ] && [ -d "$TMP" ] && : > "$TMP/stop"
    return 0
}

setup_run() {
    TMP=$(mktemp -d "${TMPDIR:-/tmp}/gh-batch.XXXXXX") ||
        die "$EX_ENV" "cannot create a temporary directory"
    trap cleanup EXIT
    trap 'on_signal' INT TERM HUP PIPE
    NOW=$(date +%s)
    RUN_START=$SECONDS
    TODAY=$(date '+%Y-%m-%d')
    CLOCK=$(date '+%H:%M')
    if stat -c %Y / >/dev/null 2>&1; then
        STAT_STYLE="gnu"
    elif stat -f %m / >/dev/null 2>&1; then
        STAT_STYLE="bsd"
    fi
    detect_isolation
}

detect_isolation() {
    # A long child must sit in its own process group: Ctrl-C then reaches
    # this program, which decides, and never a commit or a merge half-way.
    # Job control gives that; perl is the fallback where it does not.
    local answer
    if [ -n "${GH_BATCH_ISOLATE:-}" ]; then
        ISOLATE=$GH_BATCH_ISOLATE
        return 0
    fi
    answer=$(
        set -m
        sleep 5 >/dev/null 2>&1 &
        child=$!
        set +m
        group=$(ps -o pgid= -p "$child" 2>/dev/null | tr -d ' ')
        kill "$child" 2>/dev/null
        [ "$group" = "$child" ] && printf 'yes'
    ) 2>/dev/null
    if [ "$answer" = "yes" ]; then
        ISOLATE="setm"
        return 0
    fi
    if have perl; then
        answer=$(
            perl -e 'setpgrp(0, 0); exec { $ARGV[0] } @ARGV or exit 127' sleep 5 </dev/null >/dev/null 2>&1 &
            child=$!
            sleep 0.2
            group=$(ps -o pgid= -p "$child" 2>/dev/null | tr -d ' ')
            kill "$child" 2>/dev/null
            [ "$group" = "$child" ] && printf 'yes'
        ) 2>/dev/null
        if [ "$answer" = "yes" ]; then
            ISOLATE="perl"
            return 0
        fi
    fi
    ISOLATE="none"
}

take_lock() {
    # One run at a time may change repositories: a timer and a hand-typed
    # command must not meet in the same working tree.
    local pid="" lock
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    lock="$STATE_DIR/lock"
    if ! claim "$lock" "$$"; then
        pid=$(cat "$lock" 2>/dev/null)
        if [ -z "$pid" ]; then
            sleep 0.3
            pid=$(cat "$lock" 2>/dev/null)
        fi
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            die "$EX_ENV" "another $PROG is at work (process $pid): wait for it to finish"
        fi
        # The lock of a run that died is taken over.
        rm -f "$lock"
        claim "$lock" "$$" || die "$EX_ENV" "cannot take the lock in $STATE_DIR"
    fi
    LOCKED=1
    report_unfinished_updates
}

report_unfinished_updates() {
    # A marker is written before a working tree is moved and removed after:
    # one that remains names a repository whose update was cut short.
    local marker pid path
    for marker in "$STATE_DIR"/inflight.*; do
        [ -f "$marker" ] || continue
        pid=${marker##*/inflight.}
        pid=${pid%%.*}
        if is_uint "$pid" && kill -0 "$pid" 2>/dev/null; then
            continue
        fi
        path=$(cat "$marker" 2>/dev/null)
        [ -n "$path" ] &&
            warn "an earlier run was cut short while it updated $(short_path "$path"): look at it with git status"
        rm -f "$marker"
    done
}

harden_git() {
    # Variables such as GIT_DIR would redirect every "git -C DIR"; they are
    # cleared. No git started here may ask a question: with several
    # repositories at work the terminal belongs to nobody.
    local name
    for name in $(git rev-parse --local-env-vars 2>/dev/null); do
        unset "$name"
    done
    [ -n "${GIT_SSH_COMMAND:-}${GIT_SSH:-}" ] && USER_SSH=1
    export GIT_OPTIONAL_LOCKS=0
    export GIT_TERMINAL_PROMPT=0
    export GIT_ASKPASS=""
    export GCM_INTERACTIVE=never
    export GIT_EDITOR=:
    export GIT_SEQUENCE_EDITOR=:
    export GIT_MERGE_AUTOEDIT=no
}

# ---------------------------------------------------------------------------
# Discovery of the repositories
# ---------------------------------------------------------------------------

add_repo() {
    # add_repo PATH NAME: keep the repository unless its physical path was
    # already taken (a symbolic link to a repository listed elsewhere).
    local phys
    phys=$(cd "$1" 2>/dev/null && pwd -P) || return 0
    case "$SEEN$US" in
        *"$US$phys$US"*) return 0 ;;
    esac
    SEEN="$SEEN$US$phys"
    REPOS+=("$1")
    NAMES+=("$2")
}

walk() {
    # walk DIR LEVELS PREFIX: a folder holding ".git" is a repository and is
    # not entered; hidden folders and node_modules are not searched.
    local dir="$1" levels="$2" prefix="$3" entry base
    for entry in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
        [ -d "$entry" ] || continue
        base=${entry##*/}
        if [ -e "$entry/.git" ]; then
            add_repo "$entry" "$prefix$base"
            continue
        fi
        case "$base" in
            .*|node_modules) continue ;;
        esac
        if [ "$levels" -gt 1 ]; then
            walk "$entry" $(( levels - 1 )) "$prefix$base/"
        fi
    done
    return 0
}

selected() {
    # selected NAME -> 0 when --only, --except and gh-batch.exclude keep it
    local name="$1" base="${1##*/}" pattern
    # shellcheck disable=SC2254  # the patterns are meant to be matched as globs
    for pattern in ${EXCEPT[@]+"${EXCEPT[@]}"} ${CFG_EXCLUDE[@]+"${CFG_EXCLUDE[@]}"}; do
        case "$name" in $pattern) return 1 ;; esac
        case "$base" in $pattern) return 1 ;; esac
    done
    [ "${#ONLY[@]}" -eq 0 ] && return 0
    # shellcheck disable=SC2254
    for pattern in "${ONLY[@]}"; do
        case "$name" in $pattern) return 0 ;; esac
        case "$base" in $pattern) return 0 ;; esac
    done
    return 1
}

discover() {
    local roots=() root abs i kept_repos=() kept_names=()
    if [ "${#ARGS[@]}" -gt 0 ]; then
        roots=("${ARGS[@]}")
    elif [ -n "${GH_BATCH_ROOT:-}" ]; then
        roots=("$(expand_tilde "$GH_BATCH_ROOT")")
    elif [ "${#CFG_ROOTS[@]}" -gt 0 ]; then
        roots=("${CFG_ROOTS[@]}")
    else
        roots=(".")
    fi
    ROOT_LABEL=""
    ROOTS_ABS=()
    for root in "${roots[@]}"; do
        [ -d "$root" ] || die "$EX_USAGE" "no such folder: $root"
        abs=$(cd "$root" && pwd) || die "$EX_USAGE" "cannot enter $root"
        ROOTS_ABS+=("$abs")
        ROOT_LABEL="$ROOT_LABEL${ROOT_LABEL:+, }$(short_path "$abs")"
        if [ -e "$abs/.git" ]; then
            add_repo "$abs" "${abs##*/}"
        else
            walk "${abs%/}" "$DEPTH" ""
        fi
    done
    ALL_REPOS=(${REPOS[@]+"${REPOS[@]}"})
    i=0
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        if selected "${NAMES[$i]}"; then
            kept_repos+=("${REPOS[$i]}")
            kept_names+=("${NAMES[$i]}")
        fi
        i=$(( i + 1 ))
    done
    REPOS=(${kept_repos[@]+"${kept_repos[@]}"})
    NAMES=(${kept_names[@]+"${kept_names[@]}"})
    fit_names
    return 0
}

fit_names() {
    # The width of the column of names, for the repositories in hand.
    local name
    NAME_WIDTH=12
    for name in ${NAMES[@]+"${NAMES[@]}"}; do
        [ "${#name}" -gt "$NAME_WIDTH" ] && NAME_WIDTH=${#name}
    done
    [ "$NAME_WIDTH" -gt 40 ] && NAME_WIDTH=40
    return 0
}

# ---------------------------------------------------------------------------
# The engine: workers that claim repositories one by one, children in their
# own process groups, results as files printed in the order of the folders
# ---------------------------------------------------------------------------

stopped() { [ -e "$TMP/stop" ]; }

spawn() {
    # spawn NAME COMMAND...: start a long child with its output in
    # $W/NAME.out and $W/NAME.err, in a process group of its own. Sets CHILD.
    local name="$1"; shift
    OUT="$W/$name.out"
    ERR="$W/$name.err"
    case "$ISOLATE" in
        setm)
            set -m
            "$@" </dev/null >"$OUT" 2>"$ERR" &
            CHILD=$!
            set +m
            ;;
        perl)
            perl -e 'setpgrp(0, 0); exec { $ARGV[0] } @ARGV or exit 127' "$@" </dev/null >"$OUT" 2>"$ERR" &
            CHILD=$!
            ;;
        *)
            "$@" </dev/null >"$OUT" 2>"$ERR" &
            CHILD=$!
            ;;
    esac
    printf '%s\n' "$CHILD" > "$W/child"
}

signal_child() {
    if [ "$ISOLATE" = "none" ]; then
        kill "-$1" "$CHILD" 2>/dev/null
    else
        kill "-$1" -- "-$CHILD" 2>/dev/null
    fi
    return 0
}

end_child() {
    local n=0
    signal_child TERM
    signal_child CONT
    while kill -0 "$CHILD" 2>/dev/null && [ "$n" -lt 30 ]; do
        sleep 0.1
        n=$(( n + 1 ))
    done
    kill -0 "$CHILD" 2>/dev/null && signal_child KILL
    return 0
}

await() {
    # await net|timed|local [LIMIT] -> the exit status of the child, or 124
    # when the deadline passed, 130 when the run was stopped, 125 when the
    # child waited for the terminal. A network step is ended on a stop or at
    # its deadline, a timed one at its deadline only; a local step, which
    # moves files, is always left to finish.
    local kind="$1" limit="${2:-0}" started=$SECONDS n=0 why="" rc
    while kill -0 "$CHILD" 2>/dev/null; do
        n=$(( n + 1 ))
        if [ "$kind" = "net" ] && { stopped || ! kill -0 "$$" 2>/dev/null; }; then
            why=130
        elif [ "$kind" != "local" ] && [ "$limit" -gt 0 ] && [ $(( SECONDS - started )) -ge "$limit" ]; then
            why=124
        fi
        if [ -z "$why" ] && [ $(( n % 25 )) -eq 0 ]; then
            case "$(ps -o stat= -p "$CHILD" 2>/dev/null)" in
                T*) why=125 ;;
            esac
        fi
        if [ -n "$why" ]; then
            end_child
            break
        fi
        if [ "$n" -lt 12 ]; then sleep 0.02; else sleep 0.1; fi
    done
    wait "$CHILD" 2>/dev/null
    rc=$?
    rm -f "$W/child"
    [ -n "$why" ] && return "$why"
    return "$rc"
}

run_net() {
    # run_net NAME COMMAND... -> status of a step that talks to a server
    spawn "$@"
    await net "$TIMEOUT"
}

run_local() {
    # run_local NAME COMMAND... -> status of a step that changes local files
    spawn "$@"
    await local 0
}

pool_worker() {
    # pool_worker FUNCTION DIR COUNT: claim the next free repository, run
    # FUNCTION on it, publish its result by renaming the finished file.
    local fn="$1" dir="$2" count="$3" i=0
    trap - EXIT
    trap ':' TERM HUP
    while [ "$i" -lt "$count" ]; do
        stopped && break
        kill -0 "$$" 2>/dev/null || break
        if claim "$TMP/$dir/$i.claim"; then
            IDX=$i
            REPO=${REPOS[$i]}
            NAME=${NAMES[$i]}
            W="$TMP/$dir/$i.w"
            mkdir -p "$W"
            "$fn" > "$TMP/$dir/$i.part" 2>> "$TMP/$dir/$i.log"
            mv "$TMP/$dir/$i.part" "$TMP/$dir/$i.res"
        fi
        i=$(( i + 1 ))
    done
    return 0
}

hard_stop() {
    # A second signal: the workers and their children are ended at once.
    local pid file group
    for pid in "$@"; do
        kill -TERM "$pid" 2>/dev/null
    done
    for file in "$TMP"/*/*.w/child; do
        [ -f "$file" ] || continue
        group=$(cat "$file" 2>/dev/null)
        is_uint "$group" || continue
        if [ "$ISOLATE" = "none" ]; then
            kill -KILL "$group" 2>/dev/null
        else
            kill -KILL -- "-$group" 2>/dev/null
        fi
    done
    return 0
}

pool() {
    # pool FUNCTION DIR RENDER: run FUNCTION on every repository with $JOBS
    # workers and hand each result to RENDER in the order of the folders.
    local fn="$1" dir="$2" render="$3" count="${#REPOS[@]}" jobs="$JOBS"
    local w=0 next=0 alive pid pids=() killed=0
    mkdir -p "$TMP/$dir"
    [ "$jobs" -gt "$count" ] && jobs=$count
    while [ "$w" -lt "$jobs" ]; do
        pool_worker "$fn" "$dir" "$count" </dev/null >/dev/null 2>>"$TMP/worker.log" &
        pids+=("$!")
        w=$(( w + 1 ))
    done
    while [ "$next" -lt "$count" ]; do
        if [ -f "$TMP/$dir/$next.res" ]; then
            progress_clear
            "$render" "$next" "$TMP/$dir/$next.res"
            next=$(( next + 1 ))
            continue
        fi
        if [ "$HARD" -eq 1 ] && [ "$killed" -eq 0 ]; then
            hard_stop ${pids[@]+"${pids[@]}"}
            killed=1
        fi
        alive=0
        for pid in ${pids[@]+"${pids[@]}"}; do
            if kill -0 "$pid" 2>/dev/null; then
                alive=1
                break
            fi
        done
        if [ "$alive" -eq 0 ] && [ ! -f "$TMP/$dir/$next.res" ]; then
            # No worker is left: this repository was not reached, or its
            # worker died with it.
            if [ -e "$TMP/$dir/$next.claim" ] && ! stopped; then
                printf 'S%slost%s1%s%sits worker died before it finished\n' "$US" "$US" "$US" "$US" > "$TMP/$dir/$next.res"
            else
                printf 'S%sinterrupted%s1%s%snot reached before the stop\n' "$US" "$US" "$US" "$US" > "$TMP/$dir/$next.res"
            fi
            continue
        fi
        progress_show "$next" "$count"
        sleep 0.1
    done
    for pid in ${pids[@]+"${pids[@]}"}; do
        wait "$pid" 2>/dev/null
    done
    progress_clear
    return 0
}

# ---------------------------------------------------------------------------
# Results: one record per repository, written by a worker, read by render
# ---------------------------------------------------------------------------

emit() {
    # emit STATE ATTENTION MESSAGE: the state of the repository, whether it
    # needs the user (1) and one line saying why.
    printf 'S%s%s%s%s%s%s%s%s\n' "$US" "$1" "$US" "$2" "$US" "$(one_line "${R_branch:-}")" "$US" "$(one_line "$3")"
}

detail() {
    # detail TEXT: one more line shown under the repository.
    printf 'D%s%s\n' "$US" "$(one_line "$1")"
}

details() {
    # details TEXT: each line of TEXT becomes a detail.
    local line
    [ -n "$1" ] || return 0
    while IFS= read -r line; do
        [ -n "$line" ] && detail "$line"
    done <<EOF
$1
EOF
    return 0
}

record_move() {
    # record_move ACTION OLD NEW: a line for the journal of what was changed.
    printf 'J%s%s%s%s%s%s\n' "$US" "$1" "$US" "$2" "$US" "$3"
}

state_label() {
    case "$1" in
        uptodate)     printf 'up to date' ;;
        halfupdated)  printf 'half-updated' ;;
        localonly)    printf 'local only' ;;
        noupstream)   printf 'no upstream' ;;
        notcommitted) printf 'not committed' ;;
        planned)      printf 'to do' ;;
        active)       printf 'commits' ;;
        *)            printf '%s' "$1" ;;
    esac
}

state_class() {
    case "$1" in
        updated|rebased|merged|pushed|cloned|ok)   printf 'good' ;;
        uptodate|clean|present|skipped|nothing|healthy) printf 'dim' ;;
        ahead|behind|pending|stash|localonly|noupstream|detached|planned|active|warning) printf 'info' ;;
        *)                                         printf 'bad' ;;
    esac
}

state_phrase() {
    # state_phrase STATE N -> the words of the summary line
    local n="$2"
    case "$1" in
        updated)      printf '%s updated' "$n" ;;
        cloned)       printf '%s cloned' "$n" ;;
        ok)           printf '%s ok' "$n" ;;
        healthy)      printf '%s healthy' "$n" ;;
        warning)      printf '%s with warnings' "$n" ;;
        problem)      printf '%s with problems' "$n" ;;
        pushed)       printf '%s pushed' "$n" ;;
        planned)      printf '%s to do' "$n" ;;
        nothing)      printf '%s with nothing to push' "$n" ;;
        rejected)     printf '%s rejected' "$n" ;;
        notcommitted) printf '%s not committed' "$n" ;;
        rebased)      printf '%s rebased' "$n" ;;
        merged)       printf '%s merged' "$n" ;;
        uptodate)     printf '%s up to date' "$n" ;;
        clean)        printf '%s clean' "$n" ;;
        pending)      printf '%s with pending changes' "$n" ;;
        stash)        printf '%s with a stash' "$n" ;;
        ahead)        printf '%s with commits to push' "$n" ;;
        behind)       printf '%s behind' "$n" ;;
        diverged)     printf '%s diverged' "$n" ;;
        conflict)     printf '%s in conflict' "$n" ;;
        blocked)      printf '%s blocked' "$n" ;;
        failed)       printf '%s failed' "$n" ;;
        gone)         printf '%s whose branch left the server' "$n" ;;
        unfinished)   printf '%s with an unfinished operation' "$n" ;;
        halfupdated)  printf '%s half-updated' "$n" ;;
        busy)         printf '%s busy' "$n" ;;
        unreadable)   printf '%s unreadable' "$n" ;;
        localonly)    printf '%s without remote' "$n" ;;
        noupstream)   printf '%s without upstream' "$n" ;;
        detached)     printf '%s detached' "$n" ;;
        skipped)      printf '%s skipped' "$n" ;;
        interrupted)  printf '%s interrupted' "$n" ;;
        lost)         printf '%s lost' "$n" ;;
        *)            printf '%s %s' "$n" "$1" ;;
    esac
}

STATE_ORDER="updated rebased merged pushed planned cloned ok uptodate clean nothing present pending stash ahead behind localonly noupstream detached skipped healthy warning problem diverged conflict blocked rejected notcommitted failed gone unfinished halfupdated busy unreadable interrupted lost"

tally() {
    local var="N_$1"
    printf -v "$var" '%s' $(( ${!var:-0} + 1 ))
}

setup_colour() {
    USE_COLOUR=0
    case "$COLOR_MODE" in
        always) USE_COLOUR=1 ;;
        never)  ;;
        auto)
            if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
                USE_COLOUR=1
            fi
            ;;
        *) die "$EX_USAGE" "the choices for --color are auto, always and never, not '$COLOR_MODE'" ;;
    esac
    # The sixteen colours of the terminal, so that the output follows its
    # theme, light or dark.
    if [ "$USE_COLOUR" -eq 1 ]; then
        C_GOOD=$(printf '\033[32m')
        C_INFO=$(printf '\033[33m')
        C_BAD=$(printf '\033[1;31m')
        C_DIM=$(printf '\033[2m')
        C_BOLD=$(printf '\033[1m')
        C_TITLE=$(printf '\033[1;36m')
        C_NAME=$(printf '\033[1m')
        C_CYAN=$(printf '\033[36m')
        C_HASH=$(printf '\033[33m')
        C_PUBLIC=$(printf '\033[1;35m')
        C_OFF=$(printf '\033[0m')
    fi
    STYLED=$USE_COLOUR
    UNICODE=0
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) UNICODE=1 ;;
    esac
    PROGRESS=0
    if [ -t 2 ] && [ "$QUIET" -eq 0 ] && [ "$PORCELAIN" -eq 0 ]; then
        PROGRESS=1
    fi
}

mark() {
    # mark STATE -> the sign in front of a state on the screen: a tick for
    # what was done, a dot for nothing to do, arrows for what waits, a
    # cross for what needs the user; letters when the terminal is not UTF-8.
    local u a
    case "$1" in
        updated|rebased|merged|pushed|cloned|ok|healthy) u='✓'; a='+' ;;
        ahead)                 u='↑'; a='^' ;;
        behind)                u='↓'; a='v' ;;
        diverged)              u='⇅'; a='x' ;;
        planned)               u='→'; a='>' ;;
        warning)               u='⚠'; a='!' ;;
        pending|stash|active)  u='●'; a='*' ;;
        localonly|noupstream|detached) u='○'; a='o' ;;
        uptodate|clean|nothing|present|skipped) u='·'; a='-' ;;
        *)                     u='✗'; a='x' ;;
    esac
    if [ "$UNICODE" -eq 1 ]; then printf '%s' "$u"; else printf '%s' "$a"; fi
}

class_colour() {
    # class_colour STATE -> the colour of the class of the state
    case "$(state_class "$1")" in
        good) printf '%s' "$C_GOOD" ;;
        info) printf '%s' "$C_INFO" ;;
        dim)  printf '%s' "$C_DIM" ;;
        *)    printf '%s' "$C_BAD" ;;
    esac
}

progress_show() {
    local frame
    [ "$PROGRESS" -eq 1 ] || return 0
    if [ "$UNICODE" -eq 1 ]; then
        frame=${SPIN_U[$(( SPIN_I % 10 ))]}
    else
        frame=${SPIN_A[$(( SPIN_I % 4 ))]}
    fi
    SPIN_I=$(( SPIN_I + 1 ))
    printf '\r\033[K  %s%s%s %s of %s' "$C_CYAN" "$frame" "$C_OFF" "$1" "$2" >&2
}

progress_clear() {
    [ "$PROGRESS" -eq 1 ] || return 0
    printf '\r\033[K' >&2
}

put() {
    # put TEXT: one line of the report, on the screen and in the copy kept
    # for the notification.
    [ -n "$TMP" ] && printf '%s\n' "$1" >> "$TMP/report.txt"
    [ "$QUIET" -eq 1 ] && return 0
    printf '%s\n' "$1"
}

put_styled() {
    # put_styled PLAIN STYLED: PLAIN goes to the copy kept for the
    # notification and to a pipe, STYLED to a terminal that shows colours.
    [ -n "$TMP" ] && printf '%s\n' "$1" >> "$TMP/report.txt"
    [ "$QUIET" -eq 1 ] && return 0
    if [ "$STYLED" -eq 1 ]; then
        printf '%s\n' "$2"
    else
        printf '%s\n' "$1"
    fi
}

put_title() {
    # put_title TEXT: a line that heads a part of the report.
    put_styled "$1" "$C_BOLD$1$C_OFF"
}

style_message() {
    # style_message TEXT -> the message of a repository, its marks coloured
    local t="$1"
    t=${t//\[PUBLIC\]/[$C_PUBLIC"PUBLIC"$C_OFF]}
    t=${t//NOT committed/$C_BAD"NOT committed"$C_OFF}
    printf '%s' "$t"
}

style_detail() {
    # style_detail LINE -> a line of detail: the commit at its start in the
    # colour of git, the word for a change in the colour of its state, the
    # level of a finding in its own; the rest faint.
    local line="$1" word rest
    if [ "$EXEC_OUTPUT" -eq 1 ]; then
        printf '%s' "$line"
        return 0
    fi
    if [[ $line =~ ^([0-9a-f]{7,40})[[:space:]]+(.*)$ ]]; then
        printf '%s%s%s %s%s%s' "$C_HASH" "${BASH_REMATCH[1]}" "$C_OFF" "$C_DIM" "${BASH_REMATCH[2]}" "$C_OFF"
        return 0
    fi
    word=${line%% *}
    rest=${line#"$word"}
    case "$word" in
        new)              printf '%s%s%s%s' "$C_GOOD" "$word" "$C_OFF" "$rest" ;;
        changed)          printf '%s%s%s%s' "$C_INFO" "$word" "$C_OFF" "$rest" ;;
        deleted|conflict) printf '%s%s%s%s' "$C_BAD" "$word" "$C_OFF" "$rest" ;;
        warning:)         printf '%s%s%s%s' "$C_INFO" "$word" "$C_OFF" "$rest" ;;
        problem:)         printf '%s%s%s%s' "$C_BAD" "$word" "$C_OFF" "$rest" ;;
        *)                printf '%s%s%s' "$C_DIM" "$line" "$C_OFF" ;;
    esac
}

put_repo() {
    # put_repo STATE ATTENTION NAME BRANCH MESSAGE
    local state="$1" attention="$2" name="$3" branch="$4" message="$5" label colour="" plain name_colour
    label=$(state_label "$state")
    plain=$(printf '  %-13s %-*s  %-8s %s' "$label" "$NAME_WIDTH" "$name" "$branch" "$message")
    plain=${plain%"${plain##*[! ]}"}
    [ -n "$TMP" ] && printf '%s\n' "$plain" >> "$TMP/report.txt"
    SHOWN=1
    if [ "$QUIET" -eq 1 ] && [ "$attention" -ne 1 ]; then
        return 0
    fi
    if [ "$STYLED" -eq 1 ]; then
        colour=$(class_colour "$state")
        name_colour=$C_NAME
        [ "$colour" = "$C_DIM" ] && name_colour=$C_DIM
        printf '  %s%s %-13s%s %s%-*s%s  %s%-8s%s %s\n' "$colour" "$(mark "$state")" "$label" "$C_OFF" \
            "$name_colour" "$NAME_WIDTH" "$name" "$C_OFF" "$C_CYAN" "$branch" "$C_OFF" "$(style_message "$message")"
    else
        printf '%s\n' "$plain"
    fi
}

read_record() {
    # read_record FILE: the record of one repository into the REC_* variables.
    local kind a b c d
    REC_state=""; REC_attention=0; REC_branch=""; REC_message=""
    REC_lines=(); REC_moves=()
    while IFS=$US read -r kind a b c d; do
        case "$kind" in
            S) REC_state=$a; REC_attention=$b; REC_branch=$c; REC_message=$d ;;
            D) REC_lines+=("$a") ;;
            J) REC_moves+=("$a$US$b$US$c") ;;
        esac
    done < "$1"
    if [ -z "$REC_state" ]; then
        REC_state="lost"; REC_attention=1
        REC_message="no result came back for this repository"
    fi
    REC_message=$(printf '%s' "$REC_message" | redact)
    return 0
}

print_record() {
    # print_record INDEX: the line of the repository read by read_record,
    # and the lines of detail under it.
    local idx="$1" line
    put_repo "$REC_state" "$REC_attention" "${NAMES[$idx]}" "$REC_branch" "$REC_message"
    for line in ${REC_lines[@]+"${REC_lines[@]}"}; do
        line=$(printf '%s' "$line" | redact)
        [ -n "$TMP" ] && printf '        %s\n' "$line" >> "$TMP/report.txt"
        if [ "$QUIET" -eq 0 ] || [ "$REC_attention" = 1 ]; then
            if [ "$STYLED" -eq 1 ]; then
                printf '        %s\n' "$(style_detail "$line")"
            else
                printf '        %s\n' "$line"
            fi
        fi
    done
    return 0
}

render() {
    # render INDEX FILE: read the record of one repository, count it, print
    # it when it changed or needs the user (always with --verbose).
    local idx="$1" move action old new
    read_record "$2"
    [ "$REC_state" = "ignored" ] && return 0
    for move in ${REC_moves[@]+"${REC_moves[@]}"}; do
        IFS=$US read -r action old new <<EOF
$move
EOF
        journal "$action" "${REPOS[$idx]}" "$old" "$new"
    done
    TOTAL=$(( TOTAL + 1 ))
    tally "$REC_state"
    if [ "$REC_attention" = 1 ]; then
        ATTENTION=1
        ATTENTION_LIST="$ATTENTION_LIST${ATTENTION_LIST:+, }${NAMES[$idx]} ($(state_label "$REC_state"))"
    fi
    if [ "$PORCELAIN" -eq 1 ]; then
        printf '%s\t%s\t%s\t%s\n' "$REC_state" "${REPOS[$idx]}" "$REC_branch" "$REC_message"
        return 0
    fi
    if [ "$REC_attention" != 1 ] && [ "$VERBOSE" -eq 0 ]; then
        case "$(state_class "$REC_state")" in
            dim) return 0 ;;
        esac
    fi
    print_record "$idx"
    return 0
}

header() {
    # header TEXT: the first line of a report.
    local count
    [ "$PORCELAIN" -eq 1 ] && return 0
    count="$(plural "${#REPOS[@]}" repository) under $ROOT_LABEL"
    put_styled "$PROG $COMMAND: $count$1" "$C_TITLE$PROG $COMMAND$C_OFF: $count${1:+$C_DIM$1$C_OFF}"
    put ""
}

summary() {
    local state var n text="" styled="" phrase elapsed when="" head
    [ "$PORCELAIN" -eq 1 ] && return 0
    for state in $STATE_ORDER; do
        var="N_$state"
        n=${!var:-0}
        [ "$n" -gt 0 ] || continue
        phrase=$(state_phrase "$state" "$n")
        text="$text${text:+, }$phrase"
        styled="$styled${styled:+, }$(class_colour "$state")$phrase$C_OFF"
    done
    # On the screen a run of some length says how long it took; the plain
    # text, which a program or a notification may compare, does not depend
    # on the clock.
    elapsed=$(( SECONDS - RUN_START ))
    [ "$elapsed" -ge 2 ] && when=" in $elapsed s"
    head=$(plural "$TOTAL" repository)
    # A blank line parts the summary from the lines above it, and only from
    # them: the header already ends with one.
    [ "$SHOWN" -eq 1 ] && put ""
    put_styled "$head: ${text:-nothing to report}." "$C_BOLD$head$when$C_OFF: ${styled:-nothing to report}."
    if [ -n "$ATTENTION_LIST" ]; then
        put_styled "Needs you: $ATTENTION_LIST." "$C_BAD$(mark failed) Needs you:$C_OFF $ATTENTION_LIST."
    fi
    if [ "$STOP" -eq 1 ]; then
        put_styled "The run was stopped before the end." "${C_INFO}The run was stopped before the end.$C_OFF"
    fi
    return 0
}

journal() {
    # journal ACTION PATH OLD NEW: append to the record of what the tool moved.
    [ -n "$STATE_DIR" ] || return 0
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$COMMAND" "$1" "$2" "$3" "$4" \
        >> "$STATE_DIR/journal.tsv" 2>/dev/null
    return 0
}

remember_run() {
    # The date of the last pull and of the last push, shown by "status".
    [ -n "$STATE_DIR" ] || return 0
    mkdir -p "$STATE_DIR" 2>/dev/null || return 0
    date '+%Y-%m-%d %H:%M' > "$STATE_DIR/last.$1" 2>/dev/null
    return 0
}

finish() {
    summary
    notify
    if [ "$STOP" -eq 1 ]; then
        exit "$EX_INTERRUPT"
    fi
    if [ "$ATTENTION" -eq 1 ]; then
        exit "$EX_ATTENTION"
    fi
    exit "$EX_OK"
}

no_repository() {
    [ "${#REPOS[@]}" -gt 0 ] && return 1
    [ "$PORCELAIN" -eq 1 ] || put_styled "$PROG $COMMAND: no git repository found under $ROOT_LABEL." \
        "$C_TITLE$PROG $COMMAND$C_OFF: no git repository found under $ROOT_LABEL."
    return 0
}

# ---------------------------------------------------------------------------
# One repository: what git says about it
# ---------------------------------------------------------------------------

g() { "${GIT[@]}" "$@"; }

inspect() {
    # Read the state of $REPO into the R_* variables. Returns 1 when the
    # folder is not a usable repository: R_problem then says why, and stays
    # empty for a folder that only looks like one.
    local out rc line inside bare shallow gitdir common prefix path rest
    R_problem=""; R_branch=""; R_oid=""; R_detached=0; R_unborn=0
    R_upstream=""; R_ahead=""; R_behind=""
    R_tracked=0; R_unmerged=0; R_untracked=0
    R_up_ref=""; R_up_remote=""; R_up_rref=""; R_push_ref=""; R_push_remote=""
    R_operation=""; R_busy=0; R_remotes=0; R_shallow=0; R_worktree=0

    out=$(g rev-parse --is-inside-work-tree --is-bare-repository --is-shallow-repository \
        --git-dir --git-common-dir --show-prefix 2>&1)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        if [ -f "$REPO/.git/HEAD" ] || { [ -f "$REPO/.git" ] && grep -q '^gitdir:' "$REPO/.git" 2>/dev/null; }; then
            R_problem=${out%%"$NL"*}
            R_problem=${R_problem#fatal: }
        fi
        return 1
    fi
    {
        IFS= read -r inside
        IFS= read -r bare
        IFS= read -r shallow
        IFS= read -r gitdir
        IFS= read -r common
        IFS= read -r prefix
    } <<EOF
$out
EOF
    # A folder inside a larger repository answers with a prefix: it is not a
    # repository of its own.
    if [ "$inside" != "true" ] || [ "$bare" != "false" ] || [ -n "${prefix:-}" ]; then
        return 1
    fi
    [ "$shallow" = "true" ] && R_shallow=1
    [ "$gitdir" != "$common" ] && R_worktree=1

    while IFS= read -r line; do
        case "$line" in
            "# branch.oid "*)
                R_oid=${line#\# branch.oid }
                [ "$R_oid" = "(initial)" ] && R_unborn=1
                ;;
            "# branch.head "*)
                R_branch=${line#\# branch.head }
                [ "$R_branch" = "(detached)" ] && R_detached=1
                ;;
            "# branch.upstream "*)
                R_upstream=${line#\# branch.upstream }
                ;;
            "# branch.ab "*)
                rest=${line#\# branch.ab }
                R_ahead=${rest%% *}
                R_ahead=${R_ahead#+}
                R_behind=${rest##* }
                R_behind=${R_behind#-}
                ;;
            "1 "*|"2 "*) R_tracked=$(( R_tracked + 1 )) ;;
            "u "*)       R_unmerged=$(( R_unmerged + 1 )) ;;
            "? "*)       R_untracked=$(( R_untracked + 1 )) ;;
        esac
    done <<EOF
$(g status --porcelain=v2 --branch --untracked-files=normal --no-renames 2>/dev/null)
EOF

    if [ "$R_detached" -eq 0 ] && [ "$R_unborn" -eq 0 ] && [ -n "$R_branch" ]; then
        IFS=$US read -r R_up_ref R_up_remote R_up_rref R_push_ref R_push_remote <<EOF
$(g for-each-ref --format='%(upstream)%1f%(upstream:remotename)%1f%(upstream:remoteref)%1f%(push)%1f%(push:remotename)' "refs/heads/$R_branch" 2>/dev/null)
EOF
    fi

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        case "$line" in
            /*) path=$line ;;
            *)  path="$REPO/$line" ;;
        esac
        [ -e "$path" ] || continue
        case "$line" in
            *rebase-merge|*rebase-apply) R_operation="a rebase" ;;
            *MERGE_HEAD)                 R_operation="a merge" ;;
            *CHERRY_PICK_HEAD)           R_operation="a cherry-pick" ;;
            *REVERT_HEAD)                R_operation="a revert" ;;
            *BISECT_LOG)                 R_operation="a bisection" ;;
            *index.lock)                 R_busy=1 ;;
        esac
    done <<EOF
$(g rev-parse --git-path rebase-merge --git-path rebase-apply --git-path MERGE_HEAD \
    --git-path CHERRY_PICK_HEAD --git-path REVERT_HEAD --git-path BISECT_LOG --git-path index.lock 2>/dev/null)
EOF

    while IFS= read -r line; do
        [ -n "$line" ] && R_remotes=$(( R_remotes + 1 ))
    done <<EOF
$(g remote 2>/dev/null)
EOF
    return 0
}

repo_settings() {
    # The settings of this repository that steer the tool: its own
    # gh-batch.* keys and a few git keys that decide how to talk to it.
    # git names the scope of each value, which tells a choice made inside
    # the repository from the general one.
    local line scope key val
    R_skip=0; R_pullonly=0; R_sshcmd=""; R_sshvariant=""; R_lowspeed=0; R_gpgsign=0
    R_commit_eff=""; R_commit_local=""; R_autosetup=0; R_pushdefault=""
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        scope=${line%%"$TAB"*}
        line=${line#*"$TAB"}
        key=${line%% *}
        val=""
        case "$line" in *" "*) val=${line#* } ;; esac
        case "$key" in
            gh-batch.skip)      if truthy "$val"; then R_skip=1; else R_skip=0; fi ;;
            gh-batch.pullonly)  if truthy "$val"; then R_pullonly=1; else R_pullonly=0; fi ;;
            gh-batch.commit)
                if truthy "$val"; then R_commit_eff=1; else R_commit_eff=0; fi
                case "$scope" in
                    local|worktree) R_commit_local=$R_commit_eff ;;
                esac
                ;;
            core.sshcommand)    R_sshcmd=$val ;;
            ssh.variant)        R_sshvariant=$val ;;
            http.lowspeedlimit|http.lowspeedtime) R_lowspeed=1 ;;
            commit.gpgsign)     if truthy "$val"; then R_gpgsign=1; else R_gpgsign=0; fi ;;
            push.autosetupremote) if truthy "$val"; then R_autosetup=1; else R_autosetup=0; fi ;;
            push.default)       R_pushdefault=$val ;;
        esac
    done <<EOF
$(g config --show-scope --get-regexp '^(gh-batch\.|core\.sshcommand$|ssh\.variant$|http\.lowspeed|commit\.gpgsign$|push\.autosetupremote$|push\.default$)' 2>/dev/null)
EOF
    return 0
}

repo_begin() {
    # Inspect $REPO and settle the cases every command treats alike.
    # Returns 1 when the repository is settled and nothing more is to do.
    GIT=(git -C "$REPO" -c credential.interactive=false -c submodule.recurse=false)
    if ! inspect; then
        if [ -n "$R_problem" ]; then
            emit unreadable 1 "git cannot read it: $R_problem"
        else
            emit ignored 0 ""
        fi
        return 1
    fi
    repo_settings
    if [ "$R_skip" -eq 1 ]; then
        emit skipped 0 "set aside by gh-batch.skip"
        return 1
    fi
    if [ "$R_worktree" -eq 1 ]; then
        emit skipped 0 "a linked worktree: its main repository is the one to handle"
        return 1
    fi
    return 0
}

net_setup() {
    # How git talks to the server of this repository: stalled transfers are
    # dropped, and ssh never stops to ask.
    NETCFG=()
    if [ "$R_lowspeed" -eq 0 ]; then
        NETCFG=(-c http.lowSpeedLimit=1000 -c http.lowSpeedTime=30)
    fi
    if [ "$USER_SSH" -eq 0 ]; then
        unset GIT_SSH_COMMAND
        case "$R_sshvariant" in
            ""|ssh|auto)
                export GIT_SSH_COMMAND="${R_sshcmd:-ssh} -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
                ;;
        esac
    fi
    return 0
}

snapshot() {
    # What must be identical before and after when a repository is said to
    # be untouched: the commit, the branch, every pending change.
    g rev-parse -q --verify HEAD 2>/dev/null
    g symbolic-ref -q HEAD 2>/dev/null
    g status --porcelain=v1 --untracked-files=all 2>/dev/null
    return 0
}

mark_inflight() {
    [ -n "$STATE_DIR" ] && [ -d "$STATE_DIR" ] || return 0
    printf '%s\n' "$REPO" > "$STATE_DIR/inflight.$$.$IDX" 2>/dev/null
    return 0
}

unmark_inflight() {
    [ -n "$STATE_DIR" ] && rm -f "$STATE_DIR/inflight.$$.$IDX"
    return 0
}

uses_lfs() {
    local path
    path=$(g rev-parse --git-path lfs 2>/dev/null) || return 1
    case "$path" in
        /*) ;;
        *)  path="$REPO/$path" ;;
    esac
    [ -d "$path" ]
}

# ---------------------------------------------------------------------------
# Bringing one repository level with its server
# ---------------------------------------------------------------------------

net_failure() {
    # net_failure STATUS -> the words for a network step that did not succeed
    case "$1" in
        124) printf 'no answer from the server within %s s' "$TIMEOUT" ;;
        125) printf 'the server asked for a password or a passphrase' ;;
        *)   last_line "$ERR" ;;
    esac
}

fetch_upstream() {
    # Fetch the remote that the branch follows. Returns 0 when the branch is
    # still on the server, 1 on a failure (F_msg), 2 when the run was
    # stopped, 3 when the branch left the server.
    local rc before after line found=0 args=(fetch --no-progress)
    F_msg=""
    before=$(g rev-parse -q --verify "$R_up_ref" 2>/dev/null)
    [ "$FETCH_PORCELAIN" -eq 1 ] && args+=(--porcelain --verbose)
    run_net fetch "${GIT[@]}" ${NETCFG[@]+"${NETCFG[@]}"} "${args[@]}" "$R_up_remote"
    rc=$?
    case "$rc" in
        0|1) ;;
        130) return 2 ;;
        *)   F_msg=$(net_failure "$rc"); return 1 ;;
    esac
    if [ "$FETCH_PORCELAIN" -eq 1 ]; then
        # Every reference of the server has its line; a branch without one is
        # gone, even though its last known position stays in this clone.
        while IFS= read -r line; do
            if [ "${line##* }" = "$R_up_ref" ] && [ "${line%% *}" != "-" ]; then
                found=1
                break
            fi
        done < "$OUT"
        if [ "$found" -eq 0 ] && [ "$rc" -ne 0 ]; then
            F_msg=$(last_line "$ERR")
            return 1
        fi
    else
        after=$(g rev-parse -q --verify "$R_up_ref" 2>/dev/null)
        [ "$after" != "$before" ] && found=1
    fi
    if [ "$found" -eq 0 ]; then
        # The fetch did not show the branch. The server is asked for it by
        # name before it is said to be gone: a remote set to fetch only
        # some branches does not list the others.
        run_net lsremote "${GIT[@]}" ${NETCFG[@]+"${NETCFG[@]}"} ls-remote --exit-code "$R_up_remote" "$R_up_rref"
        rc=$?
        case "$rc" in
            0)   ;;
            2)   return 3 ;;
            130) return 2 ;;
            *)   F_msg=$(net_failure "$rc"); return 1 ;;
        esac
    fi
    g rev-parse -q --verify "$R_up_ref^{commit}" >/dev/null 2>&1 || return 3
    return 0
}

incoming() {
    # incoming OLD NEW COUNT -> the first new commits, one per line, then
    # what was left out. The merge commits are counted, not listed, so that
    # the lines and the count of the report agree.
    local limit=5 line listed=0 merges rest
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        listed=$(( listed + 1 ))
        printf '%s\n' "$(clip "$line" 100)"
    done <<EOF
$(g log --no-merges --format='%h %s' -n "$limit" "$1..$2" 2>/dev/null)
EOF
    merges=$(g rev-list --merges --count "$1..$2" 2>/dev/null)
    is_uint "$merges" || merges=0
    rest=$(( $3 - merges - listed ))
    if [ "$rest" -gt 0 ] && [ "$merges" -gt 0 ]; then
        printf '... and %s more, and %s\n' "$rest" "$(plural "$merges" "merge commit")"
    elif [ "$rest" -gt 0 ]; then
        printf '... and %s more\n' "$rest"
    elif [ "$merges" -gt 0 ]; then
        printf '... and %s\n' "$(plural "$merges" "merge commit")"
    fi
    return 0
}

refused_files() {
    # The files git names when it refuses to overwrite them: its message
    # lists them one per line after a tab, whatever the language.
    local line list="" n=0
    [ -f "$ERR" ] || return 0
    while IFS= read -r line; do
        case "$line" in
            "$TAB"*)
                n=$(( n + 1 ))
                [ "$n" -le 5 ] && list="$list${list:+, }${line#"$TAB"}"
                ;;
        esac
    done < "$ERR"
    [ "$n" -gt 5 ] && list="$list and $(( n - 5 )) more"
    printf '%s' "$list"
}

lfs_prefetch() {
    # Large files are downloaded while the network step is still allowed to
    # fail, so that the checkout which follows needs no server.
    uses_lfs || return 0
    have git-lfs || return 0
    run_net lfs "${GIT[@]}" lfs fetch "$R_up_remote" "$R_up_ref"
}

written_back() {
    # written_back FILE -> the words for the files that FILE lists (deleted
    # here before the update, separated by NUL) and that the update wrote
    # back, or nothing.
    local path list="" n=0
    [ -s "$1" ] || return 0
    while IFS= read -r -d '' path; do
        if [ -e "$REPO/$path" ] || [ -L "$REPO/$path" ]; then
            n=$(( n + 1 ))
            [ "$n" -le 5 ] && list="$list${list:+, }$path"
        fi
    done < "$1"
    [ "$n" -gt 0 ] || return 0
    [ "$n" -gt 5 ] && list="$list and $(( n - 5 )) more"
    if [ "$n" -eq 1 ]; then
        printf 'a file deleted here and changed on the server came back: %s' "$list"
    else
        printf '%s files deleted here and changed on the server came back: %s' "$n" "$list"
    fi
}

fast_forward() {
    # The branch is strictly behind: move it forward. Pending changes that
    # the new commits do not touch stay; otherwise git refuses and nothing
    # changes. A file deleted here without a commit is the exception: git
    # does not count a missing file as a change it would overwrite, and
    # writes the new version of a file that the new commits change. The
    # report names such files.
    local before after now rc files pending back
    if ! lfs_prefetch; then
        U_state="failed"; U_attn=1
        U_msg="the large files of the new commits could not be downloaded: $(net_failure "$?")"
        return 0
    fi
    pending=$(( R_tracked + R_untracked ))
    : > "$W/deleted"
    if [ "$R_tracked" -gt 0 ]; then
        g diff --no-color --name-only --diff-filter=D -z > "$W/deleted" 2>/dev/null
    fi
    before=$(snapshot)
    mark_inflight
    run_local ff "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false -c merge.autoStash=false \
        merge --ff-only --no-squash --no-overwrite-ignore --no-stat --quiet "$U_up"
    rc=$?
    unmark_inflight
    now=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
    if [ "$rc" -eq 0 ] && [ "$now" = "$U_up" ]; then
        U_state="updated"
        U_msg="$(plural "$U_behind" "new commit")"
        back=$(written_back "$W/deleted")
        if [ "$pending" -gt 0 ]; then
            inspect
            if [ $(( R_tracked + R_untracked )) -gt 0 ] && [ -n "$back" ]; then
                U_msg="$U_msg (your other pending changes were kept)"
            elif [ $(( R_tracked + R_untracked )) -gt 0 ]; then
                U_msg="$U_msg (your pending changes were kept)"
            fi
        fi
        [ -n "$back" ] && U_msg="$U_msg; $back"
        U_details=$(incoming "$U_head" "$U_up" "$U_behind")
        U_move="fast-forward$US$U_head$US$U_up"
        return 0
    fi
    after=$(snapshot)
    if [ "$after" = "$before" ]; then
        U_state="blocked"; U_attn=1
        files=$(refused_files)
        if [ -n "$files" ]; then
            U_msg="$(plural "$U_behind" "new commit") on the server would overwrite your changes in $files: nothing was changed"
        else
            U_msg="$(plural "$U_behind" "new commit") on the server could not be taken, git refused the update ($(last_line "$ERR")): nothing was changed"
        fi
    else
        U_state="halfupdated"; U_attn=1
        U_msg="the update stopped half-way from ${U_head:0:9} to ${U_up:0:9}: look at it with git status"
    fi
    return 0
}

in_the_way() {
    # in_the_way BASE -> the first file added on the server that exists here
    # without being tracked. A replay would stop on an untracked file and
    # silently replace an ignored one.
    local path
    while IFS= read -r -d '' path; do
        if [ -e "$REPO/$path" ] || [ -L "$REPO/$path" ]; then
            if ! g ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
                printf '%s' "$path"
                return 0
            fi
        fi
    done < <(g diff --name-only --no-renames --diff-filter=A -z "$1" "$U_up" 2>/dev/null)
    return 0
}

reconcile() {
    # Both sides have new commits. Following the setting, report, or replay
    # the local commits on top (rebase), or join the histories (merge); a
    # conflict is undone and reported.
    local reason="" count base fork blocker before after now rc files kind both
    both="$(plural "$U_ahead" commit) here and $U_behind on the server"
    if [ "$DIVERGED" = "report" ]; then
        U_state="diverged"; U_attn=1
        U_msg="$both: left to you (git pull --rebase, or git pull --no-rebase)"
        return 0
    fi
    base=$(g merge-base "$U_head" "$U_up" 2>/dev/null)
    if [ "$R_tracked" -gt 0 ]; then
        reason="files with uncommitted changes are in the working tree"
    elif [ -z "$base" ]; then
        reason="the two histories have no common commit"
    elif [ "$DIVERGED" = "rebase" ]; then
        count=$(g rev-list --merges --count "$U_up..$U_head" 2>/dev/null)
        fork=$(g merge-base --fork-point "$R_up_ref" "$U_head" 2>/dev/null)
        if [ "$R_shallow" -eq 1 ]; then
            reason="the clone is shallow"
        elif [ "${count:-0}" -gt 0 ]; then
            reason="there are merge commits among the local ones"
        elif [ "$R_gpgsign" -eq 1 ]; then
            reason="the commits are signed, and signing them again may ask for a passphrase"
        elif [ "$(g rev-list --count "$U_head" --not --remotes 2>/dev/null)" != "$U_ahead" ]; then
            reason="some of the local commits are already on a server"
        elif [ -n "$fork" ] && [ "$fork" != "$base" ]; then
            reason="the history on the server was rewritten"
        fi
    fi
    if [ -z "$reason" ] && [ "$DIVERGED" = "rebase" ]; then
        blocker=$(in_the_way "$base")
        [ -n "$blocker" ] && reason="the file $blocker, untracked here, was added on the server"
    fi
    if [ -n "$reason" ]; then
        U_state="diverged"; U_attn=1
        U_msg="$both: not reconciled automatically, because $reason"
        return 0
    fi
    if ! lfs_prefetch; then
        U_state="failed"; U_attn=1
        U_msg="the large files of the new commits could not be downloaded: $(net_failure "$?")"
        return 0
    fi

    before=$(snapshot)
    mark_inflight
    if [ "$DIVERGED" = "rebase" ]; then
        kind="rebase"
        run_local rebase "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false \
            -c rebase.autoStash=false -c rebase.updateRefs=false -c rebase.rebaseMerges=false \
            -c rebase.autoSquash=false -c rebase.backend=merge -c merge.directoryRenames=conflict \
            rebase --no-fork-point --quiet "$U_up"
        rc=$?
    else
        kind="merge"
        run_local merge "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false -c merge.autoStash=false \
            merge --no-edit --no-squash --no-ff --no-overwrite-ignore --no-stat --quiet "$U_up"
        rc=$?
    fi
    now=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
    inspect
    if [ "$rc" -eq 0 ] && [ -z "$R_operation" ] && [ "$R_unmerged" -eq 0 ] && [ "$R_detached" -eq 0 ] &&
        g merge-base --is-ancestor "$U_up" "$now" 2>/dev/null; then
        unmark_inflight
        if [ "$kind" = "rebase" ]; then
            U_state="rebased"
            U_msg="your $(plural "$U_ahead" commit) replayed on top of $(plural "$U_behind" "new one")"
        else
            U_state="merged"
            U_msg="your $(plural "$U_ahead" commit) merged with $(plural "$U_behind" "new one")"
        fi
        U_details=$(incoming "$U_head" "$U_up" "$U_behind")
        U_move="$kind$US$U_head$US$now"
        return 0
    fi

    # The attempt did not go through: collect what conflicts, undo, verify.
    files=$(conflict_files)
    if [ -n "$R_operation" ]; then
        run_local abort "${GIT[@]}" "$kind" --abort
    fi
    inspect
    after=$(snapshot)
    unmark_inflight
    if [ "$after" = "$before" ]; then
        if [ -n "$files" ]; then
            U_state="conflict"; U_attn=1
            U_msg="$both, and they conflict in $files: nothing was changed, the $kind is yours (git pull --$( [ "$kind" = rebase ] && printf 'rebase' || printf 'no-rebase' ))"
        else
            U_state="blocked"; U_attn=1
            U_msg="$both: git refused the $kind ($(last_line "$W/$kind.err")), nothing was changed"
        fi
    else
        U_state="halfupdated"; U_attn=1
        U_msg="the $kind could not be undone cleanly; the branch was at ${U_head:0:9}: look at it with git status"
    fi
    return 0
}

conflict_files() {
    local path list="" n=0
    while IFS= read -r -d '' path; do
        n=$(( n + 1 ))
        [ "$n" -le 5 ] && list="$list${list:+, }$path"
    done < <(g diff --name-only --diff-filter=U -z 2>/dev/null)
    [ "$n" -gt 5 ] && list="$list and $(( n - 5 )) more"
    printf '%s' "$list"
}

level_with_server() {
    # The whole morning logic for the repository already inspected: fetch,
    # compare, bring forward. Sets U_state, U_attn, U_msg, U_details, U_move.
    local rc counts
    U_state=""; U_attn=0; U_msg=""; U_details=""; U_move=""
    U_head=""; U_up=""; U_ahead=0; U_behind=0

    if [ "$R_busy" -eq 1 ]; then
        sleep 1
        inspect
    fi
    if [ "$R_busy" -eq 1 ]; then
        U_state="busy"; U_attn=1
        U_msg="another git process holds its index (index.lock): try again later"
        return 0
    fi
    if [ -n "$R_operation" ]; then
        U_state="unfinished"; U_attn=1
        U_msg="$R_operation is in progress: finish or abort it first"
        return 0
    fi
    if [ "$R_unmerged" -gt 0 ]; then
        U_state="unfinished"; U_attn=1
        U_msg="$(plural "$R_unmerged" file) with unresolved conflicts"
        return 0
    fi
    if [ "$R_remotes" -eq 0 ]; then
        U_state="localonly"; U_msg="it has no remote: it exists on this machine only"
        return 0
    fi
    if [ "$R_detached" -eq 1 ]; then
        U_state="detached"; U_msg="HEAD is detached: there is no branch to bring forward"
        return 0
    fi
    if [ "$R_unborn" -eq 1 ]; then
        U_state="skipped"; U_msg="it has no commit yet"
        return 0
    fi
    if [ -z "$R_up_ref" ] || [ "$R_up_remote" = "." ] || [ -z "$R_up_remote" ]; then
        U_state="noupstream"; U_msg="the branch $R_branch follows no branch of a server"
        return 0
    fi

    net_setup
    fetch_upstream
    rc=$?
    case "$rc" in
        0) ;;
        2) U_state="interrupted"; U_attn=1; U_msg="stopped during the fetch"; return 0 ;;
        3) U_state="gone"; U_attn=1
           U_msg="the branch ${R_up_rref#refs/heads/} is no longer on $R_up_remote: choose what $R_branch should follow"
           return 0 ;;
        *) U_state="failed"; U_attn=1; U_msg="the fetch failed: $F_msg"; return 0 ;;
    esac
    U_head=$(g rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)
    U_up=$(g rev-parse -q --verify "$R_up_ref^{commit}" 2>/dev/null)
    counts=$(g rev-list --left-right --count "$U_head...$U_up" 2>/dev/null)
    U_ahead=${counts%%"$TAB"*}
    U_behind=${counts##*"$TAB"}
    if ! is_uint "$U_ahead" || ! is_uint "$U_behind"; then
        U_state="failed"; U_attn=1; U_msg="the two histories could not be compared"
        return 0
    fi
    if stopped; then
        U_state="interrupted"; U_attn=1; U_msg="stopped after the fetch, before any change"
        return 0
    fi

    if [ "$U_behind" -eq 0 ]; then
        if [ "$U_ahead" -eq 0 ]; then
            U_state="uptodate"
        else
            U_state="ahead"; U_msg="$(plural "$U_ahead" commit) to push"
        fi
        return 0
    fi
    if [ "$ONLY_LOOK" -eq 1 ]; then
        if [ "$U_ahead" -eq 0 ]; then
            U_state="behind"; U_msg="$(plural "$U_behind" "new commit") on the server: pull will bring them"
            U_details=$(incoming "$U_head" "$U_up" "$U_behind")
        else
            U_state="diverged"
            U_msg="$(plural "$U_ahead" commit) here and $U_behind on the server"
            if [ "$DIVERGED" = "report" ]; then
                U_attn=1; U_msg="$U_msg: pull will leave it to you"
            else
                U_msg="$U_msg: pull will try a $DIVERGED"
            fi
        fi
        return 0
    fi
    if [ "$U_ahead" -eq 0 ]; then
        fast_forward
    else
        reconcile
    fi
    return 0
}

emit_update() {
    # Publish what level_with_server found.
    emit "$U_state" "$U_attn" "$U_msg"
    details "$U_details"
    if [ -n "$U_move" ]; then
        printf 'J%s%s\n' "$US" "$U_move"
    fi
    return 0
}

do_pull() {
    repo_begin || return 0
    level_with_server
    emit_update
}

# ---------------------------------------------------------------------------
# status: what is pending in each repository, without touching the network
# ---------------------------------------------------------------------------

oldest_change() {
    # oldest_change -> the age in seconds of the oldest pending file, or
    # nothing. The records of "status -z" end with a NUL and keep spaces.
    local record path files=() n=0 times oldest="" t
    [ -n "$STAT_STYLE" ] || return 0
    while IFS= read -r -d '' record; do
        case "$record" in
            "1 "*) path=${record#* * * * * * * * } ;;
            "u "*) path=${record#* * * * * * * * * * } ;;
            "? "*) path=${record#\? } ;;
            *)     continue ;;
        esac
        [ -e "$REPO/$path" ] || continue
        files+=("$REPO/$path")
        n=$(( n + 1 ))
        [ "$n" -ge 200 ] && break
    done < <(g status --porcelain=v2 -z --untracked-files=normal --no-renames 2>/dev/null)
    [ "$n" -gt 0 ] || return 0
    if [ "$STAT_STYLE" = "gnu" ]; then
        times=$(stat -c %Y -- "${files[@]}" 2>/dev/null)
    else
        times=$(stat -f %m -- "${files[@]}" 2>/dev/null)
    fi
    for t in $times; do
        is_uint "$t" || continue
        if [ -z "$oldest" ] || [ "$t" -lt "$oldest" ]; then
            oldest=$t
        fi
    done
    [ -n "$oldest" ] && [ "$NOW" -ge "$oldest" ] && printf '%s' $(( NOW - oldest ))
    return 0
}

change_word() {
    # change_word XY -> the word for a pending change, from the two letters
    # that "git status" gives it: new, deleted, changed, or conflict.
    case "$1" in
        "??")         printf 'new' ;;
        U?|?U|AA|DD)  printf 'conflict' ;;
        D?|?D)        printf 'deleted' ;;
        A?|?A)        printf 'new' ;;
        *)            printf 'changed' ;;
    esac
}

pending_files() {
    # pending_files LIMIT -> the pending files, one per line with the word
    # for its change: "changed  notes.txt"
    local limit="$1" record path flag n=0 more=0
    while IFS= read -r -d '' record; do
        case "$record" in
            "1 "*) flag=${record:2:2}; path=${record#* * * * * * * * } ;;
            "u "*) flag="UU"; path=${record#* * * * * * * * * * } ;;
            "? "*) flag="??"; path=${record#\? } ;;
            *)     continue ;;
        esac
        n=$(( n + 1 ))
        if [ "$n" -le "$limit" ]; then
            printf '%-8s %s\n' "$(change_word "$flag")" "$path"
        else
            more=$(( more + 1 ))
        fi
    done < <(g status --porcelain=v2 -z --untracked-files=all --no-renames 2>/dev/null)
    [ "$more" -gt 0 ] && printf '... and %s more\n' "$more"
    return 0
}

count_stashes() {
    local n=0 line
    g rev-parse -q --verify refs/stash >/dev/null 2>&1 || { printf '0'; return 0; }
    while IFS= read -r line; do
        [ -n "$line" ] && n=$(( n + 1 ))
    done <<EOF
$(g stash list 2>/dev/null)
EOF
    printf '%s' "$n"
}

describe_pending() {
    # "3 changed, 2 new" for the pending files of the repository inspected
    local text=""
    [ "$R_tracked" -gt 0 ] && text="$R_tracked changed"
    [ "$R_untracked" -gt 0 ] && text="$text${text:+, }$R_untracked new"
    printf '%s' "$text"
}

do_status() {
    local state="clean" attention=0 parts="" pending age stashes first
    repo_begin || return 0
    if [ -n "$R_operation" ]; then
        state="unfinished"; attention=1; parts="$R_operation is in progress"
    elif [ "$R_unmerged" -gt 0 ]; then
        state="unfinished"; attention=1; parts="$(plural "$R_unmerged" file) with unresolved conflicts"
    fi
    pending=$(describe_pending)
    if [ -n "$pending" ]; then
        [ "$state" = "clean" ] && state="pending"
        age=$(oldest_change)
        parts="$parts${parts:+; }$pending"
        [ -n "$age" ] && parts="$parts (the oldest since $(age_text "$age"))"
    fi
    if [ "$R_detached" -eq 1 ]; then
        [ "$state" = "clean" ] && state="detached"
        parts="$parts${parts:+; }HEAD is detached"
    elif [ "$R_unborn" -eq 1 ]; then
        parts="$parts${parts:+; }no commit yet"
    elif [ "$R_remotes" -eq 0 ]; then
        [ "$state" = "clean" ] && state="localonly"
        parts="$parts${parts:+; }no remote: it exists on this machine only"
    elif [ -z "$R_upstream" ]; then
        [ "$state" = "clean" ] && state="noupstream"
        parts="$parts${parts:+; }the branch follows no branch of a server"
    elif [ -z "$R_ahead" ]; then
        [ "$state" = "clean" ] && state="gone"
        attention=1
        parts="$parts${parts:+; }its branch $R_upstream is gone"
    else
        if [ "$R_ahead" -gt 0 ] && [ "$R_behind" -gt 0 ]; then
            [ "$state" = "clean" ] || [ "$state" = "pending" ] && state="diverged"
            parts="$parts${parts:+; }$(plural "$R_ahead" commit) here and $R_behind on the server"
        elif [ "$R_ahead" -gt 0 ]; then
            [ "$state" = "clean" ] && state="ahead"
            first=""
            IFS= read -r first < <(g log --format=%ct --reverse "$R_upstream..HEAD" 2>/dev/null)
            parts="$parts${parts:+; }$(plural "$R_ahead" commit) to push"
            if is_uint "$first" && [ "$NOW" -ge "$first" ]; then
                parts="$parts (the oldest since $(age_text $(( NOW - first ))))"
            fi
        elif [ "$R_behind" -gt 0 ]; then
            [ "$state" = "clean" ] && state="behind"
            parts="$parts${parts:+; }$(plural "$R_behind" commit) behind the last fetch"
        fi
    fi
    stashes=$(count_stashes)
    if [ "$stashes" -gt 0 ]; then
        [ "$state" = "clean" ] && state="stash"
        parts="$parts${parts:+; }$(plural "$stashes" stash)"
    fi
    emit "$state" "$attention" "$parts"
    if [ "$LONG" -eq 1 ] && [ $(( R_tracked + R_untracked + R_unmerged )) -gt 0 ]; then
        details "$(pending_files 20)"
    fi
    return 0
}

# ---------------------------------------------------------------------------
# GitHub: what the server knows about a repository
# ---------------------------------------------------------------------------

github_slug() {
    # github_slug ADDRESS -> "owner/name" in lower case when the address is
    # on GitHub, whatever its form (https, ssh, or user@host:path).
    local host lower rest owner name
    host=$(printf '%s' "${GH_HOST:-github.com}" | tr '[:upper:]' '[:lower:]')
    lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
        http://*|https://*|ssh://*|git://*|git+ssh://*)
            rest=${lower#*://}
            case "$rest" in
                *@*) rest=${rest#*@} ;;
            esac
            case "$rest" in
                "$host"/*) rest=${rest#"$host"/} ;;
                "$host":*) rest=${rest#"$host":}; rest=${rest#*/} ;;
                *)         return 0 ;;
            esac
            ;;
        *@"$host":*) rest=${lower#*@"$host":} ;;
        "$host":*)   rest=${lower#"$host":} ;;
        *)           return 0 ;;
    esac
    rest=${rest%/}
    rest=${rest%.git}
    rest=${rest%/}
    owner=${rest%%/*}
    name=${rest#*/}
    case "$name" in
        ""|*/*) return 0 ;;
    esac
    if [ -n "$owner" ] && [ "$owner" != "$rest" ]; then
        printf '%s/%s' "$owner" "$name"
    fi
    return 0
}

remote_slug() {
    # remote_slug REMOTE -> the GitHub name behind a remote of $REPO, from
    # its address as git expands it, then as the configuration writes it.
    local remote="$1" url slug
    url=$(g remote get-url --push "$remote" 2>/dev/null)
    slug=$(github_slug "$url")
    if [ -z "$slug" ]; then
        url=$(g config --get "remote.$remote.pushurl" 2>/dev/null) ||
            url=$(g config --get "remote.$remote.url" 2>/dev/null)
        slug=$(github_slug "$url")
    fi
    printf '%s' "$slug"
}

github_facts() {
    # github_facts SLUG: ask GitHub whether the repository is public, whether
    # this account may push to it, whether it is archived. Sets H_vis
    # (public, private or empty when unknown), H_push and H_archived.
    local private="" push="" archived=""
    H_vis=""; H_push=""; H_archived=""
    [ -n "$1" ] || return 0
    have gh || return 0
    spawn github env GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh api "repos/$1" \
        --jq '[(.private|tostring), (.permissions.push|tostring), (.archived|tostring)] | join("\u001f")'
    await net 20 || return 0
    IFS=$US read -r private push archived < "$OUT" || true
    case "$private" in
        true)  H_vis="private" ;;
        false) H_vis="public" ;;
    esac
    case "$push" in true|false) H_push=$push ;; esac
    case "$archived" in true|false) H_archived=$archived ;; esac
    return 0
}

# ---------------------------------------------------------------------------
# The automatic commit of the evening, and its guards
# ---------------------------------------------------------------------------

list_pending() {
    # Write the pending files of $REPO to $W/pending, one per line: the two
    # status letters, a tab, the path. Sets L_count, L_new (files that git
    # does not track yet) and L_odd (a name that cannot be written on a line).
    local record flag path
    L_count=0; L_new=0; L_odd=""
    while IFS= read -r -d '' record; do
        case "$record" in
            "1 "*) flag=${record:2:2}; path=${record#* * * * * * * * } ;;
            "u "*) flag="UU"; path=${record#* * * * * * * * * * } ;;
            "? "*) flag="??"; path=${record#\? } ;;
            *)     continue ;;
        esac
        case "$path" in
            *"$NL"*|*"$TAB"*) L_odd="a file name holds a tab or a line break"; continue ;;
        esac
        L_count=$(( L_count + 1 ))
        [ "$flag" = "??" ] && L_new=$(( L_new + 1 ))
        printf '%s\t%s\n' "$flag" "$path"
    done < <(g status --porcelain=v2 -z --untracked-files=all --no-renames 2>/dev/null) > "$W/pending"
    return 0
}

pending_words() {
    # pending_words LIMIT -> the first LIMIT files that list_pending wrote,
    # each with the word for its change: "new      abstract.tex"
    local limit="$1" flag path n=0
    while IFS=$TAB read -r flag path; do
        n=$(( n + 1 ))
        [ "$n" -le "$limit" ] || break
        printf '%-8s %s\n' "$(change_word "$flag")" "$path"
    done < "$W/pending"
    return 0
}

looks_secret() {
    # looks_secret NAME (in lower case) -> 0 when the name of the file is
    # one under which credentials are usually kept.
    case "$1" in
        .env.example|.env.sample|.env.template|.env.dist|*.pub) return 1 ;;
        .env|.env.*|*.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|*.kdbx|*.token) return 0 ;;
        id_rsa*|id_dsa*|id_ecdsa*|id_ed25519*) return 0 ;;
        .netrc|_netrc|.git-credentials|.pypirc|.htpasswd|auth.json) return 0 ;;
        credentials|credentials.*|secrets.*|secret.*) return 0 ;;
    esac
    return 1
}

big_in_batch() {
    # big_in_batch LIMIT FILE... -> prints the first file above LIMIT bytes
    local limit="$1" line size name
    shift
    while IFS= read -r line; do
        size=${line%% *}
        name=${line#* }
        if is_uint "$size" && [ "$size" -gt "$limit" ]; then
            printf '%s (%s MB)' "${name#"$REPO"/}" $(( size / 1048576 ))
            return 0
        fi
    done <<EOF
$(if [ "$STAT_STYLE" = "gnu" ]; then stat -c '%s %n' -- "$@" 2>/dev/null; else stat -f '%z %N' -- "$@" 2>/dev/null; fi)
EOF
    return 1
}

too_big() {
    # too_big -> the first pending file above the limit, with its size
    local path batch=() n=0 limit=$(( MAX_FILE_MB * 1048576 ))
    [ -n "$STAT_STYLE" ] && [ "$MAX_FILE_MB" -gt 0 ] || return 0
    while IFS=$TAB read -r _ path; do
        [ -f "$REPO/$path" ] || continue
        batch+=("$REPO/$path")
        n=$(( n + 1 ))
        if [ "$n" -ge 200 ]; then
            big_in_batch "$limit" "${batch[@]}" && return 0
            batch=()
            n=0
        fi
    done < "$W/pending"
    [ "$n" -gt 0 ] && big_in_batch "$limit" "${batch[@]}"
    return 0
}

commit_blocker() {
    # commit_blocker -> the reason why the pending files listed by
    # list_pending are not committed automatically, or nothing.
    local flag path lowpath base big
    if [ -n "$L_odd" ]; then
        printf '%s' "$L_odd"
        return 0
    fi
    if ! g var GIT_COMMITTER_IDENT >/dev/null 2>&1; then
        printf 'git does not know your name and e-mail (git config --global user.name and user.email)'
        return 0
    fi
    if [ "$MAX_NEW_FILES" -gt 0 ] && [ "$L_new" -gt "$MAX_NEW_FILES" ]; then
        printf '%s new files at once, more than the limit of %s: a .gitignore is probably missing' "$L_new" "$MAX_NEW_FILES"
        return 0
    fi
    tr '[:upper:]' '[:lower:]' < "$W/pending" > "$W/pending.lower"
    while IFS=$TAB read -r flag path <&3 && IFS=$TAB read -r _ lowpath <&4; do
        [ "$flag" = "??" ] || continue
        case "$path" in
            */)
                printf 'the folder %s is a git repository of its own: ignore it, or make it a submodule' "${path%/}"
                return 0
                ;;
        esac
        base=${lowpath##*/}
        if looks_secret "$base"; then
            printf 'the new file %s looks like a secret: commit it by hand, or add it to .gitignore' "$path"
            return 0
        fi
    done 3< "$W/pending" 4< "$W/pending.lower"
    big=$(too_big)
    if [ -n "$big" ]; then
        printf 'the file %s is above the limit of %s MB' "$big" "$MAX_FILE_MB"
    fi
    return 0
}

commits_here() {
    # commits_here -> 0 when the pending changes of $REPO are committed
    # automatically: the repository may opt out, and the command line wins
    # over the general setting.
    [ "$R_commit_local" = "0" ] && return 1
    if [ "$COMMIT_FORCED" -eq 1 ]; then
        [ "$COMMIT" -eq 1 ]
        return $?
    fi
    case "$R_commit_eff" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    [ "$COMMIT" -eq 1 ]
}

expand_message() {
    # expand_message TEMPLATE -> the subject of the automatic commit:
    # %d the date, %t the time, %h the machine, %n the number of files.
    local t="$1" out=""
    while [ -n "$t" ]; do
        case "$t" in
            %d*) out="$out$TODAY";        t=${t:2} ;;
            %t*) out="$out$CLOCK";        t=${t:2} ;;
            %h*) out="$out$MACHINE_NAME"; t=${t:2} ;;
            %n*) out="$out$L_count";      t=${t:2} ;;
            %%*) out="$out%";             t=${t:2} ;;
            *)   out="$out${t:0:1}";      t=${t:1} ;;
        esac
    done
    printf '%s' "$out"
}

commit_pending() {
    # Commit every pending change of $REPO. On a refusal (a hook, a guard)
    # the staging area is put back as it was. Returns 0 when the commit
    # exists; C_why says why it does not.
    local reason index old new rc
    C_why=""
    list_pending
    if [ "$L_count" -eq 0 ]; then
        C_why="nothing is pending any more"
        return 1
    fi
    reason=$(commit_blocker)
    if [ -n "$reason" ]; then
        C_why=$reason
        return 1
    fi
    index=$(g rev-parse --git-path index 2>/dev/null)
    case "$index" in
        /*) ;;
        *)  index="$REPO/$index" ;;
    esac
    rm -f "$W/index.before"
    [ -f "$index" ] && cp "$index" "$W/index.before"
    old=$(g rev-parse -q --verify HEAD 2>/dev/null)
    {
        printf '%s\n\n' "$(expand_message "$MESSAGE")"
        pending_words 50
        [ "$L_count" -gt 50 ] && printf '... and %s more\n' $(( L_count - 50 ))
    } > "$W/message"

    mark_inflight
    run_local add "${GIT[@]}" add -A
    rc=$?
    if [ "$rc" -eq 0 ]; then
        run_local commit "${GIT[@]}" -c gc.auto=0 -c maintenance.auto=false commit --quiet -F "$W/message"
        rc=$?
    fi
    new=$(g rev-parse -q --verify HEAD 2>/dev/null)
    if [ "$rc" -ne 0 ] || [ "$new" = "$old" ]; then
        # Nothing was committed: the staging area returns to what it was.
        if [ -f "$W/index.before" ]; then
            cp "$W/index.before" "$index"
        fi
        unmark_inflight
        C_why="git refused the commit ($(last_line "$ERR"))"
        return 1
    fi
    unmark_inflight
    record_move commit "$old" "$new"
    return 0
}

# ---------------------------------------------------------------------------
# Where a branch is pushed, and the push itself
# ---------------------------------------------------------------------------

push_target() {
    # Where "git push" would send the branch of $REPO. Sets P_remote, P_dst
    # (the name of the branch on the server), P_ref (its last known position
    # here), P_new (1 when the server has no such branch yet) and P_setup
    # (1 when the push must also record the upstream). Returns 1 with P_why
    # when there is no destination.
    local name remotes=0 first="" has_origin=0
    P_remote=""; P_dst=""; P_ref=""; P_new=0; P_setup=0; P_why=""
    if [ -n "$R_push_ref" ]; then
        if [ "$R_push_ref" = "$R_up_ref" ] && [ -n "$R_up_rref" ]; then
            P_remote=$R_up_remote
            P_dst=$R_up_rref
        else
            P_remote=$R_push_remote
            P_dst="refs/heads/${R_push_ref#refs/remotes/"$R_push_remote"/}"
        fi
        P_ref=$R_push_ref
        if [ -z "$P_remote" ] || [ "$P_remote" = "." ]; then
            P_why="the branch $R_branch follows a local branch, not a server"
            return 1
        fi
        g rev-parse -q --verify "$P_ref^{commit}" >/dev/null 2>&1 || P_new=1
        # A branch that the server lacks is created only when that was
        # asked for: by the option, or by the settings of git that make a
        # plain "git push" create it.
        if [ "$P_new" -eq 1 ] && [ "$R_pushdefault" != "current" ]; then
            if [ "$SET_UPSTREAM" -eq 1 ] || [ "$R_autosetup" -eq 1 ]; then
                P_setup=1
            else
                P_why="the branch $R_branch is not on $P_remote yet: publish it with --set-upstream"
                return 1
            fi
        fi
        return 0
    fi
    if [ -n "$R_up_ref" ]; then
        P_why="git knows no push destination for $R_branch, which follows $R_upstream under another name"
        return 1
    fi
    if [ "$SET_UPSTREAM" -eq 0 ] && [ "$R_autosetup" -eq 0 ]; then
        P_why="the branch $R_branch is on this machine only: publish it with --set-upstream"
        return 1
    fi
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        remotes=$(( remotes + 1 ))
        [ -z "$first" ] && first=$name
        [ "$name" = "origin" ] && has_origin=1
    done <<EOF
$(g remote 2>/dev/null)
EOF
    if [ "$remotes" -eq 1 ]; then
        P_remote=$first
    elif [ "$has_origin" -eq 1 ]; then
        P_remote="origin"
    else
        P_why="the branch $R_branch is on this machine only, and no remote is called origin"
        return 1
    fi
    P_dst="refs/heads/$R_branch"
    P_ref="refs/remotes/$P_remote/$R_branch"
    P_setup=1
    g rev-parse -q --verify "$P_ref^{commit}" >/dev/null 2>&1 || P_new=1
    return 0
}

count_to_push() {
    # Sets P_ahead and P_behind against the last known position of the
    # destination; a branch that the server lacks counts what no branch of
    # that remote holds yet.
    if [ "$P_new" -eq 1 ]; then
        P_ahead=$(g rev-list --count HEAD --not --remotes="$P_remote" 2>/dev/null)
        P_behind=0
    else
        P_ahead=$(g rev-list --count "$P_ref..HEAD" 2>/dev/null)
        P_behind=$(g rev-list --count "HEAD..$P_ref" 2>/dev/null)
    fi
    is_uint "$P_ahead" || P_ahead=0
    is_uint "$P_behind" || P_behind=0
    return 0
}

push_once() {
    # One push of the branch to its destination, never forced. Returns 0
    # when the server took it, 1 when the server refused it, 2 on any other
    # failure, 3 when the run was stopped. PU_why holds the words of git.
    local rc flag refs summary found="" args=(push --porcelain)
    PU_why=""
    [ "$P_setup" -eq 1 ] && args+=(--set-upstream)
    run_net push "${GIT[@]}" ${NETCFG[@]+"${NETCFG[@]}"} "${args[@]}" "$P_remote" "refs/heads/$R_branch:$P_dst"
    rc=$?
    case "$rc" in
        130)     return 3 ;;
        124|125) PU_why=$(net_failure "$rc"); return 2 ;;
    esac
    while IFS=$TAB read -r flag refs summary; do
        case "$refs" in
            *":$P_dst") found=$flag; PU_why=$summary ;;
        esac
    done < "$OUT"
    case "$found" in
        "!") return 1 ;;
        "")  PU_why=$(last_line "$ERR"); return 2 ;;
    esac
    [ "$rc" -eq 0 ] && return 0
    PU_why=$(last_line "$ERR")
    return 2
}

other_branches() {
    # Lines about the other local branches whose commits are on this machine
    # only: the evening push sends the current branch, and says what stays.
    local name upstream track n
    while IFS=$US read -r name upstream track; do
        [ -n "$name" ] || continue
        [ "$name" = "$R_branch" ] && continue
        if [ -z "$upstream" ]; then
            n=$(g rev-list --count "refs/heads/$name" --not --remotes 2>/dev/null)
            if is_uint "$n" && [ "$n" -gt 0 ]; then
                printf 'the branch %s holds %s that no server has\n' "$name" "$(plural "$n" commit)"
            fi
        else
            case "$track" in
                *">"*) printf 'the branch %s has commits that are not pushed\n' "$name" ;;
            esac
        fi
    done <<EOF
$(g for-each-ref --format='%(refname:short)%1f%(upstream)%1f%(upstream:trackshort)' refs/heads 2>/dev/null)
EOF
    return 0
}

visibility_mark() {
    case "$H_vis" in
        public) printf '  [PUBLIC]' ;;
    esac
}

do_plan() {
    # The first pass of "push": what would be committed and pushed in this
    # repository. Nothing is changed; the repositories with something to do
    # leave a marker for the second pass.
    local pending text="" block="" stays="" will_commit=0 slug total extras
    repo_begin || return 0
    if [ "$R_pullonly" -eq 1 ]; then
        emit skipped 0 "update-only (gh-batch.pullOnly)"
        return 0
    fi
    if [ "$R_busy" -eq 1 ]; then
        emit busy 1 "another git process holds its index (index.lock): try again later"
        return 0
    fi
    if [ -n "$R_operation" ]; then
        emit unfinished 1 "$R_operation is in progress: finish or abort it first"
        return 0
    fi
    if [ "$R_unmerged" -gt 0 ]; then
        emit unfinished 1 "$(plural "$R_unmerged" file) with unresolved conflicts"
        return 0
    fi
    pending=$(( R_tracked + R_untracked ))
    if [ "$R_remotes" -eq 0 ]; then
        if [ "$pending" -gt 0 ]; then
            emit localonly 0 "$(describe_pending), and no remote: it all stays on this machine"
        else
            emit localonly 0 "it has no remote: it exists on this machine only"
        fi
        return 0
    fi
    if [ "$R_detached" -eq 1 ]; then
        if [ "$pending" -gt 0 ]; then
            emit detached 0 "HEAD is detached: nothing is committed or pushed ($(describe_pending))"
        else
            emit detached 0 "HEAD is detached: nothing is pushed"
        fi
        return 0
    fi
    if [ "$R_unborn" -eq 1 ] && [ "$pending" -eq 0 ]; then
        emit nothing 0 ""
        return 0
    fi
    if ! push_target; then
        if [ "$pending" -gt 0 ]; then
            emit noupstream 0 "$P_why; $(describe_pending) stay here too"
        else
            emit noupstream 0 "$P_why"
        fi
        return 0
    fi
    count_to_push

    if [ "$pending" -gt 0 ]; then
        if commits_here; then
            list_pending
            block=$(commit_blocker)
            [ -z "$block" ] && will_commit=1
        else
            stays="$(describe_pending): not committed, they stay on this machine"
        fi
    fi
    if [ "$will_commit" -eq 0 ] && [ "$P_ahead" -eq 0 ] && [ "$P_new" -eq 0 ]; then
        if [ -n "$block" ]; then
            emit notcommitted 1 "$(describe_pending): $block"
        elif [ -n "$stays" ]; then
            emit pending 0 "$stays"
        else
            emit nothing 0 ""
        fi
        extras=$(other_branches)
        details "$extras"
        return 0
    fi
    if [ "$P_behind" -gt 0 ] && [ "$DIVERGED" = "report" ]; then
        # The last fetch saw commits on the server that this machine lacks,
        # and the setting leaves them to the user: the push would be
        # refused, and a commit made now would only widen the gap.
        if [ "$pending" -gt 0 ]; then
            text="; $(describe_pending): not committed"
        fi
        if [ "$P_ahead" -gt 0 ]; then
            emit diverged 1 "$(plural "$P_ahead" commit) here and $P_behind on the server: left to you, since the push would be refused (git pull --rebase, or git pull --no-rebase)$text"
        else
            emit behind 1 "$(plural "$P_behind" "new commit") on the server: pull them first, then push ($PROG sync does both)$text"
        fi
        extras=$(other_branches)
        details "$extras"
        return 0
    fi

    slug=$(remote_slug "$P_remote")
    net_setup
    github_facts "$slug"
    if [ "$H_push" = "false" ] || [ "$H_archived" = "true" ]; then
        if [ "$H_archived" = "true" ]; then
            text="$slug is archived on GitHub and takes no push"
        else
            text="this account has no right to push to $slug"
        fi
        if [ "$pending" -gt 0 ]; then
            emit pending 0 "$(describe_pending) stay on this machine: $text"
        else
            emit ahead 0 "$(plural "$P_ahead" commit) stay on this machine: $text"
        fi
        return 0
    fi

    total=$(( P_ahead + will_commit ))
    if [ "$will_commit" -eq 1 ]; then
        text="commit $(plural "$L_count" file), then push $(plural "$total" commit)"
    elif [ "$P_new" -eq 1 ]; then
        text="publish the branch $R_branch ($(plural "$P_ahead" commit))"
    else
        text="push $(plural "$P_ahead" commit)"
    fi
    [ "$P_behind" -gt 0 ] && text="$text, after taking $P_behind from the server"
    if [ -n "$block" ]; then
        stays="$(describe_pending) NOT committed: $block"
        : > "$TMP/plan/$IDX.alert"
    fi
    if [ -n "$stays" ]; then
        text="$text; $stays"
        printf '%s' "$stays" > "$TMP/plan/$IDX.stays"
    fi
    text="$text$(visibility_mark)"
    emit planned "$( [ -n "$block" ] && printf 1 || printf 0 )" "$text"
    if [ "$will_commit" -eq 1 ]; then
        details "$(pending_words 6)"
        [ "$L_count" -gt 6 ] && detail "... and $(( L_count - 6 )) more"
        : > "$TMP/plan/$IDX.commit"
    fi
    extras=$(other_branches)
    details "$extras"
    printf 'P%s%s%s%s%s%s\n' "$US" "$will_commit" "$US" "$total" "$US" "$H_vis"
    : > "$TMP/plan/$IDX.go"
    return 0
}

do_push() {
    # The second pass of "push": commit when the plan said so, then push;
    # when the server has newer commits, take them as "pull" does and push
    # once more. A repository without a marker keeps the answer of the plan.
    local committed=0 note="" rc pushed mark nfiles=0 stays="" alert=0 made="" looked=0
    local kind server=""
    if [ ! -e "$TMP/plan/$IDX.go" ]; then
        cat "$TMP/plan/$IDX.res"
        return 0
    fi
    repo_begin || return 0
    if [ "$R_busy" -eq 1 ] || [ -n "$R_operation" ] || [ "$R_unmerged" -gt 0 ] || [ "$R_detached" -eq 1 ]; then
        emit unfinished 1 "its state changed since the plan: nothing was done"
        return 0
    fi
    # What the plan found about GitHub and about pending files that stay.
    H_vis=""
    while IFS=$US read -r kind _ _ mark; do
        [ "$kind" = "P" ] && H_vis=$mark
    done < "$TMP/plan/$IDX.res"
    mark=$(visibility_mark)
    [ -f "$TMP/plan/$IDX.stays" ] && stays=$(cat "$TMP/plan/$IDX.stays")
    [ -e "$TMP/plan/$IDX.alert" ] && alert=1
    if [ -e "$TMP/plan/$IDX.commit" ]; then
        if commit_pending; then
            committed=1
            nfiles=$L_count
            made=" (the commit is made, not pushed)"
            inspect
        elif [ "$C_why" != "nothing is pending any more" ]; then
            stays="$(describe_pending) NOT committed: $C_why"
            alert=1
        fi
    fi
    if ! push_target; then
        emit noupstream 1 "$P_why"
        return 0
    fi
    count_to_push
    net_setup
    if [ "$P_ahead" -eq 0 ] && [ "$P_new" -eq 0 ]; then
        if [ -n "$stays" ]; then
            emit notcommitted "$alert" "$stays"
        else
            emit nothing 0 ""
        fi
        return 0
    fi
    if stopped; then
        emit interrupted 1 "stopped before the push$made"
        return 0
    fi
    pushed=$P_ahead
    server=$(g rev-parse -q --verify "$P_ref^{commit}" 2>/dev/null)
    push_once
    rc=$?
    if [ "$rc" -eq 1 ]; then
        # The server refused. If it holds commits that this machine lacks,
        # they are taken as the morning update does, and the push is tried
        # once more; a conflict there is undone and reported.
        if [ "$P_ref" = "$R_up_ref" ]; then
            if [ "$DIVERGED" = "report" ]; then
                ONLY_LOOK=1
                looked=1
            fi
            level_with_server
            ONLY_LOOK=0
            case "$U_state" in
                updated|rebased|merged)
                    [ -n "$U_move" ] && printf 'J%s%s\n' "$US" "$U_move"
                    note=" after taking $(plural "$U_behind" commit) from the server"
                    inspect
                    push_target && count_to_push
                    pushed=$P_ahead
                    server=$(g rev-parse -q --verify "$P_ref^{commit}" 2>/dev/null)
                    push_once
                    rc=$?
                    ;;
                uptodate|ahead)
                    rc=2
                    ;;
                behind|diverged)
                    if [ "$looked" -eq 1 ]; then
                        emit rejected 1 "the server has $(plural "$U_behind" commit) that this machine lacks: pull first, then push again$made"
                    else
                        emit diverged 1 "the push was refused; $U_msg$made"
                    fi
                    return 0
                    ;;
                *)
                    emit "$U_state" 1 "the push was refused, and taking the commits of the server did not work: $U_msg$made"
                    return 0
                    ;;
            esac
        else
            rc=2
        fi
    fi
    case "$rc" in
        0)
            if [ "$committed" -eq 1 ]; then
                note="committed $(plural "$nfiles" file), pushed $(plural "$pushed" commit)$note"
            elif [ "$P_new" -eq 1 ]; then
                note="published the branch $R_branch ($(plural "$pushed" commit))$note"
            else
                note="pushed $(plural "$pushed" commit)$note"
            fi
            [ -n "$stays" ] && note="$note; $stays"
            emit pushed "$alert" "$note$mark"
            # The journal keeps where the branch of the server was and the
            # commit that it received.
            record_move push "$server" "$(g rev-parse -q --verify HEAD 2>/dev/null)"
            ;;
        3)
            emit interrupted 1 "stopped during the push$made"
            ;;
        1)
            emit rejected 1 "the server refused the push again: $PU_why$made"
            ;;
        *)
            emit failed 1 "the push failed: $PU_why$made"
            ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# The commands
# ---------------------------------------------------------------------------

begin_command() {
    # begin_command change|read: what every command does first.
    setup_colour
    setup_run
    harden_git
    discover
    if [ "$1" = "change" ] && [ "$DRY_RUN" -eq 0 ] && [ "${#REPOS[@]}" -gt 0 ]; then
        take_lock
    fi
}

last_runs() {
    local text="" when
    [ -n "$STATE_DIR" ] || return 0
    when=$(cat "$STATE_DIR/last.pull" 2>/dev/null)
    [ -n "$when" ] && text="last pull $when"
    when=$(cat "$STATE_DIR/last.push" 2>/dev/null)
    [ -n "$when" ] && text="$text${text:+, }last push $when"
    [ -n "$text" ] && printf '  (%s)' "$text"
    return 0
}

cmd_status() {
    begin_command read
    no_repository && exit "$EX_OK"
    header "$(last_runs)"
    pool do_status status render
    finish
}

cmd_pull() {
    if [ "$DRY_RUN" -eq 1 ] || [ "$COMMAND" = "fetch" ]; then
        ONLY_LOOK=1
    fi
    begin_command change
    no_repository && exit "$EX_OK"
    header ""
    pool do_pull pull render
    [ "$STOP" -eq 0 ] && [ "$ONLY_LOOK" -eq 0 ] && remember_run pull
    finish
}

render_plan() {
    # render_plan INDEX FILE: count what the first pass of "push" found;
    # nothing is printed before every repository has answered.
    local kind will rest
    while IFS=$US read -r kind will _ rest; do
        [ "$kind" = "P" ] || continue
        PLAN_GO=$(( PLAN_GO + 1 ))
        [ "$will" = "1" ] && PLAN_COMMITS=$(( PLAN_COMMITS + 1 ))
        [ "$rest" = "public" ] && PLAN_PUBLIC=$(( PLAN_PUBLIC + 1 ))
    done < "$2"
    return 0
}

plan_words() {
    local text="To do:"
    if [ "$PLAN_COMMITS" -gt 0 ]; then
        text="$text a commit in $(plural "$PLAN_COMMITS" repository), then"
    fi
    text="$text a push from $(plural "$PLAN_GO" repository)"
    if [ "$PLAN_PUBLIC" -gt 0 ]; then
        text="$text, $PLAN_PUBLIC of them PUBLIC"
    fi
    printf '%s.' "$text"
}

show_plan() {
    # The list shown before anything is committed or pushed: what will be
    # done, and what is left aside and why.
    local i=0 count="${#REPOS[@]}"
    put_title "Plan:"
    while [ "$i" -lt "$count" ]; do
        if [ -f "$TMP/plan/$i.res" ]; then
            read_record "$TMP/plan/$i.res"
            if [ "$REC_state" = "planned" ] || [ "$REC_attention" = 1 ]; then
                print_record "$i"
            fi
        fi
        i=$(( i + 1 ))
    done
    put ""
    put_title "$(plan_words)"
    return 0
}

asks() {
    # asks -> 0 when this run will stop for the confirmation
    [ "$YES" -eq 0 ] && [ "$CONFIRM" -eq 1 ]
}

show_before_asking() {
    # show_before_asking FUNCTION: print the list of what is about to be
    # done. Whoever is asked must see it, even with --quiet; and a run that
    # prints records for a program cannot stop to ask.
    local quiet=$QUIET
    if [ "$PORCELAIN" -eq 1 ]; then
        asks && die "$EX_USAGE" "with --porcelain nothing can be asked: add --yes"
        return 0
    fi
    asks && QUIET=0
    "$1"
    QUIET=$quiet
    return 0
}

confirmed() {
    # One question for the whole run. Without a terminal there is nobody to
    # ask: the run then needs --yes.
    local answer=""
    if [ "$YES" -eq 1 ] || [ "$CONFIRM" -eq 0 ]; then
        return 0
    fi
    if [ ! -t 0 ]; then
        die "$EX_USAGE" "this run changes repositories: confirm it at a terminal, or add --yes"
    fi
    printf '%sProceed?%s [Y/n] ' "$C_BOLD" "$C_OFF" >&2
    IFS= read -r answer || answer="n"
    [ "$STOP" -eq 1 ] && return 1
    case "$answer" in
        ""|[Yy]|[Yy][Ee][Ss]) return 0 ;;
    esac
    return 1
}

push_phase() {
    local i=0 count="${#REPOS[@]}"
    PLAN_GO=0; PLAN_COMMITS=0; PLAN_PUBLIC=0
    pool do_plan plan render_plan
    if [ "$STOP" -eq 0 ] && [ "$PLAN_GO" -gt 0 ] && [ "$DRY_RUN" -eq 0 ]; then
        show_before_asking show_plan
        if ! confirmed; then
            put "Nothing was done."
            exit "$EX_OK"
        fi
        if [ "$PORCELAIN" -eq 0 ]; then
            put ""
            put_title "Done:"
        fi
        pool do_push push render
        [ "$STOP" -eq 0 ] && remember_run push
        return 0
    fi
    # Nothing to do, or only a look: the plan is the report.
    while [ "$i" -lt "$count" ]; do
        [ -f "$TMP/plan/$i.res" ] && render "$i" "$TMP/plan/$i.res"
        i=$(( i + 1 ))
    done
    if [ "$DRY_RUN" -eq 1 ] && [ "$PLAN_GO" -gt 0 ] && [ "$PORCELAIN" -eq 0 ]; then
        put ""
        put_title "$(plan_words) Nothing was changed (dry run)."
    fi
    return 0
}

cmd_push() {
    begin_command change
    no_repository && exit "$EX_OK"
    header ""
    push_phase
    finish
}

reset_tally() {
    local state
    for state in $STATE_ORDER planned; do
        printf -v "N_$state" '%s' 0
    done
    TOTAL=0
    SHOWN=0
    ATTENTION_LIST=""
}

cmd_sync() {
    [ "$DRY_RUN" -eq 1 ] && ONLY_LOOK=1
    begin_command change
    no_repository && exit "$EX_OK"
    header ""
    [ "$PORCELAIN" -eq 0 ] && put_title "First, the pull:"
    pool do_pull pull render
    [ "$STOP" -eq 0 ] && [ "$ONLY_LOOK" -eq 0 ] && remember_run pull
    if [ "$STOP" -eq 1 ]; then
        finish
    fi
    summary
    reset_tally
    if [ "$PORCELAIN" -eq 0 ]; then
        put ""
        put_title "Then, the push:"
    fi
    push_phase
    finish
}

notify() {
    # Hand the report to the command of gh-batch.notify, for a run that
    # nobody watches. The command reads the report on its standard input.
    local when="$NOTIFY_ON" status="ok"
    [ "$OPT_NOTIFY" -eq 1 ] && when="always"
    [ "$when" = "never" ] && return 0
    if [ -z "$NOTIFY_CMD" ]; then
        [ "$OPT_NOTIFY" -eq 1 ] &&
            warn "--notify needs a command: git config --global gh-batch.notify 'COMMAND'"
        return 0
    fi
    [ "$ATTENTION" -eq 1 ] && status="attention"
    if [ "$when" = "attention" ] && [ "$status" = "ok" ]; then
        return 0
    fi
    [ -s "$TMP/report.txt" ] || return 0
    ( notify_child "$status" ) </dev/null >/dev/null 2>&1 ||
        warn "the notification command did not succeed"
    return 0
}

notify_child() {
    # Runs in a subshell of its own: the command gets one minute.
    W="$TMP"
    export GH_BATCH_COMMAND="$COMMAND"
    export GH_BATCH_STATUS="$1"
    # shellcheck disable=SC2016  # the inner shell expands its own arguments
    spawn notify sh -c 'exec sh -c "$1" < "$2"' sh "$NOTIFY_CMD" "$TMP/report.txt"
    await timed 60
}

# ---------------------------------------------------------------------------
# clone: what an account or a layout file names and this machine lacks
# ---------------------------------------------------------------------------

clone_destination() {
    # The folder that receives the clones: --into, else the first folder of
    # the settings. A mass clone never falls back on the current folder.
    local dest=""
    if [ -n "$INTO" ]; then
        dest=$(expand_tilde "$INTO")
    elif [ -n "${GH_BATCH_ROOT:-}" ]; then
        dest=$(expand_tilde "$GH_BATCH_ROOT")
    elif [ "${#CFG_ROOTS[@]}" -gt 0 ]; then
        dest=${CFG_ROOTS[0]}
    else
        die "$EX_USAGE" "name the folder that receives the clones: --into DIR, or git config --global gh-batch.root DIR"
    fi
    if [ ! -d "$dest" ]; then
        [ -e "$dest" ] && die "$EX_USAGE" "$dest exists and is not a folder"
        mkdir -p "$dest" || die "$EX_USAGE" "cannot create $dest"
    fi
    DEST=$(cd "$dest" && pwd) || die "$EX_USAGE" "cannot enter $dest"
    if git -C "$DEST" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        die "$EX_USAGE" "$(short_path "$DEST") is inside a git repository: clones do not go there"
    fi
}

known_slugs() {
    # The GitHub names of every repository already under the destination,
    # whatever its folder: one line "name<US>index" per remote, in $TMP/known.
    local i=0 name url slug
    : > "$TMP/known"
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        REPO=${REPOS[$i]}
        GIT=(git -C "$REPO")
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            for url in "$(g remote get-url "$name" 2>/dev/null)" "$(g config --get "remote.$name.url" 2>/dev/null)"; do
                slug=$(github_slug "$url")
                [ -n "$slug" ] && printf '%s%s%s\n' "$slug" "$US" "$i" >> "$TMP/known"
            done
        done <<EOF
$(g remote 2>/dev/null)
EOF
        i=$(( i + 1 ))
    done
    return 0
}

is_known() {
    # is_known SLUG -> 0 when a repository under the destination has it
    local slug index
    while IFS=$US read -r slug index; do
        [ "$slug" = "$1" ] && return 0
    done < "$TMP/known"
    return 1
}

moved_here() {
    # moved_here FOLDER SLUG -> 0 when the repository in FOLDER is SLUG under
    # an older name: GitHub answers for a renamed or transferred repository
    # with its present name.
    local folder="$1" wanted="$2" name url slug now
    have gh || return 1
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        url=$(git -C "$folder" config --get "remote.$name.url" 2>/dev/null)
        slug=$(github_slug "$url")
        [ -n "$slug" ] || continue
        now=$(GH_PROMPT_DISABLED=1 gh api "repos/$slug" --jq .full_name 2>/dev/null | tr '[:upper:]' '[:lower:]')
        [ "$now" = "$wanted" ] && return 0
    done <<EOF
$(git -C "$folder" remote 2>/dev/null)
EOF
    return 1
}

clone_candidate() {
    # clone_candidate NAME ADDRESS TARGET SLUG SIZE_KB MARK BRANCH: decide
    # whether the repository is cloned, is present, or cannot be placed.
    local name="$1" url="$2" target="$3" slug="$4" size="$5" mark="$6" branch="$7" parent
    parent=${target%/*}
    if [ -e "$target/.git" ]; then
        if [ -z "$slug" ] || moved_here "$target" "$slug"; then
            C_PRESENT=$(( C_PRESENT + 1 ))
            [ -n "$slug" ] && C_NOTES+=("$name is here under an older address: git -C $(short_path "$target") remote set-url origin $url")
        else
            C_NOTES+=("$name is not cloned: the folder $(short_path "$target") holds another repository")
            C_BLOCKED=$(( C_BLOCKED + 1 ))
        fi
        return 0
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        if [ ! -d "$target" ] || [ -n "$(ls -A "$target" 2>/dev/null)" ]; then
            C_NOTES+=("$name is not cloned: $(short_path "$target") exists and is not a repository")
            C_BLOCKED=$(( C_BLOCKED + 1 ))
            return 0
        fi
    fi
    if [ "$parent" != "$DEST" ] && [ -e "$parent/.git" ]; then
        C_NOTES+=("$name is not cloned: the folder $(short_path "$parent") is a repository itself")
        C_BLOCKED=$(( C_BLOCKED + 1 ))
        return 0
    fi
    REPOS+=("$target")
    NAMES+=("$name")
    C_URL+=("$url")
    C_BRANCH+=("$branch")
    C_MARK+=("$mark")
    is_uint "$size" || size=0
    C_SIZE+=("$size")
    C_TOTAL_KB=$(( C_TOTAL_KB + size ))
    return 0
}

matches_selection() {
    # The --only and --except patterns, applied to a name of the server.
    local saved_exclude=(${CFG_EXCLUDE[@]+"${CFG_EXCLUDE[@]}"}) rc
    CFG_EXCLUDE=()
    selected "$1"
    rc=$?
    CFG_EXCLUDE=(${saved_exclude[@]+"${saved_exclude[@]}"})
    return "$rc"
}

read_account() {
    # read_account OWNER SELF PROTOCOL: list the repositories of an owner on
    # GitHub and sort them into present, to clone, and impossible to place.
    local owner="$1" self="$2" protocol="$3" lines=0
    local slug fork archived private size pushed https ssh name low low_owner target url mark
    GH_PROMPT_DISABLED=1 gh repo list "$owner" --limit 4000 \
        --json nameWithOwner,isFork,isArchived,isPrivate,diskUsage,pushedAt,url,sshUrl \
        --jq '.[] | [.nameWithOwner, (.isFork|tostring), (.isArchived|tostring), (.isPrivate|tostring), (.diskUsage|tostring), (.pushedAt // ""), .url, .sshUrl] | join("\u001f")' \
        > "$TMP/list" 2> "$TMP/list.err" ||
        die "$EX_ENV" "GitHub did not give the repositories of $owner: $(last_line "$TMP/list.err")"
    while IFS=$US read -r slug fork archived private size pushed https ssh; do
        [ -n "$slug" ] || continue
        lines=$(( lines + 1 ))
        C_LISTED=$(( C_LISTED + 1 ))
        name=${slug#*/}
        case "$slug" in
            */*) ;;
            *)   continue ;;
        esac
        case "${slug%%/*}$name" in
            *[!A-Za-z0-9._-]*)
                warn "the name $slug holds an unexpected character and is left out"
                continue
                ;;
        esac
        [ "$NO_FORKS" -eq 1 ] && [ "$fork" = "true" ] && continue
        [ "$NO_ARCHIVED" -eq 1 ] && [ "$archived" = "true" ] && continue
        if [ -n "$SINCE" ] && [ "${pushed%%T*}" \< "$SINCE" ]; then
            continue
        fi
        matches_selection "$name" || continue
        C_WANTED=$(( C_WANTED + 1 ))
        low=$(printf '%s' "$slug" | tr '[:upper:]' '[:lower:]')
        if is_known "$low"; then
            C_PRESENT=$(( C_PRESENT + 1 ))
            continue
        fi
        low_owner=$(printf '%s' "${slug%%/*}" | tr '[:upper:]' '[:lower:]')
        if [ "$LAYOUT" = "flat" ] || { [ "$LAYOUT" = "auto" ] && [ "$low_owner" = "$self" ]; }; then
            target="$DEST/$name"
        else
            target="$DEST/${slug%%/*}/$name"
            name=$slug
        fi
        if [ "$protocol" = "ssh" ] && [ -n "$ssh" ]; then url=$ssh; else url=$https; fi
        mark="private"
        [ "$private" = "false" ] && mark="PUBLIC"
        clone_candidate "$name" "$url" "$target" "$low" "$size" "$mark" ""
    done < "$TMP/list"
    [ "$lines" -ge 4000 ] &&
        warn "$owner has 4000 repositories or more: only the first 4000 were read"
    return 0
}

read_manifest() {
    # read_manifest FILE: the lines "folder, address, branch" of a layout
    # written by "list --manifest".
    local path url branch
    [ -f "$1" ] || die "$EX_USAGE" "no such layout file: $1"
    while IFS=$TAB read -r path url branch || [ -n "${path:-}" ]; do
        case "$path" in
            ""|"#"*) continue ;;
        esac
        C_LISTED=$(( C_LISTED + 1 ))
        case "/$path/" in
            *"/../"*|//*)
                warn "the folder $path of the layout leaves the destination and is left out"
                continue
                ;;
        esac
        case "$url" in
            ""|*"<hidden>"*)
                warn "$path has no usable address in the layout and is left out"
                continue
                ;;
        esac
        matches_selection "$path" || continue
        C_WANTED=$(( C_WANTED + 1 ))
        clone_candidate "$path" "$url" "$DEST/${path%/}" "" 0 "" "${branch:-}"
    done < "$1"
    return 0
}

megabytes() {
    # megabytes KILOBYTES -> "12 MB", or "under 1 MB"
    if [ "$1" -lt 1024 ]; then
        printf 'under 1 MB'
    else
        printf '%s MB' $(( ($1 + 512) / 1024 ))
    fi
}

sweep_leftovers() {
    # A clone is made under a temporary name beside its place. A name left
    # by a run that died is removed; the one of a run still alive is kept.
    local parent="$1" entry pid
    for entry in "$parent"/.gh-batch-clone.*; do
        [ -d "$entry" ] || continue
        pid=${entry##*.}
        if is_uint "$pid" && kill -0 "$pid" 2>/dev/null; then
            continue
        fi
        rm -rf "$entry"
    done
    return 0
}

do_clone() {
    # Clone one repository under a temporary name beside its place, then
    # give it its name: an interrupted run leaves nothing half-made.
    local target="$REPO" url="${C_URL[$IDX]}" branch="${C_BRANCH[$IDX]}" parent tmp rc note="" attention=0 first
    R_branch=""
    parent=${target%/*}
    if ! mkdir -p "$parent" 2>/dev/null; then
        emit failed 1 "cannot create the folder $(short_path "$parent")"
        return 0
    fi
    tmp="$parent/.gh-batch-clone.${target##*/}.$$"
    rm -rf "$tmp"
    if [ "$USER_SSH" -eq 0 ]; then
        export GIT_SSH_COMMAND="${GLOBAL_SSH:-ssh} -o BatchMode=yes -o ConnectTimeout=20 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"
    fi
    spawn clone env GIT_LFS_SKIP_SMUDGE=1 git -c credential.interactive=false \
        -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 clone --quiet "$url" "$tmp"
    await net 0
    rc=$?
    if [ "$rc" -eq 130 ]; then
        rm -rf "$tmp"
        emit interrupted 1 "stopped during the clone: nothing was left behind"
        return 0
    fi
    if ! git -C "$tmp" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        rm -rf "$tmp"
        emit failed 1 "the clone failed: $(net_failure "$rc")"
        return 0
    fi
    if [ "$rc" -ne 0 ]; then
        # The history arrived but the files could not be written.
        note="; the files could not all be checked out ($(last_line "$ERR"))"
        attention=1
    fi
    [ -d "$target" ] && rmdir "$target" 2>/dev/null
    if [ -e "$target" ] || ! mv "$tmp" "$target" 2>/dev/null; then
        rm -rf "$tmp"
        emit failed 1 "the clone could not take its place at $(short_path "$target")"
        return 0
    fi
    REPO=$target
    GIT=(git -C "$REPO")
    # Large files kept with git-lfs were left as pointers by the clone, so
    # that a failed download cannot lose the clone itself; they come now.
    if have git-lfs; then
        first=""
        IFS= read -r first < <(g lfs ls-files 2>/dev/null)
        if [ -n "$first" ]; then
            run_net lfs "${GIT[@]}" lfs pull
            rc=$?
            if [ "$rc" -ne 0 ]; then
                note="$note; its large files were not downloaded: run git lfs pull in it"
                attention=1
            fi
        fi
    elif grep -qs 'filter=lfs' "$REPO/.gitattributes"; then
        note="$note; it keeps large files with git-lfs, which is not installed"
        attention=1
    fi
    if [ -n "$branch" ]; then
        R_branch=$(g symbolic-ref -q --short HEAD 2>/dev/null)
        if [ "$R_branch" != "$branch" ]; then
            if run_local checkout "${GIT[@]}" checkout --quiet "$branch"; then
                R_branch=$branch
            else
                note="$note; the branch $branch of the layout could not be checked out"
                attention=1
            fi
        fi
    else
        R_branch=$(g symbolic-ref -q --short HEAD 2>/dev/null)
    fi
    emit cloned "$attention" "into $(short_path "$target")$note"
    record_move clone "$(printf '%s' "$url" | redact)" ""
    return 0
}

show_clone_plan() {
    local i=0 line size="" mark_colour
    if [ "$C_TOTAL_KB" -ge 1024 ]; then
        size=" (about $(megabytes "$C_TOTAL_KB"))"
    elif [ "$C_TOTAL_KB" -gt 0 ]; then
        size=" (under 1 MB)"
    fi
    put_title "Plan: clone $(plural "${#REPOS[@]}" repository) into $(short_path "$DEST")$size"
    while [ "$i" -lt "${#REPOS[@]}" ]; do
        size=$( [ "${C_SIZE[$i]}" -gt 0 ] && megabytes "${C_SIZE[$i]}" )
        line=$(printf '  %-*s  %-8s %s' "$NAME_WIDTH" "${NAMES[$i]}" "${C_MARK[$i]}" "$size")
        case "${C_MARK[$i]}" in
            PUBLIC) mark_colour=$C_PUBLIC ;;
            *)      mark_colour=$C_DIM ;;
        esac
        put_styled "${line%"${line##*[! ]}"}" \
            "$(printf '  %s%-*s%s  %s%-8s%s %s%s%s' "$C_NAME" "$NAME_WIDTH" "${NAMES[$i]}" "$C_OFF" "$mark_colour" "${C_MARK[$i]}" "$C_OFF" "$C_DIM" "$size" "$C_OFF")"
        i=$(( i + 1 ))
    done
    return 0
}

cmd_clone() {
    local owners=() owner self="" protocol="https" i saved_only=() saved_except=() note
    local present_repos=() present_names=()
    setup_colour
    setup_run
    harden_git
    clone_destination
    GLOBAL_SSH=$(git config --global --includes --get core.sshCommand 2>/dev/null)
    case "$LAYOUT" in
        auto|flat|owner) ;;
        *) die "$EX_USAGE" "the layouts are auto, flat and owner, not '$LAYOUT'" ;;
    esac
    if [ -n "$SINCE" ]; then
        case "$SINCE" in
            [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
            *) die "$EX_USAGE" "--since takes a date written as 2026-01-31, not '$SINCE'" ;;
        esac
    fi

    # What is already under the destination, the selection left aside: a
    # repository filtered out is still one that must not be cloned again.
    saved_only=(${ONLY[@]+"${ONLY[@]}"})
    saved_except=(${EXCEPT[@]+"${EXCEPT[@]}"})
    ONLY=(); EXCEPT=()
    ARGS=("$DEST")
    discover
    ONLY=(${saved_only[@]+"${saved_only[@]}"})
    EXCEPT=(${saved_except[@]+"${saved_except[@]}"})
    present_repos=(${REPOS[@]+"${REPOS[@]}"})
    present_names=(${NAMES[@]+"${NAMES[@]}"})
    known_slugs

    REPOS=(); NAMES=()
    C_URL=(); C_BRANCH=(); C_MARK=(); C_SIZE=(); C_NOTES=()
    C_LISTED=0; C_WANTED=0; C_PRESENT=0; C_BLOCKED=0; C_TOTAL_KB=0
    if [ -n "$MANIFEST_IN" ]; then
        [ "${#OWNERS[@]}" -eq 0 ] || die "$EX_USAGE" "give either owners or --manifest FILE, not both"
        read_manifest "$MANIFEST_IN"
        note="$(plural "$C_LISTED" repository) in $(short_path "$MANIFEST_IN")"
    else
        have gh || die "$EX_ENV" "the GitHub CLI (gh) is needed to read an account: https://cli.github.com"
        self=$(GH_PROMPT_DISABLED=1 gh api user --jq .login 2>"$TMP/list.err" | tr '[:upper:]' '[:lower:]')
        [ -n "$self" ] || die "$EX_ENV" "gh is not logged in to GitHub (gh auth login): $(last_line "$TMP/list.err")"
        if [ "${#OWNERS[@]}" -gt 0 ]; then
            owners=("${OWNERS[@]}")
        else
            owners=("$self")
        fi
        protocol=$(GH_PROMPT_DISABLED=1 gh config get git_protocol 2>/dev/null)
        note=""
        for owner in "${owners[@]}"; do
            read_account "$owner" "$self" "$protocol"
            note="$note${note:+, }$owner"
        done
        note="$(plural "$C_LISTED" repository) of $note on GitHub"
    fi
    fit_names

    if [ "$PORCELAIN" -eq 0 ]; then
        # The counts that follow concern the repositories that the filters
        # kept, which the first words say when they kept fewer.
        [ "$C_WANTED" -lt "$C_LISTED" ] && note="$note, $C_WANTED of them selected"
        put_styled "$PROG clone: $note; $C_PRESENT already under $(short_path "$DEST"), ${#REPOS[@]} to clone" \
            "$C_TITLE$PROG clone$C_OFF: $note; $C_PRESENT already under $(short_path "$DEST"), ${#REPOS[@]} to clone"
        put ""
        for note in ${C_NOTES[@]+"${C_NOTES[@]}"}; do
            put_styled "  note: $note" "  ${C_INFO}note:$C_OFF $note"
        done
        [ "${#C_NOTES[@]}" -gt 0 ] && put ""
    fi
    [ "$C_BLOCKED" -gt 0 ] && ATTENTION=1

    if [ "${#REPOS[@]}" -gt 0 ]; then
        if [ "$DRY_RUN" -eq 1 ]; then
            if [ "$PORCELAIN" -eq 1 ]; then
                i=0
                while [ "$i" -lt "${#REPOS[@]}" ]; do
                    printf 'planned\t%s\t\t%s\n' "${REPOS[$i]}" "$(printf '%s' "${C_URL[$i]}" | redact)"
                    i=$(( i + 1 ))
                done
            else
                show_clone_plan
                put ""
                put "Nothing was cloned (dry run)."
            fi
        else
            show_before_asking show_clone_plan
            take_lock
            if ! confirmed; then
                put "Nothing was done."
                exit "$EX_OK"
            fi
            [ "$PORCELAIN" -eq 0 ] && put ""
            sweep_leftovers "$DEST"
            for owner in ${owners[@]+"${owners[@]}"}; do
                [ -d "$DEST/$owner" ] && sweep_leftovers "$DEST/$owner"
            done
            [ "$JOBS" -gt 4 ] && [ "$SRC_jobs" = "default" ] && JOBS=4
            pool do_clone clone render
            summary
        fi
    elif [ "$PORCELAIN" -eq 0 ]; then
        put "Nothing is missing."
    fi

    if [ "$UPDATE" -eq 1 ] && [ "$STOP" -eq 0 ] && [ "${#present_repos[@]}" -gt 0 ]; then
        # The repositories that were there before are brought forward, as
        # "pull" does.
        REPOS=(); NAMES=()
        i=0
        while [ "$i" -lt "${#present_repos[@]}" ]; do
            if selected "${present_names[$i]}"; then
                REPOS+=("${present_repos[$i]}")
                NAMES+=("${present_names[$i]}")
            fi
            i=$(( i + 1 ))
        done
        if [ "${#REPOS[@]}" -gt 0 ]; then
            reset_tally
            fit_names
            [ "$DRY_RUN" -eq 1 ] && ONLY_LOOK=1
            [ "$LOCKED" -eq 0 ] && [ "$DRY_RUN" -eq 0 ] && take_lock
            pick GH_BATCH_JOBS "$CFG_jobs" 8 "$OPT_JOBS"
            JOBS=$VAL
            if [ "$PORCELAIN" -eq 0 ]; then
                put ""
                put_title "Then, the pull of the $(plural "${#REPOS[@]}" repository) already here:"
            fi
            pool do_pull pull render
            [ "$STOP" -eq 0 ] && [ "$ONLY_LOOK" -eq 0 ] && remember_run pull
            summary
        fi
    fi
    notify
    [ "$STOP" -eq 1 ] && exit "$EX_INTERRUPT"
    [ "$ATTENTION" -eq 1 ] && exit "$EX_ATTENTION"
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# log: the commits of a period across the repositories
# ---------------------------------------------------------------------------

do_log() {
    # One line "L" per commit of the period on a local branch: epoch, date,
    # short hash, author, subject.
    local author line n=0 args
    repo_begin || return 0
    if [ "$R_unborn" -eq 1 ]; then
        emit quiet 0 ""
        return 0
    fi
    args=(log --branches HEAD --no-merges --reverse "--since=$LOG_SINCE"
        "--date=format-local:$LOG_DATE" "--format=%ct%x1f%cd%x1f%h%x1f%an%x1f%s")
    [ -n "$LOG_UNTIL" ] && args+=("--until=$LOG_UNTIL")
    if [ "$ALL_AUTHORS" -eq 0 ]; then
        author=$LOG_AUTHOR
        [ -n "$author" ] || author=$(g config --get user.email 2>/dev/null)
        [ -n "$author" ] && args+=(--fixed-strings "--author=$author")
    fi
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        n=$(( n + 1 ))
        printf 'L%s%s\n' "$US" "$line"
    done <<EOF
$(g "${args[@]}" 2>/dev/null)
EOF
    if [ "$n" -eq 0 ]; then
        emit quiet 0 ""
    else
        emit active 0 "$(plural "$n" commit)"
    fi
    return 0
}

render_log() {
    # render_log INDEX FILE: the commits of one repository, oldest first.
    local idx="$1" kind a b c d e state="" branch="" message="" n=0 shown=0 line limit=50 width=100
    if [ "$LONG" -eq 1 ]; then
        limit=1000000
        width=1000000
    fi
    while IFS=$US read -r kind a b c d e; do
        [ "$kind" = "S" ] && { state=$a; branch=$c; message=$d; }
    done < "$2"
    case "$state" in
        ignored|skipped|"") return 0 ;;
        unreadable)
            TOTAL=$(( TOTAL + 1 ))
            ATTENTION=1
            put_repo unreadable 1 "${NAMES[$idx]}" "" "$message"
            return 0
            ;;
    esac
    TOTAL=$(( TOTAL + 1 ))
    [ "$state" = "active" ] || return 0
    LOG_REPOS=$(( LOG_REPOS + 1 ))
    [ "$PORCELAIN" -eq 1 ] || put_repo active 0 "${NAMES[$idx]}" "$branch" "$message"
    while IFS=$US read -r kind a b c d e; do
        [ "$kind" = "L" ] || continue
        n=$(( n + 1 ))
        LOG_COMMITS=$(( LOG_COMMITS + 1 ))
        if [ "$PORCELAIN" -eq 1 ]; then
            printf '%s\t%s\t%s\t%s\t%s\n' "$a" "${REPOS[$idx]}" "$c" "$d" "$e"
            continue
        fi
        [ "$n" -gt "$limit" ] && continue
        shown=$n
        line="$b  $c  $(clip "$e" "$width")"
        [ "$ALL_AUTHORS" -eq 1 ] && line="$line  ($d)"
        [ -n "$TMP" ] && printf '        %s\n' "$line" >> "$TMP/report.txt"
        [ "$QUIET" -eq 1 ] && continue
        if [ "$STYLED" -eq 1 ]; then
            printf '        %s%s%s  %s%s%s  %s' "$C_DIM" "$b" "$C_OFF" "$C_HASH" "$c" "$C_OFF" "$(clip "$e" "$width")"
            [ "$ALL_AUTHORS" -eq 1 ] && printf '  %s(%s)%s' "$C_DIM" "$d" "$C_OFF"
            printf '\n'
        else
            printf '        %s\n' "$line"
        fi
    done < "$2"
    if [ "$PORCELAIN" -eq 0 ] && [ "$n" -gt "$shown" ]; then
        put "        ... and $(( n - shown )) more (all of them with --long)"
    fi
    return 0
}

cmd_log() {
    local period="since $LOG_SINCE"
    LOG_COMMITS=0; LOG_REPOS=0
    if [ -z "$LOG_SINCE" ]; then
        LOG_SINCE="midnight"
        LOG_DATE="%H:%M"
        period="today"
    else
        LOG_DATE="%Y-%m-%d %H:%M"
    fi
    [ -n "$LOG_UNTIL" ] && period="$period until $LOG_UNTIL"
    begin_command read
    no_repository && exit "$EX_OK"
    pool do_log log render_log
    if [ "$PORCELAIN" -eq 0 ]; then
        [ "$LOG_COMMITS" -gt 0 ] && put ""
        if [ "$LOG_COMMITS" -eq 0 ]; then
            put_styled "No commit $period in the $(plural "$TOTAL" repository) under $ROOT_LABEL." \
                "${C_DIM}No commit $period in the $(plural "$TOTAL" repository) under $ROOT_LABEL.$C_OFF"
        else
            put_styled "$(plural "$LOG_COMMITS" commit) in $(plural "$LOG_REPOS" repository) $period ($TOTAL searched under $ROOT_LABEL)." \
                "$C_BOLD$(plural "$LOG_COMMITS" commit) in $(plural "$LOG_REPOS" repository) $period$C_OFF ($TOTAL searched under $ROOT_LABEL)."
        fi
    fi
    [ "$STOP" -eq 1 ] && exit "$EX_INTERRUPT"
    [ "$ATTENTION" -eq 1 ] && exit "$EX_ATTENTION"
    exit "$EX_OK"
}

# ---------------------------------------------------------------------------
# exec: a command of the user in every repository
# ---------------------------------------------------------------------------

chosen_by_state() {
    # The filters --dirty, --clean, --ahead and --behind, for the repository
    # just inspected. Without a filter every repository is chosen.
    local pending=$(( R_tracked + R_untracked + R_unmerged ))
    [ "$F_DIRTY" -eq 1 ] && [ "$pending" -eq 0 ] && return 1
    [ "$F_CLEAN" -eq 1 ] && [ "$pending" -gt 0 ] && return 1
    [ "$F_AHEAD" -eq 1 ] && [ "${R_ahead:-0}" -eq 0 ] && return 1
    [ "$F_BEHIND" -eq 1 ] && [ "${R_behind:-0}" -eq 0 ] && return 1
    return 0
}

do_exec() {
    # Run the command in the repository, its two outputs together, with the
    # path and the name of the repository in the environment.
    local rc
    repo_begin || return 0
    if ! chosen_by_state; then
        emit ignored 0 ""
        return 0
    fi
    export GH_BATCH_REPO="$REPO"
    export GH_BATCH_NAME="$NAME"
    # shellcheck disable=SC2016  # the inner shell expands its own arguments
    spawn exec sh -c 'cd "$1" && shift && unset GIT_OPTIONAL_LOCKS && exec "$@" 2>&1' sh "$REPO" "${EXEC_CMD[@]}"
    await net "$EXEC_LIMIT"
    rc=$?
    case "$rc" in
        0)   emit ok 0 "" ;;
        124) emit failed 1 "no end within $EXEC_LIMIT s: the command was stopped" ;;
        125) emit failed 1 "the command waited for the terminal and was stopped" ;;
        130) emit interrupted 1 "stopped" ;;
        127) emit failed 1 "the command was not found" ;;
        *)   emit failed 1 "exit status $rc" ;;
    esac
    # The first 500 lines of what the command wrote, as lines of detail.
    awk -v us="$US" '
        NR <= 500 { gsub(/[\r\t\037]/, " "); print "D" us $0 }
        END { if (NR > 500) print "D" us "... and " (NR - 500) " more lines" }
    ' "$OUT"
    return 0
}

render_exec() {
    # render_exec INDEX FILE: a repository is shown when the command wrote
    # something there or failed; the others are only counted.
    local idx="$1"
    read_record "$2"
    [ "$REC_state" = "ignored" ] && return 0
    TOTAL=$(( TOTAL + 1 ))
    tally "$REC_state"
    if [ "$REC_attention" = 1 ]; then
        ATTENTION=1
        ATTENTION_LIST="$ATTENTION_LIST${ATTENTION_LIST:+, }${NAMES[$idx]} ($(state_label "$REC_state"))"
    fi
    if [ "$PORCELAIN" -eq 1 ]; then
        printf '%s\t%s\t%s\t%s\n' "$REC_state" "${REPOS[$idx]}" "$REC_branch" "$REC_message"
        return 0
    fi
    if [ "${#REC_lines[@]}" -eq 0 ] && [ "$REC_attention" != 1 ] && [ "$VERBOSE" -eq 0 ]; then
        return 0
    fi
    print_record "$idx"
    return 0
}

cmd_exec() {
    local name
    [ "${#EXEC_CMD[@]}" -gt 0 ] ||
        die "$EX_USAGE" "exec needs a command: $PROG exec [options] [folder ...] -- COMMAND [ARGUMENT ...]"
    EXEC_LIMIT=${OPT_TIMEOUT:-0}
    EXEC_OUTPUT=1
    setup_colour
    setup_run
    for name in $(git rev-parse --local-env-vars 2>/dev/null); do
        unset "$name"
    done
    export GIT_OPTIONAL_LOCKS=0
    discover
    no_repository && exit "$EX_OK"
    header ""
    pool do_exec exec render_exec
    finish
}

# ---------------------------------------------------------------------------
# doctor: what is wrong, or will be, in the repositories and around them
# ---------------------------------------------------------------------------

finding() {
    # finding LEVEL TEXT: one line of the diagnosis; a problem needs the
    # user, a warning is worth knowing.
    printf 'D%s%s: %s\n' "$US" "$1" "$(one_line "$2")"
    [ "$1" = "problem" ] && D_problems=$(( D_problems + 1 ))
    [ "$1" = "warning" ] && D_warnings=$(( D_warnings + 1 ))
    return 0
}

doctor_remotes() {
    # The remotes of the repository: an address that carries a password, one
    # that travels unencrypted, and what GitHub says of each.
    local name url slug answer now archived seen="" authority k=0 fresh
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        url=$(g config --get "remote.$name.url" 2>/dev/null)
        case "$url" in
            http://*|https://*)
                authority=${url#*://}
                authority=${authority%%/*}
                case "$authority" in
                    *:*@*|ghp_*@*|gho_*@*|ghs_*@*|github_pat_*@*|glpat-*@*)
                        finding problem "the address of the remote $name holds a password or a token: keep it in a credential helper instead" ;;
                esac
                ;;
        esac
        case "$url" in
            http://*|git://*) finding warning "the remote $name is reached without encryption ($(printf '%s' "${url%%://*}"))" ;;
        esac
        [ "$OFFLINE" -eq 1 ] && continue
        have gh || continue
        slug=$(github_slug "$(g remote get-url "$name" 2>/dev/null)")
        [ -n "$slug" ] || slug=$(github_slug "$url")
        [ -n "$slug" ] || continue
        case "$seen " in *" $slug "*) continue ;; esac
        seen="$seen $slug"
        k=$(( k + 1 ))
        spawn "github$k" env GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 gh api "repos/$slug" \
            --jq '[.full_name, (.archived|tostring)] | join("\u001f")'
        if await net 20; then
            now=""; archived=""
            IFS=$US read -r now archived < "$OUT" || true
            answer=$(printf '%s' "$now" | tr '[:upper:]' '[:lower:]')
            if [ -n "$answer" ] && [ "$answer" != "$slug" ]; then
                case "$url" in
                    *://*) fresh="https://${GH_HOST:-github.com}/$now" ;;
                    *)     fresh="git@${GH_HOST:-github.com}:$now.git" ;;
                esac
                finding warning "the remote $name moved on GitHub to $now: git remote set-url $name $fresh"
            fi
            [ "$archived" = "true" ] && finding warning "$now is archived on GitHub: it takes no push"
        elif grep -q -i -E 'not found|404' "$ERR" 2>/dev/null; then
            finding problem "GitHub does not know $slug (remote $name): deleted, renamed without a trace, or closed to this account"
        else
            finding warning "GitHub could not be asked about $slug: $(last_line "$ERR")"
        fi
    done <<EOF
$(g remote 2>/dev/null)
EOF
    return 0
}

do_doctor() {
    local age first stashes limit=$(( DOCTOR_DAYS * 86400 )) state="healthy" attention=0 text=""
    D_problems=0; D_warnings=0
    GIT=(git -C "$REPO" -c credential.interactive=false -c submodule.recurse=false)
    if ! inspect; then
        if [ -n "$R_problem" ]; then
            emit problem 1 "git cannot read it: $R_problem"
        else
            emit ignored 0 ""
        fi
        return 0
    fi
    repo_settings
    if [ "$R_worktree" -eq 1 ]; then
        emit skipped 0 "a linked worktree: its main repository is the one examined"
        return 0
    fi
    net_setup
    {
        [ "$R_skip" -eq 1 ] && finding note "set aside by gh-batch.skip: no command touches it"
        [ "$R_pullonly" -eq 1 ] && finding note "update-only (gh-batch.pullOnly): never committed or pushed"
        [ -n "$R_operation" ] && finding problem "$R_operation is in progress: finish or abort it"
        [ "$R_unmerged" -gt 0 ] && finding problem "$(plural "$R_unmerged" file) with unresolved conflicts"
        [ "$R_busy" -eq 1 ] && finding warning "an index.lock is present: a git process is at work, or died there"
        if [ "$R_remotes" -eq 0 ]; then
            finding warning "no remote: the repository exists on this machine only"
        elif [ "$R_detached" -eq 1 ]; then
            finding warning "HEAD is detached: new commits would belong to no branch"
        elif [ "$R_unborn" -eq 0 ] && [ -z "$R_upstream" ]; then
            finding warning "the branch $R_branch follows no branch of a server: it is never pulled or pushed"
        elif [ "$R_unborn" -eq 0 ] && [ -z "$R_ahead" ]; then
            finding problem "the branch $R_upstream that $R_branch follows is gone"
        fi
        if [ $(( R_tracked + R_untracked )) -gt 0 ]; then
            age=$(oldest_change)
            if [ -n "$age" ] && [ "$age" -gt "$limit" ]; then
                finding warning "$(describe_pending) pending, the oldest since $(age_text "$age")"
            fi
        fi
        if is_uint "${R_ahead:-}" && [ "$R_ahead" -gt 0 ]; then
            first=""
            IFS= read -r first < <(g log --format=%ct --reverse "$R_upstream..HEAD" 2>/dev/null)
            if is_uint "$first" && [ $(( NOW - first )) -gt "$limit" ]; then
                finding warning "$(plural "$R_ahead" commit) not pushed, the oldest since $(age_text $(( NOW - first )))"
            fi
        fi
        stashes=$(count_stashes)
        [ "$stashes" -gt 0 ] && finding warning "$(plural "$stashes" stash): what is stashed stays on this machine"
        [ "$R_shallow" -eq 1 ] && finding note "a shallow clone: its history is cut"
        if ! g var GIT_COMMITTER_IDENT >/dev/null 2>&1; then
            finding warning "git does not know your name and e-mail here: no commit can be made"
        fi
        if grep -qs 'filter=lfs' "$REPO/.gitattributes" && ! have git-lfs; then
            finding warning "it keeps large files with git-lfs, which is not installed"
        fi
        doctor_remotes
    } > "$W/findings"
    if [ "$D_problems" -gt 0 ]; then
        state="problem"; attention=1
        text="$(plural "$D_problems" problem)"
        [ "$D_warnings" -gt 0 ] && text="$text, $(plural "$D_warnings" warning)"
    elif [ "$D_warnings" -gt 0 ]; then
        state="warning"
        text="$(plural "$D_warnings" warning)"
    fi
    emit "$state" "$attention" "$text"
    cat "$W/findings"
    return 0
}

doctor_around() {
    # What is wrong around the repositories: folders and files of the
    # workspace that no repository holds, leftovers of interrupted runs.
    local root entry base covered i n
    for root in ${ROOTS_ABS[@]+"${ROOTS_ABS[@]}"}; do
        [ -e "$root/.git" ] && continue
        n=0
        for entry in "$root"/*; do
            [ -e "$entry" ] || continue
            base=${entry##*/}
            if [ ! -d "$entry" ]; then
                n=$(( n + 1 ))
                continue
            fi
            [ -e "$entry/.git" ] && continue
            covered=0
            i=0
            while [ "$i" -lt "${#ALL_REPOS[@]}" ]; do
                case "${ALL_REPOS[$i]}" in
                    "$entry"/*) covered=1; break ;;
                esac
                i=$(( i + 1 ))
            done
            if [ "$covered" -eq 0 ] && [ -n "$(ls -A "$entry" 2>/dev/null)" ]; then
                AROUND+=("the folder $(short_path "$entry") holds no git repository within $(plural "$DEPTH" level): git saves nothing of it")
            fi
        done
        [ "$n" -gt 0 ] &&
            AROUND+=("$(plural "$n" file) directly in $(short_path "$root") belong to no repository")
        for entry in "$root"/.gh-batch-clone.* "$root"/*/.gh-batch-clone.*; do
            [ -d "$entry" ] || continue
            AROUND+=("$(short_path "$entry") is the leftover of an interrupted clone: the next clone removes it")
        done
    done
    return 0
}

cmd_doctor() {
    local line
    is_uint "$DOCTOR_DAYS" || die "$EX_USAGE" "--days takes a number of days, not '$DOCTOR_DAYS'"
    begin_command read
    no_repository && exit "$EX_OK"
    header ""
    pool do_doctor doctor render
    AROUND=()
    doctor_around
    if [ "$PORCELAIN" -eq 0 ] && [ "${#AROUND[@]}" -gt 0 ]; then
        [ "$SHOWN" -eq 1 ] && put ""
        put_title "Around the repositories:"
        for line in "${AROUND[@]}"; do
            put_styled "  warning: $line" "  ${C_INFO}warning:$C_OFF $line"
        done
        SHOWN=1
    fi
    if [ "$PORCELAIN" -eq 0 ] && [ "$OFFLINE" -eq 0 ] && ! have gh; then
        [ "$SHOWN" -eq 1 ] && put ""
        put_styled "GitHub was not asked: gh is not installed." "${C_DIM}GitHub was not asked: gh is not installed.$C_OFF"
        SHOWN=1
    fi
    finish
}

